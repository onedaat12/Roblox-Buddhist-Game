	raga = { name = "Raga, Daughter of Mara", pali = "Passion", daughter = true, hp = 750, dmg = 14, speed = 15, range = 7, scale = 1.25, color = { 220, 70, 110 }, glow = { 255, 140, 170 }, merit = 60, special = "drain" },
}

-- Where the armies appear. "group" lets a quest count any soldier of Mara's host.
Config.Spawns = {
	-- Forest: discontent, then doubt
	{ id = "f1", type = "discontent", x = 900, z = -40, count = 3, radius = 22 },
	{ id = "f2", type = "discontent", x = 965, z = 26, count = 3, radius = 22 },
	{ id = "f3", type = "discontent", x = 1020, z = -52, count = 3, radius = 22 },
	{ id = "f4", type = "doubt", x = 1092, z = 30, count = 3, radius = 22 },
	{ id = "f5", type = "doubt", x = 1152, z = -8, count = 3, radius = 22 },
	{ id = "f6", type = "doubt", x = 1186, z = 56, count = 2, radius = 18 },
	-- Uruvela: hunger and thirst, sloth and torpor
	{ id = "u1", type = "hunger", x = 1300, z = 44, count = 3, radius = 22 },
	{ id = "u2", type = "hunger", x = 1384, z = -18, count = 3, radius = 22 },
	{ id = "u3", type = "hunger", x = 1474, z = 34, count = 2, radius = 20 },
	{ id = "u4", type = "sloth", x = 1444, z = -64, count = 2, radius = 20 },
	{ id = "u5", type = "sloth", x = 1524, z = 16, count = 2, radius = 20 },
	-- East bank of the Neranjara: craving
	{ id = "s1", type = "craving", x = 1966, z = 78, count = 3, radius = 20 },
	{ id = "s2", type = "craving", x = 2014, z = 24, count = 3, radius = 18 },
	-- Mara's Field: the rest of the host
	{ id = "m1", type = "desire", x = 2108, z = -44, count = 3, radius = 22, group = "host" },
	{ id = "m2", type = "fear", x = 2172, z = 8, count = 3, radius = 22, group = "host" },
	{ id = "m3", type = "hypocrisy", x = 2250, z = 44, count = 2, radius = 20, group = "host" },
	{ id = "m4", type = "fame", x = 2282, z = -30, count = 3, radius = 22, group = "host" },
	{ id = "m5", type = "pride", x = 2342, z = -62, count = 2, radius = 20, group = "host" },
	{ id = "m6", type = "fear", x = 2350, z = 26, count = 2, radius = 20, group = "host" },
	{ id = "m7", type = "doubt", x = 2196, z = -86, count = 2, radius = 18, group = "host" },
	-- The three daughters, each in her pavilion
	{ id = "d1", type = "tanha", x = 2132, z = 74, count = 1, radius = 6, respawn = 45 },
	{ id = "d2", type = "arati", x = 2216, z = -74, count = 1, radius = 6, respawn = 45 },
	{ id = "d3", type = "raga", x = 2302, z = 66, count = 1, radius = 6, respawn = 45 },
}

-- Mara himself (the fight at the arena).
Config.Boss = {
	hp = 1600,
	hpPerExtraPlayer = 800,
	hostToDispel = 10,
	stormSeconds = 5,
	resetAfter = 45,
}

-- The nine storms Mara sent (Jataka Nidanakatha). Each turned to flowers or
-- sandalwood powder before it could touch the one seated beneath the tree.
Config.Storms = {
	{ name = "a whirlwind", color = { 200, 210, 220 } },
	{ name = "a great rain", color = { 90, 140, 220 } },
	{ name = "a shower of rocks", color = { 120, 110, 100 } },
	{ name = "a shower of weapons", color = { 190, 190, 205 } },
	{ name = "a shower of burning coals", color = { 255, 110, 40 } },
	{ name = "a shower of hot ashes", color = { 170, 150, 140 } },
	{ name = "a shower of sand", color = { 220, 190, 120 } },
	{ name = "a shower of mud", color = { 100, 76, 52 } },
	{ name = "a great darkness", color = { 30, 20, 50 } },
}

----------------------------------------------------------------------
-- Things to find
----------------------------------------------------------------------
Config.Leaves = {
	{ x = -112, z = 100 }, { x = 70, z = -112 }, { x = -84, z = -11, y = 4.2 }, { x = 244, z = 112 },
	{ x = 362, z = -112 }, { x = 462, z = 122 }, { x = 584, z = 96 }, { x = 690, z = 122 },
	{ x = 806, z = -120 }, { x = 902, z = 122 }, { x = 1046, z = -124 }, { x = 1162, z = 112 },
	{ x = 1292, z = 122 }, { x = 1426, z = 102 }, { x = 1542, z = -120 }, { x = 1692, z = 122 },
	{ x = 1880, z = -122 }, { x = 2008, z = -112 }, { x = 2204, z = 122 }, { x = 2702, z = 112 },
}

Config.Kusa = {
	{ x = 1932, z = 60 }, { x = 1958, z = 104 }, { x = 1990, z = 62 }, { x = 2022, z = 96 },
	{ x = 1936, z = -70 }, { x = 1972, z = -52 }, { x = 2018, z = -44 }, { x = 2026, z = -118 },
}

Config.Lotus = {
	{ x = 46, z = -98 }, { x = 60, z = -86 }, { x = 54, z = -104 },
	{ x = 1994, z = -102 }, { x = 2006, z = -90 }, { x = 2008, z = -104 },
	{ x = 2656, z = 72 }, { x = 2666, z = 64 }, { x = 2658, z = -70 }, { x = 2668, z = -78 },
}

-- The Eight Auspicious Symbols (Ashtamangala), one hidden in each land.
-- Finding all eight earns the Sword of Wisdom.
Config.Symbols = {
	{ id = "vase", name = "The Treasure Vase", x = -170, z = -60, text = "The treasure vase is never emptied, however much is taken from it. It stands for the teaching, which is not used up by being shared." },
	{ id = "parasol", name = "The Parasol", x = 330, z = 120, text = "The parasol gives shade from the burning sun. It stands for shelter from suffering, offered to every being." },
	{ id = "fishes", name = "The Golden Fishes", x = 756, z = -112, text = "Two golden fishes swim wherever they wish and do not fear the water. They stand for moving freely and without fear through the ocean of this world." },
	{ id = "knot", name = "The Endless Knot", x = 1000, z = 120, text = "The endless knot has no beginning and no end. It stands for the way all things depend on one another, and for wisdom and compassion woven together." },
	{ id = "conch", name = "The White Conch", x = 1370, z = -122, text = "The white conch is blown like a horn and heard far away. It stands for the sound of the teaching, which wakes those who hear it." },
	{ id = "lotus", name = "The Lotus", x = 1780, z = -118, text = "The lotus roots in mud and opens clean above the water. It stands for a mind that grows pure in the middle of a troubled world." },
	{ id = "banner", name = "The Victory Banner", x = 2300, z = -120, text = "The victory banner is raised when a battle is won. It stands for victory over Mara: over craving, fear, pride and death." },
	{ id = "wheel", name = "The Dharma Wheel", x = 2790, z = 70, text = "The wheel has eight spokes for the Noble Eightfold Path. When the Buddha first taught, it is said he set the wheel turning." },
}

-- Animals of the Jataka tales, the stories of the Buddha's earlier lives.
-- Share a little alms rice with each one to hear its story.
Config.Animals = {
	{ id = "hare", kind = "hare", name = "The Hare", x = 410, z = 62, yaw = 40, source = "Sasa Jataka, no. 316", text = "Long ago the Buddha-to-be was born as a hare. A hungry traveller came by, and the hare had no food to give, so he offered himself and leapt into the traveller's fire. The fire did not burn him. The traveller was the god Sakka, who drew the hare's shape on the moon so that his gift would be remembered." },
	{ id = "deer", kind = "deer", name = "The Banyan Deer", x = 520, z = -90, yaw = 200, source = "Nigrodhamiga Jataka, no. 12", text = "Long ago the Buddha-to-be was born as a golden deer, king of his herd. When a mother deer was to be sent to the king's kitchen, he lay down on the block in her place. The king was so moved that he spared the deer, and then every creature in his land." },
	{ id = "monkey", kind = "monkey", name = "The Monkey King", x = 770, z = 100, yaw = 250, source = "Mahakapi Jataka, no. 407", text = "Long ago the Buddha-to-be was born as a king of monkeys. When archers surrounded his troop, he stretched his own body across the river as a bridge, and every monkey crossed to safety over his back. The human king who saw it learned what a ruler is for." },
	{ id = "quail", kind = "quail", name = "The Young Quail", x = 1280, z = -100, yaw = 120, source = "Vattaka Jataka, no. 35", text = "Long ago the Buddha-to-be was born as a baby quail, too young to fly. A forest fire came and his parents fled. He had nothing left but the truth, so he spoke it: 'I have wings that cannot fly and feet that cannot walk.' At his true words the fire turned back." },
	{ id = "elephant", kind = "elephant", name = "The Six-Tusked Elephant", x = 1806, z = 112, yaw = 160, source = "Chaddanta Jataka, no. 514", text = "Long ago the Buddha-to-be was born as Chaddanta, a great white elephant king. A hunter wounded him for his tusks. Chaddanta felt no anger. He forgave the hunter and gave the tusks himself." },
	{ id = "goose", kind = "goose", name = "The Golden Goose", x = 1830, z = -80, yaw = 300, source = "Suvannahamsa Jataka, no. 136", text = "Long ago the Buddha-to-be was born as a goose with feathers of gold. He gave his poor family one feather at a time, and they lived well. Then greed made them pluck him bare, and every stolen feather turned plain and white." },
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[-- The Bodhi Path: music and sound effects.
--
-- HOW TO ADD A SOUND
--   1. In Roblox Studio open the Toolbox, choose the Audio tab, and find a sound you like.
--   2. Right-click it and choose "Copy Asset ID".
--   3. Replace the 0 on the matching line below with that number.
-- A line left at 0 is simply silent (music keeps playing the previous step's track).

local Sounds = {}

Sounds.MusicVolume = 0.4
Sounds.EffectVolume = 0.7
Sounds.WaterVolume = 0.6

----------------------------------------------------------------------
-- MUSIC: one looping track for each of the 28 steps of the journey.
----------------------------------------------------------------------
Sounds.Music = {
	{ step = "arrive", id = 100971756298760 }, --  1  Arrival: calm, welcoming, morning
	{ step = "bell", id = 93946537663928 }, --  2  The Temple Bell: very quiet, so the bell stands out
	{ step = "breath", id = 116130915379705 }, --  3  The First Breath: still, slow meditation
	{ step = "alms", id = 1839894836 }, --  4  The Alms Round: light, warm village life
	{ step = "store", id = 1840124474 }, --  5  The Merit Store: friendly bazaar
	{ step = "sights", id = 104515600700947 }, --  6  The Four Sights: thoughtful, bittersweet
	{ step = "cross", id = 1836376521 }, --  7  The Great Departure: night journey, resolve
	{ step = "channa", id = 1845724239 }, --  8  Channa's Farewell: tender parting
	{ step = "hair", id = 1842483589 }, --  9  The Wanderer's Robe: solemn turning point
	{ step = "scouts", id = 77103661048765 }, -- 10  Shadows on the Road: uneasy, light tension
	{ step = "alara", id = 135919250581860 }, -- 11  The First Teacher: deep forest calm
	{ step = "uddaka", id = 84936650613249 }, -- 12  The Second Teacher: deeper, more spacious
	{ step = "doubt", id = 1840843924 }, -- 13  The Seventh Army: unsettled, shifting
	{ step = "ascetics", id = 83850416265658 }, -- 14  The Five Companions: dry, sparse, austere
	{ step = "austerity", id = 76534453813986 }, -- 15  Six Years of Austerity: harsh, weary
	{ step = "sujata", id = 73080860156849 }, -- 16  Sujata's Offering: gentle relief, kindness
	{ step = "eat", id = 9046656223 }, -- 17  The Middle Way: uplifting, balanced
	{ step = "bowl", id = 140422396863468 }, -- 18  The Golden Bowl: wonder, flowing water
	{ step = "sotthiya", id = 111399415119885 }, -- 19  The Grass-Cutter: simple, earthy
	{ step = "kusa", id = 92428953268139 }, -- 20  Eight Handfuls of Grass: quiet anticipation
	{ step = "daughters", id = 9041786001 }, -- 21  The Daughters of Mara: hypnotic, then dangerous
	{ step = "armies", id = 84331969561132 }, -- 22  The Ten Armies: battle drums
	{ step = "mara", id = 9045721164 }, -- 23  Mara: the biggest, darkest track
	{ step = "seat", id = 126695140992161 }, -- 24  The Seat of Awakening: hushed, sacred
	{ step = "watch1", id = 82555754602814 }, -- 25  The First Watch: night, vast, slow
	{ step = "watch2", id = 110481782288601 }, -- 26  The Second Watch: wider, deeper
	{ step = "watch3", id = 1839251961 }, -- 27  The Third Watch: rising, luminous
	{ step = "awake", id = 96506107863425 }, -- 28  Awakened: joyful peace
}

----------------------------------------------------------------------
-- SOUND EFFECTS: short sounds that play once when something happens.
----------------------------------------------------------------------
Sounds.Effects = {
	bell = 106399723585350, -- the great temple bell is rung (deep bell or gong)
	wheel = 9120658280, -- a prayer wheel is spun (soft whirr or small chime)
	strike = 123890977510299, -- your palm or staff swings (whoosh)
	hit = 9113818671, -- a strike lands on a shadow (soft thud)
	beads = 6691605753, -- a mala bead of light is sent (light shimmer or ping)
	metta = 99384056183835, -- loving-kindness radiates (warm swell or chord)
	bowl = 138570431689848, -- the singing bowl (a long singing-bowl tone)
	meditate = 9116395089, -- you sit down to meditate (a single soft chime)
	petals = 110241936966089, -- a shadow is dispelled into petals (gentle sparkle)
	hurt = 9113486062, -- your Calm is struck (dull low hit)
	overwhelm = 107073250463751, -- your Calm runs out (low fading tone)
	merit = 1839901345, -- you earn merit (small bright chime)
	quest = 89056648074625, -- a new step of the journey begins (short gong or fanfare)
	pickup = 1008455422378, -- you pick something up: leaf, lotus, kusa (soft pluck)
	talk = 132723137731070, -- someone begins to speak (soft page-turn or blip)
	buy = 607662191, -- you buy something or put on a robe (cloth or coin sound)
	pray = 9113420607, -- you pray at a shrine (small bell)
	storm = 71511119515611, -- Mara sends a storm (thunder crack)
	quake = 9114220333, -- the earth answers as your witness (deep rumble)
	awaken = 121538758381608, -- the moment of awakening (long shimmering rise)
	splash = 142431247, -- you drop into deep water (a splash)
}

-- Effects that are too long: how many seconds to play before fading away gently.
-- (Any effect not listed here plays in full, up to 12 seconds.)
Sounds.EffectLength = {
	bowl = 6,
}

-- Effects where only the ending is wanted: play just the last so-many seconds.
Sounds.EffectTail = {
	merit = 2,
}

----------------------------------------------------------------------
-- SURROUNDINGS: looping sounds that grow louder as you come near something.
----------------------------------------------------------------------
Sounds.Ambient = {
	stream = 110597779584354, -- running water, heard near every stream and river and on the bridges
	wade = 78165223586115, -- walking through shallow water (sloshing footsteps)
	swim = 9125777696, -- swimming (strokes and splashes)
}

return Sounds
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Story</string><ProtectedString name="Source"><![CDATA[-- The Bodhi Path: the story.
-- People to meet, the steps of the journey, and the teachings written on the Bodhi leaves.
--
-- The journey follows the traditional account of how Siddhartha Gautama became the Buddha
-- (mainly the Pali Canon and the Jataka Nidanakatha): the Four Sights, the Great Departure
-- across the River Anoma, the two teachers, six years of austerity at Uruvela, Sujata's
-- offering, the golden bowl on the Neranjara, Sotthiya's kusa grass, Mara's assault, the
-- earth as witness, and the three watches of the night beneath the Bodhi tree.
--
-- Where the old sources differ, a note says so (see docs/STORY_NOTES.md).

local Story = {}

----------------------------------------------------------------------
-- People. "look" picks an outfit in the server's Rig module.
-- "lines" are what they say when they have nothing special to tell you.
----------------------------------------------------------------------
Story.NPCs = {
	-- Kapilavastu: the home temple and the village
	{ id = "abbot", name = "The Venerable Abbot", look = "abbot", x = -40, z = 6, face = { x = 0, z = 0 },
		lines = {
			"Walk gently, seeker. The path is long, but every step of it is already the path.",
			"When the mind is troubled, sit. When it is calm, sit. Either way, sit.",
		} },
	{ id = "bell_monk", name = "Brother Tissa", look = "monk", x = 20, z = -44, face = { x = 0, z = 0 },
		lines = {
			"A temple bell is rung one hundred and eight times at the turning of the year, once for each trouble of the heart.",
			"Listen to the bell until the sound is gone. Then listen to what is left.",
		} },
	{ id = "pond_nun", name = "Sister Khema", look = "nun", x = 40, z = -74, face = { x = 52, z = -92 },
		lines = {
			"The lotus grows in mud and opens above the water without a stain. That is why we love it.",
			"If you find a lotus, offer it at a shrine. Giving is the first step of the path.",
		} },
	{ id = "wheel_novice", name = "Novice Sona", look = "novice", x = 30, z = 36, face = { x = 40, z = 44 },
		lines = {
			"Spin the prayer wheels clockwise! Each turn sends good wishes out to everyone.",
			"I am saving my merit for a saffron robe. Sister Visakha sews them in the village.",
		} },
	{ id = "merchant", name = "Upali the Shopkeeper", look = "merchant", x = 160, z = 66, face = { x = 160, z = 40 }, shop = "village",
		lines = { "Tea, incense, lamps for the shrine. Take what helps you on the road." } },
	{ id = "tailor", name = "Visakha the Robe-Maker", look = "villager_f", x = 204, z = -66, face = { x = 204, z = -40 }, robes = true,
		lines = { "A robe is only cloth, friend. But it reminds the one who wears it what they have set out to do." } },
	{ id = "garland", name = "Sumana the Garland-Maker", look = "villager_m", x = 4, z = -109, face = { x = 4, z = -90 }, shop = "garden",
		lines = { "Flowers fade by evening. That is why they are worth offering." } },
	{ id = "alms1", name = "Farmer Gopal", look = "farmer", x = 150, z = -13, face = { x = 150, z = 0 }, alms = true,
		lines = { "The rains were kind this year. There is enough rice to share." } },
	{ id = "alms2", name = "Grandmother Amba", look = "elder_f", x = 180, z = 13, face = { x = 180, z = 0 }, alms = true,
		lines = { "I have fed monks at this door for fifty years. It has never once made me poorer." } },
	{ id = "alms3", name = "Dasa the Potter", look = "villager_m", x = 214, z = -13, face = { x = 214, z = 0 }, alms = true,
		lines = { "I made the bowls the monks carry. Clay, water, fire, and patience." } },
	{ id = "alms4", name = "Little Mira", look = "child", x = 234, z = 14, face = { x = 234, z = 0 }, alms = true,
		lines = { "Mother says giving makes your heart bigger. I want a very big heart." } },

	-- The Road of the Four Sights
	{ id = "old_man", name = "An Old Man", look = "elder_m", x = 332, z = 20, face = { x = 332, z = 0 },
		lines = { "I was young once, and strong. I did not believe this day would come to me. It comes to everyone." } },
	{ id = "sick_man", name = "A Sick Man", look = "sick", x = 412, z = -24, face = { x = 412, z = 0 },
		lines = { "The fever comes and goes. Be glad of your health while you have it, traveller." } },
	{ id = "mourner", name = "A Mourner", look = "mourner", x = 497, z = 28, face = { x = 505, z = 40 },
		lines = { "He was my father. Yesterday he laughed with us. All who are born must also pass away." } },
	{ id = "ascetic", name = "A Wandering Ascetic", look = "ascetic", x = 577, z = -20, face = { x = 577, z = 0 },
		lines = { "I own a bowl and a robe, and I sleep beneath the trees. I have never been so free." } },

	-- The River Anoma
	{ id = "fisherman", name = "A River Fisherman", look = "farmer", x = 690, z = 44, face = { x = 725, z = 44 },
		lines = { "The Anoma is shallow at the stones. They say a prince once crossed here in a single leap of his horse." } },
	{ id = "channa", name = "Channa the Charioteer", look = "channa", x = 784, z = 14, face = { x = 760, z = 0 },
		lines = { "I carried the news back to the palace once. I will carry it again if I must." } },

	-- The Forest of the Teachers
	{ id = "alara", name = "Alara Kalama", look = "sage", x = 940, z = 78, face = { x = 940, z = 40 },
		lines = { "Let go of form. Let go of space. Let go even of the one who lets go." } },
	{ id = "alara_student", name = "A Student of Alara", look = "ascetic", x = 928, z = 70, face = { x = 940, z = 78 },
		lines = { "The teacher once sat by the road while five hundred carts rolled past. He neither saw nor heard them." } },
	{ id = "uddaka", name = "Uddaka Ramaputta", look = "sage2", x = 1110, z = -78, face = { x = 1110, z = -40 },
		lines = { "Beyond nothingness there is a place so fine that one cannot say perception is there, or that it is not." } },

	-- Uruvela
	{ id = "kondanna", name = "Kondanna", look = "ascetic", x = 1322, z = -44, face = { x = 1322, z = 0 },
		lines = { "We eat little and sleep less. If the body is the chain, we will wear the chain away." } },
	{ id = "bhaddiya", name = "Bhaddiya", look = "ascetic", x = 1310, z = -56, face = { x = 1322, z = -52 },
		lines = { "Six years we have practised here beside the Neranjara." } },
	{ id = "vappa", name = "Vappa", look = "ascetic", x = 1332, z = -58, face = { x = 1322, z = -52 },
		lines = { "A single grain of rice a day. A single sesame seed. So we train." } },
	{ id = "mahanama", name = "Mahanama", look = "ascetic", x = 1318, z = -66, face = { x = 1322, z = -52 },
		lines = { "Do not disturb the fire. It is the only warmth we allow ourselves." } },
	{ id = "assaji", name = "Assaji", look = "ascetic", x = 1336, z = -46, face = { x = 1322, z = -52 },
		lines = { "Walk calmly and the mind follows. That much I have learned." } },

	-- Senani and the Neranjara
	{ id = "sujata", name = "Sujata", look = "sujata", x = 1700, z = 40, face = { x = 1700, z = 0 },
		lines = { "May your wishes be fulfilled, as mine have been." } },
	{ id = "punna", name = "Punna", look = "villager_f", x = 1710, z = 46, face = { x = 1700, z = 40 },
		lines = { "I came at dawn to sweep beneath the banyan, and there he sat, shining. I ran to tell my mistress." } },
	{ id = "trader", name = "Bhallika the Trader", look = "merchant", x = 1644, z = -64, face = { x = 1644, z = -40 }, shop = "senani",
		lines = { "My caravan stops here for the season. See what the road has brought." } },
	{ id = "herdsman", name = "A Herdsman", look = "farmer", x = 1752, z = 80, face = { x = 1740, z = 60 },
		lines = { "Sujata's cattle give the richest milk in Senani. She fed the milk of a thousand cows to five hundred, and theirs to fewer still, until it was sweet as honey." } },
	{ id = "sotthiya", name = "Sotthiya the Grass-Cutter", look = "farmer", x = 1946, z = 24, face = { x = 1920, z = 0 },
		lines = { "Kusa grass. Soft to sit on, and sharp enough to cut a careless hand. Hold it wisely." } },
	{ id = "pond_elder", name = "An Old Villager", look = "elder_m", x = 1986, z = -84, face = { x = 2000, z = -96 },
		lines = {
			"This is Mucalinda's pool. They say that in the weeks after the awakening a great storm came, and the naga king rose from the water, coiled seven times around the Buddha, and spread his hood above him for seven days.",
		} },
}

-- A few people who simply walk about, so the villages feel lived in.
Story.Wanderers = {
	{ name = "Villager", look = "villager_m", x = 170, z = -4, radius = 34 },
	{ name = "Villager", look = "villager_f", x = 205, z = 6, radius = 34 },
	{ name = "Monk", look = "monk", x = -10, z = 20, radius = 40 },
	{ name = "Monk", look = "monk", x = 30, z = -20, radius = 40 },
	{ name = "Novice", look = "novice", x = 0, z = 50, radius = 30 },
	{ name = "Farmer", look = "farmer", x = 310, z = 60, radius = 26 },
	{ name = "Pilgrim", look = "villager_m", x = 540, z = 6, radius = 30 },
	{ name = "Villager", look = "villager_f", x = 1670, z = 8, radius = 36 },
	{ name = "Villager", look = "villager_m", x = 1740, z = -10, radius = 36 },
	{ name = "Child", look = "child", x = 1690, z = -20, radius = 30 },
}

----------------------------------------------------------------------
-- The journey, step by step.
-- Objective kinds:
--   talk      speak with a person (target = NPC id)
--   interact  use something in the world (target = interaction id)
--   alms      receive alms from villagers
--   meditate  meditate at a place for "count" seconds (target = spot id)
--   reach     arrive somewhere (target = area id)
--   dispel    overcome enemies (target = enemy type, or a group such as "host")
--   collect   gather things (target = kind)
--   use       use an item (target = item id)
--   boss      answer Mara
----------------------------------------------------------------------
Story.Quests = {
	{
		id = "arrive", title = "Arrival",
		intro = "You have come to the temple at Kapilavastu to walk the road the Buddha walked.",
		objectives = {
			{ kind = "talk", target = "abbot", text = "Speak with the Venerable Abbot", lines = {
				{ "The Venerable Abbot", "Welcome, seeker. Long ago a prince named Siddhartha left this city in search of an end to suffering. He found it beneath a tree at Bodh Gaya." },
				{ "The Venerable Abbot", "Every seeker walks that same road: past age, sickness and death, across the rivers, through Mara's armies, to the foot of the Bodhi tree." },
				{ "The Venerable Abbot", "Begin as we all begin. Ring the temple bell, and let the whole valley know that someone has set out." },
			} },
		},
		reward = { merit = 10 },
	},
	{
		id = "bell", title = "The Temple Bell",
		intro = "The great bell hangs in the courtyard, south of where you arrived.",
		objectives = {
			{ kind = "interact", target = "temple_bell", text = "Ring the temple bell" },
		},
		reward = { merit = 15 },
		outro = {
			{ "", "The bell sounds across the valley. Somewhere far to the east, something old and watchful turns its head." },
		},
	},
	{
		id = "breath", title = "The First Breath",
		intro = "North of the courtyard is the meditation hall. Sit there and follow your breath. (Press M, or the Meditate button.)",
		objectives = {
			{ kind = "meditate", target = "village_hall", count = 10, text = "Meditate in the meditation hall" },
		},
		reward = { merit = 15 },
		outro = {
			{ "", "Breathing in, you know you are breathing in. Breathing out, you know you are breathing out. Whenever your Calm runs low, you can always return to this." },
		},
	},
	{
		id = "alms", title = "The Alms Round",
		intro = "A monk does not buy food or grow it. Each morning the village shares what it has. Cross the stream to the village. Four villagers wait by their doors beside the road: follow the golden marker to each one, walk up close, and choose \"Hold out your bowl\" (press E, or tap the button that appears). They will put food in it.",
		objectives = {
			{ kind = "alms", target = "alms", count = 4, text = "Receive alms from four villagers" },
		},
		grant = { items = { alms_bowl = 1 } },
		reward = { merit = 30 },
	},
	{
		id = "store", title = "The Merit Store",
		intro = "Kind acts earn merit. Upali keeps a store in the village where merit can be exchanged for what a traveller needs.",
		objectives = {
			{ kind = "talk", target = "merchant", text = "Visit Upali at the Merit Store", lines = {
				{ "Upali the Shopkeeper", "Ah, the new seeker. You will want tea for the road and a lamp for the shrines. Pay in merit; I have no use for coins." },
				{ "Upali the Shopkeeper", "And if robes are what you are after, Visakha sews them across the road. Every tradition, every colour." },
			} },
		},
		reward = { merit = 25 },
	},
	{
		id = "sights", title = "The Four Sights",
		intro = "Prince Siddhartha rode out from the palace four times. What he saw on the road changed him. Go east through the gate and see what he saw.",
		objectives = {
			{ kind = "talk", target = "old_man", text = "Meet the old man", lines = {
				{ "An Old Man", "Do not stare, young one. This bent back was straight once. These hands could draw a bow." },
				{ "", "The first sight: old age. The prince asked his charioteer, 'Will this happen to me also?' Channa answered, 'To you, and to everyone.'" },
			} },
			{ kind = "talk", target = "sick_man", text = "Meet the sick man", lines = {
				{ "A Sick Man", "Water... thank you. Three days the fever has held me. No one is so strong that sickness cannot find them." },
				{ "", "The second sight: sickness. Health, like youth, is only lent to us." },
			} },
			{ kind = "talk", target = "mourner", text = "Come upon the funeral", lines = {
				{ "A Mourner", "We carry my father to the river. Walk with us a little way, if you will." },
				{ "", "The third sight: death. The prince went home in silence and could find no joy in the palace." },
			} },
			{ kind = "talk", target = "ascetic", text = "Meet the wandering ascetic", lines = {
				{ "A Wandering Ascetic", "You look troubled. I was too. Then I gave up my house and went looking for what does not grow old, fall sick, or die." },
				{ "", "The fourth sight: a wanderer, calm in the midst of it all. Seeing him, the prince knew what he had to do." },
			} },
		},
		reward = { merit = 50 },
		outro = {
			{ "", "That night, at the age of twenty-nine, Siddhartha looked once at his sleeping wife and newborn son, and rode out through the city gate on his horse Kanthaka, with Channa beside him." },
		},
	},
	{
		id = "cross", title = "The Great Departure",
		intro = "They rode through the night to the River Anoma. Cross it, as he did.",
		objectives = {
			{ kind = "reach", target = "anoma_far", text = "Cross the River Anoma" },
		},
		reward = { merit = 20 },
	},
	{
		id = "channa", title = "Channa's Farewell",
		intro = "Channa the charioteer waits on the far bank with the horse Kanthaka.",
		objectives = {
			{ kind = "talk", target = "channa", text = "Speak with Channa", lines = {
				{ "Channa the Charioteer", "Here the prince dismounted and gave me his jewels to take home. I begged to stay with him. He would not allow it." },
				{ "Channa the Charioteer", "Kanthaka looked back until he could see his master no more. They say the good horse died of grief, and was reborn among the gods." },
				{ "Channa the Charioteer", "The road beyond is not safe. Take this staff. It is no weapon, but it will steady your step and turn aside what comes at you." },
			} },
		},
		reward = { merit = 20, ability = "staff" },
	},
	{
		id = "hair", title = "The Wanderer's Robe",
		intro = "By the flat rock on the bank the prince drew his sword, cut off his long hair, and put on the robe of a wanderer.",
		objectives = {
			{ kind = "interact", target = "hair_rock", text = "Leave your old life at the rock" },
		},
		reward = { merit = 30, robe = "renunciant" },
		outro = {
			{ "", "He cast his hair into the air and exchanged his silks for a simple robe. From this moment he owned nothing." },
			{ "", "You have received the Rag-Robe of the Wanderer. (Open Robes to wear it.)" },
		},
	},
	{
		id = "scouts", title = "Shadows on the Road",
		intro = "Mara, lord of all that binds the heart, has noticed you. His scouts are in the forest: the grey shapes of Discontent.",
		objectives = {
			{ kind = "dispel", target = "discontent", count = 6, text = "Dispel the shadows of Discontent" },
		},
		reward = { merit = 40 },
		outro = {
			{ "", "Nothing is destroyed. When a shadow is met with a steady mind it falls apart into petals, as Mara's weapons turned to flowers before they could touch the Buddha." },
		},
	},
	{
		id = "alara", title = "The First Teacher",
		intro = "Siddhartha sought out the greatest meditation teachers of his day. The first was Alara Kalama, whose hermitage lies north of the forest road.",
		objectives = {
			{ kind = "talk", target = "alara", text = "Speak with Alara Kalama", lines = {
				{ "Alara Kalama", "I teach the attainment of the sphere of nothingness. Sit with us, and see how far the mind can go." },
				{ "Alara Kalama", "Take this mala. Let each bead be one breath, and send your steadiness where it is needed." },
			} },
			{ kind = "meditate", target = "alara", count = 14, text = "Meditate at Alara's hermitage" },
		},
		reward = { merit = 40, ability = "beads" },
		outro = {
			{ "", "Siddhartha quickly mastered all that Alara knew, and Alara offered to share the leadership of his community. But the sphere of nothingness was not the end of suffering. He thanked his teacher and walked on." },
		},
	},
	{
		id = "uddaka", title = "The Second Teacher",
		intro = "Deeper in the forest, south of the road, Uddaka Ramaputta teaches a still subtler attainment.",
		objectives = {
			{ kind = "talk", target = "uddaka", text = "Speak with Uddaka Ramaputta", lines = {
				{ "Uddaka Ramaputta", "My father Rama reached the sphere of neither-perception-nor-non-perception. Few can follow. Sit, and we shall see." },
			} },
			{ kind = "meditate", target = "uddaka", count = 14, text = "Meditate at Uddaka's hermitage" },
		},
		reward = { merit = 40, maxCalm = 20 },
		outro = {
			{ "", "This too he mastered, and this too he found was not the goal: when the meditation ended, the troubles of the heart returned. Uddaka offered him the whole community. He declined, and walked on alone." },
		},
	},
	{
		id = "doubt", title = "The Seventh Army",
		intro = "Having left both teachers, a seeker meets Doubt. It never stays where you look for it.",
		objectives = {
			{ kind = "dispel", target = "doubt", count = 5, text = "Dispel the shadows of Doubt" },
		},
		reward = { merit = 45 },
	},
	{
		id = "ascetics", title = "The Five Companions",
		intro = "At Uruvela, by the Neranjara river, five ascetics practise the hardest disciplines known. Their camp is south of the road.",
		objectives = {
			{ kind = "talk", target = "kondanna", text = "Speak with Kondanna", lines = {
				{ "Kondanna", "I was one of the eight brahmins who read the signs at the prince's birth. I alone said he would surely become a Buddha. So I came here to wait for him." },
				{ "Kondanna", "We believe the body must be worn down until the spirit is free. Stay. Fast with us. Face what comes." },
			} },
		},
		reward = { merit = 30 },
	},
	{
		id = "austerity", title = "Six Years of Austerity",
		intro = "For six years Siddhartha starved himself until he could feel his spine through his belly. Face what he faced, then sit in the cave to the north.",
		objectives = {
			{ kind = "dispel", target = "hunger", count = 6, text = "Endure Hunger and Thirst" },
			{ kind = "dispel", target = "sloth", count = 3, text = "Overcome Sloth and Torpor" },
			{ kind = "meditate", target = "cave", count = 16, text = "Meditate in the cave" },
		},
		reward = { merit = 70 },
		outro = {
			{ "", "At the edge of death he remembered a day in childhood: sitting in the shade of a rose-apple tree while his father ploughed, his mind had settled, easy and clear, all by itself." },
			{ "", "'Could that be the way?' he thought. 'But this wasted body cannot follow it. I will eat.' This was the discovery of the Middle Way, between indulgence and self-torment." },
		},
	},
	{
		id = "sujata", title = "Sujata's Offering",
		intro = "East of Uruvela is the village of Senani. A woman named Sujata is carrying an offering to the banyan tree.",
		objectives = {
			{ kind = "talk", target = "sujata", text = "Meet Sujata beneath the banyan", lines = {
				{ "Sujata", "I vowed to make an offering at this tree if I should bear a son, and I have. My maid said the spirit of the tree itself was sitting here, shining." },
				{ "Sujata", "But you are no spirit; you are thin as a reed. Please, take this: rice boiled in the richest milk, in a bowl of gold." },
				{ "Sujata", "May your wishes be fulfilled, as mine have been." },
			} },
		},
		reward = { merit = 30, items = { milk_rice = 1, golden_bowl = 1 } },
	},
	{
		id = "eat", title = "The Middle Way",
		intro = "Eat Sujata's milk-rice. (Open your Bag and use it.)",
		objectives = {
			{ kind = "use", target = "milk_rice", text = "Eat the milk-rice" },
		},
		reward = { merit = 30, maxCalm = 30, ability = "metta" },
		outro = {
			{ "", "Strength returns. The five ascetics, seeing him eat, said, 'Gotama has given up the struggle,' and left him in disgust." },
			{ "", "Moved by Sujata's kindness, you have learned Metta: loving-kindness, radiated in every direction." },
		},
	},
	{
		id = "bowl", title = "The Golden Bowl",
		intro = "He carried the empty bowl down to the Neranjara and made a vow. Go down the steps to the river.",
		objectives = {
			{ kind = "interact", target = "bowl_river", text = "Set the golden bowl upon the river" },
		},
		reward = { merit = 40 },
		outro = {
			{ "", "'If I am to awaken today, let this bowl go upstream.' He set it on the water. It glided against the current, swift as a horse, then sank to the palace of the naga king below." },
		},
	},
	{
		id = "sotthiya", title = "The Grass-Cutter",
		intro = "Cross the Neranjara. On the far bank the grass-cutter Sotthiya is at his work.",
		objectives = {
			{ kind = "talk", target = "sotthiya", text = "Speak with Sotthiya", lines = {
				{ "Sotthiya the Grass-Cutter", "Going to the great tree, are you? Then you will want something to sit on. The ground there is hard." },
				{ "Sotthiya the Grass-Cutter", "I gave the Bodhisatta eight handfuls of kusa. Gather eight for yourself; the best of it grows along this bank." },
			} },
		},
		reward = { merit = 25 },
	},
	{
		id = "kusa", title = "Eight Handfuls of Grass",
		intro = "Gather eight handfuls of kusa grass along the east bank of the Neranjara.",
		objectives = {
			{ kind = "collect", target = "kusa", count = 8, text = "Gather kusa grass" },
		},
		reward = { merit = 50 },
	},
	{
		id = "daughters", title = "The Daughters of Mara",
		intro = "The land darkens ahead. Mara sends his three daughters first: Tanha, Arati and Raga. Craving, Aversion and Passion.",
		objectives = {
			{ kind = "dispel", target = "tanha", count = 1, text = "Remain unmoved by Tanha" },
			{ kind = "dispel", target = "arati", count = 1, text = "Remain unmoved by Arati" },
			{ kind = "dispel", target = "raga", count = 1, text = "Remain unmoved by Raga" },
		},
		reward = { merit = 120 },
		outro = {
			{ "", "They tried every guise and were no more able to move him than a feather can cut stone. (In the Pali texts they come after the awakening; other tellings place them before it. Either way, they fail.)" },
		},
	},
	{
		id = "armies", title = "The Ten Armies",
		intro = "'Sensual desire is your first army; the second is discontent; the third is hunger and thirst; the fourth is craving...' Mara's host stands between you and the tree.",
		objectives = {
			{ kind = "dispel", target = "host", count = 15, text = "Break through Mara's host" },
		},
		reward = { merit = 120 },
	},
	{
		id = "mara", title = "Mara",
		intro = "Mara himself waits at the end of the field, mounted on the great elephant Girimekhala. Enter the ring of fires.",
		objectives = {
			{ kind = "boss", target = "mara", text = "Answer Mara" },
		},
		reward = { merit = 250 },
		outro = {
			{ "", "Mara cried, 'That seat is mine! My army is my witness. Who is yours?' The Bodhisatta reached down with his right hand and touched the earth." },
			{ "", "And the earth roared, 'I am his witness.' Girimekhala fell to his knees. The ten armies scattered to the ends of the world." },
		},
	},
	{
		id = "seat", title = "The Seat of Awakening",
		intro = "The way to the Bodhi tree is open. Spread your kusa grass on the stone seat on the eastern side of the tree.",
		objectives = {
			{ kind = "interact", target = "vajrasana", text = "Spread the kusa grass at the foot of the tree" },
		},
		reward = { merit = 60 },
		outro = {
			{ "", "He sat facing east and made his vow: 'Let only skin, sinew and bone remain; let the flesh and blood dry up in my body. I will not rise from this seat until I have awakened.'" },
		},
	},
	{
		id = "watch1", title = "The First Watch of the Night",
		intro = "Sit on the seat and meditate.",
		objectives = {
			{ kind = "meditate", target = "bodhi_seat", count = 20, text = "Meditate beneath the Bodhi tree" },
		},
		reward = { merit = 60 },
		outro = {
			{ "", "In the first watch of the night his mind turned to the past, and he remembered his former lives: one birth, two, a hundred, a hundred thousand, through the rising and falling of whole worlds." },
		},
	},
	{
		id = "watch2", title = "The Second Watch of the Night",
		intro = "Remain seated. Meditate on.",
		objectives = {
			{ kind = "meditate", target = "bodhi_seat", count = 20, text = "Meditate beneath the Bodhi tree" },
		},
		reward = { merit = 60 },
		outro = {
			{ "", "In the second watch he saw beings everywhere passing away and being reborn, high and low, happy and wretched, each according to their own actions." },
		},
	},
	{
		id = "watch3", title = "The Third Watch of the Night",
		intro = "The night is almost over. Meditate on.",
		objectives = {
			{ kind = "meditate", target = "bodhi_seat", count = 20, text = "Meditate beneath the Bodhi tree" },
		},
		reward = { merit = 300, robe = "golden" },
		outro = {
			{ "", "In the third watch he saw it whole: this is suffering; this is its cause; this is its end; this is the path that leads to its end." },
			{ "", "As the morning star rose, ignorance was destroyed and knowledge arose. 'Birth is ended. The holy life has been lived. What had to be done is done.'" },
			{ "", "'House-builder, you are seen. You shall not build this house again.' So Siddhartha Gautama became the Buddha, the Awakened One." },
		},
	},
	{
		id = "awake", title = "Awakened",
		intro = "You have walked the whole of the Bodhi Path. Stay as long as you like: find every Bodhi leaf, complete the Eightfold Path, and help other seekers answer Mara.",
		objectives = {},
		final = true,
	},
}

Story.QuestIndex = {}
for i, q in ipairs(Story.Quests) do
	Story.QuestIndex[q.id] = i
end

----------------------------------------------------------------------
-- Teachings on the Bodhi leaves. These are short paraphrases, with the
-- traditional source of each.
----------------------------------------------------------------------
Story.Teachings = {
	{ text = "Mind comes first. Speak or act with a clear mind, and happiness follows like a shadow that never leaves.", source = "Dhammapada 2" },
	{ text = "Hatred is never ended by hatred. By non-hatred alone is it ended. This is an ancient law.", source = "Dhammapada 5" },
	{ text = "Better than a thousand hollow words is one word that brings peace.", source = "Dhammapada 100" },
	{ text = "You yourself must make the effort. The Buddhas only point the way.", source = "Dhammapada 276" },
	{ text = "Drop by drop the water pot is filled. So the wise fill themselves with good, little by little.", source = "Dhammapada 122" },
	{ text = "As a solid rock is not shaken by the wind, the wise are not moved by praise or blame.", source = "Dhammapada 81" },
	{ text = "One may conquer a thousand men a thousand times in battle. The greatest victor conquers only one: oneself.", source = "Dhammapada 103" },
	{ text = "All tremble at violence; life is dear to all. Seeing yourself in others, do not harm, and do not cause harm.", source = "Dhammapada 130" },
	{ text = "Health is the greatest gift, contentment the greatest wealth, trust the best of kin, Nibbana the highest happiness.", source = "Dhammapada 204" },
	{ text = "There is no fire like passion, no grip like hatred, no net like delusion, no river like craving.", source = "Dhammapada 251" },
	{ text = "To avoid all harm, to cultivate the good, and to purify the mind: this is the teaching of the Buddhas.", source = "Dhammapada 183" },
	{ text = "The scent of flowers does not travel against the wind. The fragrance of the good spreads in every direction.", source = "Dhammapada 54" },
	{ text = "Do not dwell on the faults of others, on what they did or left undone. Look to your own doing.", source = "Dhammapada 50" },
	{ text = "As rain cannot break into a well-roofed house, craving cannot break into a well-trained mind.", source = "Dhammapada 14" },
	{ text = "Conquer anger with calm, meanness with giving, and falsehood with truth.", source = "Dhammapada 223" },
	{ text = "A fool who knows they are a fool is, in that at least, wise.", source = "Dhammapada 63" },
	{ text = "Irrigators guide water, fletchers straighten arrows, carpenters shape wood. The wise shape themselves.", source = "Dhammapada 80" },
	{ text = "As a lotus is born in the water and grows in the water, yet rises above it unstained, so the awakened one lives in the world.", source = "Anguttara Nikaya 4.36" },
	{ text = "All conditioned things pass away. Strive on with heedfulness.", source = "The Buddha's last words, Digha Nikaya 16" },
	{ text = "May all beings be happy and safe. May their hearts be at ease.", source = "Metta Sutta, Sutta Nipata 1.8" },
}

-- Short words shown when a player's Calm runs out.
Story.OverwhelmLines = {
	"The mind was swept away. Begin again; the breath is still here.",
	"Even the Bodhisatta wavered. Return to the shrine and gather yourself.",
	"Falling is part of the path. So is getting up.",
}

return Story
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX28"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX27"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Boss</string><ProtectedString name="Source"><![CDATA[-- Boss: the meeting with Mara, told in the order the old stories tell it.
--   1. Mara's host attacks.
--   2. Mara sends nine storms. To one who sits unmoved, they fall as flowers.
--   3. Mara himself attacks from the back of the elephant Girimekhala, hurling his discus.
--   4. Mara claims the seat and demands a witness. The seeker touches the earth,
--      the earth answers, and Mara's armies scatter.
-- Any number of players can face him together.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Story = require(Shared:WaitForChild("Story"))
local Remotes = require(script.Parent.Remotes)
local PlayerData = require(script.Parent.PlayerData)
local Quests = require(script.Parent.Quests)
local Combat = require(script.Parent.Combat)
local Enemies = require(script.Parent.Enemies)
local Rig = require(script.Parent.Rig)
local Kit = require(script.Parent.Kit)

local Boss = {}

local ARENA = Config.Places.arena
local CENTER = Vector3.new(ARENA.x, 0, ARENA.z)
local HOST_TYPES = { "desire", "discontent", "hunger", "craving", "sloth", "fear", "doubt", "hypocrisy", "fame", "pride" }

local state = Remotes.BossState
local folder = nil
local maraModel = nil
local maraHome = nil
local target = nil
local running = false
local earthTouchedBy = nil
local lastStart = -1000
local helpCooldown = {}
local rng = Random.new()

local function setPhase(phase, text)
	state:SetAttribute("Phase", phase)
	state:SetAttribute("Text", text or "")
end

local function participants()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local pos = Combat.position(player)
		if pos and PlayerData.get(player) then
			local flat = Vector3.new(pos.X, 0, pos.Z)
			if (flat - CENTER).Magnitude <= ARENA.radius + 34 then
				table.insert(list, { player = player, pos = pos })
			end
		end
	end
	return list
end

local function isMeditating(player)
	local session = PlayerData.session(player)
	return session ~= nil and session.meditating
end

-- Something falling from the sky onto a spot. Calls onImpact() when it lands.
local function hazard(pos, color, radius, delay, onImpact)
	local disc = Kit.cyl(folder, CFrame.new(pos.X, 0.35, pos.Z), radius * 2, 0.25, color, Enum.Material.Neon, { collide = false, shadow = false, transparency = 0.6 })
	local rock = Kit.ball(folder, CFrame.new(pos.X, 80, pos.Z), 4.5, color, Enum.Material.Neon, { collide = false, shadow = false })
	TweenService:Create(rock, TweenInfo.new(delay, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(pos.X, 2, pos.Z) }):Play()
	TweenService:Create(disc, TweenInfo.new(delay), { Transparency = 0.2 }):Play()
	task.delay(delay, function()
		disc:Destroy()
		rock:Destroy()
		onImpact()
	end)
end

local temps = {}
local function clearTemps(withPetals)
	for i = #temps, 1, -1 do
		local enemy = temps[i]
		if enemy.alive then
			if withPetals and enemy.root and enemy.root.Parent then
				Remotes.fx("petals", { pos = enemy.root.Position, color = Color3.fromRGB(255, 190, 210) })
			end
			Enemies.remove(enemy)
		end
		temps[i] = nil
	end
end

local function summon(count, onDefeat)
	for _ = 1, count do
		if Enemies.count() >= 30 then
			break
		end
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(26, ARENA.radius - 12)
		local typeId = HOST_TYPES[rng:NextInteger(1, #HOST_TYPES)]
		local enemy = Enemies.create(typeId, ARENA.x + math.cos(a) * r, ARENA.z + math.sin(a) * r, nil, {
			temporary = true,
			hpScale = 0.7,
			onDefeat = onDefeat,
		})
		enemy.home = CENTER
		table.insert(temps, enemy)
	end
end

local function showMara(visible)
	if not maraModel then
		return
	end
	maraModel.Parent = visible and folder or nil
end

local function reset()
	clearTemps(false)
	if target then
		target.invulnerable = true
		target.hp = target.maxHp
		target.alive = false
		Combat.removeTarget(target)
	end
	showMara(true)
	earthTouchedBy = nil
	running = false
	state:SetAttribute("Hp", 0)
	setPhase("idle", "")
end

----------------------------------------------------------------------
-- The four parts of the encounter. Each returns false if everyone has left.
----------------------------------------------------------------------
local function waitWhile(seconds, step)
	local elapsed = 0
	local empty = 0
	while elapsed < seconds do
		task.wait(0.5)
		elapsed = elapsed + 0.5
		local list = participants()
		if #list == 0 then
			empty = empty + 0.5
			if empty >= 8 then
				return false
			end
		else
			empty = 0
		end
		if step and step(elapsed, list) == true then
			return true
		end
	end
	return true
end

local function phaseHost()
	local count = #participants()
	local need = Config.Boss.hostToDispel + math.max(0, count - 1) * 4
	local dispelled = 0
	state:SetAttribute("Count", 0)
	state:SetAttribute("Need", need)
	setPhase("host", "Mara's host closes in. Dispel them!")
	Remotes.notifyAll("Mara: 'Arise, my armies. Drive this one from the tree!'", "warn")
	local finished = false
	local ok = waitWhile(240, function(elapsed)
		local living = 0
		for _, e in ipairs(temps) do
			if e.alive then
				living = living + 1
			end
		end
		if living < 4 + count and elapsed % 1.5 == 0 then
			summon(2, function()
				dispelled = dispelled + 1
				state:SetAttribute("Count", math.min(dispelled, need))
			end)
		end
		if dispelled >= need then
			finished = true
			return true
		end
		return false
	end)
	return ok and finished
end

local function phaseStorms()
	clearTemps(true)
	for i, storm in ipairs(Config.Storms) do
		local color = Color3.fromRGB(storm.color[1], storm.color[2], storm.color[3])
		setPhase("storms", "Mara sends " .. storm.name .. ". Sit unmoved (Meditate) and it falls as flowers.")
		state:SetAttribute("Count", i)
		state:SetAttribute("Need", #Config.Storms)
		Remotes.fx("storm", { color = color, index = i })
		local ok = waitWhile(Config.Boss.stormSeconds, function(elapsed, list)
			if elapsed % 1 ~= 0 then
				return false
			end
			for _, entry in ipairs(list) do
				local spot = entry.pos + Vector3.new(rng:NextNumber(-5, 5), 0, rng:NextNumber(-5, 5))
				hazard(spot, color, 7, 1.2, function()
					local unmoved = false
					for _, p in ipairs(participants()) do
						if (Vector3.new(p.pos.X, 0, p.pos.Z) - Vector3.new(spot.X, 0, spot.Z)).Magnitude <= 7.5 then
							if isMeditating(p.player) then
								unmoved = true
							else
								Combat.hurt(p.player, 13)
							end
						end
					end
					Remotes.fx("petals", { pos = Vector3.new(spot.X, 2, spot.Z), color = unmoved and Color3.fromRGB(255, 200, 220) or color })
				end)
			end
			return false
		end)
		if not ok then
			return false
		end
	end
	return true
end

local function throwDiscus(victim)
	local from = maraHome.Position + Vector3.new(-6, 4, 0)
	local pos = Combat.position(victim)
	if not pos then
		return
	end
	local to = Vector3.new(pos.X, 3, pos.Z)
	local disc = Kit.cyl(folder, CFrame.new(from), 5, 0.4, Color3.fromRGB(255, 90, 50), Enum.Material.Neon, { collide = false, shadow = false })
	Kit.light(disc, Color3.fromRGB(255, 90, 50), 18, 2)
	local travel = math.clamp((to - from).Magnitude / 75, 0.5, 1.6)
	TweenService:Create(disc, TweenInfo.new(travel, Enum.EasingStyle.Linear), { CFrame = CFrame.new(to) * CFrame.Angles(0, 0, math.rad(90)) }):Play()
	task.delay(travel, function()
		disc:Destroy()
		local now = Combat.position(victim)
		if now and (Vector3.new(now.X, 3, now.Z) - to).Magnitude <= 6.5 then
			if isMeditating(victim) then
				Remotes.fx("petals", { pos = to + Vector3.new(0, 6, 0), color = Color3.fromRGB(255, 200, 220), big = true })
				Remotes.notify(victim, "Mara's discus hangs above you as a canopy of flowers.", "good")
			else
				Combat.hurt(victim, 22)
				Remotes.fx("petals", { pos = to, color = Color3.fromRGB(255, 90, 50) })
			end
		end
	end)
end

local function stomp()
	local spot = Vector3.new(Config.Places.mara.x - 30, 0, Config.Places.mara.z)
	hazard(spot, Color3.fromRGB(200, 60, 255), 30, 1.6, function()
		Remotes.fx("ring", { pos = spot, radius = 32, color = Color3.fromRGB(200, 60, 255), time = 0.6 })
		for _, p in ipairs(participants()) do
			if (Vector3.new(p.pos.X, 0, p.pos.Z) - spot).Magnitude <= 31 then
				Combat.hurt(p.player, 18)
			end
		end
	end)
end

local function phaseMara(startFraction)
	local count = math.max(1, #participants())
	local maxHp = Config.Boss.hp + (count - 1) * Config.Boss.hpPerExtraPlayer
	target.maxHp = maxHp
	target.hp = math.floor(maxHp * (startFraction or 1))
	target.invulnerable = false
	target.tagged = {}
	if not target.alive then
		Combat.addTarget(target)
	end
	state:SetAttribute("MaxHp", maxHp)
	state:SetAttribute("Hp", target.hp)
	setPhase("mara", "Mara attacks! Strike back, and sit unmoved when he hurls his discus.")
	local defeated = false
	target.onDamage = function(self)
		state:SetAttribute("Hp", math.max(0, self.hp))
	end
	target.onDefeat = function()
		defeated = true
	end
	local ok = waitWhile(600, function(elapsed, list)
		if defeated then
			return true
		end
		if #list > 0 then
			if elapsed % 3.5 == 0 then
				throwDiscus(list[rng:NextInteger(1, #list)].player)
			end
			if elapsed % 9 == 0 then
				stomp()
			end
			if elapsed % 15 == 0 then
				summon(2)
			end
		end
		return false
	end)
	target.invulnerable = true
	return ok and defeated
end

local function phaseWitness()
	clearTemps(true)
	earthTouchedBy = nil
	setPhase("witness", "Mara: 'That seat is mine! My army is my witness. Who is yours?'  Touch the earth!")
	local ok = waitWhile(40, function()
		return earthTouchedBy ~= nil
	end)
	return ok and earthTouchedBy ~= nil
end

local function victory()
	local who = earthTouchedBy
	setPhase("won", "The earth roars: 'I am his witness.'")
	Remotes.fx("quake", { pos = CENTER, by = who and who.DisplayName or "" })
	if maraHome then
		Remotes.fx("petals", { pos = maraHome.Position, color = Color3.fromRGB(255, 120, 90), big = true })
	end
	showMara(false)
	Combat.removeTarget(target)
	local now = os.clock()
	for _, entry in ipairs(participants()) do
		local player = entry.player
		local profile = PlayerData.get(player)
		if Quests.active(player, "boss", "mara") then
			Quests.progress(player, "boss", "mara")
		elseif profile and Quests.reached(player, "seat") then
			if now >= (helpCooldown[player] or 0) then
				helpCooldown[player] = now + 600
				profile.bossWins = profile.bossWins + 1
				PlayerData.addMerit(player, 80)
				Remotes.notify(player, "You stood beside another seeker against Mara.", "good")
			end
		end
	end
	Remotes.notifyAll("Mara's armies scatter to the ends of the world.", "good")
	task.wait(Config.Boss.resetAfter)
end

local function fight()
	running = true
	lastStart = os.clock()
	local won = false
	if phaseHost() and phaseStorms() then
		local fraction = 1
		for _ = 1, 4 do
			if not phaseMara(fraction) then
				break
			end
			if phaseWitness() then
				won = true
				break
			end
			-- nobody answered: Mara gathers himself and attacks again
			Remotes.notifyAll("No one answers. Mara laughs and raises his discus again.", "warn")
			fraction = 0.35
			target.alive = false
			Combat.removeTarget(target)
		end
	end
	if won then
		victory()
	end
	reset()
end

----------------------------------------------------------------------
-- Public
----------------------------------------------------------------------
function Boss.touchEarth(player)
	if state:GetAttribute("Phase") ~= "witness" or earthTouchedBy then
		return
	end
	local pos = Combat.position(player)
	if pos and (Vector3.new(pos.X, 0, pos.Z) - CENTER).Magnitude <= ARENA.radius + 34 then
		earthTouchedBy = player
	end
end

function Boss.challenge()
	if running or os.clock() - lastStart < 20 then
		return false
	end
	task.spawn(function()
		local ok, err = pcall(fight)
		if not ok then
			warn("[Bodhi Path] The encounter with Mara failed:", err)
			reset()
		end
	end)
	return true
end

function Boss.start(objects)
	folder = Kit.folder(workspace, "MaraEncounter")
	maraHome = objects.maraSeat

	-- Mara, mounted on Girimekhala
	local model, hum = Rig.make("Mara", "mara")
	local hip = hum.HipHeight
	model:ScaleTo(2.6)
	hum.DisplayName = "Mara"
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.NameDisplayDistance = 200
	local root = model:FindFirstChild("HumanoidRootPart")
	root.Anchored = true
	local lift = hip * 2.6 + root.Size.Y / 2
	model:PivotTo(maraHome * CFrame.new(0, lift, 0))
	model.Parent = folder
	Rig.animate(model, false)
	maraModel = model

	local body = objects.elephant and objects.elephant:FindFirstChildWhichIsA("BasePart")
	target = {
		name = "Mara",
		root = body or root,
		hp = Config.Boss.hp,
		maxHp = Config.Boss.hp,
		hitRadius = 16,
		static = true,
		big = true,
		invulnerable = true,
		tagged = {},
		alive = false,
	}

	-- a gong for those who wish to face him again
	local gong = Kit.cyl(folder, CFrame.new(ARENA.x - ARENA.radius + 6, 5, 20) * CFrame.Angles(0, 0, math.rad(90)), 7, 0.6, Kit.C.bronze, Enum.Material.Metal)
	Kit.block(folder, CFrame.new(ARENA.x - ARENA.radius + 6, 9.4, 20), Vector3.new(1, 0.8, 10), Kit.C.black, Enum.Material.Wood)
	Kit.block(folder, CFrame.new(ARENA.x - ARENA.radius + 6, 4.7, 24.6), Vector3.new(1, 9.4, 0.8), Kit.C.black, Enum.Material.Wood)
	Kit.block(folder, CFrame.new(ARENA.x - ARENA.radius + 6, 4.7, 15.4), Vector3.new(1, 9.4, 0.8), Kit.C.black, Enum.Material.Wood)
	local prompt = Kit.prompt(gong, "Strike the gong", "Challenge Mara", 14, 0.6)
	prompt.Triggered:Connect(function(player)
		if not Quests.reached(player, "mara") then
			Remotes.notify(player, "Break through Mara's host first.", "warn")
		elseif running then
			Remotes.notify(player, "Mara is already here.", "info")
		elseif not Boss.challenge() then
			Remotes.notify(player, "The field is quiet. Wait a moment.", "info")
		end
	end)

	-- Mara appears by himself when a seeker who must face him steps into the ring
	local maraStage = Story.QuestIndex.mara
	task.spawn(function()
		while true do
			task.wait(1)
			if not running then
				for _, entry in ipairs(participants()) do
					local flat = Vector3.new(entry.pos.X, 0, entry.pos.Z)
					if Quests.stage(entry.player) == maraStage and (flat - CENTER).Magnitude <= ARENA.radius - 6 then
						Boss.challenge()
						break
					end
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		helpCooldown[player] = nil
	end)
	setPhase("idle", "")
end

return Boss
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Buildings</string><ProtectedString name="Source"><![CDATA[-- Buildings: temples, stupas, gateways, houses and the other architecture of the journey.
-- Styles are drawn from Buddhist India and the wider Buddhist world: the stone spire of the
-- Mahabodhi temple, the domed stupas and carved gateways (toranas) of Sanchi, mud-walled
-- village houses, tiered East Asian roofs, Tibetan prayer wheels and prayer flags.
-- Structures treat -Z as their front.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)
local C = Kit.C
local M = Enum.Material

local B = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end
local rad = math.rad
local NOCOL = { collide = false }
local SOFT = { collide = false, shadow = false }

----------------------------------------------------------------------
-- Statues
----------------------------------------------------------------------

-- A seated Buddha. mudra = "meditation" (hands in the lap) or "earth" (right hand
-- touching the ground, calling the earth to witness).
function B.buddha(parent, o, s, mudra, color)
	s = s or 1
	local g = color or C.gold
	local mat = M.Metal
	local m = Kit.model(parent, "BuddhaStatue")
	local function at(x, y, z)
		return o * CFrame.new(x * s, y * s, z * s)
	end
	Kit.cyl(m, at(0, 0.6, 0), 7.4 * s, 1.2 * s, C.lotusPink, M.SmoothPlastic)
	Kit.cyl(m, at(0, 1.45, 0), 6.4 * s, 0.5 * s, g, mat)
	Kit.blob(m, at(0, 2.5, -0.3), V(6 * s, 1.7 * s, 4 * s), g, mat, NOCOL)
	Kit.blob(m, at(0, 4.7, 0.2), V(3.6 * s, 4.4 * s, 2.4 * s), g, mat, NOCOL)
	Kit.blob(m, at(-1.9, 4.6, 0) * CFrame.Angles(0, 0, rad(-10)), V(1.2 * s, 3.2 * s, 1.4 * s), g, mat, NOCOL)
	if mudra == "earth" then
		Kit.blob(m, at(2.3, 4.2, -0.6) * CFrame.Angles(rad(-25), 0, rad(8)), V(1.1 * s, 3.4 * s, 1.2 * s), g, mat, NOCOL)
		Kit.blob(m, at(2.7, 2.3, -1.9), V(0.8 * s, 1.5 * s, 0.7 * s), g, mat, NOCOL)
		Kit.blob(m, at(-0.4, 3.1, -1.5), V(1.6 * s, 0.6 * s, 1.1 * s), g, mat, NOCOL)
	else
		Kit.blob(m, at(1.9, 4.6, 0) * CFrame.Angles(0, 0, rad(10)), V(1.2 * s, 3.2 * s, 1.4 * s), g, mat, NOCOL)
		Kit.blob(m, at(0, 3.1, -1.5), V(2.4 * s, 0.7 * s, 1.2 * s), g, mat, NOCOL)
	end
	Kit.cyl(m, at(0, 6.6, 0), 1 * s, 0.6 * s, g, mat, NOCOL)
	Kit.ball(m, at(0, 7.6, 0), 2.1 * s, g, mat, NOCOL)
	Kit.ball(m, at(0, 8.75, 0.1), 0.9 * s, g, mat, NOCOL)
	Kit.block(m, at(-1.08, 7.4, 0), V(0.25 * s, 1.1 * s, 0.4 * s), g, mat, SOFT)
	Kit.block(m, at(1.08, 7.4, 0), V(0.25 * s, 1.1 * s, 0.4 * s), g, mat, SOFT)
	Kit.cyl(m, at(0, 7.7, 1.25) * CFrame.Angles(rad(90), 0, 0), 4.8 * s, 0.2 * s, C.goldBright, M.SmoothPlastic, { collide = false, shadow = false, transparency = 0.25 })
	return m
end

-- Mucalinda, the naga king, sheltering the seated Buddha beneath his seven hoods.
function B.naga(parent, o, s)
	s = s or 1
	local st = Color3.fromRGB(96, 122, 104)
	local m = Kit.model(parent, "Mucalinda")
	local function at(x, y, z)
		return o * CFrame.new(x * s, y * s, z * s)
	end
	Kit.cyl(m, at(0, 1, 0), 11 * s, 2 * s, st, M.Slate)
	Kit.cyl(m, at(0, 3, 0), 9 * s, 2 * s, st, M.Slate)
	Kit.cyl(m, at(0, 5, 0), 7 * s, 2 * s, st, M.Slate)
	B.buddha(m, at(0, 6, -0.4), 0.62 * s, "meditation", C.gold)
	Kit.block(m, at(0, 10, 3) * CFrame.Angles(rad(-8), 0, 0), V(3 * s, 10 * s, 1.6 * s), st, M.Slate, NOCOL)
	for i = -3, 3 do
		local hood = at(i * 1.5, 14.5 - math.abs(i) * 0.6, 2.4 - math.abs(i) * 0.1) * CFrame.Angles(rad(-28), 0, rad(-i * 11))
		Kit.blob(m, hood, V(2.4 * s, 4.2 * s, 1.6 * s), st, M.Slate, NOCOL)
		Kit.ball(m, hood * CFrame.new(0.5 * s, 1 * s, -0.8 * s), 0.3 * s, C.goldBright, M.Neon, SOFT)
		Kit.ball(m, hood * CFrame.new(-0.5 * s, 1 * s, -0.8 * s), 0.3 * s, C.goldBright, M.Neon, SOFT)
	end
	return m
end

----------------------------------------------------------------------
-- Stupas, shrines, gateways
----------------------------------------------------------------------

function B.stupa(parent, o, r, opts)
	opts = opts or {}
	local white = opts.color or C.white
	local m = Kit.model(parent, opts.name or "Stupa")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	local plinth = Kit.block(m, at(0, 0.75, 0), V(2.7 * r, 1.5, 2.7 * r), C.sandstone, M.Sandstone)
	Kit.cyl(m, at(0, 1.5 + 0.3 * r, 0), 2.24 * r, 0.6 * r, white, M.Concrete)
	Kit.cyl(m, at(0, 1.5 + 0.62 * r, 0), 2.3 * r, 0.14 * r, C.gold, M.Metal, NOCOL)
	Kit.ball(m, at(0, 1.5 + 0.6 * r, 0), 2 * r, white, M.Concrete)
	local top = 1.5 + 1.6 * r
	Kit.block(m, at(0, top + 0.2 * r, 0), V(0.62 * r, 0.44 * r, 0.62 * r), C.ivory, M.Sandstone, NOCOL)
	Kit.cyl(m, at(0, top + 0.4 * r + 0.5 * r, 0), 0.14 * r, 1 * r, C.gold, M.Metal, NOCOL)
	Kit.cyl(m, at(0, top + 0.68 * r, 0), 0.9 * r, 0.1 * r, C.gold, M.Metal, NOCOL)
	Kit.cyl(m, at(0, top + 0.93 * r, 0), 0.66 * r, 0.1 * r, C.gold, M.Metal, NOCOL)
	Kit.cyl(m, at(0, top + 1.18 * r, 0), 0.42 * r, 0.1 * r, C.gold, M.Metal, NOCOL)
	Kit.ball(m, at(0, top + 1.5 * r, 0), 0.28 * r, C.goldBright, M.Metal, SOFT)
	return m, plinth
end

-- A wayside shrine: a small stupa with butter lamps. Returns the part that holds the prompt.
function B.shrine(parent, o, name)
	local m, plinth = B.stupa(parent, o, 3.2, { name = "Shrine" })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			Props.butterLamp(m, o * CFrame.new(sx * 3.7, 1.5, sz * 3.7))
		end
	end
	Kit.block(m, o * CFrame.new(0, 0.2, 0), V(13, 0.4, 13), C.stone, M.Cobblestone)
	local glow = Kit.ball(m, o * CFrame.new(0, 12.2, 0), 0.9, C.goldBright, M.Neon, SOFT)
	Kit.light(glow, Color3.fromRGB(255, 220, 150), 26, 1.2)
	Kit.sparkle(glow, C.goldBright, 5)
	Kit.sign(plinth, name or "Shrine", C.goldBright, 14, 140)
	return m, plinth
end

-- A torana: the carved stone gateway of the great stupas. The opening runs along local X.
function B.torana(parent, o, w, h, color)
	w = w or 20
	h = h or 22
	local col = color or C.sandstone
	local m = Kit.model(parent, "Torana")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(m, at(sx * w / 2, h / 2, 0), V(2.8, h, 2.8), col, M.Sandstone)
		Kit.block(m, at(sx * w / 2, 0.6, 0), V(4, 1.2, 4), C.sandstoneDark, M.Sandstone)
		Kit.block(m, at(sx * w / 2, h * 0.6, 0), V(3.6, 1, 3.6), C.sandstoneLight, M.Sandstone, NOCOL)
		Kit.ball(m, at(sx * w / 2, h + 1.2, 0), 2, C.gold, M.Metal, SOFT)
	end
	local ys = { h - 1, h - 4.2, h - 7.4 }
	for i, y in ipairs(ys) do
		Kit.block(m, at(0, y, 0), V(w + 10 - i, 1.5, 2.3), C.sandstoneLight, M.Sandstone, NOCOL)
		for _, sx in ipairs({ -1, 1 }) do
			Kit.cyl(m, at(sx * (w / 2 + 5 - i / 2), y, 0) * CFrame.Angles(rad(90), 0, 0), 2.3, 2.3, col, M.Sandstone, SOFT)
		end
	end
	for _, x in ipairs({ -w / 4, 0, w / 4 }) do
		Kit.block(m, at(x, h - 2.6, 0), V(1.2, 1.8, 1.6), col, M.Sandstone, SOFT)
		Kit.block(m, at(x, h - 5.8, 0), V(1.2, 1.8, 1.6), col, M.Sandstone, SOFT)
	end
	-- The Dharma wheel at the summit.
	Kit.cyl(m, at(0, h + 2.4, 0) * CFrame.Angles(rad(90), 0, 0), 4.4, 0.5, C.gold, M.Metal, SOFT)
	Kit.cyl(m, at(0, h + 2.4, 0) * CFrame.Angles(rad(90), 0, 0), 1.2, 0.8, C.goldBright, M.Metal, SOFT)
	for i = 0, 3 do
		Kit.block(m, at(0, h + 2.4, 0) * CFrame.Angles(0, 0, rad(i * 45)), V(4.2, 0.25, 0.6), C.goldBright, M.Metal, SOFT)
	end
	return m
end

-- A straight wall between two ground points.
function B.wall(parent, x1, z1, x2, z2, h, color, material, cap)
	local p1 = Vector3.new(x1, 0, z1)
	local p2 = Vector3.new(x2, 0, z2)
	local len = (p2 - p1).Magnitude
	if len < 0.5 then
		return
	end
	local cf = CFrame.new((p1 + p2) / 2, p2)
	Kit.block(parent, cf * CFrame.new(0, h / 2, 0), V(2.4, h, len), color or C.sandstone, material or M.Sandstone)
	if cap ~= false then
		Kit.block(parent, cf * CFrame.new(0, h + 0.4, 0), V(3.2, 0.8, len + 0.4), C.sandstoneDark, material or M.Sandstone, NOCOL)
	end
end

----------------------------------------------------------------------
-- Houses, huts, shops
----------------------------------------------------------------------

-- A village house you can walk into. opts: w, d, h, door, wall, roof ("thatch", "tile", "flat"), interior
function B.house(parent, o, opts)
	opts = opts or {}
	local w, d, h = opts.w or 22, opts.d or 18, opts.h or 10
	local wallC = opts.wall or C.mud
	local wallM = M.Sandstone
	local t = 1.2
	local door = opts.door or 6
	local doorH = 7.6
	local y0 = 0.7
	local m = Kit.model(parent, opts.name or "House")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	Kit.block(m, at(0, y0 / 2, 0), V(w + 2, y0, d + 2), C.mudDark, M.Sandstone)
	Kit.block(m, at(0, y0 + h / 2, d / 2 - t / 2), V(w, h, t), wallC, wallM)
	Kit.block(m, at(-w / 2 + t / 2, y0 + h / 2, 0), V(t, h, d - 2 * t), wallC, wallM)
	Kit.block(m, at(w / 2 - t / 2, y0 + h / 2, 0), V(t, h, d - 2 * t), wallC, wallM)
	local side = (w - door) / 2
	Kit.block(m, at(-(door / 2 + side / 2), y0 + h / 2, -d / 2 + t / 2), V(side, h, t), wallC, wallM)
	Kit.block(m, at(door / 2 + side / 2, y0 + h / 2, -d / 2 + t / 2), V(side, h, t), wallC, wallM)
	Kit.block(m, at(0, y0 + doorH + (h - doorH) / 2, -d / 2 + t / 2), V(door, h - doorH, t), wallC, wallM)
	-- wooden door frame and a painted band along the base of the wall
	Kit.block(m, at(-door / 2 - 0.3, y0 + doorH / 2, -d / 2 + t / 2), V(0.6, doorH, t + 0.3), C.woodDark, M.Wood, NOCOL)
	Kit.block(m, at(door / 2 + 0.3, y0 + doorH / 2, -d / 2 + t / 2), V(0.6, doorH, t + 0.3), C.woodDark, M.Wood, NOCOL)
	Kit.block(m, at(0, y0 + doorH + 0.3, -d / 2 + t / 2), V(door + 1.2, 0.6, t + 0.3), C.woodDark, M.Wood, NOCOL)
	Kit.block(m, at(0, 0.2, -d / 2 - 1.8), V(door + 2, 0.4, 2.6), C.stone, M.Slate)
	local band = opts.band or C.redstone
	Kit.block(m, at(-(door / 2 + side / 2), y0 + 1, -d / 2 - 0.05), V(side, 2, 0.2), band, wallM, SOFT)
	Kit.block(m, at(door / 2 + side / 2, y0 + 1, -d / 2 - 0.05), V(side, 2, 0.2), band, wallM, SOFT)
	-- small windows (dark insets) on the side walls
	Kit.block(m, at(-w / 2 - 0.05, y0 + h * 0.6, 0), V(0.2, 2.6, 3), C.woodDark, M.Wood, SOFT)
	Kit.block(m, at(w / 2 + 0.05, y0 + h * 0.6, 0), V(0.2, 2.6, 3), C.woodDark, M.Wood, SOFT)

	local yTop = y0 + h
	local roof = opts.roof or "thatch"
	if roof == "flat" then
		Kit.block(m, at(0, yTop + 0.4, 0), V(w + 1.4, 0.8, d + 1.4), C.mudDark, wallM)
		Kit.block(m, at(0, yTop + 1.4, d / 2 + 0.3), V(w + 1.4, 1.4, 0.8), wallC, wallM, NOCOL)
		Kit.block(m, at(0, yTop + 1.4, -d / 2 - 0.3), V(w + 1.4, 1.4, 0.8), wallC, wallM, NOCOL)
		Kit.block(m, at(w / 2 + 0.3, yTop + 1.4, 0), V(0.8, 1.4, d), wallC, wallM, NOCOL)
		Kit.block(m, at(-w / 2 - 0.3, yTop + 1.4, 0), V(0.8, 1.4, d), wallC, wallM, NOCOL)
	else
		local roofC = (roof == "tile") and C.terracotta or C.thatch
		local roofM = (roof == "tile") and M.Slate or M.Grass
		local a = rad(30)
		local run = d / 2 + 2.2
		local len = run / math.cos(a)
		local rise = run * math.tan(a)
		for _, sgn in ipairs({ -1, 1 }) do
			Kit.block(m, at(0, yTop + rise / 2 - 0.2, sgn * run / 2) * CFrame.Angles(sgn * a, 0, 0), V(w + 4, 0.9, len + 0.6), roofC, roofM)
		end
		Kit.block(m, at(0, yTop + rise + 0.1, 0), V(w + 4.6, 0.8, 1.2), C.woodDark, M.Wood, NOCOL)
		local gableRise = (d / 2) * math.tan(a)
		for _, sx in ipairs({ -1, 1 }) do
			for i = 0, 2 do
				local frac = (i + 0.5) / 3
				Kit.block(m, at(sx * (w / 2 - t / 2), yTop + frac * gableRise, 0), V(t, gableRise / 3 + 0.05, (d - 1) * (1 - frac)), wallC, wallM, NOCOL)
			end
		end
	end

	if opts.interior ~= false then
		Kit.block(m, at(-w / 4, y0 + 0.08, 1), V(w / 3, 0.16, d / 2), opts.rug or Color3.fromRGB(150, 50, 50), M.Fabric, SOFT)
		Kit.block(m, at(w / 2 - 3.4, y0 + 1, d / 2 - 4), V(3.6, 0.5, 6.4), C.wood, M.WoodPlanks, NOCOL)
		Kit.block(m, at(w / 2 - 3.4, y0 + 1.4, d / 2 - 4), V(3.2, 0.4, 6), C.ivory, M.Fabric, SOFT)
		Props.pot(m, at(-w / 2 + 2.6, y0, d / 2 - 2.6), 1)
		Props.pot(m, at(-w / 2 + 5, y0, d / 2 - 2.4), 0.7, C.mudDark)
		local lamp = Props.butterLamp(m, at(0, y0, d / 2 - 2))
		Kit.light(lamp, Color3.fromRGB(255, 200, 140), 22, 1)
	end
	return m
end

-- A round thatched hut (hermitages and forest dwellings).
function B.hut(parent, o, r)
	r = r or 7
	local m = Kit.model(parent, "Hut")
	local n = 10
	for i = 1, n - 1 do
		local a = (i / n) * math.pi * 2 - math.pi / 2
		-- the gap (i = 0) is the doorway, facing -Z
		local cf = o * CFrame.new(math.cos(a) * r, 3.5, math.sin(a) * r) * CFrame.Angles(0, -a + math.pi / 2, 0)
		Kit.block(m, cf, V(2 * r * math.sin(math.pi / n) + 0.5, 7, 0.9), C.mud, M.Sandstone)
	end
	for i = 0, 4 do
		Kit.cyl(m, o * CFrame.new(0, 7.5 + i * 1.5, 0), (2 * r + 4) * (1 - i / 5.2), 1.6, (i % 2 == 0) and C.thatch or Color3.fromRGB(180, 148, 80), M.Grass, NOCOL)
	end
	Kit.cyl(m, o * CFrame.new(0, 0.15, 0), 2 * r, 0.3, C.mudDark, M.Sandstone, SOFT)
	return m
end

-- A shop: a larger house with a counter, shelves of goods, an awning and a sign.
function B.shop(parent, o, title, opts)
	opts = opts or {}
	local w, d, h = 30, 24, 12
	local m = B.house(parent, o, { w = w, d = d, h = h, door = 9, roof = opts.roof or "tile", wall = opts.wall or C.ivory, band = opts.band or C.saffron, interior = false, name = "Shop" })
	local y0 = 0.7
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	Kit.block(m, at(0, y0 + 1.7, 4), V(16, 3.4, 2.2), C.wood, M.WoodPlanks)
	Kit.block(m, at(0, y0 + 3.5, 4), V(16.6, 0.3, 2.8), C.woodDark, M.WoodPlanks, NOCOL)
	for _, sx in ipairs({ -1, 1 }) do
		for tier = 0, 2 do
			Kit.block(m, at(sx * (w / 2 - 2.4), y0 + 2.4 + tier * 2.8, 2), V(2.2, 0.3, 14), C.woodDark, M.WoodPlanks, NOCOL)
			for k = -2, 2 do
				local goods = opts.goods or { C.saffron, C.maroon, C.gold, C.flagBlue, C.terracotta, C.ivory }
				local color = goods[(k + tier * 2 + sx + 6) % #goods + 1]
				Kit.block(m, at(sx * (w / 2 - 2.4), y0 + 3.2 + tier * 2.8, 2 + k * 2.6), V(1.6, 1.3, 1.8), color, M.Fabric, SOFT)
			end
		end
	end
	Props.pot(m, at(-9, y0, 9), 1.1)
	Props.pot(m, at(9, y0, 9), 1.1, C.bronze)
	Kit.block(m, at(0, y0 + 0.08, -4), V(12, 0.16, 9), opts.rug or Color3.fromRGB(150, 50, 50), M.Fabric, SOFT)
	local lamp = Kit.ball(m, at(0, y0 + h - 1.5, 0), 1.2, Color3.fromRGB(255, 214, 150), M.Neon, SOFT)
	Kit.light(lamp, Color3.fromRGB(255, 205, 140), 40, 1.3)
	-- awning over the door
	Kit.block(m, at(0, y0 + 9.4, -d / 2 - 2.4) * CFrame.Angles(rad(-18), 0, 0), V(14, 0.3, 5.4), opts.awning or C.saffron, M.Fabric, NOCOL)
	Kit.cyl(m, at(-6.5, 4.6, -d / 2 - 4.6), 0.4, 9.2, C.woodDark, M.Wood)
	Kit.cyl(m, at(6.5, 4.6, -d / 2 - 4.6), 0.4, 9.2, C.woodDark, M.Wood)
	local board = Kit.block(m, at(0, y0 + h + 1.4, -d / 2 - 0.4), V(15, 2.6, 0.4), C.woodDark, M.WoodPlanks, NOCOL)
	Kit.plaque(board, title, C.goldBright, { Enum.NormalId.Front })
	return m
end

----------------------------------------------------------------------
-- The great temple (a shikhara tower in the manner of the Mahabodhi temple)
----------------------------------------------------------------------
function B.temple(parent, o)
	local m = Kit.model(parent, "Temple")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	local stone, dark, light = C.sandstone, C.sandstoneDark, C.sandstoneLight
	-- platform and front steps
	Kit.block(m, at(0, 2, 0), V(60, 4, 60), dark, M.Sandstone)
	for i = 1, 3 do
		Kit.block(m, at(0, (4 - i) / 2, -30 - (i - 0.5) * 2.4), V(22, 4 - i, 2.4), stone, M.Sandstone)
	end
	-- sanctum walls (36 x 36, door at the front)
	local hh, base = 18, 4
	Kit.block(m, at(0, base + hh / 2, 17), V(36, hh, 2), stone, M.Sandstone)
	Kit.block(m, at(-17, base + hh / 2, 0), V(2, hh, 32), stone, M.Sandstone)
	Kit.block(m, at(17, base + hh / 2, 0), V(2, hh, 32), stone, M.Sandstone)
	Kit.block(m, at(-11.5, base + hh / 2, -17), V(13, hh, 2), stone, M.Sandstone)
	Kit.block(m, at(11.5, base + hh / 2, -17), V(13, hh, 2), stone, M.Sandstone)
	Kit.block(m, at(0, base + 12 + 3, -17), V(10, 6, 2), stone, M.Sandstone)
	Kit.block(m, at(0, base + 12.3, -17.2), V(11.6, 0.8, 2.6), C.gold, M.Metal, NOCOL)
	-- porch
	for _, x in ipairs({ -14, -6, 6, 14 }) do
		Kit.cyl(m, at(x, base + 6.5, -24), 2, 13, light, M.Sandstone)
		Kit.block(m, at(x, base + 0.5, -24), V(3, 1, 3), dark, M.Sandstone, NOCOL)
		Kit.block(m, at(x, base + 12.6, -24), V(3, 0.8, 3), dark, M.Sandstone, NOCOL)
	end
	Kit.block(m, at(0, base + 13.6, -22), V(36, 1.2, 10), dark, M.Sandstone)
	Kit.block(m, at(0, base + 14.7, -22), V(32, 1, 8), stone, M.Sandstone, NOCOL)
	-- roof of the sanctum and the tower above it
	Kit.block(m, at(0, base + hh + 0.5, 0), V(39, 1, 39), dark, M.Sandstone)
	local y = base + hh + 1
	local tiers = 9
	for i = 0, tiers - 1 do
		local size = 34 - i * 3
		Kit.block(m, at(0, y + 2.1, 0), V(size, 4.2, size), (i % 2 == 0) and stone or light, M.Sandstone)
		Kit.block(m, at(0, y + 0.3, 0), V(size + 1.4, 0.6, size + 1.4), dark, M.Sandstone, NOCOL)
		-- a small niche on each face
		if size > 14 then
			Kit.block(m, at(0, y + 2.2, -size / 2 - 0.1), V(3, 2.6, 0.3), C.gold, M.Metal, SOFT)
			Kit.block(m, at(0, y + 2.2, size / 2 + 0.1), V(3, 2.6, 0.3), C.gold, M.Metal, SOFT)
			Kit.block(m, at(-size / 2 - 0.1, y + 2.2, 0), V(0.3, 2.6, 3), C.gold, M.Metal, SOFT)
			Kit.block(m, at(size / 2 + 0.1, y + 2.2, 0), V(0.3, 2.6, 3), C.gold, M.Metal, SOFT)
		end
		y = y + 4.2
	end
	Kit.blob(m, at(0, y + 1.8, 0), V(12, 4, 12), dark, M.Sandstone, NOCOL)
	Kit.ball(m, at(0, y + 5, 0), 3.4, C.gold, M.Metal, NOCOL)
	Kit.cyl(m, at(0, y + 9, 0), 0.7, 6, C.gold, M.Metal, NOCOL)
	Kit.ball(m, at(0, y + 12.2, 0), 1.1, C.goldBright, M.Metal, SOFT)
	-- four corner towers
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local cy = base
			for i = 0, 3 do
				local size = 8 - i * 1.6
				Kit.block(m, at(sx * 24, cy + 1.6, sz * 24), V(size, 3.2, size), (i % 2 == 0) and stone or light, M.Sandstone)
				cy = cy + 3.2
			end
			Kit.ball(m, at(sx * 24, cy + 0.8, sz * 24), 1.8, C.gold, M.Metal, SOFT)
		end
	end
	-- inside: the image, an altar, lamps and incense
	B.buddha(m, at(0, base, 9), 1.5, "earth")
	Kit.block(m, at(0, base + 1, 1.5), V(10, 2, 3), C.woodRed, M.Wood)
	Kit.block(m, at(0, base + 2.1, 1.5), V(10.6, 0.3, 3.4), C.gold, M.Metal, NOCOL)
	for _, x in ipairs({ -3.6, 0, 3.6 }) do
		Props.butterLamp(m, at(x, base + 2.25, 1.5))
	end
	Props.incenseBurner(m, at(0, base, -6))
	Kit.block(m, at(0, base + 0.06, -8), V(12, 0.12, 14), C.maroon, M.Fabric, SOFT)
	local glow = Kit.block(m, at(0, base + 15, 0), V(1, 1, 1), C.goldBright, M.Neon, { collide = false, shadow = false, transparency = 1 })
	Kit.light(glow, Color3.fromRGB(255, 205, 140), 46, 1.5)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(m, at(sx * 12, base + 9, 15.8), V(5, 14, 0.3), (sx == -1) and C.maroon or C.saffron, M.Fabric, SOFT)
	end
	return m
end

----------------------------------------------------------------------
-- East Asian roofs: the meditation hall and the pagoda
----------------------------------------------------------------------
local function tierRoof(m, cf, w, d, tileColor)
	Kit.block(m, cf * CFrame.new(0, 0.5, 0), V(w + 9, 1, d + 9), tileColor, M.Slate)
	Kit.block(m, cf * CFrame.new(0, 1.5, 0), V(w + 4, 1, d + 4), tileColor, M.Slate, NOCOL)
	Kit.block(m, cf * CFrame.new(0, 2.4, 0), V(w - 1, 0.8, d - 1), tileColor, M.Slate, NOCOL)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local corner = cf * CFrame.new(sx * (w + 9) / 2, 1, sz * (d + 9) / 2) * CFrame.Angles(0, rad(45), 0) * CFrame.Angles(rad(18 * -sz), 0, rad(18 * sx))
			Kit.block(m, corner, V(4, 0.8, 4), tileColor, M.Slate, SOFT)
			Kit.ball(m, cf * CFrame.new(sx * (w + 10.5) / 2, 2.2, sz * (d + 10.5) / 2), 0.9, C.gold, M.Metal, SOFT)
		end
	end
end

-- An open-sided meditation hall.
function B.hall(parent, o)
	local m = Kit.model(parent, "MeditationHall")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	Kit.block(m, at(0, 1, 0), V(48, 2, 38), C.stone, M.Cobblestone)
	Kit.block(m, at(0, 0.5, -20.2), V(20, 1, 2.4), C.stone, M.Cobblestone)
	Kit.block(m, at(0, 2.06, 0), V(44, 0.12, 34), C.wood, M.WoodPlanks, SOFT)
	for _, x in ipairs({ -21, -10.5, 0, 10.5, 21 }) do
		for _, z in ipairs({ -16, 16 }) do
			Kit.cyl(m, at(x, 8, z), 1.8, 12, C.woodRed, M.Wood)
			Kit.block(m, at(x, 2.4, z), V(2.6, 0.8, 2.6), C.stoneDark, M.Slate, NOCOL)
		end
	end
	for _, x in ipairs({ -21, 21 }) do
		Kit.cyl(m, at(x, 8, 0), 1.8, 12, C.woodRed, M.Wood)
	end
	Kit.block(m, at(0, 13.6, -16), V(46, 1.2, 1.4), C.woodDark, M.Wood, NOCOL)
	Kit.block(m, at(0, 13.6, 16), V(46, 1.2, 1.4), C.woodDark, M.Wood, NOCOL)
	Kit.block(m, at(-21, 13.6, 0), V(1.4, 1.2, 34), C.woodDark, M.Wood, NOCOL)
	Kit.block(m, at(21, 13.6, 0), V(1.4, 1.2, 34), C.woodDark, M.Wood, NOCOL)
	tierRoof(m, at(0, 14.2, 0), 46, 36, C.tileTeal)
	Kit.block(m, at(0, 18.8, 0), V(30, 4, 20), C.woodRed, M.Wood, NOCOL)
	Kit.block(m, at(0, 18.8, -10.1), V(22, 2.4, 0.2), C.gold, M.Metal, SOFT)
	tierRoof(m, at(0, 20.8, 0), 30, 20, C.tileTeal)
	Kit.block(m, at(0, 24.6, 0), V(26, 1.4, 2), C.gold, M.Metal, SOFT)
	-- inside
	Kit.block(m, at(0, 8, 15.2), V(20, 12, 0.6), C.ivory, M.Sandstone)
	B.buddha(m, at(0, 2, 11), 0.9, "meditation")
	for _, x in ipairs({ -12, -6, 0, 6, 12 }) do
		for _, z in ipairs({ -9, -3, 3 }) do
			Kit.cyl(m, at(x, 2.4, z), 2.6, 0.6, (math.abs(x) == 6) and C.saffron or C.maroon, M.Fabric, SOFT)
		end
	end
	Props.butterLamp(m, at(-5, 2.1, 11))
	Props.butterLamp(m, at(5, 2.1, 11))
	local glow = Kit.block(m, at(0, 11, 0), V(1, 1, 1), C.goldBright, M.Neon, { collide = false, shadow = false, transparency = 1 })
	Kit.light(glow, Color3.fromRGB(255, 210, 150), 44, 1.2)
	return m
end

-- A tiered pagoda tower.
function B.pagoda(parent, o, tiers, baseW, tileColor)
	tiers = tiers or 5
	baseW = baseW or 22
	local m = Kit.model(parent, "Pagoda")
	Kit.block(m, o * CFrame.new(0, 1, 0), V(baseW + 12, 2, baseW + 12), C.stone, M.Cobblestone)
	local y = 2
	for i = 0, tiers - 1 do
		local w = baseW - i * 3.2
		Kit.block(m, o * CFrame.new(0, y + 3.5, 0), V(w, 7, w), C.ivory, M.Sandstone)
		for _, sx in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				Kit.block(m, o * CFrame.new(sx * w / 2, y + 3.5, sz * w / 2), V(1.2, 7, 1.2), C.woodRed, M.Wood, NOCOL)
			end
		end
		Kit.block(m, o * CFrame.new(0, y + 3.2, -w / 2 - 0.1), V(w * 0.3, 4.4, 0.3), C.woodDark, M.Wood, SOFT)
		tierRoof(m, o * CFrame.new(0, y + 7, 0), w, w, tileColor or C.tileGrey)
		y = y + 9.6
	end
	Kit.cyl(m, o * CFrame.new(0, y + 4, 0), 0.8, 10, C.gold, M.Metal, NOCOL)
	for i = 0, 4 do
		Kit.cyl(m, o * CFrame.new(0, y + 1.5 + i * 1.4, 0), 2.6 - i * 0.4, 0.4, C.gold, M.Metal, SOFT)
	end
	Kit.ball(m, o * CFrame.new(0, y + 9.6, 0), 1.3, C.goldBright, M.Metal, SOFT)
	return m
end

----------------------------------------------------------------------
-- The temple bell and the prayer wheels
----------------------------------------------------------------------
function B.bellPavilion(parent, o)
	local m = Kit.model(parent, "BellPavilion")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	Kit.block(m, at(0, 0.5, 0), V(16, 1, 16), C.stone, M.Cobblestone)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			Kit.cyl(m, at(sx * 6, 7, sz * 6), 1.4, 12, C.woodRed, M.Wood)
		end
	end
	Kit.block(m, at(0, 12.6, 0), V(14, 1, 1.2), C.woodDark, M.Wood, NOCOL)
	tierRoof(m, at(0, 13, 0), 13, 13, C.tileTeal)
	Kit.cyl(m, at(0, 11.4, 0), 0.4, 1.6, C.black, M.Metal, SOFT)
	Kit.blob(m, at(0, 9.6, 0), V(5.2, 3.2, 5.2), C.bronze, M.Metal, NOCOL)
	local bell = Kit.cyl(m, at(0, 6.8, 0), 5.2, 5.4, C.bronze, M.Metal)
	bell.Name = "Bell"
	Kit.cyl(m, at(0, 4.3, 0), 5.6, 0.5, C.gold, M.Metal, NOCOL)
	Kit.cyl(m, at(0, 8.2, 0), 5.3, 0.3, C.gold, M.Metal, SOFT)
	local striker = Kit.block(m, at(5.6, 6.4, 0), V(5, 0.9, 0.9), C.wood, M.Wood, NOCOL)
	striker.Name = "Striker"
	Kit.cyl(m, at(5.6, 9.4, 0), 0.12, 5.2, C.ivory, M.Fabric, SOFT)
	return m, bell, striker
end

-- A row of prayer wheels. Returns the list of wheel cores (each can be spun).
function B.prayerWheels(parent, o, n)
	n = n or 8
	local m = Kit.model(parent, "PrayerWheels")
	local spacing = 4.2
	local half = (n - 1) * spacing / 2
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	Kit.block(m, at(0, 0.3, 0), V(half * 2 + 7, 0.6, 5), C.stone, M.Cobblestone)
	Kit.block(m, at(0, 1.7, 0), V(half * 2 + 5, 0.6, 1.2), C.woodRed, M.Wood, NOCOL)
	Kit.block(m, at(0, 7.9, 0), V(half * 2 + 5, 0.6, 1.2), C.woodRed, M.Wood, NOCOL)
	Kit.block(m, at(-half - 2.4, 4.4, 0), V(0.9, 8.2, 1.4), C.woodRed, M.Wood)
	Kit.block(m, at(half + 2.4, 4.4, 0), V(0.9, 8.2, 1.4), C.woodRed, M.Wood)
	Kit.block(m, at(0, 8.9, 0) * CFrame.Angles(rad(8), 0, 0), V(half * 2 + 8, 0.5, 5.4), C.tileTeal, M.Slate, NOCOL)
	local wheels = {}
	for i = 0, n - 1 do
		local x = -half + i * spacing
		Kit.cyl(m, at(x, 4.8, 0), 0.3, 6, C.black, M.Metal, SOFT)
		local core = Kit.cyl(m, at(x, 4.8, 0), 2.6, 3.8, C.bronze, M.Metal)
		core.Name = "Wheel"
		local function welded(p)
			p.Anchored = false
			p.Massless = true
			Kit.weld(p, core)
		end
		welded(Kit.cyl(m, at(x, 6.5, 0), 2.8, 0.3, C.gold, M.Metal, SOFT))
		welded(Kit.cyl(m, at(x, 3.1, 0), 2.8, 0.3, C.gold, M.Metal, SOFT))
		for k = 0, 2 do
			welded(Kit.block(m, at(x, 4.8, 0) * CFrame.Angles(0, rad(k * 120), 0) * CFrame.new(0, 0, -1.34), V(1.2, 1.8, 0.14), (k == 0) and C.goldBright or C.gold, M.Metal, SOFT))
		end
		table.insert(wheels, core)
	end
	return m, wheels
end

----------------------------------------------------------------------
-- Crossings
----------------------------------------------------------------------

-- A gently arched bridge. The deck runs along local Z.
function B.bridge(parent, o, len, w, color)
	len = len or 24
	w = w or 10
	local col = color or C.wood
	local m = Kit.model(parent, "Bridge")
	local n = 9
	local rise = len * 0.09
	local segLen = len / n
	for i = 1, n do
		local t = ((i - 0.5) / n) * 2 - 1
		local z = t * len / 2
		local y = rise * (1 - t * t) + 0.25
		local slope = -2 * rise * t / (len / 2)
		local ang = math.atan(slope)
		local cf = o * CFrame.new(0, y, z) * CFrame.Angles(-ang, 0, 0)
		Kit.block(m, cf, V(w, 0.6, segLen / math.cos(ang) + 0.3), col, M.WoodPlanks)
		for _, sx in ipairs({ -1, 1 }) do
			Kit.block(m, cf * CFrame.new(sx * (w / 2 - 0.3), 2.6, 0), V(0.4, 0.4, segLen / math.cos(ang) + 0.3), C.woodRed, M.Wood, NOCOL)
			if i % 2 == 1 then
				Kit.block(m, cf * CFrame.new(sx * (w / 2 - 0.3), 1.4, 0), V(0.5, 2.6, 0.5), C.woodRed, M.Wood, NOCOL)
			end
		end
	end
	for _, sz in ipairs({ -1, 1 }) do
		for _, sx in ipairs({ -1, 1 }) do
			Kit.block(m, o * CFrame.new(sx * (w / 2 - 0.3), 2, sz * (len / 2 + 0.6)), V(1, 4, 1), C.woodRed, M.Wood)
			Kit.ball(m, o * CFrame.new(sx * (w / 2 - 0.3), 4.5, sz * (len / 2 + 0.6)), 1.2, C.gold, M.Metal, SOFT)
		end
	end
	return m
end

-- Flat stones across a river, from (x1, z) to (x2, z).
function B.steppingStones(parent, x1, x2, z, rng, topY)
	local count = math.floor(math.abs(x2 - x1) / 7.5)
	for i = 0, count do
		local x = x1 + (x2 - x1) * (i / count)
		local dz = rng:NextNumber(-2, 2)
		Kit.cyl(parent, CFrame.new(x, (topY or 0.3) - 7, z + dz), rng:NextNumber(5.4, 6.6), 14, C.stone, M.Slate)
	end
end

----------------------------------------------------------------------
-- Special places
----------------------------------------------------------------------

-- The cave of austerities. Entrance faces -Z.
function B.cave(parent, o)
	local m = Kit.model(parent, "Cave")
	local rock = Color3.fromRGB(118, 104, 90)
	local dark = Color3.fromRGB(88, 78, 70)
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	Kit.block(m, at(-15, 9, 0) * CFrame.Angles(0, rad(6), rad(5)), V(11, 21, 34), rock, M.Slate)
	Kit.block(m, at(15, 9, 0) * CFrame.Angles(0, rad(-6), rad(-5)), V(11, 21, 34), rock, M.Slate)
	Kit.block(m, at(0, 9, 16) * CFrame.Angles(rad(-5), 0, 0), V(40, 21, 10), dark, M.Slate)
	Kit.block(m, at(0, 21, 0) * CFrame.Angles(rad(3), rad(8), 0), V(44, 8, 40), rock, M.Slate)
	Kit.block(m, at(-9.5, 7, -16) * CFrame.Angles(0, rad(-10), 0), V(8, 15, 6), dark, M.Slate)
	Kit.block(m, at(9.5, 7, -16) * CFrame.Angles(0, rad(10), 0), V(8, 15, 6), dark, M.Slate)
	Kit.block(m, at(0, 16, -17) * CFrame.Angles(rad(8), 0, 0), V(16, 5, 6), rock, M.Slate)
	Kit.blob(m, at(-5, 27, 3), V(34, 12, 30), rock, M.Slate, NOCOL)
	Kit.blob(m, at(11, 26, -7), V(20, 9, 20), dark, M.Slate, NOCOL)
	Kit.block(m, at(0, 0.5, 4), V(7, 1, 7), dark, M.Slate)
	Props.butterLamp(m, at(-5, 0, 8))
	Props.butterLamp(m, at(5, 0, 8))
	Props.butterLamp(m, at(0, 0, 10.5))
	local glow = Kit.block(m, at(0, 8, 2), V(1, 1, 1), C.goldBright, M.Neon, { collide = false, shadow = false, transparency = 1 })
	Kit.light(glow, Color3.fromRGB(255, 190, 120), 30, 0.8)
	return m
end

-- A pavilion of illusions for one of Mara's daughters.
function B.pavilion(parent, o, color)
	local m = Kit.model(parent, "Pavilion")
	Kit.cyl(m, o * CFrame.new(0, 0.6, 0), 28, 1.2, C.ivory, M.Marble)
	Kit.cyl(m, o * CFrame.new(0, 0.3, 0), 31, 0.6, C.gold, M.Metal)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 + math.pi / 8
		local p = o * CFrame.new(math.cos(a) * 11, 0, math.sin(a) * 11)
		Kit.cyl(m, p * CFrame.new(0, 7.2, 0), 1.1, 12, C.ivory, M.Marble)
		Kit.ball(m, p * CFrame.new(0, 13.6, 0), 1.6, C.gold, M.Metal, SOFT)
		if i % 2 == 0 then
			local a2 = (i + 1) / 8 * math.pi * 2 + math.pi / 8
			local q = o * CFrame.new(math.cos(a2) * 11, 0, math.sin(a2) * 11)
			local mid = (p.Position + q.Position) / 2 + Vector3.new(0, 8, 0)
			Kit.block(m, CFrame.new(mid, mid + (q.Position - p.Position)), V(0.15, 9, (q.Position - p.Position).Magnitude), color, M.Fabric, { collide = false, shadow = false, transparency = 0.35 })
		end
	end
	Kit.blob(m, o * CFrame.new(0, 17, 0), V(28, 10, 28), color, M.SmoothPlastic, NOCOL)
	Kit.cyl(m, o * CFrame.new(0, 13.4, 0), 26, 0.8, C.gold, M.Metal, NOCOL)
	Kit.ball(m, o * CFrame.new(0, 23, 0), 2.2, C.goldBright, M.Metal, SOFT)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		Kit.cyl(m, o * CFrame.new(math.cos(a) * 6, 1.5, math.sin(a) * 6), 3, 0.6, color, M.Fabric, SOFT)
	end
	local glow = Kit.ball(m, o * CFrame.new(0, 10.5, 0), 1.4, color, M.Neon, SOFT)
	Kit.light(glow, color, 40, 1.8)
	Kit.sparkle(glow, color, 10)
	return m
end

-- The Bodhi tree (Ficus religiosa) on its terrace, with the stone seat on the eastern (+X) side.
-- Returns the model and the seat part.
function B.bodhiTree(parent, o)
	local m = Kit.model(parent, "BodhiTree")
	local function at(x, y, z)
		return o * CFrame.new(x, y, z)
	end
	-- terrace in two low steps
	Kit.cyl(m, at(0, 0.5, 0), 100, 1, C.sandstoneDark, M.Sandstone)
	Kit.cyl(m, at(0, 1.5, 0), 92, 1, C.sandstone, M.Sandstone)
	local top = 2
	-- trunk: a fused bundle, as old fig trees grow
	Kit.cyl(m, at(0, top + 16, 0), 13, 32, C.trunk, M.Wood)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		Kit.cyl(m, at(math.cos(a) * 6, top + 13, math.sin(a) * 6), 5.2, 26 + (i % 3) * 3, (i % 2 == 0) and C.trunkPale or C.trunk, M.Wood)
		Kit.blob(m, at(math.cos(a + 0.4) * 9.5, top + 3, math.sin(a + 0.4) * 9.5) * CFrame.Angles(0, -a, 0), V(6, 9, 9), C.trunk, M.Wood)
	end
	-- great limbs
	for i = 0, 6 do
		local limb = at(0, top + 26, 0) * CFrame.Angles(0, rad(i * 51.4 + 12), 0) * CFrame.Angles(rad(52 + (i % 2) * 10), 0, 0)
		Kit.cyl(m, limb * CFrame.new(0, 16, 0), 4.2 - (i % 2), 32, C.trunk, M.Wood, NOCOL)
	end
	-- canopy
	local leafColors = { C.leaf, C.leafDark, C.leafLight }
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		Kit.blob(m, at(math.cos(a) * 36, top + 50 + (i % 2) * 4, math.sin(a) * 36), V(42, 20, 42), leafColors[i % 3 + 1], M.Grass, NOCOL)
	end
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2 + 0.5
		Kit.blob(m, at(math.cos(a) * 17, top + 62, math.sin(a) * 17), V(44, 22, 44), leafColors[(i + 1) % 3 + 1], M.Grass, NOCOL)
	end
	Kit.blob(m, at(0, top + 73, 0), V(52, 24, 52), C.leaf, M.Grass, NOCOL)
	-- drifting leaves
	local drift = Kit.block(m, at(0, top + 46, 0), V(70, 1, 70), C.leaf, M.SmoothPlastic, { collide = false, shadow = false, transparency = 1 })
	local e = Instance.new("ParticleEmitter")
	e.Rate = 5
	e.Lifetime = NumberRange.new(9, 13)
	e.Speed = NumberRange.new(2.5, 4)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.SpreadAngle = Vector2.new(20, 20)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	e.Size = NumberSequence.new(0.7)
	e.Color = ColorSequence.new(Color3.fromRGB(150, 190, 80), Color3.fromRGB(230, 200, 90))
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.8, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = drift
	-- golden railing, open to the west where the path arrives
	local posts = 28
	for i = 0, posts - 1 do
		local a = i / posts * math.pi * 2
		if math.cos(a) > -0.9 then
			local p = at(math.cos(a) * 44, top, math.sin(a) * 44)
			Kit.block(m, p * CFrame.new(0, 2, 0), V(1, 4, 1), C.sandstoneLight, M.Sandstone, NOCOL)
			Kit.ball(m, p * CFrame.new(0, 4.4, 0), 1.1, C.gold, M.Metal, SOFT)
			local a2 = (i + 1) / posts * math.pi * 2
			if math.cos(a2) > -0.9 then
				local q = at(math.cos(a2) * 44, top, math.sin(a2) * 44)
				local mid = (p.Position + q.Position) / 2
				local seg = CFrame.new(mid, q.Position)
				Kit.block(m, seg * CFrame.new(0, 3.2, 0), V(0.5, 0.5, (q.Position - p.Position).Magnitude), C.gold, M.Metal, NOCOL)
				Kit.block(m, seg * CFrame.new(0, 1.6, 0), V(0.5, 0.5, (q.Position - p.Position).Magnitude), C.gold, M.Metal, NOCOL)
			end
			if i % 2 == 0 then
				Props.butterLamp(m, at(math.cos(a) * 41, top, math.sin(a) * 41))
			end
		end
	end
	-- prayer flags from the trunk out to tall poles
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2 + 0.2
		local outer = (o * CFrame.new(math.cos(a) * 47, 16, math.sin(a) * 47)).Position
		local inner = (o * CFrame.new(math.cos(a) * 7, top + 24, math.sin(a) * 7)).Position
		Props.flags(m, inner, outer, false)
		Kit.cyl(m, CFrame.new(outer.X, outer.Y / 2, outer.Z), 0.6, outer.Y, C.woodDark, M.Wood)
	end
	-- the Vajrasana, the Diamond Seat, on the east side with its back to the trunk
	local seat = Kit.block(m, at(12, top + 0.6, 0), V(9, 1.2, 11), C.redstone, M.Marble)
	seat.Name = "Vajrasana"
	Kit.block(m, at(12, top + 0.6, 0), V(9.3, 0.4, 11.3), C.gold, M.Metal, NOCOL)
	Kit.block(m, at(12, top + 1.26, 0), V(7.6, 0.14, 9.6), Color3.fromRGB(150, 178, 92), M.Grass, SOFT)
	Props.butterLamp(m, at(18, top, 5))
	Props.butterLamp(m, at(18, top, -5))
	Props.incenseBurner(m, at(21, top, 0))
	local glow = Kit.block(m, at(12, top + 10, 0), V(1, 1, 1), C.goldBright, M.Neon, { collide = false, shadow = false, transparency = 1 })
	Kit.light(glow, Color3.fromRGB(255, 220, 160), 50, 1.4)
	return m, seat
end

return B
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[-- Combat: Calm (the player's "health"), the monk's abilities, and meditation.
--
-- Nothing is killed in this game. Mara's soldiers are troubles of the mind; when they are
-- met steadily they are "dispelled" and fall apart into petals, as Mara's weapons turned
-- to flowers. When a player's Calm runs out they are "overwhelmed" and return to the last
-- shrine they prayed at.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Story = require(Shared:WaitForChild("Story"))
local Remotes = require(script.Parent.Remotes)
local PlayerData = require(script.Parent.PlayerData)
local Quests = require(script.Parent.Quests)

local Combat = {}

-- Everything that can be struck: Mara's soldiers, his daughters, and Mara himself.
Combat.targets = {}
local projectiles = {}
local meditateHooks = {}

function Combat.addTarget(t)
	t.tagged = t.tagged or {}
	t.alive = true
	table.insert(Combat.targets, t)
end

function Combat.removeTarget(t)
	t.alive = false
	for i, other in ipairs(Combat.targets) do
		if other == t then
			table.remove(Combat.targets, i)
			break
		end
	end
end

function Combat.onMeditateTick(fn)
	table.insert(meditateHooks, fn)
end

----------------------------------------------------------------------
-- Where players are
----------------------------------------------------------------------
function Combat.root(player)
	local character = player.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local hum = character:FindFirstChildOfClass("Humanoid")
	if root and hum and hum.Health > 0 then
		return root, hum
	end
	return nil
end

function Combat.position(player)
	local root = Combat.root(player)
	return root and root.Position or nil
end

function Combat.shrineCFrame(shrineId)
	for _, s in ipairs(Config.Shrines) do
		if s.id == shrineId then
			return CFrame.new(s.x - 9, 4.5, s.z) * CFrame.Angles(0, math.rad(-90), 0)
		end
	end
	return CFrame.new(Config.Places.spawn.x, 4.5, Config.Places.spawn.z)
end

function Combat.toShrine(player, shrineId)
	local character = player.Character
	if character and character.PrimaryPart then
		character:PivotTo(Combat.shrineCFrame(shrineId))
		local root = character:FindFirstChild("HumanoidRootPart")
		if root then
			root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end
	end
end

----------------------------------------------------------------------
-- Speed, healing and harm
----------------------------------------------------------------------
function Combat.refreshSpeed(player)
	local root, hum = Combat.root(player)
	local session = PlayerData.session(player)
	if not root or not session then
		return
	end
	local now = os.clock()
	local speed = Config.Player.BaseSpeed
	if PlayerData.hasPath(player, "effort") then
		speed = speed + 3
	end
	if now < session.speedUntil then
		speed = speed + Config.Items.tea.amount
	end
	if now < session.slowUntil then
		speed = speed * 0.6
	end
	if math.abs(hum.WalkSpeed - speed) > 0.05 then
		hum.WalkSpeed = speed
	end
end

function Combat.heal(player, amount)
	local max = player:GetAttribute("MaxCalm") or Config.Player.BaseCalm
	local calm = player:GetAttribute("Calm") or max
	if calm < max then
		player:SetAttribute("Calm", math.min(max, calm + amount))
	end
end

function Combat.setMeditating(player, on)
	local session = PlayerData.session(player)
	if not session then
		return
	end
	on = on and true or false
	if session.meditating == on then
		return
	end
	local root = Combat.root(player)
	if on and not root then
		return
	end
	session.meditating = on
	session.meditateAt = root and root.Position or nil
	player:SetAttribute("Meditating", on)
end

local function overwhelm(player)
	local session = PlayerData.session(player)
	local profile = PlayerData.get(player)
	if not session or not profile then
		return
	end
	local now = os.clock()
	session.graceUntil = now + Config.Player.OverwhelmGrace + 1.2
	Combat.setMeditating(player, false)
	player:SetAttribute("Calm", player:GetAttribute("MaxCalm"))
	local line = Story.OverwhelmLines[math.random(1, #Story.OverwhelmLines)]
	Remotes.fxTo(player, "overwhelm", { text = line })
	task.delay(0.7, function()
		if player.Parent then
			Combat.toShrine(player, profile.checkpoint)
		end
	end)
end

-- Reduce a player's Calm. Returns true if it landed.
function Combat.hurt(player, amount)
	local session = PlayerData.session(player)
	if not session or not Combat.root(player) then
		return false
	end
	local now = os.clock()
	if now < session.graceUntil or now < session.talkUntil then
		return false
	end
	if session.meditating then
		amount = amount * Config.Player.MeditateShield
	end
	if now < session.shieldUntil then
		amount = amount * 0.7
	end
	session.lastHurt = now
	local calm = (player:GetAttribute("Calm") or 0) - amount
	if calm <= 0 then
		overwhelm(player)
	else
		player:SetAttribute("Calm", calm)
		Remotes.fxTo(player, "hurt", { amount = amount })
	end
	return true
end

function Combat.slow(player, seconds)
	local session = PlayerData.session(player)
	if session then
		session.slowUntil = math.max(session.slowUntil, os.clock() + seconds)
		Combat.refreshSpeed(player)
	end
end

function Combat.canBeTargeted(player)
	local session = PlayerData.session(player)
	if not session or os.clock() < session.graceUntil or os.clock() < session.talkUntil then
		return false
	end
	return Combat.root(player) ~= nil
end

-- While someone is speaking to you (or the story is being told), Mara's shadows wait.
-- The player's screen reports when the last line has been read.
function Combat.beginTalk(player, lines)
	local session = PlayerData.session(player)
	if session then
		local count = type(lines) == "table" and #lines or 1
		local seconds = math.min(240, 20 * count + 5)
		session.talkUntil = math.max(session.talkUntil, os.clock() + seconds)
	end
end

function Combat.endTalk(player)
	local session = PlayerData.session(player)
	if session and os.clock() < session.talkUntil then
		session.talkUntil = os.clock() + 3
	end
end

----------------------------------------------------------------------
-- Striking targets
----------------------------------------------------------------------
function Combat.damage(target, player, amount)
	if not target.alive or target.invulnerable then
		return false
	end
	amount = math.floor(amount + 0.5)
	target.hp = target.hp - amount
	if player then
		target.tagged[player] = true
	end
	if target.hum then
		target.hum.Health = math.max(1, target.hp)
	end
	if target.root then
		Remotes.fx("hit", { pos = target.root.Position + Vector3.new(0, 3, 0), amount = amount })
	end
	if target.onDamage then
		target.onDamage(target, player, amount)
	end
	if target.hp <= 0 then
		target.alive = false
		if target.onDefeat then
			target.onDefeat(target, player)
		end
	end
	return true
end

local function targetsNear(pos, range)
	local found = {}
	for _, t in ipairs(Combat.targets) do
		if t.alive and t.root and t.root.Parent then
			local d = (t.root.Position - pos).Magnitude - (t.hitRadius or 0)
			if d <= range then
				table.insert(found, { target = t, dist = d })
			end
		end
	end
	table.sort(found, function(a, b)
		return a.dist < b.dist
	end)
	return found
end
Combat.targetsNear = targetsNear

local function ready(session, name, cooldown)
	local now = os.clock()
	if now < (session.cooldowns[name] or 0) then
		return false
	end
	session.cooldowns[name] = now + cooldown
	return true
end

-- Which weapon a player is holding: returns its id and its entry in Config.Weapons.
function Combat.weapon(player)
	local profile = PlayerData.get(player)
	local id = profile and profile.weapon or "palm"
	if id == "auto" then
		id = profile.abilities.staff and "staff" or "palm"
	end
	if id ~= "palm" and (not Config.Weapons[id] or (profile.inv[id] or 0) < 1) then
		id = "palm"
	end
	return id, Config.Weapons[id]
end

local function strikePower(player)
	local profile = PlayerData.get(player)
	local _, weapon = Combat.weapon(player)
	local dmg = weapon.damage
	if PlayerData.hasPath(player, "action") then
		dmg = dmg * 1.3
	end
	if (profile.inv.vajra or 0) > 0 then
		dmg = dmg * 1.25
	end
	return dmg
end

-- The Wheel of Light: flies out, turns, and comes back to the hand.
local wheels = {}

local function throwWheel(player, root, weapon, dmg)
	local disc = Instance.new("Part")
	disc.Name = "ThrownWheel"
	disc.Size = Vector3.new(3.2, 0.3, 3.2)
	disc.Material = Enum.Material.Neon
	disc.Color = Color3.fromRGB(255, 214, 110)
	disc.Anchored = true
	disc.CanCollide = false
	disc.CanTouch = false
	disc.CanQuery = false
	disc.CastShadow = false
	local look = root.CFrame.LookVector
	local dir = Vector3.new(look.X, 0, look.Z)
	if dir.Magnitude < 0.1 then
		dir = Vector3.new(0, 0, -1)
	end
	dir = dir.Unit
	disc.CFrame = CFrame.new(root.Position + Vector3.new(0, 1.5, 0) + dir * 2)
	local light = Instance.new("PointLight")
	light.Color = disc.Color
	light.Range = 14
	light.Parent = disc
	disc.Parent = workspace
	local speed = 90
	table.insert(wheels, {
		part = disc, dir = dir, speed = speed, out = weapon.range / speed, age = 0,
		player = player, damage = dmg, struck = {},
	})
end

local function moveWheels(dt)
	for i = #wheels, 1, -1 do
		local w = wheels[i]
		w.age = w.age + dt
		local pos = w.part.Position
		local done = false
		if w.age < w.out then
			pos = pos + w.dir * w.speed * dt
		else
			local home = Combat.root(w.player)
			if not home or w.age > 4 then
				done = true
			else
				if not w.returning then
					w.returning = true
					w.struck = {} -- it may touch each shadow again on the way back
				end
				local to = (home.Position + Vector3.new(0, 1.5, 0)) - pos
				local step = w.speed * dt
				if to.Magnitude <= step + 2 then
					done = true
				else
					pos = pos + to.Unit * step
				end
			end
		end
		w.part.CFrame = CFrame.new(pos) * CFrame.Angles(0, w.age * 18, 0)
		for _, t in ipairs(Combat.targets) do
			if t.alive and t.root and t.root.Parent and not w.struck[t] then
				if (t.root.Position - pos).Magnitude <= 4.5 + (t.hitRadius or 0) then
					w.struck[t] = true
					Combat.damage(t, w.player, w.damage)
				end
			end
		end
		if done then
			w.part:Destroy()
			table.remove(wheels, i)
		end
	end
end

-- The Paper Lantern: a circle of light stays where you stood. Shadows inside it are
-- slowed and worn away a little at a time.
local function lightLantern(player, root, weapon, dmg)
	local pos = root.Position
	local glow = Instance.new("Part")
	glow.Name = "LanternLight"
	glow.Shape = Enum.PartType.Cylinder
	glow.Size = Vector3.new(0.3, weapon.range * 2, weapon.range * 2)
	glow.Material = Enum.Material.Neon
	glow.Color = Color3.fromRGB(255, 206, 130)
	glow.Transparency = 0.8
	glow.Anchored = true
	glow.CanCollide = false
	glow.CanTouch = false
	glow.CanQuery = false
	glow.CastShadow = false
	glow.CFrame = CFrame.new(pos - Vector3.new(0, 2.7, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local light = Instance.new("PointLight")
	light.Color = glow.Color
	light.Range = 30
	light.Brightness = 1.6
	light.Shadows = false
	light.Parent = glow
	glow.Parent = workspace
	Remotes.fx("ring", { pos = pos, radius = weapon.range, color = glow.Color, time = 0.8 })
	task.spawn(function()
		for _ = 1, weapon.field * 2 do
			task.wait(0.5)
			local now = os.clock()
			for _, entry in ipairs(targetsNear(pos, weapon.range)) do
				local t = entry.target
				t.slowUntil = now + 0.8
				Combat.damage(t, player, dmg)
			end
		end
		glow:Destroy()
	end)
end

local Abilities = {}

function Abilities.strike(player, session, profile, root)
	local _, weapon = Combat.weapon(player)
	if not ready(session, "strike", weapon.cooldown - 0.08) then
		return
	end
	Combat.setMeditating(player, false)
	Combat.swing(player)
	local range = weapon.range
	local look = root.CFrame.LookVector
	local dmg = strikePower(player)
	if weapon.thrown then
		throwWheel(player, root, weapon, dmg)
		return
	end
	if weapon.field then
		lightLantern(player, root, weapon, dmg)
		return
	end
	if weapon.ring then
		Remotes.fx("ring", { pos = root.Position, radius = range, color = Color3.fromRGB(255, 244, 214), time = 0.5 })
	end
	local now = os.clock()
	local hits = 0
	for _, entry in ipairs(targetsNear(root.Position, range)) do
		local t = entry.target
		local to = t.root.Position - root.Position
		local flat = Vector3.new(to.X, 0, to.Z)
		if weapon.all or flat.Magnitude < 3 + (t.hitRadius or 0) or flat.Unit:Dot(look) > 0.1 then
			Combat.damage(t, player, dmg)
			if t.alive and not t.static then
				if weapon.stun then
					local seconds = t.big and weapon.stun * 0.25 or weapon.stun
					t.stunUntil = math.max(t.stunUntil or 0, now + seconds)
				end
				if weapon.push and not t.big and t.model and flat.Magnitude > 0.1 then
					local at = t.root.Position
					local dest = at + flat.Unit * weapon.push
					t.model:PivotTo(CFrame.new(dest.X, at.Y + 0.5, dest.Z))
				end
			end
			hits = hits + 1
			if hits >= weapon.hits then
				break
			end
		end
	end
end

function Abilities.beads(player, session, profile, root)
	if not profile.abilities.beads then
		return
	end
	local cd = Config.Abilities.beads.cooldown
	if (profile.inv.long_mala or 0) > 0 then
		cd = cd / 2
	end
	if not ready(session, "beads", cd - 0.08) then
		return
	end
	Combat.setMeditating(player, false)
	local origin = root.Position + Vector3.new(0, 1.5, 0)
	local dir = root.CFrame.LookVector
	local best = nil
	for _, entry in ipairs(targetsNear(root.Position, Config.Abilities.beads.range)) do
		local to = entry.target.root.Position - root.Position
		if to.Magnitude > 0.1 and to.Unit:Dot(root.CFrame.LookVector) > -0.25 then
			best = entry.target
			break
		end
	end
	if best then
		local to = (best.root.Position + Vector3.new(0, 1, 0)) - origin
		if to.Magnitude > 0.1 then
			dir = to.Unit
		end
	end
	local bead = Instance.new("Part")
	bead.Name = "Bead"
	bead.Shape = Enum.PartType.Ball
	bead.Size = Vector3.new(1.1, 1.1, 1.1)
	bead.Material = Enum.Material.Neon
	bead.Color = Color3.fromRGB(255, 214, 110)
	bead.Anchored = true
	bead.CanCollide = false
	bead.CanTouch = false
	bead.CanQuery = false
	bead.CastShadow = false
	bead.CFrame = CFrame.new(origin + dir * 2)
	local light = Instance.new("PointLight")
	light.Color = bead.Color
	light.Range = 10
	light.Parent = bead
	bead.Parent = workspace
	table.insert(projectiles, {
		part = bead, dir = dir, speed = 95, life = 1.1, player = player,
		damage = Config.Abilities.beads.damage * (PlayerData.hasPath(player, "action") and 1.3 or 1),
	})
end

function Abilities.metta(player, session, profile, root)
	if not profile.abilities.metta then
		return
	end
	if not ready(session, "metta", Config.Abilities.metta.cooldown - 0.1) then
		return
	end
	local range = Config.Abilities.metta.range
	local dmg = Config.Abilities.metta.damage
	if PlayerData.hasPath(player, "intention") then
		dmg = dmg * 1.4
	end
	Remotes.fx("ring", { pos = root.Position, radius = range, color = Color3.fromRGB(255, 190, 210), time = 0.7 })
	for _, entry in ipairs(targetsNear(root.Position, range)) do
		Combat.damage(entry.target, player, dmg)
	end
	Combat.heal(player, 12)
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local pos = Combat.position(other)
			if pos and (pos - root.Position).Magnitude <= range then
				Combat.heal(other, 25)
				Remotes.notify(other, player.DisplayName .. " shares loving-kindness with you.", "good")
			end
		end
	end
end

function Abilities.bowl(player, session, profile, root)
	if not profile.abilities.bowl then
		return
	end
	if not ready(session, "bowl", Config.Abilities.bowl.cooldown - 0.1) then
		return
	end
	local range = Config.Abilities.bowl.range
	local now = os.clock()
	Remotes.fx("ring", { pos = root.Position, radius = range, color = Color3.fromRGB(255, 220, 130), time = 1.1 })
	for _, entry in ipairs(targetsNear(root.Position, range)) do
		local t = entry.target
		if not t.static then
			local seconds = t.big and 1.5 or Config.Abilities.bowl.stun
			t.stunUntil = math.max(t.stunUntil or 0, now + seconds)
		end
	end
end

function Abilities.meditate(player, session, profile, root, on)
	if on and not ready(session, "meditate", 0.3) then
		return
	end
	Combat.setMeditating(player, on)
end

-- Called when a player presses an ability button.
function Combat.use(player, name, arg)
	local session = PlayerData.session(player)
	local profile = PlayerData.get(player)
	local root = Combat.root(player)
	local fn = Abilities[name]
	if not session or not profile or not root or not fn then
		return
	end
	session.talkUntil = 0 -- acting ends the pause that a conversation gives
	fn(player, session, profile, root, arg)
end

----------------------------------------------------------------------
-- The weapon in the player's hand
----------------------------------------------------------------------
local GRIP = CFrame.new(0, 1.1, -0.55)
local WOOD = Color3.fromRGB(110, 78, 50)
local BRASS = Color3.fromRGB(226, 178, 54)
local STEEL = Color3.fromRGB(196, 200, 208)

-- One piece of a weapon, fixed to its handle.
local function piece(handle, size, offset, color, material, shape)
	local p = Instance.new("Part")
	p.Name = "Piece"
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Material = material or Enum.Material.Wood
	p.Color = color
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.CFrame = handle.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = handle
	w.Part1 = p
	w.Parent = p
	p.Parent = handle
	return p
end

-- Each builder shapes the handle, adds the pieces, and returns the height of the
-- weapon's tip above the middle of the handle.
local Builders = {}

function Builders.staff(handle)
	handle.Size = Vector3.new(0.3, 6.2, 0.3)
	for i = 0, 2 do
		local d = 0.55 - i * 0.08
		piece(handle, Vector3.new(d, d, d), CFrame.new(0, 2.5 + i * 0.36, 0), BRASS, Enum.Material.Metal, Enum.PartType.Ball)
	end
	return 3.1
end

function Builders.whisk(handle)
	handle.Size = Vector3.new(0.26, 2.2, 0.26)
	handle.Color = Color3.fromRGB(120, 36, 30)
	piece(handle, Vector3.new(0.4, 0.3, 0.4), CFrame.new(0, 1.2, 0), BRASS, Enum.Material.Metal)
	piece(handle, Vector3.new(0.55, 1.5, 0.55), CFrame.new(0, 2.05, 0), Color3.fromRGB(244, 240, 228), Enum.Material.Fabric)
	piece(handle, Vector3.new(0.4, 1.3, 0.4), CFrame.new(0, 3.3, 0), Color3.fromRGB(236, 232, 218), Enum.Material.Fabric)
	return 3.9
end

function Builders.spade(handle)
	handle.Size = Vector3.new(0.34, 7.4, 0.34)
	-- the flat spade at the top
	piece(handle, Vector3.new(1.5, 0.3, 0.2), CFrame.new(0, 3.75, 0), STEEL, Enum.Material.Metal)
	piece(handle, Vector3.new(1.9, 1.1, 0.14), CFrame.new(0, 4.4, 0), STEEL, Enum.Material.Metal)
	-- the crescent at the foot
	piece(handle, Vector3.new(0.5, 0.4, 0.5), CFrame.new(0, -3.7, 0), BRASS, Enum.Material.Metal)
	for _, side in ipairs({ -1, 1 }) do
		piece(handle, Vector3.new(1.1, 0.3, 0.14), CFrame.new(side * 0.5, -4.05, 0) * CFrame.Angles(0, 0, math.rad(side * -35)), STEEL, Enum.Material.Metal)
	end
	for i = 0, 1 do
		piece(handle, Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, 3.2 - i * 0.4, 0), BRASS, Enum.Material.Metal, Enum.PartType.Ball)
	end
	return 4.9
end

function Builders.wisdom_sword(handle)
	handle.Size = Vector3.new(0.3, 1.3, 0.3)
	handle.Color = BRASS
	handle.Material = Enum.Material.Metal
	piece(handle, Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, -0.8, 0), BRASS, Enum.Material.Metal, Enum.PartType.Ball)
	piece(handle, Vector3.new(1.5, 0.28, 0.4), CFrame.new(0, 0.75, 0), BRASS, Enum.Material.Metal)
	local blade = piece(handle, Vector3.new(0.5, 4.4, 0.14), CFrame.new(0, 3.05, 0), Color3.fromRGB(255, 206, 110), Enum.Material.Neon)
	piece(handle, Vector3.new(0.3, 0.6, 0.12), CFrame.new(0, 5.5, 0), Color3.fromRGB(255, 226, 150), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 190, 90)
	light.Range = 12
	light.Brightness = 1.3
	light.Shadows = false
	light.Parent = blade
	local flame = Instance.new("ParticleEmitter")
	flame.Rate = 14
	flame.Lifetime = NumberRange.new(0.4, 0.8)
	flame.Speed = NumberRange.new(1, 2.5)
	flame.SpreadAngle = Vector2.new(25, 25)
	flame.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0) })
	flame.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	flame.Color = ColorSequence.new(Color3.fromRGB(255, 170, 60))
	flame.LightEmission = 0.9
	flame.Parent = blade
	return 5.8
end

function Builders.conch(handle)
	local shell = Color3.fromRGB(246, 242, 232)
	handle.Size = Vector3.new(0.45, 1.2, 0.45)
	handle.Color = shell
	handle.Material = Enum.Material.SmoothPlastic
	piece(handle, Vector3.new(0.6, 0.3, 0.6), CFrame.new(0, -0.75, 0), BRASS, Enum.Material.Metal)
	piece(handle, Vector3.new(1.3, 1.3, 1.3), CFrame.new(0, 0.6, 0), shell, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	piece(handle, Vector3.new(0.95, 0.95, 0.95), CFrame.new(0, 1.35, 0), shell, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	piece(handle, Vector3.new(0.6, 0.6, 0.6), CFrame.new(0, 1.9, 0), shell, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	piece(handle, Vector3.new(0.35, 0.35, 0.35), CFrame.new(0, 2.3, 0), BRASS, Enum.Material.Metal, Enum.PartType.Ball)
	return 2.4
end

function Builders.bell(handle)
	handle.Size = Vector3.new(0.25, 1.5, 0.25)
	handle.Color = BRASS
	handle.Material = Enum.Material.Metal
	-- the half-vajra on top of the handle
	piece(handle, Vector3.new(0.45, 0.45, 0.45), CFrame.new(0, 0.85, 0), BRASS, Enum.Material.Metal, Enum.PartType.Ball)
	piece(handle, Vector3.new(0.2, 0.5, 0.2), CFrame.new(0, 1.25, 0), BRASS, Enum.Material.Metal)
	-- the bell itself, hanging below the hand
	piece(handle, Vector3.new(0.9, 0.3, 0.9), CFrame.new(0, -1.7, 0), BRASS, Enum.Material.Metal)
	piece(handle, Vector3.new(1.25, 0.8, 1.25), CFrame.new(0, -2.2, 0), BRASS, Enum.Material.Metal)
	piece(handle, Vector3.new(1.5, 0.2, 1.5), CFrame.new(0, -2.65, 0), BRASS, Enum.Material.Metal)
	return 1.5
end

function Builders.phurba(handle)
	handle.Size = Vector3.new(0.3, 1.2, 0.3)
	handle.Color = BRASS
	handle.Material = Enum.Material.Metal
	piece(handle, Vector3.new(0.55, 0.55, 0.55), CFrame.new(0, -0.8, 0), BRASS, Enum.Material.Metal, Enum.PartType.Ball)
	piece(handle, Vector3.new(0.7, 0.2, 0.7), CFrame.new(0, 0.65, 0), BRASS, Enum.Material.Metal)
	piece(handle, Vector3.new(0.45, 1.2, 0.45), CFrame.new(0, 1.3, 0) * CFrame.Angles(0, math.rad(45), 0), STEEL, Enum.Material.Metal)
	piece(handle, Vector3.new(0.3, 1, 0.3), CFrame.new(0, 2.3, 0) * CFrame.Angles(0, math.rad(45), 0), STEEL, Enum.Material.Metal)
	piece(handle, Vector3.new(0.15, 0.7, 0.15), CFrame.new(0, 3.1, 0) * CFrame.Angles(0, math.rad(45), 0), STEEL, Enum.Material.Metal)
	return 3.4
end

function Builders.chakra(handle)
	local gold = Color3.fromRGB(255, 214, 110)
	handle.Size = Vector3.new(0.25, 0.9, 0.25)
	handle.Color = BRASS
	handle.Material = Enum.Material.Metal
	local centre = CFrame.new(0, 1.9, 0)
	piece(handle, Vector3.new(0.7, 0.7, 0.7), centre, gold, Enum.Material.Neon, Enum.PartType.Ball)
	for i = 0, 3 do
		piece(handle, Vector3.new(0.16, 2.7, 0.2), centre * CFrame.Angles(0, 0, math.rad(i * 45)), BRASS, Enum.Material.Metal)
	end
	for i = 0, 7 do
		piece(handle, Vector3.new(1.12, 0.22, 0.28), centre * CFrame.Angles(0, 0, math.rad(i * 45)) * CFrame.new(0, 1.35, 0), BRASS, Enum.Material.Metal)
	end
	return 3.3
end

function Builders.lantern(handle)
	handle.Size = Vector3.new(0.2, 3, 0.2)
	local red = Color3.fromRGB(176, 40, 36)
	piece(handle, Vector3.new(1.3, 0.15, 1.3), CFrame.new(0, 1.6, 0), red, Enum.Material.Wood)
	local paper = piece(handle, Vector3.new(1.15, 1.5, 1.15), CFrame.new(0, 2.4, 0), Color3.fromRGB(255, 214, 150), Enum.Material.Neon)
	piece(handle, Vector3.new(1.3, 0.15, 1.3), CFrame.new(0, 3.2, 0), red, Enum.Material.Wood)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 120)
	light.Range = 16
	light.Brightness = 1.4
	light.Shadows = false
	light.Parent = paper
	return 3.3
end

-- Put the chosen weapon in the player's hand (or take it away for the open palm).
function Combat.equipWeapon(player)
	local profile = PlayerData.get(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	local id = Combat.weapon(player)
	local old = character:FindFirstChild("HeldWeapon")
	if old then
		if old:GetAttribute("Weapon") == id then
			return
		end
		old:Destroy()
	end
	local build = Builders[id]
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not build or not hand then
		return
	end
	local handle = Instance.new("Part")
	handle.Name = "HeldWeapon"
	handle:SetAttribute("Weapon", id)
	handle.Material = Enum.Material.Wood
	handle.Color = WOOD
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.CFrame = hand.CFrame * GRIP
	local tip = build(handle)

	-- a streak of light that follows the tip while the weapon is swung
	local a0 = Instance.new("Attachment")
	a0.Name = "TipTop"
	a0.Position = Vector3.new(0, tip, 0)
	a0.Parent = handle
	local a1 = Instance.new("Attachment")
	a1.Name = "TipLow"
	a1.Position = Vector3.new(0, tip - 2.2, 0)
	a1.Parent = handle
	local trail = Instance.new("Trail")
	trail.Name = "SwingTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.22
	trail.MinLength = 0.05
	trail.LightEmission = 0.8
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 232, 170))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	trail.Enabled = false
	trail.Parent = handle

	-- held by a joint, so that it can be swung
	local grip = Instance.new("Weld")
	grip.Name = "Grip"
	grip.Part0 = hand
	grip.Part1 = handle
	grip.C0 = GRIP
	grip.Parent = handle
	handle.Parent = character
end

-- Sweep the held weapon forward and down in a wide arc, then bring it back.
function Combat.swing(player)
	local character = player.Character
	local handle = character and character:FindFirstChild("HeldWeapon")
	local grip = handle and handle:FindFirstChild("Grip")
	local id, weapon = Combat.weapon(player)
	if not grip or not weapon.swing or handle:GetAttribute("Swinging") then
		return
	end
	handle:SetAttribute("Swinging", true)
	local trail = handle:FindFirstChild("SwingTrail")
	if trail then
		trail.Enabled = true
	end
	local out = math.min(0.16, weapon.cooldown * 0.3)
	local back = math.min(0.22, weapon.cooldown * 0.45)
	local raised = CFrame.Angles(math.rad(35), 0, 0) * GRIP
	local swept = CFrame.Angles(math.rad(-weapon.swing), 0, math.rad(id == "whisk" and 35 or 0)) * GRIP
	grip.C0 = raised
	TweenService:Create(grip, TweenInfo.new(out, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { C0 = swept }):Play()
	task.delay(out + 0.03, function()
		if not grip.Parent then
			return
		end
		TweenService:Create(grip, TweenInfo.new(back, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { C0 = GRIP }):Play()
		task.wait(back)
		if handle.Parent then
			if trail then
				trail.Enabled = false
			end
			handle:SetAttribute("Swinging", false)
		end
	end)
end

-- Choose what to hold. Choosing the weapon already in hand puts it away.
function Combat.chooseWeapon(player, id)
	local profile = PlayerData.get(player)
	if not profile or not Config.Weapons[id] or id == "palm" or (profile.inv[id] or 0) < 1 then
		return
	end
	local current = Combat.weapon(player)
	if current == id then
		profile.weapon = "palm"
		Remotes.notify(player, "You put away the " .. Config.Weapons[id].name .. ". Your hands are open.", "info")
	else
		profile.weapon = id
		Remotes.notify(player, "You take up the " .. Config.Weapons[id].name .. ".", "good")
	end
	Combat.equipWeapon(player)
end

----------------------------------------------------------------------
-- Loops
----------------------------------------------------------------------
local function spotAt(pos)
	for _, s in ipairs(Config.MeditationSpots) do
		local dx, dz = pos.X - s.x, pos.Z - s.z
		if dx * dx + dz * dz <= s.radius * s.radius then
			return s
		end
	end
	return nil
end

local TICK = 0.5

local function tickPlayer(player, now)
	local session = PlayerData.session(player)
	local root = Combat.root(player)
	if not session or not root then
		return
	end
	local regen = 0
	if session.meditating then
		local moved = session.meditateAt and (root.Position - session.meditateAt).Magnitude or 0
		if moved > 4 then
			Combat.setMeditating(player, false)
		else
			regen = Config.Player.MeditateRegen
			if PlayerData.hasPath(player, "concentration") then
				regen = regen * 2
			end
			local spot = spotAt(root.Position)
			if spot then
				Quests.progress(player, "meditate", spot.id, TICK)
			end
			for _, fn in ipairs(meditateHooks) do
				fn(player, root.Position, TICK)
			end
		end
	elseif now - session.lastHurt > Config.Player.HurtRegenDelay then
		regen = Config.Player.PassiveRegen
	end
	if now < session.regenUntil then
		regen = regen + Config.Items.incense.amount
	end
	if regen > 0 then
		Combat.heal(player, regen * TICK)
	end
	Combat.refreshSpeed(player)
end

function Combat.start()
	task.spawn(function()
		while true do
			task.wait(TICK)
			local now = os.clock()
			for _, player in ipairs(Players:GetPlayers()) do
				local ok, err = pcall(tickPlayer, player, now)
				if not ok then
					warn("[Bodhi Path] player tick failed:", err)
				end
			end
		end
	end)

	RunService.Heartbeat:Connect(function(dt)
		moveWheels(dt)
		for i = #projectiles, 1, -1 do
			local p = projectiles[i]
			p.life = p.life - dt
			local pos = p.part.Position + p.dir * p.speed * dt
			p.part.CFrame = CFrame.new(pos)
			local hit = false
			for _, t in ipairs(Combat.targets) do
				if t.alive and t.root and t.root.Parent then
					if (t.root.Position - pos).Magnitude <= 3.5 + (t.hitRadius or 0) then
						Combat.damage(t, p.player, p.damage)
						hit = true
						break
					end
				end
			end
			if hit or p.life <= 0 then
				p.part:Destroy()
				table.remove(projectiles, i)
			end
		end
	end)

	-- when a step of the journey grants the staff, put it in the player's hand
	Quests.onReward(function(player, reward)
		if reward.ability == "staff" then
			PlayerData.give(player, "staff", 1)
			local profile = PlayerData.get(player)
			if profile and profile.weapon == "palm" then
				profile.weapon = "staff"
			end
			Combat.equipWeapon(player)
			PlayerData.push(player)
		end
	end)

	Remotes.onDialog = Combat.beginTalk
end

return Combat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[-- Cosmetics: things that change only how a player looks. Trails that follow behind,
-- small companions that float at the shoulder, and the colours of their sky lanterns.
-- None of them makes the journey easier.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PlayerData = require(script.Parent.PlayerData)

local Cosmetics = {}

local FEET = -2.8 -- how far below the middle of the body the ground is

local function attachment(root, x, y, z)
	local a = Instance.new("Attachment")
	a.Name = "Cosmetic"
	a.Position = Vector3.new(x, y, z)
	a.Parent = root
	return a
end

local function ribbon(root, color, width, life)
	local a0 = attachment(root, -width / 2, FEET, 0.4)
	local a1 = attachment(root, width / 2, FEET, 0.4)
	local trail = Instance.new("Trail")
	trail.Name = "Cosmetic"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = life
	trail.MinLength = 0.1
	trail.LightEmission = 0.8
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
	trail.Parent = root
end

local function drift(root, color, rate, size)
	local e = Instance.new("ParticleEmitter")
	e.Name = "Cosmetic"
	e.Rate = rate
	e.Lifetime = NumberRange.new(1.4, 2.4)
	e.Speed = NumberRange.new(0.4, 1.4)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -2.5, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-120, 120)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 0.3) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Color = ColorSequence.new(color)
	e.LightEmission = 0.3
	e.Parent = attachment(root, 0, FEET + 1.2, 0.8)
end

local Trails = {}

function Trails.trail_petals(root)
	drift(root, Color3.fromRGB(255, 176, 204), 9, 0.45)
end

function Trails.trail_light(root)
	ribbon(root, Color3.fromRGB(255, 236, 190), 1.6, 1.3)
end

function Trails.trail_gold(root)
	ribbon(root, Color3.fromRGB(255, 206, 80), 2.2, 1.8)
	drift(root, Color3.fromRGB(255, 220, 120), 5, 0.25)
end

-- A small thing that floats beside the shoulder.
local function floater(character, root, size, color, material)
	local p = Instance.new("Part")
	p.Name = "CosmeticPart"
	p.Shape = Enum.PartType.Ball
	p.Size = size
	p.Color = color
	p.Material = material
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.CastShadow = false
	p.CFrame = root.CFrame * CFrame.new(1.9, 2.5, 0.5)
	local weld = Instance.new("Weld")
	weld.Part0 = root
	weld.Part1 = p
	weld.C0 = CFrame.new(1.9, 2.5, 0.5)
	weld.Parent = p
	p.Parent = character
	return p
end

local function wing(body, side, color)
	local w = Instance.new("Part")
	w.Name = "Wing"
	w.Size = Vector3.new(0.7, 0.05, 0.6)
	w.Color = color
	w.Material = Enum.Material.Neon
	w.CanCollide = false
	w.CanTouch = false
	w.CanQuery = false
	w.Massless = true
	w.CastShadow = false
	w.CFrame = body.CFrame * CFrame.new(side * 0.36, 0.1, 0) * CFrame.Angles(0, 0, math.rad(side * 28))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = w
	weld.Parent = w
	w.Parent = body
end

local Companions = {}

function Companions.firefly(character, root)
	local body = floater(character, root, Vector3.new(0.36, 0.36, 0.36), Color3.fromRGB(226, 255, 130), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(226, 255, 150)
	light.Range = 12
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = body
	local e = Instance.new("ParticleEmitter")
	e.Rate = 4
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(0.2, 0.8)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0) })
	e.Color = ColorSequence.new(Color3.fromRGB(226, 255, 150))
	e.LightEmission = 1
	e.Parent = body
end

function Companions.butterfly(character, root)
	local body = floater(character, root, Vector3.new(0.2, 0.2, 0.2), Color3.fromRGB(60, 40, 30), Enum.Material.SmoothPlastic)
	wing(body, -1, Color3.fromRGB(255, 160, 60))
	wing(body, 1, Color3.fromRGB(255, 160, 60))
end

-- Put on (or take off) whatever the player has chosen to wear.
function Cosmetics.apply(player)
	local profile = PlayerData.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not profile or not root then
		return
	end
	for _, child in ipairs(root:GetChildren()) do
		if child.Name == "Cosmetic" then
			child:Destroy()
		end
	end
	for _, child in ipairs(character:GetChildren()) do
		if child.Name == "CosmeticPart" then
			child:Destroy()
		end
	end
	local worn = profile.worn or {}
	local trail = worn.trail
	if trail and Trails[trail] and (profile.inv[trail] or 0) > 0 then
		Trails[trail](root)
	end
	local companion = worn.companion
	if companion and Companions[companion] and (profile.inv[companion] or 0) > 0 then
		Companions[companion](character, root)
	end
end

-- Wear this item, or take it off if it is already on.
function Cosmetics.toggle(player, itemId)
	local profile = PlayerData.get(player)
	local def = Config.Items[itemId]
	if not profile or not def or not def.slot or (profile.inv[itemId] or 0) < 1 then
		return
	end
	if profile.worn[def.slot] == itemId then
		profile.worn[def.slot] = nil
	else
		profile.worn[def.slot] = itemId
	end
	Cosmetics.apply(player)
end

-- One of the lantern colours this player owns, or nil for the ordinary warm colours.
function Cosmetics.lanternColor(player, rng)
	local profile = PlayerData.get(player)
	if not profile then
		return nil
	end
	local owned = {}
	for id, def in pairs(Config.Items) do
		if def.lanternColor and (profile.inv[id] or 0) > 0 then
			table.insert(owned, def.lanternColor)
		end
	end
	if #owned == 0 then
		return nil
	end
	table.sort(owned, function(a, b)
		return a[1] * 65536 + a[2] * 256 + a[3] < b[1] * 65536 + b[2] * 256 + b[3]
	end)
	local c = owned[rng:NextInteger(1, #owned)]
	return Color3.fromRGB(c[1], c[2], c[3])
end

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Enemies</string><ProtectedString name="Source"><![CDATA[-- Enemies: Mara's ten armies and his three daughters.
-- Soldiers appear only where players are nearby, chase them, and wear down their Calm.
-- Each army has its own character: Hunger drains you from a distance, Sloth slows you,
-- Doubt never stays where you look for it, and so on (see Config.Enemies).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local PlayerData = require(script.Parent.PlayerData)
local Quests = require(script.Parent.Quests)
local Combat = require(script.Parent.Combat)
local Rig = require(script.Parent.Rig)
local Kit = require(script.Parent.Kit)

local Enemies = {}

local MAX_ALIVE = 36
local WAKE_DISTANCE = 230
local SLEEP_DISTANCE = 330
local AGGRO = 70
local LEASH = 120

local folder = nil
local spawns = {}
local alive = {}
local rng = Random.new()

local function playerPositions()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local pos = Combat.position(player)
		if pos then
			table.insert(list, { player = player, pos = pos })
		end
	end
	return list
end

local function glowColor(cfg)
	return Color3.fromRGB(cfg.glow[1], cfg.glow[2], cfg.glow[3])
end

-- Reward everyone who helped, and count it toward their journey.
local function reward(enemy)
	local cfg = enemy.cfg
	for player in pairs(enemy.tagged) do
		if player.Parent and PlayerData.get(player) then
			local pos = Combat.position(player)
			if pos and (pos - enemy.lastPos).Magnitude < 160 then
				PlayerData.addMerit(player, cfg.merit or 5)
				local profile = PlayerData.get(player)
				profile.dispelled = profile.dispelled + 1
				Quests.progress(player, "dispel", enemy.typeId)
				if enemy.group then
					Quests.progress(player, "dispel", enemy.group)
				end
			end
		end
	end
end

local function remove(enemy)
	Combat.removeTarget(enemy)
	for i, other in ipairs(alive) do
		if other == enemy then
			table.remove(alive, i)
			break
		end
	end
	if enemy.spawn then
		for i, other in ipairs(enemy.spawn.alive) do
			if other == enemy then
				table.remove(enemy.spawn.alive, i)
				break
			end
		end
	end
	if enemy.model then
		enemy.model:Destroy()
	end
end

-- Create one soldier. Returns the enemy record (which is also a Combat target).
function Enemies.create(typeId, x, z, spawn, options)
	local cfg = Config.Enemies[typeId]
	options = options or {}
	local model, hum = Rig.make(cfg.name, "enemy", cfg)
	local hp = math.floor(cfg.hp * (options.hpScale or 1))
	hum.MaxHealth = hp
	hum.Health = hp
	hum.WalkSpeed = cfg.speed
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	hum.NameDisplayDistance = 60
	hum.HealthDisplayDistance = 60
	Rig.place(model, Kit.at(x, z, rng:NextNumber(0, 360)), folder)
	Rig.animate(model, true)
	local root = model:FindFirstChild("HumanoidRootPart")
	local enemy = {
		typeId = typeId,
		cfg = cfg,
		model = model,
		hum = hum,
		root = root,
		hp = hp,
		maxHp = hp,
		home = Vector3.new(x, 0, z),
		spawn = spawn,
		group = options.group or (spawn and spawn.def.group) or nil,
		hitRadius = 1.5 * (cfg.scale or 1),
		big = cfg.daughter or false,
		stunUntil = 0,
		nextAttack = 0,
		nextSpecial = 0,
		nextWander = 0,
		lastPos = root.Position,
		temporary = options.temporary or false,
	}
	enemy.onDefeat = function(self)
		self.lastPos = self.root.Position
		Remotes.fx("petals", { pos = self.root.Position, color = glowColor(cfg), big = self.big })
		reward(self)
		if self.spawn then
			self.spawn.nextRespawn = os.clock() + (self.spawn.def.respawn or 22)
		end
		if options.onDefeat then
			options.onDefeat(self)
		end
		remove(self)
	end
	Combat.addTarget(enemy)
	table.insert(alive, enemy)
	if spawn then
		table.insert(spawn.alive, enemy)
	end
	return enemy
end

function Enemies.remove(enemy)
	remove(enemy)
end

function Enemies.count()
	return #alive
end

----------------------------------------------------------------------
-- Behaviour
----------------------------------------------------------------------
local function think(enemy, now, players)
	local root, hum, cfg = enemy.root, enemy.hum, enemy.cfg
	if not root.Parent or root.Position.Y < -60 then
		remove(enemy)
		return
	end
	local pos = root.Position
	enemy.lastPos = pos
	if now < enemy.stunUntil then
		hum.WalkSpeed = 0
		return
	end

	-- choose the nearest player who can be reached
	local target, targetPos, best = nil, nil, AGGRO
	for _, entry in ipairs(players) do
		local d = (entry.pos - pos).Magnitude
		if d < best and (entry.pos - enemy.home).Magnitude < LEASH and Combat.canBeTargeted(entry.player) then
			target, targetPos, best = entry.player, entry.pos, d
		end
	end

	if not target then
		hum.WalkSpeed = cfg.speed * 0.5
		if now >= enemy.nextWander then
			enemy.nextWander = now + rng:NextNumber(3, 7)
			local a = rng:NextNumber(0, math.pi * 2)
			local r = rng:NextNumber(2, (enemy.spawn and enemy.spawn.def.radius) or 12)
			hum:MoveTo(enemy.home + Vector3.new(math.cos(a) * r, pos.Y, math.sin(a) * r))
		end
		return
	end

	hum.WalkSpeed = cfg.speed * ((now < (enemy.slowUntil or 0)) and 0.4 or 1)
	local reach = cfg.range * (cfg.scale or 1) * 0.8 + 2
	if best > reach then
		hum:MoveTo(targetPos)
	else
		hum:MoveTo(pos)
		if now >= enemy.nextAttack then
			enemy.nextAttack = now + 1.5
			if Combat.hurt(target, cfg.dmg) then
				if cfg.special == "slow" then
					Combat.slow(target, 3.5)
				elseif cfg.special == "steal" then
					local profile = PlayerData.get(target)
					if profile and profile.merit > 0 then
						PlayerData.addMerit(target, -math.min(4, profile.merit), true)
						Remotes.notify(target, "Gain and Fame took a little of your merit.", "warn")
					end
				end
			end
		end
	end

	-- special behaviours
	if cfg.special == "drain" and best < 22 and now >= enemy.nextSpecial then
		enemy.nextSpecial = now + 1
		Combat.hurt(target, enemy.big and 4 or 2)
	elseif cfg.special == "pull" and best < 26 then
		Combat.slow(target, 0.8)
	elseif cfg.special == "blink" and best > 12 and now >= enemy.nextSpecial then
		enemy.nextSpecial = now + (enemy.big and 4 or 5.5)
		local a = rng:NextNumber(0, math.pi * 2)
		local dest = targetPos + Vector3.new(math.cos(a) * 7, 0, math.sin(a) * 7)
		Remotes.fx("ring", { pos = pos, radius = 5, color = glowColor(cfg), time = 0.4 })
		enemy.model:PivotTo(CFrame.new(dest.X, pos.Y + 0.5, dest.Z))
		Remotes.fx("ring", { pos = dest, radius = 5, color = glowColor(cfg), time = 0.4 })
	end
end

local function manage(now, players)
	for _, spawn in ipairs(spawns) do
		local def = spawn.def
		local nearest = math.huge
		for _, entry in ipairs(players) do
			local dx, dz = entry.pos.X - def.x, entry.pos.Z - def.z
			local d = math.sqrt(dx * dx + dz * dz)
			if d < nearest then
				nearest = d
			end
		end
		if nearest < WAKE_DISTANCE then
			if #spawn.alive < def.count and now >= spawn.nextRespawn and #alive < MAX_ALIVE then
				local a = rng:NextNumber(0, math.pi * 2)
				local r = rng:NextNumber(0, def.radius)
				Enemies.create(def.type, def.x + math.cos(a) * r, def.z + math.sin(a) * r, spawn)
				spawn.nextRespawn = now + 0.6
			end
		elseif nearest > SLEEP_DISTANCE and #spawn.alive > 0 then
			for i = #spawn.alive, 1, -1 do
				remove(spawn.alive[i])
			end
		end
	end
end

function Enemies.start()
	folder = Kit.folder(workspace, "Shadows")
	for _, def in ipairs(Config.Spawns) do
		table.insert(spawns, { def = def, alive = {}, nextRespawn = 0 })
	end
	task.spawn(function()
		while true do
			task.wait(0.3)
			local now = os.clock()
			local players = playerPositions()
			local ok, err = pcall(manage, now, players)
			if not ok then
				warn("[Bodhi Path] spawn manager failed:", err)
			end
			for i = #alive, 1, -1 do
				local enemy = alive[i]
				if enemy and enemy.alive then
					local ok2, err2 = pcall(think, enemy, now, players)
					if not ok2 then
						warn("[Bodhi Path] enemy failed:", err2)
						remove(enemy)
					end
				end
			end
		end
	end)
end

return Enemies
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Garden</string><ProtectedString name="Source"><![CDATA[-- Garden: the Pilgrims' Garden, a quiet corner of the temple compound where players
-- can meet. Nothing here is part of the story and no shadow comes near it.
--   * a tea pavilion with cushions to sit on, and a pot of tea to pour for friends
--   * five song bells and a drum that anyone can play
--   * sky lanterns to release
--   * a meditation circle that gives merit only when people sit there together

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)

local C = Kit.C
local M = Enum.Material

local Garden = {}

local CENTRE = { x = -28, z = -94 }
local TEA = { x = -46, z = -94 }
local CIRCLE = { x = -10, z = -96 }
local CIRCLE_RADIUS = 13

local SOFT = { collide = false, shadow = false }

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

-- A cushion or bench that a player can really sit on.
local function seat(parent, cf, size, color)
	local s = Instance.new("Seat")
	s.Name = "Cushion"
	s.Anchored = true
	s.Size = size
	s.Color = color
	s.Material = M.Fabric
	s.CFrame = cf
	s.Parent = parent
	return s
end

----------------------------------------------------------------------
-- Building the garden (called while the world is being made)
----------------------------------------------------------------------
function Garden.build(ctx, parent)
	local root = Kit.folder(parent, "PilgrimsGarden")
	local things = { bells = {} }

	-- keep trees and flowers out of the garden and off its path
	ctx.reserve(CENTRE.x, CENTRE.z, 31)
	for _, z in ipairs({ -42, -50, -58, -66 }) do
		ctx.reserve(CENTRE.x, z, 6)
	end

	-- the path from the courtyard, and a small paved square in the middle
	ctx.pave(CENTRE.x - 4, CENTRE.x + 4, -70, -36, M.Limestone)
	ctx.pave(CENTRE.x - 9, CENTRE.x + 9, CENTRE.z - 9, CENTRE.z + 9, M.Limestone)
	Props.signpost(root, Kit.at(CENTRE.x + 7, -39, 0), "Pilgrims' Garden")
	Props.flags(root, V(CENTRE.x - 22, 13, -70), V(CENTRE.x + 22, 13, -70), true)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			Props.lantern(root, Kit.at(CENTRE.x + sx * 11, CENTRE.z + sz * 11, 0))
		end
	end

	-- two benches beside the way in
	for _, sx in ipairs({ -1, 1 }) do
		local x = CENTRE.x + sx * 10
		seat(root, CFrame.new(x, 1.7, -76) * CFrame.Angles(0, math.rad(180), 0), V(7, 0.5, 2.2), C.wood).Material = M.WoodPlanks
		Kit.block(root, CFrame.new(x - 3, 0.75, -76), V(0.5, 1.5, 2), C.woodDark, M.Wood)
		Kit.block(root, CFrame.new(x + 3, 0.75, -76), V(0.5, 1.5, 2), C.woodDark, M.Wood)
	end

	-- the tea pavilion
	do
		local o = Kit.at(TEA.x, TEA.z, 0)
		Kit.cyl(root, o * CFrame.new(0, 0.4, 0), 19, 0.8, C.wood, M.WoodPlanks)
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2 + math.pi / 6
			Kit.cyl(root, o * CFrame.new(math.cos(a) * 8.4, 5.6, math.sin(a) * 8.4), 0.8, 9.6, C.woodRed, M.Wood)
		end
		Kit.cyl(root, o * CFrame.new(0, 10.6, 0), 21, 0.6, C.woodDark, M.Wood, { collide = false })
		Kit.blob(root, o * CFrame.new(0, 12.6, 0), V(23, 5, 23), C.tileTeal, M.Slate, { collide = false })
		Kit.ball(root, o * CFrame.new(0, 15.6, 0), 1.6, C.goldBright, M.Metal, SOFT)
		-- the low table and the teapot
		Kit.cyl(root, o * CFrame.new(0, 1.4, 0), 5.4, 1.2, C.woodDark, M.Wood)
		local pot = Kit.ball(root, o * CFrame.new(0, 2.7, 0), 1.5, C.bronze, M.Metal, SOFT)
		Kit.block(root, o * CFrame.new(0.95, 2.8, 0) * CFrame.Angles(0, 0, math.rad(-35)), V(0.9, 0.22, 0.22), C.bronze, M.Metal, SOFT)
		Kit.ball(root, o * CFrame.new(0, 3.55, 0), 0.4, C.gold, M.Metal, SOFT)
		Kit.smoke(pot, Color3.fromRGB(240, 240, 240))
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			Kit.cyl(root, o * CFrame.new(math.cos(a) * 1.9, 2.15, math.sin(a) * 1.9), 0.5, 0.3, C.ivory, M.SmoothPlastic, SOFT)
			local at = (o * CFrame.new(math.cos(a) * 5.4, 1.1, math.sin(a) * 5.4)).Position
			seat(root, CFrame.new(at, V(o.Position.X, at.Y, o.Position.Z)), V(2.6, 0.6, 2.6), (i % 2 == 0) and C.maroon or C.saffron)
		end
		local lamp = Kit.ball(root, o * CFrame.new(0, 9.4, 0), 1, Color3.fromRGB(255, 214, 150), M.Neon, SOFT)
		Kit.light(lamp, Color3.fromRGB(255, 205, 140), 30, 1.2)
		things.teapot = pot
	end

	-- the meditation circle: eight cushions around a stone lantern
	do
		Kit.cyl(root, CFrame.new(CIRCLE.x, 0.15, CIRCLE.z), 22, 0.3, C.sandstoneLight, M.Sandstone)
		Props.lantern(root, Kit.at(CIRCLE.x, CIRCLE.z, 0))
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			Kit.cyl(root, CFrame.new(CIRCLE.x + math.cos(a) * 8, 0.5, CIRCLE.z + math.sin(a) * 8), 3, 0.5, (i % 2 == 0) and C.saffron or C.maroon, M.Fabric)
		end
		things.circle = V(CIRCLE.x, 0, CIRCLE.z)
	end

	-- the song bells: five bells on a frame, low note to high note
	do
		local z = CENTRE.z - 21
		Kit.cyl(root, CFrame.new(CENTRE.x - 9, 3.5, z), 0.7, 7, C.woodRed, M.Wood)
		Kit.cyl(root, CFrame.new(CENTRE.x + 9, 3.5, z), 0.7, 7, C.woodRed, M.Wood)
		Kit.block(root, CFrame.new(CENTRE.x, 7.2, z), V(19.4, 0.6, 0.8), C.woodRed, M.Wood)
		for i = 1, 5 do
			local x = CENTRE.x - 9 + i * 3
			local size = 2.3 - i * 0.22
			Kit.block(root, CFrame.new(x, 6.5, z), V(0.12, 1, 0.12), C.woodDark, M.Wood, SOFT)
			local bell = Kit.cyl(root, CFrame.new(x, 6 - size / 2, z), size, size, C.gold, M.Metal, { collide = false })
			Kit.ball(root, CFrame.new(x, 6 - size - 0.15, z), 0.45, C.bronze, M.Metal, SOFT)
			table.insert(things.bells, bell)
		end
		-- the drum
		local dx = CENTRE.x + 15
		Kit.cyl(root, CFrame.new(dx, 0.6, z + 2), 3.2, 1.2, C.woodDark, M.Wood)
		local drum = Kit.cyl(root, CFrame.new(dx, 2.6, z + 2), 4.4, 2.8, C.woodRed, M.Wood)
		Kit.cyl(root, CFrame.new(dx, 4.05, z + 2), 4.2, 0.1, C.ivory, M.Fabric, SOFT)
		things.drum = drum
	end

	-- the lantern table in the middle of the square
	do
		local table_ = Kit.cyl(root, CFrame.new(CENTRE.x, 1.2, CENTRE.z), 4.6, 2.4, C.woodDark, M.Wood)
		for i = 0, 2 do
			local a = i / 3 * math.pi * 2
			local paper = Kit.block(root, CFrame.new(CENTRE.x + math.cos(a) * 1.1, 3.3, CENTRE.z + math.sin(a) * 1.1), V(1.1, 1.6, 1.1), Color3.fromRGB(255, 214, 150), M.Neon, SOFT)
			if i == 0 then
				Kit.light(paper, Color3.fromRGB(255, 200, 120), 20, 1.2)
			end
		end
		things.lanternTable = table_
	end

	-- the garland-maker's stall
	Props.stall(root, Kit.at(4, -116, Kit.FACE_POS_Z), C.lotusPink, { C.lotusPink, C.lotusWhite, C.saffron, C.flagYellow })
	ctx.reserve(4, -113, 9)

	ctx.objects.garden = things
	return root
end

----------------------------------------------------------------------
-- Using the garden (called once the game is running)
----------------------------------------------------------------------
local NOTES = { 1, 1.122, 1.26, 1.498, 1.682 } -- a five-note scale, so anything played sounds pleasant
local LANTERN_COLORS = {
	Color3.fromRGB(255, 206, 130), Color3.fromRGB(255, 170, 110), Color3.fromRGB(255, 226, 170),
	Color3.fromRGB(255, 150, 140), Color3.fromRGB(250, 190, 90),
}

function Garden.start(objects)
	local things = objects.garden
	if not things then
		return
	end
	local Remotes = require(script.Parent.Remotes)
	local PlayerData = require(script.Parent.PlayerData)
	local Combat = require(script.Parent.Combat)
	local Cosmetics = require(script.Parent.Cosmetics)
	local rng = Random.new()

	-- song bells
	for i, bell in ipairs(things.bells) do
		local prompt = Kit.prompt(bell, "Ring", "Song Bell", 8)
		prompt.Triggered:Connect(function()
			Remotes.fx("note", { pos = bell.Position, pitch = NOTES[i] or 1 })
			Remotes.fx("ring", { pos = bell.Position, radius = 4, color = Color3.fromRGB(255, 226, 150), time = 0.5 })
		end)
	end

	-- the drum
	if things.drum then
		local prompt = Kit.prompt(things.drum, "Beat", "Garden Drum", 9)
		prompt.Triggered:Connect(function()
			Remotes.fx("drum", { pos = things.drum.Position })
			Remotes.fx("ring", { pos = things.drum.Position + Vector3.new(0, 2, 0), radius = 6, color = Color3.fromRGB(255, 150, 110), time = 0.35 })
		end)
	end

	-- tea, poured for everyone sitting near
	if things.teapot then
		local prompt = Kit.prompt(things.teapot, "Pour tea", "Teapot", 10)
		prompt.Triggered:Connect(function(player)
			local session = PlayerData.session(player)
			if not session then
				return
			end
			local now = os.clock()
			if now < (session.teaAt or 0) then
				Remotes.notify(player, "The pot is still steeping. Give it a moment.", "info")
				return
			end
			session.teaAt = now + 45
			Combat.heal(player, 30)
			local friends = 0
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player then
					local pos = Combat.position(other)
					if pos and (pos - things.teapot.Position).Magnitude <= 18 then
						friends = friends + 1
						Combat.heal(other, 30)
						Remotes.notify(other, player.DisplayName .. " pours you a cup of tea.", "good")
					end
				end
			end
			if friends > 0 then
				PlayerData.addMerit(player, math.min(6, friends * 2))
				Remotes.notify(player, "You pour tea for " .. friends .. (friends == 1 and " friend." or " friends."), "good")
			else
				Remotes.notify(player, "You pour yourself a cup of tea. It is better shared.", "info")
			end
		end)
	end

	-- sky lanterns
	if things.lanternTable then
		local flying = 0
		local prompt = Kit.prompt(things.lanternTable, "Release a sky lantern", "Lantern Table", 10)
		prompt.Triggered:Connect(function(player)
			local session = PlayerData.session(player)
			if not session then
				return
			end
			local now = os.clock()
			if now < (session.lanternAt or 0) or flying >= 24 then
				return
			end
			session.lanternAt = now + 4
			flying = flying + 1
			local start = things.lanternTable.Position + Vector3.new(rng:NextNumber(-3, 3), 4, rng:NextNumber(-3, 3))
			local lantern = Instance.new("Part")
			lantern.Name = "SkyLantern"
			lantern.Size = Vector3.new(1.6, 2.2, 1.6)
			lantern.Material = Enum.Material.Neon
			lantern.Color = Cosmetics.lanternColor(player, rng) or LANTERN_COLORS[rng:NextInteger(1, #LANTERN_COLORS)]
			lantern.Anchored = true
			lantern.CanCollide = false
			lantern.CanTouch = false
			lantern.CanQuery = false
			lantern.CastShadow = false
			lantern.CFrame = CFrame.new(start)
			Kit.light(lantern, lantern.Color, 18, 1.4)
			lantern.Parent = workspace
			local drift = Vector3.new(rng:NextNumber(-45, 45), rng:NextNumber(130, 170), rng:NextNumber(-45, 45))
			TweenService:Create(lantern, TweenInfo.new(32, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = CFrame.new(start + drift) }):Play()
			task.delay(28, function()
				if lantern.Parent then
					TweenService:Create(lantern, TweenInfo.new(4), { Transparency = 1 }):Play()
				end
			end)
			task.delay(32.5, function()
				lantern:Destroy()
				flying = flying - 1
			end)
		end)
	end

	-- the meditation circle: merit comes only from sitting with others
	if things.circle then
		Combat.onMeditateTick(function(player, pos, dt)
			local flat = Vector3.new(pos.X - things.circle.X, 0, pos.Z - things.circle.Z)
			if flat.Magnitude > CIRCLE_RADIUS then
				return
			end
			local session = PlayerData.session(player)
			if not session then
				return
			end
			session.circleTime = (session.circleTime or 0) + dt
			if session.circleTime < 15 then
				return
			end
			session.circleTime = 0
			local companions = 0
			for _, other in ipairs(Players:GetPlayers()) do
				local theirs = other ~= player and PlayerData.session(other)
				local at = theirs and theirs.meditating and Combat.position(other)
				if at and Vector3.new(at.X - things.circle.X, 0, at.Z - things.circle.Z).Magnitude <= CIRCLE_RADIUS then
					companions = companions + 1
				end
			end
			if companions > 0 then
				PlayerData.addMerit(player, math.min(4, companions))
				if not session.circleTold then
					session.circleTold = true
					Remotes.notify(player, "You are sitting together. Each companion in the circle adds merit.", "good")
				end
			elseif not session.circleTold then
				session.circleTold = true
				Remotes.notify(player, "The circle is for sitting together. When others meditate here with you, everyone earns merit.", "info")
			end
		end)
	end
end

return Garden
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Interact</string><ProtectedString name="Source"><![CDATA[-- Interact: everything a player can use in the world or choose in a window.
-- The temple bell, prayer wheels, shrines, things to pick up, the shops, robes,
-- the Eightfold Path, and using items from the Bag.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Story = require(Shared:WaitForChild("Story"))
local Remotes = require(script.Parent.Remotes)
local PlayerData = require(script.Parent.PlayerData)
local Quests = require(script.Parent.Quests)
local Combat = require(script.Parent.Combat)
local Robes = require(script.Parent.Robes)
local Kit = require(script.Parent.Kit)
local Garden = require(script.Parent.Garden)
local Cosmetics = require(script.Parent.Cosmetics)
local Robux = require(script.Parent.Robux)

local Interact = {}

local function livelihood(player, amount)
	if PlayerData.hasPath(player, "livelihood") then
		return amount * 2
	end
	return amount
end

local function nearShrine(player, distance)
	local pos = Combat.position(player)
	if not pos then
		return nil
	end
	for _, s in ipairs(Config.Shrines) do
		local dx, dz = pos.X - s.x, pos.Z - s.z
		if dx * dx + dz * dz <= distance * distance then
			return s
		end
	end
	return nil
end

local function countOf(list)
	local n = 0
	for _ in pairs(list) do
		n = n + 1
	end
	return n
end

local function leafCount(profile)
	return countOf(profile.leaves)
end

local symbolById = {}
for _, def in ipairs(Config.Symbols) do
	symbolById["symbol_" .. def.id] = def
end
local animalById = {}
for _, def in ipairs(Config.Animals) do
	animalById["animal_" .. def.id] = def
end

local function foundSymbol(player, profile, def)
	if not profile.symbols[def.id] then
		profile.symbols[def.id] = true
		PlayerData.addMerit(player, 15)
		local n = countOf(profile.symbols)
		Remotes.notify(player, "Auspicious symbols found: " .. n .. " of " .. #Config.Symbols, "good")
		if n >= #Config.Symbols and (profile.inv.wisdom_sword or 0) < 1 then
			PlayerData.give(player, "wisdom_sword", 1)
			profile.weapon = "wisdom_sword"
			Combat.equipWeapon(player)
			Remotes.notify(player, "You have found all eight symbols. The Sword of Wisdom is yours.", "good")
		end
		PlayerData.push(player)
	end
	Remotes.dialog(player, { { def.name, def.text } }, def.name)
end

local function wheelGift(player, profile)
	if countOf(profile.friends) >= #Config.Animals and (profile.inv.chakra or 0) < 1 then
		PlayerData.give(player, "chakra", 1)
		profile.weapon = "chakra"
		Combat.equipWeapon(player)
		Remotes.notify(player, "The animals have given you the Wheel of Light.", "good")
		PlayerData.push(player)
	end
end

local function metAnimal(player, profile, session, def)
	wheelGift(player, profile)
	local known = profile.friends[def.id]
	local tale = { { def.name, def.text }, { "", "(" .. def.source .. ", retold)" } }
	if PlayerData.count(player, "rice") < 1 then
		if known then
			Remotes.dialog(player, tale, def.name)
		else
			Remotes.notify(player, def.name .. " watches you hopefully. Bring some Alms Rice to share.", "info")
		end
		return
	end
	local now = os.clock()
	if known and now < (session.fed[def.id] or 0) then
		Remotes.dialog(player, tale, def.name)
		return
	end
	PlayerData.take(player, "rice", 1)
	session.fed[def.id] = now + 300
	if known then
		PlayerData.addMerit(player, livelihood(player, 3))
		Remotes.notify(player, "You share your rice with " .. def.name .. ".", "good")
	else
		profile.friends[def.id] = true
		PlayerData.addMerit(player, 20)
		local n = countOf(profile.friends)
		Remotes.notify(player, "Animal friends: " .. n .. " of " .. #Config.Animals, "good")
		if n >= #Config.Animals and not profile.bought.all_friends then
			profile.bought.all_friends = true
			profile.bonusCalm = profile.bonusCalm + 20
			PlayerData.refreshCalm(player)
			Remotes.notify(player, "Every animal of the old stories is your friend. Your Calm grows by 20.", "good")
		end
		wheelGift(player, profile)
		Remotes.dialog(player, tale, def.name)
	end
	PlayerData.push(player)
end

----------------------------------------------------------------------
-- World objects
----------------------------------------------------------------------
local function setupBell(objects)
	if not objects.bell then
		return
	end
	local prompt = Kit.prompt(objects.bell, "Ring", "Temple Bell", 14)
	local swinging = false
	prompt.Triggered:Connect(function(player)
		local session = PlayerData.session(player)
		if not session then
			return
		end
		if not swinging and objects.striker then
			swinging = true
			local home = objects.striker.CFrame
			local tween = TweenService:Create(objects.striker, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = home * CFrame.new(-2.2, 0, 0) })
			tween:Play()
			task.delay(0.3, function()
				TweenService:Create(objects.striker, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { CFrame = home }):Play()
				task.wait(0.7)
				swinging = false
			end)
		end
		Remotes.fx("bell", { pos = objects.bell.Position })
		Remotes.fx("ring", { pos = objects.bell.Position - Vector3.new(0, 5, 0), radius = 26, color = Color3.fromRGB(255, 220, 130), time = 1.4 })
		if not Quests.progress(player, "interact", "temple_bell") then
			local now = os.clock()
			if now >= (session.bellAt or 0) then
				session.bellAt = now + 60
				PlayerData.addMerit(player, livelihood(player, 2))
			end
		end
	end)
end

local function setupWheels(objects)
	for index, core in ipairs(objects.wheels) do
		local prompt = Kit.prompt(core, "Spin", "Prayer Wheel", 9)
		local spinning = false
		prompt.Triggered:Connect(function(player)
			local session = PlayerData.session(player)
			if not session then
				return
			end
			if not spinning then
				spinning = true
				task.spawn(function()
					for _ = 1, 6 do
						local tween = TweenService:Create(core, TweenInfo.new(0.22, Enum.EasingStyle.Linear), { CFrame = core.CFrame * CFrame.Angles(math.rad(-120), 0, 0) })
						tween:Play()
						task.wait(0.22)
					end
					spinning = false
				end)
			end
			Remotes.fx("wheel", { pos = core.Position })
			local now = os.clock()
			if now >= (session.wheels[index] or 0) then
				session.wheels[index] = now + 45
				PlayerData.addMerit(player, livelihood(player, 1))
			end
		end)
	end
end

local function setupShrines(objects)
	for _, s in ipairs(Config.Shrines) do
		local part = objects.shrines[s.id]
		if part then
			local prompt = Kit.prompt(part, "Pray", s.name, 14)
			prompt.Triggered:Connect(function(player)
				local profile = PlayerData.get(player)
				if not profile then
					return
				end
				local first = not profile.shrines[s.id]
				profile.shrines[s.id] = true
				profile.checkpoint = s.id
				player:SetAttribute("Calm", PlayerData.maxCalm(player))
				if first then
					Remotes.notify(player, "Shrine found: " .. s.name .. ". You will return here if you are overwhelmed.", "good")
					PlayerData.addMerit(player, 5)
				end
				local today = math.floor(os.time() / 86400)
				if profile.lastDaily ~= today then
					profile.lastDaily = today
					PlayerData.addMerit(player, 40)
					Remotes.notify(player, "Daily devotion: your first prayer of the day.", "good")
				end
				PlayerData.push(player)
				Remotes.UI:FireClient(player, "shrine", s.id)
			end)
		end
	end
end

local function setupStoryPlaces(objects)
	if objects.hair_rock then
		local prompt = Kit.prompt(objects.hair_rock, "Leave your old life", "The Flat Rock", 14, 0.8)
		prompt.Triggered:Connect(function(player)
			if not Quests.progress(player, "interact", "hair_rock") then
				Remotes.dialog(player, { { "", "Silk, a crown, and a sword lie on the rock where the prince left them. He never came back for them." } })
			end
		end)
	end

	if objects.bowl_river then
		local prompt = Kit.prompt(objects.bowl_river, "Set the bowl on the water", "The Neranjara", 14, 0.8)
		local busy = false
		prompt.Triggered:Connect(function(player)
			if not Quests.active(player, "interact", "bowl_river") then
				Remotes.dialog(player, { { "", "The river slides by. Somewhere beneath it, the old stories say, a golden bowl rests in the palace of the naga king." } })
				return
			end
			PlayerData.take(player, "golden_bowl", 1)
			if not busy then
				busy = true
				local start = objects.bowl_river.Position
				local bowl = Kit.blob(workspace, CFrame.new(start.X + 8, -1.7, start.Z), Vector3.new(2.6, 1.2, 2.6), Kit.C.goldBright, Enum.Material.Metal, { collide = false })
				Kit.sparkle(bowl, Kit.C.goldBright, 14)
				local tween = TweenService:Create(bowl, TweenInfo.new(6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(start.X + 26, -1.7, start.Z - 110) })
				tween:Play()
				task.delay(6, function()
					TweenService:Create(bowl, TweenInfo.new(2), { CFrame = CFrame.new(start.X + 26, -9, start.Z - 118) }):Play()
					task.wait(2.2)
					bowl:Destroy()
					busy = false
				end)
			end
			Quests.progress(player, "interact", "bowl_river")
		end)
	end

	if objects.seat then
		local prompt = Kit.prompt(objects.seat, "Spread the kusa grass", "The Diamond Seat", 14, 1)
		prompt.Triggered:Connect(function(player)
			if Quests.active(player, "interact", "vajrasana") then
				if PlayerData.count(player, "kusa") < 8 then
					Remotes.notify(player, "You need eight handfuls of kusa grass.", "warn")
					return
				end
				PlayerData.take(player, "kusa", 8)
				Quests.progress(player, "interact", "vajrasana")
			elseif Quests.reached(player, "watch1") then
				Remotes.dialog(player, { { "", "The Vajrasana, the Diamond Seat. Sit here and meditate (M)." } })
			else
				Remotes.dialog(player, { { "", "A slab of polished stone at the foot of the great tree. It seems to be waiting for someone." } })
			end
		end)
	end
end

local function setupCollectibles(objects)
	for _, item in ipairs(objects.collectibles) do
		item.prompt.Triggered:Connect(function(player)
			local profile = PlayerData.get(player)
			local session = PlayerData.session(player)
			if not profile or not session then
				return
			end
			Remotes.fxTo(player, "pickup", {})
			if item.kind == "leaf" then
				local index = tonumber(string.sub(item.id, 6)) or 1
				local teaching = Story.Teachings[index] or Story.Teachings[1]
				local lines = { { "A Bodhi Leaf", teaching.text }, { "", "(" .. teaching.source .. ", paraphrased)" } }
				if not profile.leaves[item.id] then
					profile.leaves[item.id] = true
					PlayerData.addMerit(player, 10)
					local n = leafCount(profile)
					Remotes.notify(player, "Bodhi leaves found: " .. n .. " of " .. #Config.Leaves, "good")
					if n >= #Config.Leaves and not profile.robes.pilgrim then
						profile.robes.pilgrim = true
						Remotes.notify(player, "You have found every leaf. The Pilgrim's Robe is yours.", "good")
					end
					PlayerData.push(player)
				end
				Remotes.dialog(player, lines, "A Bodhi Leaf")
			elseif item.kind == "kusa" then
				if profile.collected[item.id] then
					Remotes.notify(player, "You have already gathered this grass.", "info")
				elseif Quests.active(player, "collect", "kusa") then
					profile.collected[item.id] = true
					PlayerData.give(player, "kusa", 1)
					Quests.progress(player, "collect", "kusa")
					PlayerData.push(player)
				else
					Remotes.notify(player, "Kusa grass. Sotthiya the grass-cutter tends this bank; speak with him first.", "info")
				end
			elseif item.kind == "symbol" then
				if symbolById[item.id] then
					foundSymbol(player, profile, symbolById[item.id])
				end
			elseif item.kind == "animal" then
				if animalById[item.id] then
					metAnimal(player, profile, session, animalById[item.id])
				end
			elseif item.kind == "lotus" then
				if session.lotus[item.id] then
					Remotes.notify(player, "You have already picked this lotus today.", "info")
				else
					session.lotus[item.id] = true
					PlayerData.give(player, "lotus", 1)
					Remotes.notify(player, "You picked a lotus. Offer it at any shrine.", "good")
					PlayerData.push(player)
				end
			end
		end)
	end
end

----------------------------------------------------------------------
-- Choices made in windows
----------------------------------------------------------------------
local Actions = {}

function Actions.UseItem(player, itemId)
	local def = Config.Items[itemId]
	local session = PlayerData.session(player)
	if type(itemId) ~= "string" or not def or not session or PlayerData.count(player, itemId) < 1 then
		return
	end
	local now = os.clock()
	if def.use == "heal" then
		local max = player:GetAttribute("MaxCalm") or 100
		if (player:GetAttribute("Calm") or max) >= max then
			Remotes.notify(player, "Your Calm is already full.", "info")
			return
		end
		PlayerData.take(player, itemId, 1)
		Combat.heal(player, def.amount)
	elseif def.use == "speed" then
		PlayerData.take(player, itemId, 1)
		session.speedUntil = now + def.duration
		Combat.refreshSpeed(player)
		Remotes.notify(player, "The tea warms you. You walk faster for a while.", "good")
	elseif def.use == "regen" then
		PlayerData.take(player, itemId, 1)
		session.regenUntil = now + def.duration
		Remotes.notify(player, "The incense steadies your breath.", "good")
	elseif def.use == "offer" then
		if not nearShrine(player, 30) then
			Remotes.notify(player, "Carry this to a shrine to offer it.", "info")
			return
		end
		PlayerData.take(player, itemId, 1)
		PlayerData.addMerit(player, livelihood(player, def.merit))
		if itemId == "lamp" then
			session.shieldUntil = now + 180
			Remotes.notify(player, "The lamp is lit. You are protected for a while.", "good")
		end
	elseif def.use == "equip" then
		Combat.chooseWeapon(player, itemId)
	elseif def.use == "wear" then
		Cosmetics.toggle(player, itemId)
	elseif def.use == "quest" then
		if not Quests.active(player, "use", itemId) then
			Remotes.notify(player, "Not yet.", "info")
			return
		end
		PlayerData.take(player, itemId, 1)
		player:SetAttribute("Calm", PlayerData.maxCalm(player))
		Quests.progress(player, "use", itemId)
	else
		return
	end
	PlayerData.push(player)
end

local function priceFor(player, price)
	if PlayerData.hasPath(player, "speech") then
		return math.floor(price * 0.85 + 0.5)
	end
	return price
end

function Actions.Buy(player, shopId, itemId)
	local shop = type(shopId) == "string" and Config.Shops[shopId] or nil
	local profile = PlayerData.get(player)
	if not shop or not profile then
		return
	end
	for _, entry in ipairs(shop.stock) do
		if entry.item == itemId then
			local def = Config.Items[itemId]
			if entry.once and (profile.bought[itemId] or (profile.inv[itemId] or 0) > 0) then
				Remotes.notify(player, "You already have this.", "info")
				return
			end
			local price = priceFor(player, entry.price)
			if not PlayerData.spend(player, price) then
				Remotes.notify(player, "Not enough merit. Kind acts, prayer and the journey itself all earn merit.", "warn")
				return
			end
			if entry.once then
				profile.bought[itemId] = true
			end
			PlayerData.give(player, itemId, 1)
			Remotes.fxTo(player, "buy", {})
			Remotes.notify(player, "Received: " .. def.name, "good")
			if itemId == "prayer_flags" then
				task.spawn(Robes.apply, player)
			end
			if Config.Weapons[itemId] then
				profile.weapon = itemId
				Combat.equipWeapon(player)
			end
			if def.use == "wear" then
				profile.worn[def.slot] = itemId
				Cosmetics.apply(player)
			end
			PlayerData.push(player)
			return
		end
	end
end

function Actions.BuyRobe(player, robeId)
	local profile = PlayerData.get(player)
	local def = type(robeId) == "string" and Robes.def(robeId) or nil
	if not profile or not def or profile.robes[robeId] then
		return
	end
	if def.pass then
		Remotes.notify(player, "This robe comes with " .. Config.Robux.passes[1].name .. ". Ask at the Garden Stall.", "info")
		return
	end
	if def.quest or def.reward or not def.price then
		Remotes.notify(player, "This robe cannot be bought. It is earned on the journey.", "info")
		return
	end
	if not PlayerData.spend(player, priceFor(player, def.price)) then
		Remotes.notify(player, "Not enough merit for this robe yet.", "warn")
		return
	end
	profile.robes[robeId] = true
	profile.robe = robeId
	Remotes.fxTo(player, "buy", {})
	Remotes.notify(player, "You now wear the " .. def.name .. ".", "good")
	PlayerData.push(player)
	Robes.apply(player)
end

function Actions.WearRobe(player, robeId)
	local profile = PlayerData.get(player)
	if not profile or type(robeId) ~= "string" or not profile.robes[robeId] or not Robes.def(robeId) then
		return
	end
	profile.robe = robeId
	PlayerData.push(player)
	Robes.apply(player)
end

function Actions.BuyPass(player, id)
	if type(id) == "string" then
		Robux.buyPass(player, id)
	end
end

function Actions.BuyProduct(player, id)
	if type(id) == "string" then
		Robux.buyProduct(player, id)
	end
end

function Actions.BuyPath(player)
	local profile = PlayerData.get(player)
	if not profile then
		return
	end
	local step = Config.Path[profile.path + 1]
	if not step then
		return
	end
	if not nearShrine(player, 34) then
		Remotes.notify(player, "The Eightfold Path is practised at a shrine. Pray at one first.", "info")
		return
	end
	if not PlayerData.spend(player, step.cost) then
		Remotes.notify(player, "Not enough merit for " .. step.name .. " yet.", "warn")
		return
	end
	profile.path = profile.path + 1
	PlayerData.refreshCalm(player)
	Combat.refreshSpeed(player)
	Remotes.notify(player, step.name .. " (" .. step.pali .. ") is now part of your practice.", "good")
	if profile.path >= #Config.Path then
		Remotes.notify(player, "You have completed the Noble Eightfold Path.", "good")
	end
	PlayerData.push(player)
end

function Actions.Travel(player, shrineId)
	local profile = PlayerData.get(player)
	if not profile or type(shrineId) ~= "string" or not profile.shrines[shrineId] then
		return
	end
	if not nearShrine(player, 34) then
		Remotes.notify(player, "You can travel between shrines only while standing at one.", "info")
		return
	end
	Combat.setMeditating(player, false)
	profile.checkpoint = shrineId
	Remotes.fxTo(player, "fade", {})
	task.delay(0.35, function()
		if player.Parent then
			Combat.toShrine(player, shrineId)
		end
	end)
end

function Interact.action(player, kind, a, b)
	local fn = Actions[kind]
	if fn then
		fn(player, a, b)
		return true
	end
	return false
end

----------------------------------------------------------------------
-- Gates and "arrive here" objectives
----------------------------------------------------------------------
local function watchPlayers()
	local warned = {}
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local root = Combat.root(player)
			local profile = PlayerData.get(player)
			if root and profile then
				local pos = root.Position
				for _, gate in ipairs(Config.Gates) do
					local need = Story.QuestIndex[gate.quest]
					if pos.X > gate.x + 3 and profile.stage < need then
						player.Character:PivotTo(CFrame.new(gate.x - 16, 4.5, math.clamp(pos.Z, -8, 8)))
						if os.clock() >= (warned[player] or 0) then
							warned[player] = os.clock() + 4
							Remotes.notify(player, gate.hint, "warn")
						end
						break
					end
				end
				local quest = Story.Quests[profile.stage]
				for _, obj in ipairs(quest.objectives) do
					if obj.kind == "reach" then
						local area = Config.Areas[obj.target]
						if area then
							local dx, dz = pos.X - area.x, pos.Z - area.z
							if dx * dx + dz * dz <= area.radius * area.radius then
								Quests.progress(player, "reach", obj.target)
								break
							end
						end
					end
				end
			end
		end
	end
end

function Interact.start(objects)
	setupBell(objects)
	setupWheels(objects)
	setupShrines(objects)
	setupStoryPlaces(objects)
	setupCollectibles(objects)
	task.spawn(watchPlayers)
	for name, start in pairs({ Garden = function()
		Garden.start(objects)
	end, Robux = Robux.start }) do
		local ok, err = pcall(start)
		if not ok then
			warn("[Bodhi Path] " .. name .. " could not start: " .. tostring(err))
		end
	end
end

return Interact
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[-- Kit: small helpers for building the world out of simple parts.
-- Every structure in the game is assembled from these (blocks, cylinders, balls),
-- so nothing has to be made by hand in Roblox Studio.

local Kit = {}

local function rgb(c)
	return Color3.fromRGB(c[1], c[2], c[3])
end
Kit.rgb = rgb

-- A shared palette so the whole world keeps one look.
Kit.C = {
	sandstone = Color3.fromRGB(214, 178, 128),
	sandstoneDark = Color3.fromRGB(176, 138, 94),
	sandstoneLight = Color3.fromRGB(234, 208, 164),
	redstone = Color3.fromRGB(168, 84, 62),
	brick = Color3.fromRGB(170, 96, 70),
	mud = Color3.fromRGB(196, 160, 118),
	mudDark = Color3.fromRGB(150, 116, 84),
	white = Color3.fromRGB(240, 236, 226),
	ivory = Color3.fromRGB(226, 216, 194),
	gold = Color3.fromRGB(226, 178, 54),
	goldBright = Color3.fromRGB(255, 214, 96),
	bronze = Color3.fromRGB(150, 104, 54),
	wood = Color3.fromRGB(122, 84, 52),
	woodDark = Color3.fromRGB(84, 56, 36),
	woodRed = Color3.fromRGB(150, 44, 34),
	thatch = Color3.fromRGB(196, 164, 92),
	terracotta = Color3.fromRGB(190, 98, 62),
	tileTeal = Color3.fromRGB(44, 92, 96),
	tileGrey = Color3.fromRGB(70, 74, 82),
	stone = Color3.fromRGB(136, 134, 128),
	stoneDark = Color3.fromRGB(92, 90, 88),
	leaf = Color3.fromRGB(74, 128, 62),
	leafDark = Color3.fromRGB(48, 98, 52),
	leafLight = Color3.fromRGB(118, 160, 72),
	leafDry = Color3.fromRGB(146, 142, 78),
	bamboo = Color3.fromRGB(128, 164, 76),
	trunk = Color3.fromRGB(104, 78, 56),
	trunkPale = Color3.fromRGB(150, 130, 104),
	lotusPink = Color3.fromRGB(240, 150, 190),
	lotusWhite = Color3.fromRGB(250, 236, 240),
	saffron = Color3.fromRGB(232, 136, 24),
	maroon = Color3.fromRGB(122, 28, 40),
	flagBlue = Color3.fromRGB(40, 90, 200),
	flagWhite = Color3.fromRGB(245, 245, 245),
	flagRed = Color3.fromRGB(205, 44, 44),
	flagGreen = Color3.fromRGB(46, 150, 70),
	flagYellow = Color3.fromRGB(240, 200, 40),
	water = Color3.fromRGB(64, 140, 150),
	ash = Color3.fromRGB(60, 56, 60),
	ember = Color3.fromRGB(255, 120, 40),
	bone = Color3.fromRGB(214, 206, 186),
	black = Color3.fromRGB(26, 24, 28),
}

Kit.FlagColors = { Kit.C.flagBlue, Kit.C.flagWhite, Kit.C.flagRed, Kit.C.flagGreen, Kit.C.flagYellow }

local function toCF(v)
	if typeof(v) == "Vector3" then
		return CFrame.new(v)
	end
	return v
end
Kit.toCF = toCF

local function apply(part, opts)
	if not opts then
		return
	end
	if opts.collide ~= nil then
		part.CanCollide = opts.collide
	end
	if opts.shadow ~= nil then
		part.CastShadow = opts.shadow
	end
	if opts.transparency then
		part.Transparency = opts.transparency
	end
	if opts.reflectance then
		part.Reflectance = opts.reflectance
	end
	if opts.name then
		part.Name = opts.name
	end
	if opts.anchored ~= nil then
		part.Anchored = opts.anchored
	end
	if opts.touch ~= nil then
		part.CanTouch = opts.touch
	end
	if opts.query ~= nil then
		part.CanQuery = opts.query
	end
end

local function base(shape, size, cf, color, material)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color or Kit.C.stone
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	return p
end

-- A box.
function Kit.block(parent, cf, size, color, material, opts)
	local p = base(Enum.PartType.Block, size, toCF(cf), color, material)
	apply(p, opts)
	p.Parent = parent
	return p
end

-- An upright cylinder: "cf" is its centre, its axis follows cf's up direction.
function Kit.cyl(parent, cf, diameter, height, color, material, opts)
	local p = base(Enum.PartType.Cylinder, Vector3.new(height, diameter, diameter), toCF(cf) * CFrame.Angles(0, 0, math.rad(90)), color, material)
	apply(p, opts)
	p.Parent = parent
	return p
end

-- A perfect ball.
function Kit.ball(parent, cf, diameter, color, material, opts)
	local p = base(Enum.PartType.Ball, Vector3.new(diameter, diameter, diameter), toCF(cf), color, material)
	apply(p, opts)
	p.Parent = parent
	return p
end

-- A stretched ball (egg / dome / leaf-cloud shapes).
function Kit.blob(parent, cf, size, color, material, opts)
	local p = base(Enum.PartType.Block, size, toCF(cf), color, material)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	apply(p, opts)
	p.Parent = parent
	return p
end

function Kit.model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

function Kit.folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- A ground-level frame at (x, z), turned by "yaw" degrees. Structures treat -Z as their front.
function Kit.at(x, z, yaw, y)
	return CFrame.new(x, y or 0, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
end

-- Yaw (degrees) that makes a structure's front face the given direction.
Kit.FACE_NEG_Z = 0
Kit.FACE_POS_Z = 180
Kit.FACE_POS_X = -90
Kit.FACE_NEG_X = 90

-- Yaw that makes a structure at (x, z) face the point (tx, tz).
function Kit.yawToward(x, z, tx, tz)
	local dx, dz = tx - x, tz - z
	return math.deg(math.atan2(-dx, -dz))
end

function Kit.light(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color or Color3.fromRGB(255, 200, 130)
	l.Range = range or 16
	l.Brightness = brightness or 1.2
	l.Shadows = false
	l.Parent = parent
	return l
end

function Kit.fire(parent, size, heat)
	local f = Instance.new("Fire")
	f.Size = size or 4
	f.Heat = heat or 8
	f.Parent = parent
	return f
end

function Kit.smoke(parent, color)
	local e = Instance.new("ParticleEmitter")
	e.Rate = 4
	e.Lifetime = NumberRange.new(3, 5)
	e.Speed = NumberRange.new(1, 2)
	e.SpreadAngle = Vector2.new(12, 12)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 2.2) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	e.Color = ColorSequence.new(color or Color3.fromRGB(230, 225, 215))
	e.LightEmission = 0.1
	e.Parent = parent
	return e
end

function Kit.sparkle(parent, color, rate)
	local e = Instance.new("ParticleEmitter")
	e.Rate = rate or 6
	e.Lifetime = NumberRange.new(1.2, 2)
	e.Speed = NumberRange.new(0.5, 1.5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Color = ColorSequence.new(color or Kit.C.goldBright)
	e.LightEmission = 0.8
	e.Parent = parent
	return e
end

-- A floating label that always faces the camera (used for signs and markers).
function Kit.sign(parent, text, color, height, maxDistance, size)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Sign"
	gui.Size = size or UDim2.new(0, 220, 0, 44)
	-- the third number brings the words towards the viewer, so that nearby walls
	-- and roofs do not cut through them
	gui.StudsOffset = Vector3.new(0, height or 4, 6)
	gui.AlwaysOnTop = false
	gui.MaxDistance = maxDistance or 110
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color or Kit.C.goldBright
	label.TextStrokeColor3 = Color3.fromRGB(40, 20, 10)
	label.TextStrokeTransparency = 0.2
	label.Font = Enum.Font.Fondamento
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = parent
	return gui
end

-- Words painted flat on the faces of a board, like a real sign. Nothing can cut
-- through them. "faces" is a list such as { Enum.NormalId.Front, Enum.NormalId.Back }.
function Kit.plaque(part, text, color, faces)
	for _, face in ipairs(faces or { Enum.NormalId.Front }) do
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Plaque"
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.Size = UDim2.new(0.92, 0, 0.84, 0)
		label.Position = UDim2.new(0.04, 0, 0.08, 0)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextColor3 = color or Kit.C.goldBright
		label.TextStrokeColor3 = Color3.fromRGB(40, 20, 10)
		label.TextStrokeTransparency = 0.2
		label.Font = Enum.Font.Fondamento
		label.TextScaled = true
		label.Parent = gui
		gui.Parent = part
	end
end

-- An interaction prompt (works with keyboard, touch and gamepad).
function Kit.prompt(parent, action, object, distance, hold)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object or ""
	p.MaxActivationDistance = distance or 12
	p.HoldDuration = hold or 0
	p.RequiresLineOfSight = false
	p.Parent = parent
	return p
end

-- Weld "part" to "to", keeping where it is now.
function Kit.weld(part, to)
	local w = Instance.new("WeldConstraint")
	w.Part0 = to
	w.Part1 = part
	w.Parent = part
	return w
end

return Kit
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX15"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- The Bodhi Path: server start-up.
-- Builds the world, then looks after each player who arrives.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

Players.CharacterAutoLoads = false
Players.RespawnTime = 3

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Story = require(Shared:WaitForChild("Story"))

local Remotes = require(script.Parent.Remotes)
local PlayerData = require(script.Parent.PlayerData)
local Quests = require(script.Parent.Quests)
local World = require(script.Parent.World)
local Rig = require(script.Parent.Rig)
local Combat = require(script.Parent.Combat)
local Enemies = require(script.Parent.Enemies)
local NPCs = require(script.Parent.NPCs)
local Robes = require(script.Parent.Robes)
local Interact = require(script.Parent.Interact)
local Boss = require(script.Parent.Boss)
local Robux = require(script.Parent.Robux)

local function step(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[Bodhi Path] " .. name .. " failed: " .. tostring(err))
	end
end

step("Building the world", World.build)
step("Preparing characters", Rig.init)
step("Combat", Combat.start)
step("People", NPCs.start)
step("Mara's armies", Enemies.start)
step("Mara", function()
	Boss.start(World.objects)
end)
step("Interactions", function()
	Interact.start(World.objects)
end)

----------------------------------------------------------------------
-- Awakening
----------------------------------------------------------------------
Quests.onComplete(function(player, quest)
	if quest.id ~= "watch3" then
		return
	end
	local profile = PlayerData.get(player)
	if not profile then
		return
	end
	profile.awakened = true
	profile.robe = "golden"
	player:SetAttribute("Awakened", true)
	Combat.setMeditating(player, false)
	Remotes.fxTo(player, "awaken", {})
	Remotes.notifyAll(player.DisplayName .. " has awakened beneath the Bodhi tree.", "good")
	PlayerData.push(player)
	task.wait(1)
	Robes.apply(player)
end)

----------------------------------------------------------------------
-- Players
----------------------------------------------------------------------
local ABILITY = { strike = true, beads = true, metta = true, bowl = true, meditate = true }

Remotes.Action.OnServerEvent:Connect(function(player, kind, a, b)
	if type(kind) ~= "string" or not PlayerData.get(player) then
		return
	end
	local ok, err = pcall(function()
		if ABILITY[kind] then
			Combat.use(player, kind, a)
		elseif kind == "TouchEarth" then
			Boss.touchEarth(player)
		elseif kind == "DialogDone" then
			Combat.endTalk(player)
		elseif kind == "Ready" then
			PlayerData.push(player)
		else
			Interact.action(player, kind, a, b)
		end
	end)
	if not ok then
		warn("[Bodhi Path] action " .. kind .. " failed: " .. tostring(err))
	end
end)

local function onCharacter(player, character)
	local waited = 0
	while not PlayerData.get(player) and player.Parent and waited < 20 do
		task.wait(0.1)
		waited = waited + 0.1
	end
	local profile = PlayerData.get(player)
	if not profile or character.Parent == nil then
		return
	end
	local session = PlayerData.session(player)
	session.meditating = false
	session.graceUntil = os.clock() + 3
	player:SetAttribute("Meditating", false)
	player:SetAttribute("Calm", PlayerData.maxCalm(player))

	task.wait(0.15)
	Combat.toShrine(player, profile.checkpoint)

	local hum = character:WaitForChild("Humanoid", 10)
	if hum then
		hum.Died:Connect(function()
			task.wait(Players.RespawnTime)
			if player.Parent then
				player:LoadCharacter()
			end
		end)
	end

	if not player:HasAppearanceLoaded() then
		local t = 0
		while not player:HasAppearanceLoaded() and t < 6 and character.Parent do
			task.wait(0.25)
			t = t + 0.25
		end
	end
	if character.Parent then
		Robes.apply(player)
		Combat.refreshSpeed(player)
	end
end

local function onPlayer(player)
	player.CharacterAdded:Connect(function(character)
		local ok, err = pcall(onCharacter, player, character)
		if not ok then
			warn("[Bodhi Path] character setup failed: " .. tostring(err))
		end
	end)
	local profile = PlayerData.load(player)
	if not profile then
		return
	end
	player:LoadCharacter()
	Quests.enter(player, true)
	task.spawn(function()
		local ok, err = pcall(Robux.check, player)
		if not ok then
			warn("[Bodhi Path] could not check passes: " .. tostring(err))
		end
	end)
	if profile.stage == 1 then
		Remotes.dialog(player, {
			{ "", "Welcome to " .. Config.Title .. "." },
			{ "", "Two and a half thousand years ago, Prince Siddhartha left his palace to find an end to suffering. He found it beneath the Bodhi tree, and became the Buddha." },
			{ "", "You are a seeker walking that same road. Mara, lord of all that binds the heart, will try to turn you back." },
			{ "", "Your goal is on the right of the screen. Begin by speaking with the Venerable Abbot, in front of the great temple behind you." },
		}, Config.Title)
	else
		local quest = Story.Quests[profile.stage]
		Remotes.notify(player, "Welcome back. " .. quest.title, "quest")
	end
end

Players.PlayerAdded:Connect(function(player)
	local ok, err = pcall(onPlayer, player)
	if not ok then
		warn("[Bodhi Path] player setup failed: " .. tostring(err))
	end
end)
Players.PlayerRemoving:Connect(function(player)
	PlayerData.release(player)
end)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(function()
		local ok, err = pcall(onPlayer, player)
		if not ok then
			warn("[Bodhi Path] player setup failed: " .. tostring(err))
		end
	end)
end

print("[Bodhi Path] Ready.")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">NPCs</string><ProtectedString name="Source"><![CDATA[-- NPCs: the people of the story. They stand (or sit) where the story needs them,
-- speak when spoken to, give alms, and keep the shops. A few simply wander so the
-- villages feel alive.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Story = require(Shared:WaitForChild("Story"))
local Remotes = require(script.Parent.Remotes)
local PlayerData = require(script.Parent.PlayerData)
local Quests = require(script.Parent.Quests)
local Rig = require(script.Parent.Rig)
local Kit = require(script.Parent.Kit)

local NPCs = {}

-- People who sit on the ground rather than stand.
local SITTING = {
	sick_man = true, ascetic = true, alara = true, alara_student = true, uddaka = true,
	bhaddiya = true, vappa = true, mahanama = true, assaji = true,
}

local ALMS_WAIT = 600 -- seconds before the same villager gives again

local people = {}
local wanderers = {}
local rng = Random.new()

local function talk(player, npc)
	local def = npc.def
	local profile = PlayerData.get(player)
	local session = PlayerData.session(player)
	if not profile or not session then
		return
	end

	-- part of the current step of the journey?
	local obj = Quests.active(player, "talk", def.id)
	if obj then
		Remotes.dialog(player, obj.lines, def.name)
		Quests.progress(player, "talk", def.id)
		return
	end

	-- alms
	if def.alms and (profile.inv.alms_bowl or 0) > 0 then
		session.alms = session.alms or {}
		local now = os.clock()
		if now >= (session.alms[def.id] or 0) then
			session.alms[def.id] = now + ALMS_WAIT
			PlayerData.give(player, "rice", 1)
			Remotes.dialog(player, {
				{ def.name, def.lines[1] },
				{ "", def.name .. " places a ladle of rice in your bowl. (Alms Rice added to your Bag.)" },
			}, def.name)
			if not Quests.progress(player, "alms", "alms") then
				PlayerData.push(player)
			end
			return
		end
	end

	if def.shop then
		Remotes.UI:FireClient(player, "shop", def.shop)
		return
	end
	if def.robes then
		Remotes.UI:FireClient(player, "robes")
		return
	end

	local line = def.lines[rng:NextInteger(1, #def.lines)]
	Remotes.dialog(player, { { def.name, line } }, def.name)
end

-- The villagers who only walk about: they greet you, and during the alms round they
-- point you to someone who has food ready.
local GREETINGS = {
	"Peace to you, traveller.",
	"May your road be an easy one.",
	"A fine morning for walking.",
	"Go gently.",
}

local function greet(player, npc)
	local session = PlayerData.session(player)
	local name = npc.def.name
	if session and Quests.active(player, "alms", "alms") then
		local now = os.clock()
		for _, def in ipairs(Story.NPCs) do
			if def.alms and now >= ((session.alms or {})[def.id] or 0) then
				Remotes.dialog(player, { { name, "I have nothing cooked yet, but " .. def.name .. " is waiting by the door with rice for you. Follow the golden marker." } }, name)
				return
			end
		end
	end
	Remotes.dialog(player, { { name, GREETINGS[rng:NextInteger(1, #GREETINGS)] } }, name)
end

local function makePerson(def, folder)
	local model, hum = Rig.make(def.name, def.look)
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	hum.NameDisplayDistance = 70
	hum.WalkSpeed = 7
	local yaw = 0
	if def.face then
		yaw = Kit.yawToward(def.x, def.z, def.face.x, def.face.z)
	end
	local home = Kit.at(def.x, def.z, yaw, def.y or 0)
	Rig.place(model, home, folder)
	local tracks = Rig.animate(model, false)
	local root = model:FindFirstChild("HumanoidRootPart")
	local npc = { def = def, model = model, hum = hum, root = root, home = home, tracks = tracks }
	return npc
end

function NPCs.start()
	local folder = Kit.folder(workspace, "People")

	for _, def in ipairs(Story.NPCs) do
		local ok, result = pcall(makePerson, def, folder)
		if ok then
			local npc = result
			local action = "Talk"
			if def.alms then
				action = "Hold out your bowl"
			elseif def.shop then
				action = "Trade"
			elseif def.robes then
				action = "Robes"
			end
			local prompt = Kit.prompt(npc.root, action, def.name, 11)
			prompt.Triggered:Connect(function(player)
				talk(player, npc)
			end)
			if SITTING[def.id] then
				npc.sitting = true
				task.delay(2, function()
					if npc.hum.Parent then
						npc.hum.Sit = true
						if npc.tracks then
							npc.tracks.idle:Stop(0.2)
							npc.tracks.sit:Play(0.2)
						end
					end
				end)
			end
			table.insert(people, npc)
		else
			warn("[Bodhi Path] Could not create " .. def.name .. ":", result)
		end
	end

	for _, def in ipairs(Story.Wanderers) do
		local ok, result = pcall(makePerson, def, folder)
		if ok then
			result.nextMove = 0
			table.insert(wanderers, result)
			local walker = result
			local prompt = Kit.prompt(walker.root, "Greet", def.name, 9)
			prompt.Triggered:Connect(function(player)
				greet(player, walker)
			end)
		end
	end

	-- keep people where they belong, and let the wanderers wander
	task.spawn(function()
		while true do
			task.wait(2.5)
			local now = os.clock()
			for _, npc in ipairs(people) do
				if npc.root.Parent then
					local away = (npc.root.Position - npc.home.Position)
					local flat = Vector3.new(away.X, 0, away.Z).Magnitude
					if npc.root.Position.Y < -30 or flat > 30 then
						npc.model:PivotTo(npc.home * CFrame.new(0, 4, 0))
					elseif flat > 4 and not npc.sitting then
						npc.hum:MoveTo(npc.home.Position)
					end
				end
			end
			for _, npc in ipairs(wanderers) do
				if npc.root.Parent then
					if npc.root.Position.Y < -30 then
						npc.model:PivotTo(npc.home * CFrame.new(0, 4, 0))
					elseif now >= npc.nextMove then
						npc.nextMove = now + rng:NextNumber(5, 11)
						local a = rng:NextNumber(0, math.pi * 2)
						local r = rng:NextNumber(4, npc.def.radius or 20)
						local dest = npc.home.Position + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
						-- stay off the far side of the road only if it keeps them near home
						npc.hum:MoveTo(dest)
					end
				end
			end
		end
	end)
end

return NPCs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[-- PlayerData: each player's saved progress (merit, bag, robes, how far they have walked)
-- plus short-lived things that last only for one visit (cooldowns, blessings).

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Story = require(Shared:WaitForChild("Story"))
local Remotes = require(script.Parent.Remotes)

local PlayerData = {}

local profiles = {}
local sessions = {}
local store = nil
local storeWarned = false

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	end
end

local function defaults()
	return {
		v = 1,
		merit = 0,
		stage = 1,
		prog = {},
		inv = {},
		abilities = { strike = true, meditate = true },
		robes = { own = true, novice = true },
		robe = "novice",
		path = 0,
		leaves = {},
		collected = {},
		shrines = { village = true },
		checkpoint = "village",
		bonusCalm = 0,
		awakened = false,
		lastDaily = 0,
		dispelled = 0,
		bought = {},
		bossWins = 0,
		weapon = "auto",
		symbols = {},
		friends = {},
		worn = {},
	}
end

local function sanitize(data)
	local base = defaults()
	if type(data) ~= "table" then
		return base
	end
	for key, value in pairs(base) do
		if data[key] == nil or type(data[key]) ~= type(value) then
			data[key] = value
		end
	end
	if data.stage < 1 then
		data.stage = 1
	end
	if data.stage > #Story.Quests then
		data.stage = #Story.Quests
	end
	data.abilities.strike = true
	data.abilities.meditate = true
	data.robes.own = true
	data.robes.novice = true
	if data.abilities.staff then
		data.inv.staff = 1
	end
	return data
end

local function warnStore(err)
	if not storeWarned then
		storeWarned = true
		warn("[Bodhi Path] Saving is not available right now, so progress will last only for this visit. (" .. tostring(err) .. ")")
	end
end

----------------------------------------------------------------------
-- Loading and saving
----------------------------------------------------------------------
function PlayerData.load(player)
	local profile = nil
	local canSave = false
	if store then
		local key = "p_" .. player.UserId
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key)
			end)
			if ok then
				profile = sanitize(result)
				canSave = true
				break
			end
			warnStore(result)
			if attempt < 3 then
				task.wait(1.5)
			end
		end
	end
	if not profile then
		profile = defaults()
	end
	if not player.Parent then
		return nil
	end
	profiles[player] = profile
	sessions[player] = {
		canSave = canSave,
		cooldowns = {},
		lastHurt = 0,
		speedUntil = 0,
		regenUntil = 0,
		shieldUntil = 0,
		slowUntil = 0,
		graceUntil = 0,
		talkUntil = 0,
		fed = {},
		meditating = false,
		lotus = {},
		wheels = {},
		tagged = {},
	}

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local merit = Instance.new("IntValue")
	merit.Name = "Merit"
	merit.Value = profile.merit
	merit.Parent = stats
	local journey = Instance.new("IntValue")
	journey.Name = "Journey"
	journey.Value = math.floor((profile.stage - 1) / (#Story.Quests - 1) * 100)
	journey.Parent = stats
	stats.Parent = player

	player:SetAttribute("MaxCalm", PlayerData.maxCalm(player))
	player:SetAttribute("Calm", PlayerData.maxCalm(player))
	player:SetAttribute("Merit", profile.merit)
	player:SetAttribute("Stage", profile.stage)
	player:SetAttribute("Meditating", false)
	player:SetAttribute("Awakened", profile.awakened)
	return profile
end

function PlayerData.save(player)
	local profile = profiles[player]
	local session = sessions[player]
	if not profile or not session or not session.canSave or not store then
		return
	end
	local ok, err = pcall(function()
		store:SetAsync("p_" .. player.UserId, profile)
	end)
	if not ok then
		warnStore(err)
	end
end

function PlayerData.release(player)
	PlayerData.save(player)
	profiles[player] = nil
	sessions[player] = nil
end

function PlayerData.get(player)
	return profiles[player]
end

function PlayerData.session(player)
	return sessions[player]
end

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
function PlayerData.hasPath(player, id)
	local profile = profiles[player]
	if not profile then
		return false
	end
	for i, step in ipairs(Config.Path) do
		if step.id == id then
			return profile.path >= i
		end
	end
	return false
end

function PlayerData.count(player, item)
	local profile = profiles[player]
	return profile and profile.inv[item] or 0
end

function PlayerData.give(player, item, amount)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.inv[item] = (profile.inv[item] or 0) + (amount or 1)
	local def = Config.Items[item]
	if def and def.unlock then
		profile.abilities[def.unlock] = true
	end
end

function PlayerData.take(player, item, amount)
	local profile = profiles[player]
	if not profile then
		return false
	end
	local have = profile.inv[item] or 0
	amount = amount or 1
	if have < amount then
		return false
	end
	have = have - amount
	if have <= 0 then
		profile.inv[item] = nil
	else
		profile.inv[item] = have
	end
	return true
end

function PlayerData.maxCalm(player)
	local profile = profiles[player]
	local value = Config.Player.BaseCalm
	if profile then
		value = value + profile.bonusCalm
		if PlayerData.hasPath(player, "mindfulness") then
			value = value + 40
		end
	end
	return value
end

function PlayerData.refreshCalm(player)
	local max = PlayerData.maxCalm(player)
	player:SetAttribute("MaxCalm", max)
	local calm = player:GetAttribute("Calm") or max
	if calm > max then
		player:SetAttribute("Calm", max)
	end
end

-- Add merit. Returns how much was actually given. "plain" skips the bonuses.
function PlayerData.addMerit(player, amount, plain)
	local profile = profiles[player]
	if not profile or amount == 0 then
		return 0
	end
	if amount > 0 and not plain then
		local mult = 1
		if PlayerData.hasPath(player, "view") then
			mult = mult + 0.2
		end
		if (profile.inv.wheel_charm or 0) > 0 then
			mult = mult + 0.1
		end
		amount = math.floor(amount * mult + 0.5)
	end
	profile.merit = math.max(0, profile.merit + amount)
	player:SetAttribute("Merit", profile.merit)
	local stats = player:FindFirstChild("leaderstats")
	if stats and stats:FindFirstChild("Merit") then
		stats.Merit.Value = profile.merit
	end
	if amount > 0 then
		Remotes.notify(player, "+" .. amount .. " merit", "merit")
	end
	return amount
end

function PlayerData.spend(player, amount)
	local profile = profiles[player]
	if not profile or profile.merit < amount then
		return false
	end
	PlayerData.addMerit(player, -amount, true)
	return true
end

-- Send the player's screen everything it needs to draw the HUD and windows.
function PlayerData.push(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	-- which villagers have already filled the bowl this morning
	local almsGiven = {}
	local given = sessions[player] and sessions[player].alms
	if given then
		local now = os.clock()
		for id, untilTime in pairs(given) do
			if now < untilTime then
				almsGiven[id] = true
			end
		end
	end
	player:SetAttribute("Stage", profile.stage)
	local stats = player:FindFirstChild("leaderstats")
	if stats and stats:FindFirstChild("Journey") then
		stats.Journey.Value = math.floor((profile.stage - 1) / (#Story.Quests - 1) * 100)
	end
	Remotes.State:FireClient(player, {
		merit = profile.merit,
		stage = profile.stage,
		prog = profile.prog,
		inv = profile.inv,
		abilities = profile.abilities,
		robes = profile.robes,
		robe = profile.robe,
		path = profile.path,
		leaves = profile.leaves,
		collected = profile.collected,
		shrines = profile.shrines,
		checkpoint = profile.checkpoint,
		awakened = profile.awakened,
		bought = profile.bought,
		weapon = profile.weapon,
		symbols = profile.symbols,
		friends = profile.friends,
		almsGiven = almsGiven,
		worn = profile.worn,
		lotus = sessions[player] and sessions[player].lotus or {},
	})
end

function PlayerData.all()
	return profiles
end

-- Autosave, and save everyone when the server shuts down.
task.spawn(function()
	while true do
		task.wait(120)
		for _, player in ipairs(Players:GetPlayers()) do
			PlayerData.save(player)
		end
	end
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		PlayerData.save(player)
	end
end)

return PlayerData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">Props</string><ProtectedString name="Source"><![CDATA[-- Props: trees, rocks, animals and small objects.
-- Every function takes the place to put the thing ("o", a ground-level frame) and
-- builds it from simple parts. Structures treat -Z as "front".

local Kit = require(script.Parent.Kit)
local C = Kit.C
local M = Enum.Material

local Props = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end
local rad = math.rad
local NOCOL = { collide = false }
local SOFT = { collide = false, shadow = false }

----------------------------------------------------------------------
-- Trees and plants
----------------------------------------------------------------------

-- Sal tree: tall and straight. The Buddha was born and passed away beneath sal trees.
function Props.sal(parent, o, s)
	s = s or 1
	local h = 18 * s
	Kit.cyl(parent, o * CFrame.new(0, h / 2, 0), 1.8 * s, h, C.trunk, M.Wood)
	Kit.blob(parent, o * CFrame.new(0, h * 0.8, 0), V(13 * s, 9 * s, 13 * s), C.leaf, M.Grass, NOCOL)
	Kit.blob(parent, o * CFrame.new(2.5 * s, h * 1.03, 1.5 * s), V(9 * s, 7 * s, 9 * s), C.leafLight, M.Grass, NOCOL)
	Kit.blob(parent, o * CFrame.new(-3 * s, h * 0.93, -2 * s), V(8.5 * s, 6 * s, 8.5 * s), C.leafDark, M.Grass, NOCOL)
end

-- A smaller round tree (mango / rose-apple).
function Props.roundTree(parent, o, s, leafColor)
	s = s or 1
	local h = 9 * s
	Kit.cyl(parent, o * CFrame.new(0, h / 2, 0), 1.6 * s, h, C.trunk, M.Wood)
	Kit.blob(parent, o * CFrame.new(0, h + 2.5 * s, 0), V(14 * s, 9 * s, 14 * s), leafColor or C.leafDark, M.Grass, NOCOL)
	Kit.blob(parent, o * CFrame.new(3 * s, h + 4.5 * s, -2 * s), V(8 * s, 6 * s, 8 * s), C.leaf, M.Grass, NOCOL)
end

-- Banyan: a huge spreading fig with hanging roots.
function Props.banyan(parent, o, s)
	s = s or 1
	local m = Kit.model(parent, "Banyan")
	Kit.cyl(m, o * CFrame.new(0, 8 * s, 0), 7 * s, 16 * s, C.trunk, M.Wood)
	Kit.cyl(m, o * CFrame.new(0, 1 * s, 0), 10 * s, 2 * s, C.trunk, M.Wood)
	for i = 0, 6 do
		local a = i / 7 * math.pi * 2
		local r = 13 * s
		Kit.blob(m, o * CFrame.new(math.cos(a) * r, 19 * s + (i % 2) * 2 * s, math.sin(a) * r), V(20 * s, 10 * s, 20 * s), (i % 2 == 0) and C.leafDark or C.leaf, M.Grass, NOCOL)
	end
	Kit.blob(m, o * CFrame.new(0, 24 * s, 0), V(24 * s, 11 * s, 24 * s), C.leaf, M.Grass, NOCOL)
	for i = 0, 8 do
		local a = i / 9 * math.pi * 2 + 0.3
		local r = (9 + (i % 3) * 4) * s
		local hh = 15 * s
		Kit.cyl(m, o * CFrame.new(math.cos(a) * r, hh / 2, math.sin(a) * r), 0.7 * s, hh, C.trunkPale, M.Wood, SOFT)
	end
	return m
end

function Props.palm(parent, o, s, lean)
	s = s or 1
	local h = 22 * s
	local tilt = o * CFrame.Angles(rad(lean or 7), 0, 0)
	Kit.cyl(parent, tilt * CFrame.new(0, h / 2, 0), 1.3 * s, h, C.trunkPale, M.Wood)
	local top = tilt * CFrame.new(0, h, 0)
	for i = 0, 7 do
		local f = top * CFrame.Angles(0, rad(i * 45), 0) * CFrame.Angles(rad(-24 - (i % 2) * 10), 0, 0) * CFrame.new(0, 0, -5.5 * s)
		Kit.block(parent, f, V(1.8 * s, 0.25, 11 * s), (i % 2 == 0) and C.leaf or C.leafLight, M.Grass, SOFT)
	end
	Kit.ball(parent, top * CFrame.new(0.6, -0.8, 0.4), 1.2 * s, C.woodDark, M.Wood, SOFT)
	Kit.ball(parent, top * CFrame.new(-0.6, -0.9, -0.3), 1.2 * s, C.woodDark, M.Wood, SOFT)
end

function Props.bamboo(parent, o, rng, n)
	for _ = 1, n or 7 do
		local h = rng:NextNumber(14, 24)
		local cf = o * CFrame.new(rng:NextNumber(-2.5, 2.5), 0, rng:NextNumber(-2.5, 2.5)) * CFrame.Angles(rad(rng:NextNumber(-6, 6)), 0, rad(rng:NextNumber(-6, 6)))
		Kit.cyl(parent, cf * CFrame.new(0, h / 2, 0), 0.6, h, C.bamboo, M.SmoothPlastic, SOFT)
		Kit.blob(parent, cf * CFrame.new(0, h, 0), V(3.4, 2.4, 3.4), C.leafLight, M.Grass, SOFT)
	end
end

function Props.bush(parent, o, s, color)
	s = s or 1
	Kit.blob(parent, o * CFrame.new(0, 1.2 * s, 0), V(5 * s, 3.2 * s, 5 * s), color or C.leafDark, M.Grass, SOFT)
end

function Props.flowers(parent, o, color, rng)
	Kit.blob(parent, o * CFrame.new(0, 0.5, 0), V(4, 1.4, 4), C.leaf, M.Grass, SOFT)
	for _ = 1, 4 do
		Kit.ball(parent, o * CFrame.new(rng:NextNumber(-1.4, 1.4), 1.2, rng:NextNumber(-1.4, 1.4)), 0.8, color, M.SmoothPlastic, SOFT)
	end
end

function Props.rock(parent, o, s, color, rng)
	s = s or 1
	local cf = o * CFrame.new(0, 0.9 * s, 0) * CFrame.Angles(rad(rng:NextNumber(-18, 18)), rad(rng:NextNumber(0, 360)), rad(rng:NextNumber(-18, 18)))
	Kit.block(parent, cf, V(rng:NextNumber(3, 5) * s, rng:NextNumber(2, 3.4) * s, rng:NextNumber(3, 5) * s), color or C.stone, M.Slate)
end

-- A bare, twisted tree for Mara's Field.
function Props.deadTree(parent, o, s)
	s = s or 1
	local trunk = o * CFrame.Angles(rad(6), 0, rad(-5))
	Kit.cyl(parent, trunk * CFrame.new(0, 7 * s, 0), 1.6 * s, 14 * s, C.black, M.Wood)
	Kit.block(parent, trunk * CFrame.new(0, 12 * s, 0) * CFrame.Angles(0, 0, rad(50)) * CFrame.new(0, 3.5 * s, 0), V(0.8 * s, 7 * s, 0.8 * s), C.black, M.Wood, SOFT)
	Kit.block(parent, trunk * CFrame.new(0, 10 * s, 0) * CFrame.Angles(0, rad(120), rad(-55)) * CFrame.new(0, 3 * s, 0), V(0.7 * s, 6 * s, 0.7 * s), C.black, M.Wood, SOFT)
	Kit.block(parent, trunk * CFrame.new(0, 14 * s, 0) * CFrame.Angles(rad(35), rad(40), 0) * CFrame.new(0, 2.5 * s, 0), V(0.6 * s, 5 * s, 0.6 * s), C.black, M.Wood, SOFT)
end

-- A lotus pad with a flower, floating at water level.
function Props.lotus(parent, o, color, open)
	Kit.cyl(parent, o * CFrame.new(0, 0.05, 0), 3, 0.12, C.leaf, M.SmoothPlastic, SOFT)
	if open ~= false then
		local c = color or C.lotusPink
		for i = 0, 5 do
			local f = o * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, rad(i * 60), 0) * CFrame.Angles(rad(35), 0, 0) * CFrame.new(0, 0.3, -0.5)
			Kit.blob(parent, f, V(0.7, 0.3, 1.3), c, M.SmoothPlastic, SOFT)
		end
		Kit.ball(parent, o * CFrame.new(0, 0.6, 0), 0.55, C.flagYellow, M.SmoothPlastic, SOFT)
	end
end

-- A flooded rice paddy.
function Props.paddy(parent, o, w, d, rng)
	Kit.block(parent, o * CFrame.new(0, 0.12, 0), V(w, 0.24, d), Color3.fromRGB(96, 150, 140), M.Glass, { collide = false, shadow = false, transparency = 0.25, reflectance = 0.2 })
	Kit.block(parent, o * CFrame.new(0, 0.3, d / 2), V(w + 1.6, 0.6, 1.2), C.mudDark, M.Mud, SOFT)
	Kit.block(parent, o * CFrame.new(0, 0.3, -d / 2), V(w + 1.6, 0.6, 1.2), C.mudDark, M.Mud, SOFT)
	Kit.block(parent, o * CFrame.new(w / 2, 0.3, 0), V(1.2, 0.6, d), C.mudDark, M.Mud, SOFT)
	Kit.block(parent, o * CFrame.new(-w / 2, 0.3, 0), V(1.2, 0.6, d), C.mudDark, M.Mud, SOFT)
	local rows = math.floor(d / 4)
	for r = 1, rows do
		local z = -d / 2 + r * (d / (rows + 1))
		Kit.block(parent, o * CFrame.new(0, 0.9, z), V(w - 3, 1.5, 0.5), (r % 2 == 0) and C.leafLight or C.bamboo, M.Grass, SOFT)
	end
	if rng then
		rng:NextNumber()
	end
end

-- A patch of yellow mustard in flower.
function Props.mustard(parent, o, w, d)
	Kit.block(parent, o * CFrame.new(0, 0.9, 0), V(w, 1.8, d), Color3.fromRGB(226, 196, 44), M.Grass, SOFT)
	Kit.block(parent, o * CFrame.new(0, 0.4, 0), V(w + 0.6, 0.8, d + 0.6), C.leaf, M.Grass, SOFT)
end

----------------------------------------------------------------------
-- Small objects
----------------------------------------------------------------------

function Props.pot(parent, o, s, color)
	s = s or 1
	Kit.blob(parent, o * CFrame.new(0, 1.1 * s, 0), V(2.2 * s, 2.2 * s, 2.2 * s), color or C.terracotta, M.SmoothPlastic, SOFT)
	Kit.cyl(parent, o * CFrame.new(0, 2.2 * s, 0), 1.3 * s, 0.5 * s, color or C.terracotta, M.SmoothPlastic, SOFT)
end

-- A small butter lamp with a living flame.
function Props.butterLamp(parent, o, lit)
	Kit.cyl(parent, o * CFrame.new(0, 0.3, 0), 0.9, 0.6, C.gold, M.Metal, SOFT)
	local cup = Kit.cyl(parent, o * CFrame.new(0, 0.75, 0), 1.2, 0.3, C.gold, M.Metal, SOFT)
	if lit ~= false then
		local flame = Kit.ball(parent, o * CFrame.new(0, 1.15, 0), 0.5, C.goldBright, M.Neon, SOFT)
		Kit.light(flame, Color3.fromRGB(255, 190, 110), 12, 1)
	end
	return cup
end

function Props.lantern(parent, o)
	Kit.block(parent, o * CFrame.new(0, 0.4, 0), V(2.6, 0.8, 2.6), C.stone, M.Slate)
	Kit.cyl(parent, o * CFrame.new(0, 2.6, 0), 1, 3.6, C.stone, M.Slate)
	Kit.block(parent, o * CFrame.new(0, 4.7, 0), V(2.4, 0.5, 2.4), C.stone, M.Slate, NOCOL)
	local glow = Kit.block(parent, o * CFrame.new(0, 5.6, 0), V(1.5, 1.4, 1.5), Color3.fromRGB(255, 214, 150), M.Neon, SOFT)
	Kit.light(glow, Color3.fromRGB(255, 200, 130), 18, 1.1)
	Kit.block(parent, o * CFrame.new(0, 6.6, 0), V(3.2, 0.5, 3.2), C.stoneDark, M.Slate, NOCOL)
	Kit.block(parent, o * CFrame.new(0, 7.1, 0), V(1.8, 0.5, 1.8), C.stoneDark, M.Slate, NOCOL)
	Kit.ball(parent, o * CFrame.new(0, 7.7, 0), 0.8, C.stoneDark, M.Slate, SOFT)
end

function Props.incenseBurner(parent, o)
	Kit.cyl(parent, o * CFrame.new(0, 0.9, 0), 1.2, 1.8, C.bronze, M.Metal)
	local bowl = Kit.blob(parent, o * CFrame.new(0, 2.2, 0), V(3.2, 1.6, 3.2), C.bronze, M.Metal, NOCOL)
	Kit.cyl(parent, o * CFrame.new(0, 2.8, 0), 2.6, 0.2, C.ash, M.Sand, SOFT)
	for i = -1, 1 do
		Kit.cyl(parent, o * CFrame.new(i * 0.5, 3.5, 0), 0.12, 1.4, C.woodRed, M.SmoothPlastic, SOFT)
	end
	local tip = Kit.ball(parent, o * CFrame.new(0, 4.2, 0), 0.2, C.ember, M.Neon, SOFT)
	Kit.smoke(tip)
	return bowl
end

-- A line of five-coloured prayer flags between two points.
function Props.flags(parent, p1, p2, poles)
	local d = p2 - p1
	local len = d.Magnitude
	local mid = (p1 + p2) / 2
	local cf = CFrame.new(mid, p2)
	Kit.block(parent, cf, V(0.12, 0.12, len), C.ivory, M.Fabric, SOFT)
	local n = math.max(3, math.floor(len / 2.4))
	for i = 1, n do
		local t = (i - 0.5) / n
		local sag = math.sin(t * math.pi) * (len * 0.04)
		local fcf = cf * CFrame.new(0, -0.9 - sag, -len / 2 + t * len)
		Kit.block(parent, fcf, V(0.08, 1.5, 1.6), Kit.FlagColors[(i - 1) % 5 + 1], M.Fabric, SOFT)
	end
	if poles then
		if poles ~= "end" then
			Kit.cyl(parent, CFrame.new(p1.X, p1.Y / 2, p1.Z), 0.5, p1.Y, C.woodDark, M.Wood)
		end
		Kit.cyl(parent, CFrame.new(p2.X, p2.Y / 2, p2.Z), 0.5, p2.Y, C.woodDark, M.Wood)
	end
end

function Props.campfire(parent, o)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Kit.block(parent, o * CFrame.new(math.cos(a) * 1.8, 0.4, math.sin(a) * 1.8) * CFrame.Angles(0, -a, 0), V(1, 0.8, 1.2), C.stoneDark, M.Slate, SOFT)
	end
	Kit.block(parent, o * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, rad(30), rad(20)), V(2.6, 0.5, 0.5), C.woodDark, M.Wood, SOFT)
	Kit.block(parent, o * CFrame.new(0, 0.5, 0) * CFrame.Angles(0, rad(-50), rad(-20)), V(2.6, 0.5, 0.5), C.woodDark, M.Wood, SOFT)
	local core = Kit.ball(parent, o * CFrame.new(0, 0.7, 0), 1, C.ember, M.Neon, SOFT)
	Kit.fire(core, 5, 9)
	Kit.light(core, Color3.fromRGB(255, 150, 70), 22, 1.4)
end

-- A tall iron brazier (ring of fires around Mara's arena).
function Props.brazier(parent, o, flameColor)
	Kit.cyl(parent, o * CFrame.new(0, 3, 0), 0.8, 6, C.black, M.Metal)
	Kit.block(parent, o * CFrame.new(0, 0.3, 0), V(3, 0.6, 3), C.black, M.Metal)
	Kit.blob(parent, o * CFrame.new(0, 6.4, 0), V(4, 2, 4), C.black, M.Metal, NOCOL)
	local core = Kit.ball(parent, o * CFrame.new(0, 7.2, 0), 1.6, flameColor or C.ember, M.Neon, SOFT)
	local f = Kit.fire(core, 8, 12)
	if flameColor then
		f.Color = flameColor
		f.SecondaryColor = Color3.fromRGB(80, 20, 120)
	end
	Kit.light(core, flameColor or Color3.fromRGB(255, 140, 60), 30, 1.6)
end

-- A tattered war banner.
function Props.banner(parent, o, color)
	Kit.cyl(parent, o * CFrame.new(0, 8, 0), 0.5, 16, C.black, M.Wood)
	Kit.block(parent, o * CFrame.new(1.8, 12.5, 0), V(3.2, 6, 0.15), color or Color3.fromRGB(110, 20, 30), M.Fabric, SOFT)
	Kit.block(parent, o * CFrame.new(1.2, 8.8, 0), V(1.6, 1.6, 0.15), color or Color3.fromRGB(110, 20, 30), M.Fabric, SOFT)
	Kit.ball(parent, o * CFrame.new(0, 16.3, 0), 1, C.bone, M.SmoothPlastic, SOFT)
end

function Props.haystack(parent, o)
	Kit.blob(parent, o * CFrame.new(0, 2.6, 0), V(7, 6.4, 7), C.thatch, M.Grass)
	Kit.cyl(parent, o * CFrame.new(0, 5.6, 0), 0.4, 3, C.wood, M.Wood, SOFT)
end

function Props.cart(parent, o)
	Kit.block(parent, o * CFrame.new(0, 2.4, 0), V(5, 0.5, 8), C.wood, M.WoodPlanks)
	Kit.block(parent, o * CFrame.new(2.4, 3.2, 0), V(0.3, 1.4, 8), C.woodDark, M.WoodPlanks, NOCOL)
	Kit.block(parent, o * CFrame.new(-2.4, 3.2, 0), V(0.3, 1.4, 8), C.woodDark, M.WoodPlanks, NOCOL)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.cyl(parent, o * CFrame.new(sx * 2.9, 2, 0.5) * CFrame.Angles(0, 0, rad(90)), 4, 0.5, C.woodDark, M.Wood)
	end
	Kit.block(parent, o * CFrame.new(0, 2.2, -6.5), V(0.4, 0.4, 5.5), C.woodDark, M.Wood, NOCOL)
	Kit.blob(parent, o * CFrame.new(0, 3.6, 0.5), V(4, 2.4, 6), C.thatch, M.Grass, NOCOL)
end

function Props.well(parent, o)
	local m = Kit.model(parent, "Well")
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		Kit.block(m, o * CFrame.new(math.cos(a) * 3.6, 1.4, math.sin(a) * 3.6) * CFrame.Angles(0, -a, 0), V(1.4, 2.8, 2.5), C.stone, M.Cobblestone)
	end
	Kit.cyl(m, o * CFrame.new(0, 1.2, 0), 6.4, 0.3, Color3.fromRGB(40, 80, 96), M.Glass, { collide = false, shadow = false, transparency = 0.2 })
	Kit.cyl(m, o * CFrame.new(-3.8, 4, 0), 0.5, 8, C.woodDark, M.Wood)
	Kit.cyl(m, o * CFrame.new(3.8, 4, 0), 0.5, 8, C.woodDark, M.Wood)
	Kit.block(m, o * CFrame.new(0, 7.8, 0), V(9, 0.5, 0.5), C.woodDark, M.Wood, NOCOL)
	Kit.cyl(m, o * CFrame.new(0, 5.6, 0), 0.12, 4, C.ivory, M.Fabric, SOFT)
	Kit.cyl(m, o * CFrame.new(0, 3.4, 0), 1.3, 1.4, C.wood, M.WoodPlanks, SOFT)
	return m
end

-- A market stall with a striped canopy and heaps of goods.
function Props.stall(parent, o, canopy, goods)
	local m = Kit.model(parent, "Stall")
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			Kit.cyl(m, o * CFrame.new(sx * 4.5, 4, sz * 3), 0.4, 8, C.woodDark, M.Wood)
		end
	end
	local roof = o * CFrame.new(0, 8.2, 0) * CFrame.Angles(rad(-10), 0, 0)
	for i = -2, 2 do
		Kit.block(m, roof * CFrame.new(i * 2.1, 0, 0), V(2.1, 0.2, 8), (i % 2 == 0) and canopy or C.ivory, M.Fabric, NOCOL)
	end
	Kit.block(m, o * CFrame.new(0, 2.6, -1), V(8.6, 0.4, 3.2), C.wood, M.WoodPlanks)
	Kit.block(m, o * CFrame.new(-3.9, 1.2, -1), V(0.5, 2.4, 3), C.woodDark, M.Wood)
	Kit.block(m, o * CFrame.new(3.9, 1.2, -1), V(0.5, 2.4, 3), C.woodDark, M.Wood)
	local colors = goods or { Color3.fromRGB(240, 150, 30), Color3.fromRGB(220, 60, 50), Color3.fromRGB(240, 210, 60), Color3.fromRGB(120, 170, 60) }
	for i = 1, 4 do
		local x = -3.6 + i * 1.5
		Kit.blob(m, o * CFrame.new(x, 3.3, -1), V(1.4, 1.2, 1.8), colors[(i - 1) % #colors + 1], M.SmoothPlastic, SOFT)
	end
	Kit.blob(m, o * CFrame.new(-2.8, 1, 2.4), V(2.2, 2, 2.2), C.thatch, M.Fabric, SOFT)
	Kit.blob(m, o * CFrame.new(2.8, 1, 2.4), V(2.2, 2, 2.2), C.ivory, M.Fabric, SOFT)
	return m
end

function Props.signpost(parent, o, text)
	Kit.cyl(parent, o * CFrame.new(0, 3, 0), 0.5, 6, C.woodDark, M.Wood)
	local board = Kit.block(parent, o * CFrame.new(0, 5.4, 0), V(6, 1.8, 0.3), C.wood, M.WoodPlanks, NOCOL)
	Kit.plaque(board, text, C.ivory, { Enum.NormalId.Front, Enum.NormalId.Back })
	return board
end

-- A funeral bier: a shrouded figure laid on a litter, with marigold garlands.
function Props.bier(parent, o)
	Kit.block(parent, o * CFrame.new(0, 1.2, 0), V(3.4, 0.3, 8.6), C.bamboo, M.Wood)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(parent, o * CFrame.new(sx * 1.7, 1.2, 0), V(0.35, 0.35, 11), C.woodDark, M.Wood, NOCOL)
		for _, sz in ipairs({ -1, 1 }) do
			Kit.cyl(parent, o * CFrame.new(sx * 1.5, 0.55, sz * 3.6), 0.4, 1.1, C.woodDark, M.Wood, NOCOL)
		end
	end
	Kit.blob(parent, o * CFrame.new(0, 1.9, 0.3), V(2.6, 1.3, 7), C.white, M.Fabric, NOCOL)
	Kit.blob(parent, o * CFrame.new(0, 2.1, -3), V(1.5, 1.3, 1.5), C.white, M.Fabric, NOCOL)
	Kit.blob(parent, o * CFrame.new(0, 2.6, 0.3), V(2.2, 0.4, 3), Color3.fromRGB(240, 150, 30), M.SmoothPlastic, SOFT)
end

----------------------------------------------------------------------
-- Animals (still figures)
----------------------------------------------------------------------

function Props.cow(parent, o, color)
	local c = color or C.white
	local m = Kit.model(parent, "Cow")
	Kit.block(m, o * CFrame.new(0, 3.2, 0), V(2.4, 2.6, 5.2), c, M.SmoothPlastic)
	Kit.blob(m, o * CFrame.new(0, 4.7, -1.4), V(1.8, 1.4, 2), c, M.SmoothPlastic, SOFT)
	Kit.block(m, o * CFrame.new(0, 3.8, -3.4), V(1.6, 1.7, 2), c, M.SmoothPlastic, NOCOL)
	Kit.block(m, o * CFrame.new(0, 3.4, -4.5), V(1.2, 1, 0.8), Color3.fromRGB(226, 190, 170), M.SmoothPlastic, SOFT)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(m, o * CFrame.new(sx * 0.8, 4.9, -3.3) * CFrame.Angles(0, 0, rad(sx * -30)), V(0.25, 1.1, 0.25), C.bone, M.SmoothPlastic, SOFT)
		for _, sz in ipairs({ -1, 1 }) do
			Kit.block(m, o * CFrame.new(sx * 0.8, 1, sz * 2), V(0.6, 2, 0.6), c, M.SmoothPlastic, NOCOL)
		end
	end
	Kit.block(m, o * CFrame.new(0, 2.9, 2.7) * CFrame.Angles(rad(15), 0, 0), V(0.2, 2, 0.2), c, M.SmoothPlastic, SOFT)
	return m
end

-- Kanthaka, the white horse who carried the prince from the palace.
function Props.horse(parent, o)
	local c = C.white
	local m = Kit.model(parent, "Kanthaka")
	Kit.block(m, o * CFrame.new(0, 4.6, 0), V(2.2, 2.4, 6), c, M.SmoothPlastic)
	Kit.block(m, o * CFrame.new(0, 6.2, -3.3) * CFrame.Angles(rad(-35), 0, 0), V(1.4, 3.6, 1.6), c, M.SmoothPlastic, NOCOL)
	Kit.block(m, o * CFrame.new(0, 7.7, -4.9) * CFrame.Angles(rad(20), 0, 0), V(1.2, 1.4, 2.6), c, M.SmoothPlastic, NOCOL)
	Kit.block(m, o * CFrame.new(0, 6.6, -2.8) * CFrame.Angles(rad(-35), 0, 0), V(0.4, 3.8, 0.8), C.ivory, M.SmoothPlastic, SOFT)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(m, o * CFrame.new(sx * 0.4, 8.6, -4.3), V(0.3, 0.7, 0.3), c, M.SmoothPlastic, SOFT)
		for _, sz in ipairs({ -1, 1 }) do
			Kit.block(m, o * CFrame.new(sx * 0.75, 1.75, sz * 2.4), V(0.6, 3.5, 0.6), c, M.SmoothPlastic, NOCOL)
		end
	end
	Kit.block(m, o * CFrame.new(0, 4.2, 3.4) * CFrame.Angles(rad(25), 0, 0), V(0.5, 3, 0.5), C.ivory, M.SmoothPlastic, SOFT)
	Kit.block(m, o * CFrame.new(0, 5.9, 0), V(2.4, 0.3, 2.6), Color3.fromRGB(150, 30, 40), M.Fabric, SOFT)
	Kit.block(m, o * CFrame.new(0, 5.95, 0), V(2.5, 0.25, 1.2), C.gold, M.Fabric, SOFT)
	return m
end

function Props.deer(parent, o, color)
	local c = color or Color3.fromRGB(176, 124, 76)
	Kit.block(parent, o * CFrame.new(0, 2.6, 0), V(1.3, 1.5, 3.4), c, M.SmoothPlastic, NOCOL)
	Kit.block(parent, o * CFrame.new(0, 3.9, -1.7) * CFrame.Angles(rad(-25), 0, 0), V(0.8, 2, 0.8), c, M.SmoothPlastic, SOFT)
	Kit.block(parent, o * CFrame.new(0, 4.9, -2.4), V(0.8, 0.8, 1.4), c, M.SmoothPlastic, SOFT)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(parent, o * CFrame.new(sx * 0.3, 5.7, -2.1) * CFrame.Angles(0, 0, rad(sx * -20)), V(0.15, 1.2, 0.15), C.bone, M.SmoothPlastic, SOFT)
		for _, sz in ipairs({ -1, 1 }) do
			Kit.block(parent, o * CFrame.new(sx * 0.45, 0.95, sz * 1.3), V(0.3, 1.9, 0.3), c, M.SmoothPlastic, SOFT)
		end
	end
end

-- An elephant. Used for the temple elephant and (scaled up, darkened) for Girimekhala.
function Props.elephant(parent, o, s, color, opts)
	s = s or 1
	opts = opts or {}
	local c = color or Color3.fromRGB(128, 124, 126)
	local m = Kit.model(parent, opts.name or "Elephant")
	Kit.blob(m, o * CFrame.new(0, 8 * s, 1 * s), V(9 * s, 9 * s, 14 * s), c, M.SmoothPlastic)
	Kit.blob(m, o * CFrame.new(0, 9.5 * s, -7 * s), V(7 * s, 7.5 * s, 7 * s), c, M.SmoothPlastic)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.blob(m, o * CFrame.new(sx * 4.4 * s, 9.5 * s, -5.5 * s) * CFrame.Angles(0, rad(sx * 25), 0), V(0.8 * s, 7 * s, 5.5 * s), c, M.SmoothPlastic, NOCOL)
		Kit.cyl(m, o * CFrame.new(sx * 2.6 * s, 2.5 * s, -3.5 * s), 2.8 * s, 5 * s, c, M.SmoothPlastic)
		Kit.cyl(m, o * CFrame.new(sx * 2.6 * s, 2.5 * s, 5 * s), 2.8 * s, 5 * s, c, M.SmoothPlastic)
		Kit.block(m, o * CFrame.new(sx * 1.9 * s, 6.5 * s, -10.6 * s) * CFrame.Angles(rad(55), 0, 0), V(0.7 * s, 5 * s, 0.7 * s), C.bone, M.SmoothPlastic, NOCOL)
		Kit.ball(m, o * CFrame.new(sx * 2.2 * s, 10.6 * s, -9.6 * s), 0.7 * s, opts.eye or C.black, opts.eye and M.Neon or M.SmoothPlastic, SOFT)
	end
	local trunkTop = o * CFrame.new(0, 8.6 * s, -10 * s)
	for i = 0, 4 do
		local seg = trunkTop * CFrame.new(0, -i * 1.7 * s, -i * 0.25 * s)
		Kit.cyl(m, seg, (2.2 - i * 0.3) * s, 1.9 * s, c, M.SmoothPlastic, NOCOL)
	end
	Kit.block(m, o * CFrame.new(0, 6 * s, 8 * s) * CFrame.Angles(rad(20), 0, 0), V(0.5 * s, 5 * s, 0.5 * s), c, M.SmoothPlastic, SOFT)
	if opts.cloth then
		Kit.block(m, o * CFrame.new(0, 12.4 * s, 1 * s), V(8.4 * s, 0.5 * s, 8 * s), opts.cloth, M.Fabric, NOCOL)
		Kit.block(m, o * CFrame.new(4.4 * s, 9.6 * s, 1 * s), V(0.4 * s, 5.6 * s, 7 * s), opts.cloth, M.Fabric, NOCOL)
		Kit.block(m, o * CFrame.new(-4.4 * s, 9.6 * s, 1 * s), V(0.4 * s, 5.6 * s, 7 * s), opts.cloth, M.Fabric, NOCOL)
		Kit.block(m, o * CFrame.new(0, 12.7 * s, 1 * s), V(8.6 * s, 0.2 * s, 2 * s), C.gold, M.Fabric, SOFT)
		Kit.blob(m, o * CFrame.new(0, 12.4 * s, -7.4 * s), V(4 * s, 1.4 * s, 4 * s), opts.cloth, M.Fabric, SOFT)
	end
	return m
end

----------------------------------------------------------------------
-- Animals of the Jataka tales (small still figures)
----------------------------------------------------------------------

function Props.hare(parent, o)
	local c = Color3.fromRGB(206, 186, 154)
	Kit.blob(parent, o * CFrame.new(0, 0.75, 0), V(1.2, 1.1, 1.8), c, M.SmoothPlastic, NOCOL)
	Kit.ball(parent, o * CFrame.new(0, 1.4, -0.9), 0.9, c, M.SmoothPlastic, SOFT)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(parent, o * CFrame.new(sx * 0.22, 2.2, -0.8) * CFrame.Angles(rad(-10), 0, rad(sx * -8)), V(0.2, 1, 0.3), c, M.SmoothPlastic, SOFT)
		Kit.ball(parent, o * CFrame.new(sx * 0.3, 1.5, -1.25), 0.14, C.black, M.SmoothPlastic, SOFT)
	end
	Kit.ball(parent, o * CFrame.new(0, 0.9, 0.95), 0.45, C.white, M.SmoothPlastic, SOFT)
end

function Props.monkey(parent, o)
	local c = Color3.fromRGB(140, 100, 70)
	local face = Color3.fromRGB(222, 190, 160)
	Kit.blob(parent, o * CFrame.new(0, 1.2, 0), V(1.4, 1.9, 1.3), c, M.SmoothPlastic, NOCOL)
	Kit.ball(parent, o * CFrame.new(0, 2.6, -0.2), 1.1, c, M.SmoothPlastic, SOFT)
	Kit.blob(parent, o * CFrame.new(0, 2.5, -0.65), V(0.75, 0.65, 0.45), face, M.SmoothPlastic, SOFT)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(parent, o * CFrame.new(sx * 0.85, 1.4, -0.2) * CFrame.Angles(rad(-15), 0, rad(sx * 8)), V(0.35, 1.5, 0.35), c, M.SmoothPlastic, SOFT)
		Kit.block(parent, o * CFrame.new(sx * 0.5, 0.25, -0.7), V(0.4, 0.4, 1.1), c, M.SmoothPlastic, SOFT)
		Kit.ball(parent, o * CFrame.new(sx * 0.6, 2.7, -0.2), 0.4, face, M.SmoothPlastic, SOFT)
		Kit.ball(parent, o * CFrame.new(sx * 0.2, 2.65, -0.85), 0.12, C.black, M.SmoothPlastic, SOFT)
	end
	Kit.block(parent, o * CFrame.new(0, 0.9, 1.3) * CFrame.Angles(rad(40), 0, 0), V(0.2, 0.2, 2.2), c, M.SmoothPlastic, SOFT)
end

function Props.goose(parent, o)
	local c = C.goldBright
	local beak = Color3.fromRGB(226, 120, 40)
	Kit.blob(parent, o * CFrame.new(0, 1.3, 0), V(1.4, 1.3, 2.4), c, M.Metal, NOCOL)
	Kit.block(parent, o * CFrame.new(0, 2.4, -1) * CFrame.Angles(rad(-15), 0, 0), V(0.4, 1.7, 0.4), c, M.Metal, SOFT)
	Kit.ball(parent, o * CFrame.new(0, 3.3, -1.25), 0.7, c, M.Metal, SOFT)
	Kit.block(parent, o * CFrame.new(0, 3.25, -1.75), V(0.25, 0.2, 0.6), beak, M.SmoothPlastic, SOFT)
	Kit.block(parent, o * CFrame.new(0, 1.7, 1.3) * CFrame.Angles(rad(25), 0, 0), V(0.9, 0.2, 0.9), c, M.Metal, SOFT)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(parent, o * CFrame.new(sx * 0.3, 0.35, 0), V(0.15, 0.7, 0.15), beak, M.SmoothPlastic, SOFT)
		Kit.blob(parent, o * CFrame.new(sx * 0.7, 1.45, 0.15), V(0.3, 0.9, 1.8), c, M.Metal, SOFT)
		Kit.ball(parent, o * CFrame.new(sx * 0.3, 3.4, -1.45), 0.12, C.black, M.SmoothPlastic, SOFT)
	end
end

function Props.quail(parent, o)
	local c = Color3.fromRGB(150, 120, 90)
	Kit.blob(parent, o * CFrame.new(0, 0.6, 0), V(1, 0.9, 1.3), c, M.SmoothPlastic, NOCOL)
	Kit.ball(parent, o * CFrame.new(0, 1.1, -0.5), 0.55, c, M.SmoothPlastic, SOFT)
	Kit.block(parent, o * CFrame.new(0, 1.05, -0.85), V(0.14, 0.12, 0.25), Color3.fromRGB(60, 50, 40), M.SmoothPlastic, SOFT)
	Kit.block(parent, o * CFrame.new(0, 1.55, -0.5) * CFrame.Angles(rad(-20), 0, 0), V(0.08, 0.45, 0.08), C.black, M.SmoothPlastic, SOFT)
	Kit.blob(parent, o * CFrame.new(0, 0.55, 0.1), V(1.05, 0.5, 0.9), Color3.fromRGB(196, 170, 130), M.SmoothPlastic, SOFT)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.ball(parent, o * CFrame.new(sx * 0.22, 1.18, -0.7), 0.09, C.black, M.SmoothPlastic, SOFT)
	end
end

----------------------------------------------------------------------
-- The Eight Auspicious Symbols (floating golden figures). "o" is the centre.
----------------------------------------------------------------------
local FIND = { collide = false, shadow = false }

function Props.symbol(parent, o, id)
	local gold = C.goldBright
	local red = Color3.fromRGB(190, 40, 44)
	if id == "vase" then
		Kit.blob(parent, o, V(1.9, 1.9, 1.9), gold, M.Metal, FIND)
		Kit.cyl(parent, o * CFrame.new(0, -1, 0), 1.1, 0.3, gold, M.Metal, FIND)
		Kit.cyl(parent, o * CFrame.new(0, 1.1, 0), 0.9, 0.7, gold, M.Metal, FIND)
		Kit.cyl(parent, o * CFrame.new(0, 1.5, 0), 1.4, 0.2, gold, M.Metal, FIND)
		Kit.ball(parent, o * CFrame.new(0, 1.95, 0), 0.6, red, M.Neon, FIND)
	elseif id == "parasol" then
		Kit.cyl(parent, o, 0.2, 3.2, gold, M.Metal, FIND)
		Kit.blob(parent, o * CFrame.new(0, 1.7, 0), V(3, 1.3, 3), gold, M.Metal, FIND)
		Kit.cyl(parent, o * CFrame.new(0, 1.3, 0), 3, 0.3, red, M.Fabric, FIND)
		Kit.ball(parent, o * CFrame.new(0, 2.45, 0), 0.45, gold, M.Neon, FIND)
	elseif id == "fishes" then
		for _, sx in ipairs({ -1, 1 }) do
			local f = o * CFrame.new(sx * 0.6, 0, 0) * CFrame.Angles(rad(sx * 90 - 90), rad(sx * 12), 0)
			Kit.blob(parent, f, V(0.7, 1, 2.3), gold, M.Metal, FIND)
			Kit.block(parent, f * CFrame.new(0, 0, 1.35), V(0.1, 0.9, 0.6), gold, M.Metal, FIND)
			Kit.ball(parent, f * CFrame.new(0.3, 0.15, -0.75), 0.16, C.black, M.SmoothPlastic, FIND)
		end
	elseif id == "knot" then
		local k = o * CFrame.Angles(0, 0, rad(45))
		for _, d in ipairs({ -0.75, 0, 0.75 }) do
			Kit.block(parent, k * CFrame.new(d, 0, 0), V(0.3, 2.6, 0.3), gold, M.Metal, FIND)
			Kit.block(parent, k * CFrame.new(0, d, 0), V(2.6, 0.3, 0.34), gold, M.Metal, FIND)
		end
	elseif id == "conch" then
		Kit.blob(parent, o, V(1.5, 1.5, 2.4), C.white, M.SmoothPlastic, FIND)
		Kit.blob(parent, o * CFrame.new(0, 0, -1.2), V(1, 1, 1.5), C.white, M.SmoothPlastic, FIND)
		Kit.ball(parent, o * CFrame.new(0, 0, 1.3), 0.6, gold, M.Metal, FIND)
		Kit.ball(parent, o * CFrame.new(0, 0, -2), 0.4, gold, M.Metal, FIND)
	elseif id == "lotus" then
		Props.lotus(parent, o * CFrame.new(0, -0.6, 0), gold, true)
	elseif id == "banner" then
		Kit.cyl(parent, o, 0.2, 3.8, gold, M.Metal, FIND)
		Kit.cyl(parent, o * CFrame.new(0, 0.6, 0), 1.3, 1.6, red, M.Fabric, FIND)
		Kit.cyl(parent, o * CFrame.new(0, -0.3, 0), 1.5, 0.2, gold, M.Metal, FIND)
		Kit.cyl(parent, o * CFrame.new(0, 1.5, 0), 1.7, 0.25, gold, M.Metal, FIND)
		Kit.ball(parent, o * CFrame.new(0, 2.1, 0), 0.5, gold, M.Neon, FIND)
	else -- the wheel
		local face = o * CFrame.Angles(rad(90), 0, 0)
		Kit.cyl(parent, face, 2.8, 0.25, gold, M.Metal, FIND)
		Kit.cyl(parent, face, 0.8, 0.5, red, M.Metal, FIND)
		for i = 0, 3 do
			Kit.block(parent, o * CFrame.Angles(0, 0, rad(i * 45)), V(0.18, 3.3, 0.3), gold, M.Metal, FIND)
		end
	end
end

return Props
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[-- Quests: moves each player through the steps of the journey (see Story.Quests).
-- Other modules report what happened ("talked to the abbot", "dispelled a shadow")
-- and this module works out whether the current step is now complete.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Story = require(Shared:WaitForChild("Story"))
local Remotes = require(script.Parent.Remotes)
local PlayerData = require(script.Parent.PlayerData)

local Quests = {}

local completeHooks = {}
local rewardHooks = {}

-- Other modules can ask to be told when a step is finished, or a reward is given.
function Quests.onComplete(fn)
	table.insert(completeHooks, fn)
end
function Quests.onReward(fn)
	table.insert(rewardHooks, fn)
end

function Quests.current(player)
	local profile = PlayerData.get(player)
	if not profile then
		return nil, 0
	end
	return Story.Quests[profile.stage], profile.stage
end

function Quests.stage(player)
	local profile = PlayerData.get(player)
	return profile and profile.stage or 0
end

-- Has the player reached (or passed) the named step?
function Quests.reached(player, questId)
	local profile = PlayerData.get(player)
	local index = Story.QuestIndex[questId]
	return profile ~= nil and index ~= nil and profile.stage >= index
end

-- Is there an unfinished objective of this kind and target in the current step?
function Quests.active(player, kind, target)
	local profile = PlayerData.get(player)
	if not profile then
		return nil
	end
	local quest = Story.Quests[profile.stage]
	for i, obj in ipairs(quest.objectives) do
		if obj.kind == kind and obj.target == target then
			local have = profile.prog[tostring(i)] or 0
			if have < (obj.count or 1) then
				return obj, i
			end
		end
	end
	return nil
end

local function giveReward(player, reward)
	if not reward then
		return
	end
	local profile = PlayerData.get(player)
	if reward.merit then
		PlayerData.addMerit(player, reward.merit, true)
	end
	if reward.items then
		for item, amount in pairs(reward.items) do
			PlayerData.give(player, item, amount)
			Remotes.notify(player, "Received: " .. Config.Items[item].name, "good")
		end
	end
	if reward.ability then
		profile.abilities[reward.ability] = true
		local def = Config.Abilities[reward.ability]
		if def then
			Remotes.notify(player, "New ability: " .. def.name .. " (" .. def.key .. ")", "good")
		elseif reward.ability == "staff" then
			Remotes.notify(player, "You now carry a walking staff. Your Strike reaches further and hits harder.", "good")
		end
	end
	if reward.robe then
		profile.robes[reward.robe] = true
	end
	if reward.maxCalm then
		profile.bonusCalm = profile.bonusCalm + reward.maxCalm
		PlayerData.refreshCalm(player)
		player:SetAttribute("Calm", PlayerData.maxCalm(player))
		Remotes.notify(player, "Your Calm has deepened (+" .. reward.maxCalm .. ").", "good")
	end
	for _, fn in ipairs(rewardHooks) do
		task.spawn(fn, player, reward)
	end
end

-- Called when a player arrives at a new step.
function Quests.enter(player, quiet)
	local profile = PlayerData.get(player)
	if not profile then
		return
	end
	local quest = Story.Quests[profile.stage]
	if quest.grant and not profile.collected["grant_" .. quest.id] then
		profile.collected["grant_" .. quest.id] = true
		giveReward(player, quest.grant)
	end
	if not quiet then
		Remotes.notify(player, quest.title, "quest")
	end
	PlayerData.push(player)
end

local function complete(player)
	local profile = PlayerData.get(player)
	local quest = Story.Quests[profile.stage]
	if quest.final then
		return
	end
	giveReward(player, quest.reward)
	if quest.outro then
		Remotes.dialog(player, quest.outro, quest.title)
	end
	profile.stage = math.min(#Story.Quests, profile.stage + 1)
	profile.prog = {}
	for _, fn in ipairs(completeHooks) do
		task.spawn(fn, player, quest)
	end
	Quests.enter(player)
	task.spawn(PlayerData.save, player)
end

-- Report that something happened. Returns true if it counted toward the current step.
function Quests.progress(player, kind, target, amount)
	local profile = PlayerData.get(player)
	if not profile then
		return false
	end
	local quest = Story.Quests[profile.stage]
	local changed = false
	for i, obj in ipairs(quest.objectives) do
		if obj.kind == kind and obj.target == target then
			local need = obj.count or 1
			local key = tostring(i)
			local have = profile.prog[key] or 0
			if have < need then
				have = math.min(need, have + (amount or 1))
				profile.prog[key] = have
				changed = true
			end
		end
	end
	if not changed then
		return false
	end
	local done = true
	for i, obj in ipairs(quest.objectives) do
		if (profile.prog[tostring(i)] or 0) < (obj.count or 1) then
			done = false
		end
	end
	if done then
		complete(player)
	else
		PlayerData.push(player)
	end
	return true
end

return Quests
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[-- Remotes: the messages that travel between the server and each player's screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function event(name)
	local e = Instance.new("RemoteEvent")
	e.Name = name
	e.Parent = folder
	return e
end

local Remotes = {
	Action = event("Action"), -- player -> server: "I pressed / chose something"
	State = event("State"), -- server -> player: your progress, bag, robes ...
	Notify = event("Notify"), -- server -> player: a short message
	Dialog = event("Dialog"), -- server -> player: someone speaks, or the story is told
	Fx = event("Fx"), -- server -> players: a visual effect
	UI = event("UI"), -- server -> player: open a window (shop, shrine, robes)
}

-- Shared state of the fight with Mara, readable by every player's screen.
local boss = Instance.new("Folder")
boss.Name = "BossState"
boss:SetAttribute("Phase", "idle")
boss:SetAttribute("Text", "")
boss:SetAttribute("Hp", 0)
boss:SetAttribute("MaxHp", 1)
boss.Parent = ReplicatedStorage
Remotes.BossState = boss

folder.Parent = ReplicatedStorage

-- kind: "info", "good", "warn", "quest", "merit"
function Remotes.notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function Remotes.notifyAll(text, kind)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

-- lines: a list of { speaker, text }. An empty speaker is the storyteller.
function Remotes.dialog(player, lines, title)
	if Remotes.onDialog then
		Remotes.onDialog(player, lines)
	end
	Remotes.Dialog:FireClient(player, lines, title)
end

function Remotes.fx(name, data)
	Remotes.Fx:FireAllClients(name, data)
end

function Remotes.fxTo(player, name, data)
	Remotes.Fx:FireClient(player, name, data)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Rig</string><ProtectedString name="Source"><![CDATA[-- Rig: makes people (and Mara's soldiers) out of the standard Roblox character body.
-- One blank body is created when the server starts; every villager, monk and shadow is a
-- copy of it, recoloured and dressed with simple welded pieces (robes, wraps, turbans).

local Players = game:GetService("Players")

local Rig = {}

local template = nil
local fallback = false

local TORSO = { "UpperTorso", "LowerTorso" }
local LEFT_ARM = { "LeftUpperArm", "LeftLowerArm" }
local RIGHT_ARM = { "RightUpperArm", "RightLowerArm" }
local HANDS = { "LeftHand", "RightHand" }
local LEGS = { "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg" }
local FEET = { "LeftFoot", "RightFoot" }

local ANIM = {
	idle = 507766388,
	walk = 507777826,
	run = 507767714,
	sit = 2506281703,
}

local SKIN = {
	Color3.fromRGB(141, 85, 36), Color3.fromRGB(160, 108, 66), Color3.fromRGB(178, 126, 84),
	Color3.fromRGB(124, 76, 40), Color3.fromRGB(196, 146, 100),
}
local BRIGHT = {
	Color3.fromRGB(214, 60, 60), Color3.fromRGB(232, 136, 24), Color3.fromRGB(40, 120, 190),
	Color3.fromRGB(46, 150, 90), Color3.fromRGB(190, 60, 150), Color3.fromRGB(240, 196, 50),
	Color3.fromRGB(120, 60, 170),
}
local WHITE = Color3.fromRGB(238, 234, 224)
local BLACK = Color3.fromRGB(28, 24, 24)
local GREY = Color3.fromRGB(190, 190, 190)
local GOLD = Color3.fromRGB(226, 178, 54)

----------------------------------------------------------------------
-- The blank body
----------------------------------------------------------------------
local function buildFallback()
	-- A very simple figure, used only if Roblox cannot supply the standard body.
	local model = Instance.new("Model")
	local function part(name, size, pos, transparency)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = CFrame.new(pos)
		p.Transparency = transparency or 0
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = false
		p.Parent = model
		return p
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), 1)
	root.CanCollide = true
	local pieces = {
		part("LowerTorso", Vector3.new(2, 0.4, 1), Vector3.new(0, 2.2, 0)),
		part("UpperTorso", Vector3.new(2, 1.6, 1), Vector3.new(0, 3.2, 0)),
		part("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0)),
		part("LeftUpperArm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0)),
		part("RightUpperArm", Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0)),
		part("LeftUpperLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0)),
		part("RightUpperLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0)),
	}
	for _, p in ipairs(pieces) do
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = p
		w.Parent = p
	end
	local hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.AutomaticScalingEnabled = false
	hum.HipHeight = 2
	hum.RequiresNeck = false
	hum.Parent = model
	model.PrimaryPart = root
	model:SetAttribute("SimpleRig", true)
	return model
end

function Rig.init()
	local ok, result = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if ok and result and result:FindFirstChild("HumanoidRootPart") and result:FindFirstChildOfClass("Humanoid") then
		template = result
		for _, d in ipairs(template:GetDescendants()) do
			if d:IsA("LuaSourceContainer") or d:IsA("BodyColors") or d:IsA("Clothing") or d:IsA("ShirtGraphic") then
				d:Destroy()
			end
		end
		if not template.PrimaryPart then
			template.PrimaryPart = template:FindFirstChild("HumanoidRootPart")
		end
	else
		warn("[Bodhi Path] Could not create the standard character body; using simple figures instead.", result)
		template = buildFallback()
		fallback = true
	end
	template.Name = "RigTemplate"
end

function Rig.isSimple()
	return fallback
end

----------------------------------------------------------------------
-- Dressing
----------------------------------------------------------------------
local function paint(model, names, color, style)
	for _, name in ipairs(names) do
		local p = model:FindFirstChild(name)
		if p and p:IsA("BasePart") then
			p.Color = color
			if style.material then
				p.Material = style.material
			end
			if style.transparency then
				p.Transparency = style.transparency
			end
		end
	end
end

-- Weld a simple piece onto a body part. shape: nil (block), "ball", "blob"
local function attach(model, baseName, offset, size, color, material, shape)
	local base = model:FindFirstChild(baseName)
	if not base then
		return nil
	end
	local p = Instance.new("Part")
	p.Name = "Dress"
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Fabric
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.Massless = true
	p.Anchored = false
	if shape == "ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "blob" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.CFrame = base.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	p.Parent = model
	return p
end
Rig.attach = attach

local function torsoName(model)
	if model:FindFirstChild("LowerTorso") then
		return "LowerTorso", "UpperTorso"
	end
	return "Torso", "Torso"
end

-- Pieces of clothing. Each is safe to call on any rig.
local Dress = {}

function Dress.wrap(model, color, length)
	local lower = torsoName(model)
	local len = length or 2.1
	local yOff = (lower == "Torso") and (-1 - len / 2) or (-0.15 - len / 2)
	attach(model, lower, CFrame.new(0, yOff, 0), Vector3.new(2.14, len, 1.18), color)
end

function Dress.sash(model, color, leftToRight)
	local _, upper = torsoName(model)
	local angle = leftToRight and -34 or 34
	attach(model, upper, CFrame.new(0, 0.05, 0) * CFrame.Angles(0, 0, math.rad(angle)), Vector3.new(0.55, 2.5, 1.14), color)
end

function Dress.shoulder(model, color)
	local _, upper = torsoName(model)
	attach(model, upper, CFrame.new(-0.72, 0.84, 0), Vector3.new(1.3, 0.3, 1.2), color)
end

function Dress.hair(model, color, style)
	attach(model, "Head", CFrame.new(0, 0.38, 0.06), Vector3.new(1.34, 0.72, 1.34), color, Enum.Material.SmoothPlastic, "blob")
	if style == "bun" then
		attach(model, "Head", CFrame.new(0, 0.3, 0.68), Vector3.new(0.7, 0.7, 0.7), color, Enum.Material.SmoothPlastic, "ball")
	elseif style == "long" then
		attach(model, "Head", CFrame.new(0, -0.3, 0.6), Vector3.new(1.1, 1.3, 0.3), color, Enum.Material.SmoothPlastic)
	elseif style == "topknot" then
		attach(model, "Head", CFrame.new(0, 0.9, 0), Vector3.new(0.72, 0.72, 0.72), color, Enum.Material.SmoothPlastic, "ball")
	end
end

function Dress.turban(model, color)
	attach(model, "Head", CFrame.new(0, 0.5, 0), Vector3.new(1.56, 0.95, 1.56), color, Enum.Material.Fabric, "blob")
	attach(model, "Head", CFrame.new(0, 0.62, -0.7), Vector3.new(0.3, 0.3, 0.3), GOLD, Enum.Material.Metal, "ball")
end

function Dress.beard(model, color, long)
	attach(model, "Head", CFrame.new(0, -0.62 - (long and 0.25 or 0), -0.48), Vector3.new(0.8, long and 1.2 or 0.6, 0.3), color, Enum.Material.SmoothPlastic)
end

function Dress.staff(model, color)
	attach(model, "RightHand", CFrame.new(0, 1.3, -0.35), Vector3.new(0.26, 5.6, 0.26), color or Color3.fromRGB(104, 78, 56), Enum.Material.Wood)
end

function Dress.bindi(model)
	attach(model, "Head", CFrame.new(0, 0.22, -0.6), Vector3.new(0.14, 0.14, 0.14), Color3.fromRGB(200, 30, 40), Enum.Material.SmoothPlastic, "ball")
end

function Dress.crown(model, color)
	attach(model, "Head", CFrame.new(0, 0.72, 0), Vector3.new(1.4, 0.5, 1.4), color or GOLD, Enum.Material.Metal, "blob")
	for i = -1, 1 do
		attach(model, "Head", CFrame.new(i * 0.4, 1.1 - math.abs(i) * 0.12, -0.3), Vector3.new(0.22, 0.7, 0.22), color or GOLD, Enum.Material.Metal)
	end
end

function Dress.horns(model, color)
	attach(model, "Head", CFrame.new(-0.45, 0.8, 0) * CFrame.Angles(0, 0, math.rad(24)), Vector3.new(0.22, 0.9, 0.22), color, Enum.Material.SmoothPlastic)
	attach(model, "Head", CFrame.new(0.45, 0.8, 0) * CFrame.Angles(0, 0, math.rad(-24)), Vector3.new(0.22, 0.9, 0.22), color, Enum.Material.SmoothPlastic)
end

function Dress.eyes(model, color)
	attach(model, "Head", CFrame.new(-0.26, 0.12, -0.58), Vector3.new(0.2, 0.2, 0.2), color, Enum.Material.Neon, "ball")
	attach(model, "Head", CFrame.new(0.26, 0.12, -0.58), Vector3.new(0.2, 0.2, 0.2), color, Enum.Material.Neon, "ball")
end

function Dress.weapon(model, color)
	attach(model, "RightHand", CFrame.new(0, -0.1, -1.7) * CFrame.Angles(math.rad(90), 0, 0), Vector3.new(0.28, 4.8, 0.28), Color3.fromRGB(40, 34, 40), Enum.Material.Wood)
	attach(model, "RightHand", CFrame.new(0, -0.1, -4.3) * CFrame.Angles(math.rad(90), 0, 0), Vector3.new(0.6, 1.3, 0.14), color, Enum.Material.Metal)
end

local function face(model, show)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local decal = head:FindFirstChildOfClass("Decal")
	if show and not decal then
		decal = Instance.new("Decal")
		decal.Name = "face"
		decal.Face = Enum.NormalId.Front
		decal.Texture = "rbxasset://textures/face.png"
		decal.Parent = head
	elseif not show and decal then
		decal:Destroy()
	end
end

-- Monastic robe: one colour for body and wrap, a sash, right shoulder bare if asked.
local function robe(model, skin, main, sashColor, bare, style)
	paint(model, { "Head" }, skin, style)
	paint(model, HANDS, skin, style)
	paint(model, FEET, skin, style)
	paint(model, TORSO, main, style)
	paint(model, LEGS, main, style)
	paint(model, LEFT_ARM, main, style)
	paint(model, RIGHT_ARM, bare and skin or main, style)
	Dress.wrap(model, main, 2.3)
	Dress.sash(model, sashColor, false)
	Dress.shoulder(model, sashColor)
end
Rig.robe = robe
Rig.Dress = Dress

----------------------------------------------------------------------
-- Looks
----------------------------------------------------------------------
local Looks = {}

local function layman(model, rng, style, top, bottom, bareChest)
	local skin = SKIN[rng:NextInteger(1, #SKIN)]
	paint(model, { "Head" }, skin, style)
	paint(model, HANDS, skin, style)
	paint(model, FEET, skin, style)
	paint(model, LEFT_ARM, skin, style)
	paint(model, RIGHT_ARM, skin, style)
	paint(model, TORSO, bareChest and skin or top, style)
	paint(model, LEGS, skin, style)
	Dress.wrap(model, bottom, 1.9)
	return skin
end

function Looks.abbot(model, rng, style)
	robe(model, SKIN[2], Color3.fromRGB(150, 70, 30), GOLD, true, style)
end
function Looks.monk(model, rng, style)
	robe(model, SKIN[rng:NextInteger(1, #SKIN)], Color3.fromRGB(232, 136, 24), Color3.fromRGB(205, 110, 14), true, style)
end
function Looks.nun(model, rng, style)
	robe(model, SKIN[3], Color3.fromRGB(176, 110, 48), Color3.fromRGB(140, 84, 36), false, style)
end
function Looks.novice(model, rng, style)
	robe(model, SKIN[rng:NextInteger(1, #SKIN)], WHITE, Color3.fromRGB(205, 200, 188), false, style)
	style.scale = 0.78
end
function Looks.merchant(model, rng, style)
	layman(model, rng, style, Color3.fromRGB(236, 222, 190), WHITE, false)
	paint(model, LEFT_ARM, Color3.fromRGB(236, 222, 190), style)
	paint(model, RIGHT_ARM, Color3.fromRGB(236, 222, 190), style)
	Dress.turban(model, Color3.fromRGB(232, 136, 24))
	Dress.sash(model, Color3.fromRGB(150, 44, 34), true)
	Dress.beard(model, BLACK, false)
end
function Looks.villager_m(model, rng, style)
	local top = BRIGHT[rng:NextInteger(1, #BRIGHT)]
	layman(model, rng, style, top, WHITE, rng:NextNumber() < 0.4)
	if rng:NextNumber() < 0.6 then
		Dress.turban(model, BRIGHT[rng:NextInteger(1, #BRIGHT)])
	else
		Dress.hair(model, BLACK)
	end
end
function Looks.villager_f(model, rng, style)
	local sari = BRIGHT[rng:NextInteger(1, #BRIGHT)]
	local trim = BRIGHT[rng:NextInteger(1, #BRIGHT)]
	layman(model, rng, style, trim, sari, false)
	Dress.wrap(model, sari, 2.4)
	Dress.sash(model, sari, true)
	Dress.hair(model, BLACK, "bun")
	Dress.bindi(model)
end
function Looks.farmer(model, rng, style)
	layman(model, rng, style, WHITE, Color3.fromRGB(196, 170, 130), true)
	Dress.turban(model, WHITE)
end
function Looks.elder_m(model, rng, style)
	layman(model, rng, style, WHITE, WHITE, false)
	Dress.hair(model, GREY)
	Dress.beard(model, GREY, true)
	Dress.staff(model)
	style.scale = 0.94
end
function Looks.elder_f(model, rng, style)
	layman(model, rng, style, WHITE, WHITE, false)
	Dress.wrap(model, WHITE, 2.4)
	Dress.sash(model, Color3.fromRGB(214, 200, 170), true)
	Dress.hair(model, GREY, "bun")
	style.scale = 0.92
end
function Looks.child(model, rng, style)
	layman(model, rng, style, BRIGHT[rng:NextInteger(1, #BRIGHT)], BRIGHT[rng:NextInteger(1, #BRIGHT)], false)
	Dress.hair(model, BLACK, (rng:NextNumber() < 0.5) and "bun" or nil)
	style.scale = 0.66
end
function Looks.sick(model, rng, style)
	layman(model, rng, style, Color3.fromRGB(170, 160, 150), Color3.fromRGB(150, 140, 130), true)
	paint(model, { "Head" }, Color3.fromRGB(170, 140, 110), style)
	Dress.hair(model, BLACK)
end
function Looks.mourner(model, rng, style)
	layman(model, rng, style, WHITE, WHITE, false)
	paint(model, LEFT_ARM, WHITE, style)
	paint(model, RIGHT_ARM, WHITE, style)
	Dress.hair(model, BLACK)
end
function Looks.ascetic(model, rng, style)
	layman(model, rng, style, WHITE, Color3.fromRGB(176, 120, 60), true)
	Dress.hair(model, Color3.fromRGB(60, 44, 34), "topknot")
	Dress.beard(model, Color3.fromRGB(60, 44, 34), false)
	style.scale = 0.96
end
function Looks.channa(model, rng, style)
	layman(model, rng, style, Color3.fromRGB(40, 70, 170), WHITE, false)
	paint(model, LEFT_ARM, Color3.fromRGB(40, 70, 170), style)
	paint(model, RIGHT_ARM, Color3.fromRGB(40, 70, 170), style)
	Dress.turban(model, Color3.fromRGB(190, 40, 44))
	Dress.sash(model, GOLD, true)
end
function Looks.sage(model, rng, style)
	robe(model, SKIN[3], Color3.fromRGB(190, 130, 60), Color3.fromRGB(150, 96, 40), true, style)
	Dress.hair(model, WHITE, "topknot")
	Dress.beard(model, WHITE, true)
end
function Looks.sage2(model, rng, style)
	robe(model, SKIN[1], Color3.fromRGB(150, 96, 52), Color3.fromRGB(110, 70, 36), true, style)
	Dress.hair(model, GREY, "topknot")
	Dress.beard(model, GREY, true)
end
function Looks.sujata(model, rng, style)
	local sari = Color3.fromRGB(196, 40, 60)
	layman(model, rng, style, GOLD, sari, false)
	Dress.wrap(model, sari, 2.4)
	Dress.sash(model, GOLD, true)
	Dress.hair(model, BLACK, "bun")
	Dress.bindi(model)
	attach(model, "Head", CFrame.new(0.4, 0.5, 0.6), Vector3.new(0.34, 0.34, 0.34), WHITE, Enum.Material.SmoothPlastic, "ball")
end

-- A soldier of Mara's host: a dark, glowing figure. cfg comes from Config.Enemies.
function Looks.enemy(model, rng, style, cfg)
	local body = Color3.fromRGB(cfg.color[1], cfg.color[2], cfg.color[3])
	local glow = Color3.fromRGB(cfg.glow[1], cfg.glow[2], cfg.glow[3])
	local all = { "Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm", "LeftHand", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg", "LeftFoot", "RightFoot" }
	style.material = Enum.Material.SmoothPlastic
	paint(model, all, body, style)
	face(model, false)
	Dress.eyes(model, glow)
	if cfg.daughter then
		Dress.wrap(model, glow, 2.4)
		Dress.sash(model, GOLD, true)
		Dress.crown(model, GOLD)
		Dress.hair(model, BLACK, "long")
	else
		Dress.horns(model, glow)
		Dress.wrap(model, Color3.fromRGB(30, 26, 32), 1.4)
		Dress.weapon(model, glow)
	end
	local torso = model:FindFirstChild("UpperTorso")
	if torso then
		local light = Instance.new("PointLight")
		light.Color = glow
		light.Range = 10
		light.Brightness = 1.4
		light.Shadows = false
		light.Parent = torso
		local e = Instance.new("ParticleEmitter")
		e.Rate = 8
		e.Lifetime = NumberRange.new(0.8, 1.4)
		e.Speed = NumberRange.new(0.5, 2)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		e.Color = ColorSequence.new(glow)
		e.LightEmission = 0.6
		e.Parent = torso
	end
	style.scale = cfg.scale or 1
end

-- Mara himself: crowned, four-armed, armed.
function Looks.mara(model, rng, style)
	local body = Color3.fromRGB(70, 20, 90)
	local glow = Color3.fromRGB(255, 70, 50)
	local all = { "Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "RightUpperArm", "RightLowerArm", "LeftHand", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "RightUpperLeg", "RightLowerLeg", "LeftFoot", "RightFoot" }
	paint(model, all, body, style)
	face(model, false)
	Dress.eyes(model, glow)
	Dress.crown(model, GOLD)
	Dress.wrap(model, Color3.fromRGB(120, 16, 30), 2.2)
	Dress.sash(model, GOLD, true)
	Dress.weapon(model, glow)
	local _, upper = torsoName(model)
	for _, sx in ipairs({ -1, 1 }) do
		attach(model, upper, CFrame.new(sx * 1.7, 0.6, 0.2) * CFrame.Angles(0, 0, math.rad(sx * -62)), Vector3.new(0.8, 2.6, 0.8), body, Enum.Material.SmoothPlastic)
		attach(model, upper, CFrame.new(sx * 3, 1.5, 0.2), Vector3.new(0.3, 3.4, 0.3), GOLD, Enum.Material.Metal)
	end
	local torso = model:FindFirstChild(upper)
	if torso then
		local light = Instance.new("PointLight")
		light.Color = glow
		light.Range = 30
		light.Brightness = 2
		light.Shadows = false
		light.Parent = torso
	end
end

----------------------------------------------------------------------
-- Making and animating
----------------------------------------------------------------------
local lookRng = Random.new(77)

-- Make a figure. look = a name in Looks; extra is passed through (enemy settings).
function Rig.make(name, look, extra)
	local model = template:Clone()
	model.Name = name
	local hum = model:FindFirstChildOfClass("Humanoid")
	local style = {}
	face(model, true)
	local fn = Looks[look] or Looks.villager_m
	fn(model, lookRng, style, extra)
	if style.scale and style.scale ~= 1 then
		model:ScaleTo(style.scale)
		if fallback then
			hum.HipHeight = 2 * style.scale
		end
	end
	hum.DisplayName = name
	hum.BreakJointsOnDeath = false
	return model, hum
end

-- Put a figure on the ground at "cf" (a ground-level frame) and add it to the world.
function Rig.place(model, cf, parent)
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	local lift = hum.HipHeight + root.Size.Y / 2 + 0.3
	model:PivotTo(cf * CFrame.new(0, lift, 0))
	model.Parent = parent
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
end

-- Give a figure its idle / walk / sit animations. "fast" uses the run cycle.
function Rig.animate(model, fast)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum or fallback then
		return nil
	end
	local tracks = nil
	local ok, err = pcall(function()
		local animator = hum:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = hum
		end
		local function load(id)
			local a = Instance.new("Animation")
			a.AnimationId = "rbxassetid://" .. id
			return animator:LoadAnimation(a)
		end
		local idle = load(ANIM.idle)
		local move = load(fast and ANIM.run or ANIM.walk)
		local sit = load(ANIM.sit)
		tracks = { idle = idle, move = move, sit = sit }
		idle:Play()
		hum.Running:Connect(function(speed)
			if speed > 0.5 then
				if not move.IsPlaying then
					move:Play(0.2)
				end
			elseif move.IsPlaying then
				move:Stop(0.2)
			end
		end)
		hum.Seated:Connect(function(active)
			if active then
				idle:Stop(0.2)
				move:Stop(0.2)
				sit:Play(0.2)
			else
				sit:Stop(0.2)
				idle:Play(0.2)
			end
		end)
	end)
	if not ok then
		warn("[Bodhi Path] Animation setup failed:", err)
	end
	return tracks
end

return Rig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">Robes</string><ProtectedString name="Source"><![CDATA[-- Robes: dresses a player's avatar as a monastic.
-- The avatar keeps its own face, hair and body. Everything it was wearing (shirt, trousers,
-- jackets, shoes, hats, backpacks and the like) is taken off and replaced by a robe in the
-- chosen colours, with a wrap and a sash. "My Own Clothes" restores the avatar.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PlayerData = require(script.Parent.PlayerData)
local Combat = require(script.Parent.Combat)
local Rig = require(script.Parent.Rig)
local Cosmetics = require(script.Parent.Cosmetics)

local Robes = {}

local originals = {} -- [character] = the avatar's own look

local function robeDef(id)
	for _, r in ipairs(Config.Robes) do
		if r.id == id then
			return r
		end
	end
	return nil
end
Robes.def = robeDef

-- Kinds of worn thing that stay on with a robe: they are part of the face and head.
local KEPT = {
	[Enum.AccessoryType.Hair] = true,
	[Enum.AccessoryType.Face] = true,
	[Enum.AccessoryType.Eyebrow] = true,
	[Enum.AccessoryType.Eyelash] = true,
}

-- Take off everything the avatar was wearing.
local function undress(desc)
	desc.Shirt = 0
	desc.Pants = 0
	desc.GraphicTShirt = 0
	desc.HatAccessory = ""
	desc.BackAccessory = ""
	desc.FrontAccessory = ""
	desc.NeckAccessory = ""
	desc.ShouldersAccessory = ""
	desc.WaistAccessory = ""
	-- layered clothing: jackets, sweaters, trousers, skirts, shoes ...
	pcall(function()
		local kept = {}
		for _, worn in ipairs(desc:GetAccessories(false)) do
			if KEPT[worn.AccessoryType] then
				table.insert(kept, worn)
			end
		end
		desc:SetAccessories(kept, false)
	end)
end

local function clearPieces(character)
	for _, child in ipairs(character:GetChildren()) do
		if child.Name == "RobePiece" then
			child:Destroy()
		end
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d.Name == "RobeGlow" then
			d:Destroy()
		end
	end
end

function Robes.apply(player)
	local character = player.Character
	local profile = PlayerData.get(player)
	if not character or not profile then
		return
	end
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return
	end
	local def = robeDef(profile.robe) or robeDef("novice")

	if not originals[character] then
		local ok, desc = pcall(function()
			return hum:GetAppliedDescription()
		end)
		if ok and desc then
			originals[character] = desc
			character.Destroying:Connect(function()
				originals[character] = nil
			end)
		end
	end
	local original = originals[character]

	clearPieces(character)

	if def.id == "own" or not def.main then
		if original then
			pcall(function()
				hum:ApplyDescription(original)
			end)
		end
	else
		local main = Color3.fromRGB(def.main[1], def.main[2], def.main[3])
		local sash = Color3.fromRGB(def.sash[1], def.sash[2], def.sash[3])
		if original then
			pcall(function()
				local desc = original:Clone()
				undress(desc)
				desc.TorsoColor = main
				desc.LeftArmColor = main
				desc.LeftLegColor = main
				desc.RightLegColor = main
				desc.RightArmColor = def.bare and original.HeadColor or main
				hum:ApplyDescription(desc)
			end)
		end
		if character.Parent and hum.Health > 0 then
			Rig.Dress.wrap(character, main, 2.3)
			Rig.Dress.sash(character, sash, false)
			Rig.Dress.shoulder(character, sash)
			for _, child in ipairs(character:GetChildren()) do
				if child.Name == "Dress" then
					child.Name = "RobePiece"
				end
			end
			if def.glow then
				local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
				if torso then
					local light = Instance.new("PointLight")
					light.Name = "RobeGlow"
					light.Color = Color3.fromRGB(255, 226, 150)
					light.Range = 16
					light.Brightness = 1.4
					light.Shadows = false
					light.Parent = torso
					local e = Instance.new("ParticleEmitter")
					e.Name = "RobeGlow"
					e.Rate = 6
					e.Lifetime = NumberRange.new(1.2, 2)
					e.Speed = NumberRange.new(0.4, 1.2)
					e.SpreadAngle = Vector2.new(180, 180)
					e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
					e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
					e.Color = ColorSequence.new(Color3.fromRGB(255, 226, 150))
					e.LightEmission = 0.8
					e.Parent = torso
				end
			end
		end
	end

	-- a trail of prayer-flag colours for those who carry prayer flags
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and (profile.inv.prayer_flags or 0) > 0 and not root:FindFirstChild("FlagTrail") then
		local a0 = Instance.new("Attachment")
		a0.Name = "FlagTrailTop"
		a0.Position = Vector3.new(0, 1.6, 0.6)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Name = "FlagTrailBottom"
		a1.Position = Vector3.new(0, 0.6, 0.6)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Name = "FlagTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 1.1
		trail.MinLength = 0.2
		trail.LightEmission = 0.2
		trail.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 90, 200)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(245, 245, 245)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(205, 44, 44)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(46, 150, 70)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(240, 200, 40)),
		})
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		trail.Parent = root
	end

	Combat.equipWeapon(player)
	Cosmetics.apply(player)
end

return Robes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">Robux</string><ProtectedString name="Source"><![CDATA[-- Robux: the few things that can be bought with Robux. They change only how things
-- look, or are a gift to everyone in the game. Nothing here makes the journey easier.
--
-- The ID numbers live in Config.Robux. While an ID is 0 that item is "coming soon"
-- and cannot be bought.

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = require(script.Parent.Remotes)
local PlayerData = require(script.Parent.PlayerData)
local Combat = require(script.Parent.Combat)
local Cosmetics = require(script.Parent.Cosmetics)

local Robux = {}

local function passById(id)
	for _, def in ipairs(Config.Robux.passes) do
		if def.id == id then
			return def
		end
	end
	return nil
end

local function productById(id)
	for _, def in ipairs(Config.Robux.products) do
		if def.id == id then
			return def
		end
	end
	return nil
end

-- Hand over what a pass includes. Safe to call more than once.
function Robux.grantPass(player, id, quiet)
	local def = passById(id)
	local profile = PlayerData.get(player)
	if not def or not profile then
		return false
	end
	local new = not profile.bought["pass_" .. id]
	profile.bought["pass_" .. id] = true
	if def.robe then
		profile.robes[def.robe] = true
	end
	for _, itemId in ipairs(def.items or {}) do
		if (profile.inv[itemId] or 0) < 1 then
			PlayerData.give(player, itemId, 1)
		end
	end
	if new and not quiet then
		Remotes.notify(player, "Thank you. " .. def.name .. " is yours: look in your Bag and at the robe-maker's.", "good")
	end
	PlayerData.push(player)
	return true
end

-- When a player arrives, see which passes they already own.
function Robux.check(player)
	for _, def in ipairs(Config.Robux.passes) do
		if def.passId > 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, def.passId)
			end)
			if ok and owns and player.Parent then
				Robux.grantPass(player, def.id, true)
			end
		end
	end
end

function Robux.buyPass(player, id)
	local def = passById(id)
	local profile = PlayerData.get(player)
	if not def or not profile then
		return
	end
	if profile.bought["pass_" .. id] then
		Remotes.notify(player, "You already have this.", "info")
	elseif def.passId <= 0 then
		Remotes.notify(player, def.name .. " is not available yet.", "info")
	else
		MarketplaceService:PromptGamePassPurchase(player, def.passId)
	end
end

function Robux.buyProduct(player, id)
	local def = productById(id)
	if not def then
		return
	end
	if def.productId <= 0 then
		Remotes.notify(player, def.name .. " is not available yet.", "info")
	else
		MarketplaceService:PromptProductPurchase(player, def.productId)
	end
end

-- An offering of flowers: petals fall around every player in the game.
function Robux.flowers(player)
	Remotes.notifyAll(player.DisplayName .. " has made an offering of flowers for everyone.", "good")
	task.spawn(function()
		local rng = Random.new()
		for _ = 1, 10 do
			for _, other in ipairs(Players:GetPlayers()) do
				local pos = Combat.position(other)
				if pos then
					local at = pos + Vector3.new(rng:NextNumber(-14, 14), rng:NextNumber(8, 14), rng:NextNumber(-14, 14))
					Remotes.fx("petals", { pos = at, color = Color3.fromRGB(255, 200, 220), big = true })
				end
			end
			task.wait(0.6)
		end
	end)
end

function Robux.start()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, bought)
		if not bought then
			return
		end
		for _, def in ipairs(Config.Robux.passes) do
			if def.passId == passId and def.passId > 0 then
				Robux.grantPass(player, def.id)
				if def.robe then
					local profile = PlayerData.get(player)
					if profile then
						profile.robe = def.robe
						PlayerData.push(player)
						task.spawn(require(script.Parent.Robes).apply, player)
					end
				end
				Cosmetics.apply(player)
			end
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		for _, def in ipairs(Config.Robux.products) do
			if def.productId == receipt.ProductId and def.productId > 0 then
				if def.id == "flowers" then
					Robux.flowers(player)
				end
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
end

return Robux
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX24"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[-- World: builds the whole landscape when the server starts.
-- Terrain (ground, hills, rivers), lighting, the gates between zones, the things to
-- collect, and then each zone's own scenery (see ZonesWest and ZonesEast).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Story = require(Shared:WaitForChild("Story"))
local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)
local B = require(script.Parent.Buildings)

local C = Kit.C
local M = Enum.Material
local terrain = workspace.Terrain

local World = {}

-- Things other server modules need to find again (bells, wheels, shrines, seats ...).
World.objects = {
	shrines = {},
	wheels = {},
	collectibles = {},
	gates = {},
}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

----------------------------------------------------------------------
-- Context shared with the zone builders
----------------------------------------------------------------------
local ctx = {}
ctx.rng = Random.new(20261109)
ctx.objects = World.objects
ctx.rivers = {}
ctx.reserved = {}

function ctx.fill(x0, x1, y0, y1, z0, z1, material)
	terrain:FillBlock(CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), V(x1 - x0, y1 - y0, z1 - z0), material)
end

function ctx.reserve(x, z, r)
	table.insert(ctx.reserved, { x, z, r })
end

function ctx.isFree(x, z, r)
	if math.abs(z) < 10 + r then
		return false
	end
	for _, river in ipairs(ctx.rivers) do
		if math.abs(x - river.x) < river.half + r + 4 then
			return false
		end
	end
	for _, gate in ipairs(Config.Gates) do
		if math.abs(x - gate.x) < 6 + r then
			return false
		end
	end
	for _, c in ipairs(ctx.reserved) do
		local dx, dz = x - c[1], z - c[2]
		local rr = c[3] + r
		if dx * dx + dz * dz < rr * rr then
			return false
		end
	end
	return true
end

-- Scatter "count" things between x0 and x1, keeping clear of roads, rivers and buildings.
function ctx.scatter(x0, x1, count, r, fn, zMax)
	local placed, tries = 0, 0
	local limit = zMax or 144
	while placed < count and tries < count * 14 do
		tries = tries + 1
		local x = ctx.rng:NextNumber(x0, x1)
		local z = ctx.rng:NextNumber(-limit, limit)
		if ctx.isFree(x, z, r) then
			ctx.reserve(x, z, r * 0.8)
			fn(Kit.at(x, z, ctx.rng:NextNumber(0, 360)), x, z)
			placed = placed + 1
		end
	end
end

-- A river or stream running across the road (along Z) at the given x.
function ctx.river(x, width, depth)
	local half = width / 2
	ctx.fill(x - half, x + half, -depth, 72, -320, 320, M.Air)
	ctx.fill(x - half - 4, x + half + 4, -depth - 4, -depth, -320, 320, M.Sand)
	ctx.fill(x - half, x + half, -depth, -2, -320, 320, M.Water)
	ctx.fill(x - half - 6, x - half, -4, 0, -170, 170, M.Sand)
	ctx.fill(x + half, x + half + 6, -4, 0, -170, 170, M.Sand)
	table.insert(ctx.rivers, { x = x, half = half })
end

-- A round pond.
function ctx.pond(x, z, radius)
	terrain:FillCylinder(CFrame.new(x, -1, z), 2, radius, M.Air)
	terrain:FillCylinder(CFrame.new(x, -5, z), 6, radius, M.Water)
	ctx.reserve(x, z, radius + 3)
	local n = math.floor(radius * 1.1)
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		Kit.block(ctx.root, CFrame.new(x + math.cos(a) * (radius + 1.2), 0.1, z + math.sin(a) * (radius + 1.2)) * CFrame.Angles(0, -a, 0), V(2.4, 1.4, (math.pi * 2 * radius / n) + 1), C.stone, M.Cobblestone)
	end
end

-- A strip of road / paving laid into the ground.
function ctx.pave(x0, x1, z0, z1, material)
	ctx.fill(x0, x1, -3, 0, z0, z1, material)
end

-- Something a player can pick up once. Returns the root part.
function ctx.collectible(kind, id, x, y, z, actionText, objectText)
	local root = Kit.block(ctx.pickups, CFrame.new(x, y, z), V(2.4, 2.4, 2.4), C.goldBright, M.SmoothPlastic, { collide = false, shadow = false, transparency = 1, name = id })
	root.CanQuery = false
	root:SetAttribute("CollectId", id)
	root:SetAttribute("Kind", kind)
	local prompt = Kit.prompt(root, actionText, objectText, 13)
	CollectionService:AddTag(root, "Collectible")
	table.insert(World.objects.collectibles, { id = id, kind = kind, root = root, prompt = prompt })
	return root
end

----------------------------------------------------------------------
-- Lighting and sky
----------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 8.6
	Lighting.GeographicLatitude = 24.7 -- Bodh Gaya
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(96, 88, 84)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 132, 120)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 232, 190)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.5
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.3
	Lighting.ExposureCompensation = 0.1

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(222, 206, 178)
	atmosphere.Decay = Color3.fromRGB(150, 120, 92)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.35
	bloom.Size = 30
	bloom.Threshold = 1.1
	bloom.Parent = Lighting

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "Mood"
	cc.Saturation = 0.12
	cc.Contrast = 0.06
	cc.TintColor = Color3.fromRGB(255, 244, 228)
	cc.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.08
	rays.Spread = 0.6
	rays.Parent = Lighting

	terrain.WaterColor = Color3.fromRGB(58, 132, 140)
	terrain.WaterTransparency = 0.45
	terrain.WaterReflectance = 0.25
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8
end

----------------------------------------------------------------------
-- Ground, hills, distant mountains, outer walls
----------------------------------------------------------------------
local hillMaterial = {
	village = M.Grass, road = M.Grass, anoma = M.Grass, forest = M.LeafyGrass,
	uruvela = M.Sandstone, senani = M.Grass, mara = M.Basalt, bodhgaya = M.Grass,
}

local function zoneAt(x)
	for _, z in ipairs(Config.Zones) do
		if x >= z.x0 and x < z.x1 then
			return z
		end
	end
	if x < Config.Zones[1].x0 then
		return Config.Zones[1]
	end
	return Config.Zones[#Config.Zones]
end
World.zoneAt = zoneAt

local function buildGround()
	local rng = ctx.rng
	for i, zone in ipairs(Config.Zones) do
		local x0, x1 = zone.x0, zone.x1
		if i == 1 then
			x0 = x0 - 120
		end
		if i == #Config.Zones then
			x1 = x1 + 120
		end
		ctx.fill(x0, x1, -28, 0, -330, 330, M[zone.ground])
	end
	-- ridges along both sides
	local x = Config.WorldStart - 60
	while x < Config.WorldEnd + 60 do
		local zone = zoneAt(x)
		for _, side in ipairs({ -1, 1 }) do
			local r = rng:NextNumber(52, 78)
			local cx = x + rng:NextNumber(-10, 10)
			terrain:FillBall(V(cx, -12, side * (153 + r)), r, hillMaterial[zone.id])
			if rng:NextNumber() < 0.5 then
				terrain:FillBall(V(cx + rng:NextNumber(-14, 14), r * 0.55, side * (190 + r)), r * 0.62, M.Rock)
			end
		end
		x = x + 40
	end
	-- close off both ends of the valley
	for _, endX in ipairs({ Config.WorldStart - 40, Config.WorldEnd + 72 }) do
		local zone = zoneAt(endX)
		local z = -230
		while z <= 230 do
			terrain:FillBall(V(endX + rng:NextNumber(-8, 8), -10, z), rng:NextNumber(50, 66), hillMaterial[zone.id])
			z = z + 46
		end
	end
	-- the Himalaya, far to the north (simple distant shapes)
	local far = Kit.folder(ctx.root, "Mountains")
	local mx = Config.WorldStart - 200
	while mx < Config.WorldEnd + 300 do
		local size = rng:NextNumber(260, 420)
		local dist = rng:NextNumber(820, 1000) * ((rng:NextNumber() < 0.3) and -1 or 1)
		local cf = CFrame.new(mx, -size * 0.18, dist) * CFrame.Angles(0, math.rad(rng:NextNumber(0, 90)), 0) * CFrame.Angles(math.rad(45), 0, math.rad(35.26))
		Kit.block(far, cf, V(size, size, size), Color3.fromRGB(112, 124, 150), M.Slate, { collide = false, shadow = false })
		Kit.block(far, cf * CFrame.new(size * 0.19, size * 0.19, size * 0.19), V(size * 0.64, size * 0.64, size * 0.64), Color3.fromRGB(238, 242, 250), M.Snow, { collide = false, shadow = false })
		mx = mx + rng:NextNumber(170, 250)
	end
	-- invisible walls so nobody leaves the valley
	local length = Config.WorldEnd - Config.WorldStart + 40
	local midX = (Config.WorldStart + Config.WorldEnd) / 2
	local limits = Kit.folder(ctx.root, "Limits")
	local hidden = { transparency = 1, shadow = false, name = "Limit" }
	Kit.block(limits, CFrame.new(midX, 110, Config.HalfWidth + 40), V(length, 260, 4), C.stone, M.SmoothPlastic, hidden)
	Kit.block(limits, CFrame.new(midX, 110, -Config.HalfWidth - 40), V(length, 260, 4), C.stone, M.SmoothPlastic, hidden)
	Kit.block(limits, CFrame.new(Config.WorldStart + 6, 110, 0), V(4, 260, 400), C.stone, M.SmoothPlastic, hidden)
	Kit.block(limits, CFrame.new(Config.WorldEnd - 4, 110, 0), V(4, 260, 400), C.stone, M.SmoothPlastic, hidden)
end

----------------------------------------------------------------------
-- Gates between zones
----------------------------------------------------------------------
local function buildGates()
	local folder = Kit.folder(ctx.root, "Gates")
	for _, gate in ipairs(Config.Gates) do
		local zone = zoneAt(gate.x + 1)
		local dark = zone.id == "mara"
		local stone = dark and Color3.fromRGB(70, 62, 70) or C.sandstone
		B.torana(folder, Kit.at(gate.x, 0, 90), 22, 24, stone)
		B.wall(folder, gate.x, 12.4, gate.x, Config.HalfWidth + 44, 18, stone, M.Sandstone)
		B.wall(folder, gate.x, -12.4, gate.x, -Config.HalfWidth - 44, 18, stone, M.Sandstone)
		local barrier = Kit.block(folder, CFrame.new(gate.x, 20, 0), V(2.4, 40, 22.4), C.gold, M.SmoothPlastic, { transparency = 1, shadow = false, name = "GateBarrier" })
		barrier:SetAttribute("GateId", gate.id)
		barrier:SetAttribute("MinStage", Story.QuestIndex[gate.quest])
		CollectionService:AddTag(barrier, "GateBarrier")
		local veil = Kit.block(folder, CFrame.new(gate.x, 8.2, 0), V(0.3, 16.4, 19.2), C.goldBright, M.Neon, { transparency = 0.72, shadow = false, collide = false, name = "GateVeil" })
		veil:SetAttribute("GateId", gate.id)
		veil:SetAttribute("MinStage", Story.QuestIndex[gate.quest])
		CollectionService:AddTag(veil, "GateVeil")
		World.objects.gates[gate.id] = { barrier = barrier, veil = veil, x = gate.x }
		ctx.reserve(gate.x, 0, 16)
	end
end

----------------------------------------------------------------------
-- Shrines and things to collect
----------------------------------------------------------------------
local function buildShrines()
	local folder = Kit.folder(ctx.root, "Shrines")
	for _, s in ipairs(Config.Shrines) do
		local _, plinth = B.shrine(folder, Kit.at(s.x, s.z, 0), s.name)
		World.objects.shrines[s.id] = plinth
		ctx.reserve(s.x, s.z, 11)
	end
end

local function buildCollectibles()
	ctx.pickups = Kit.folder(workspace, "Pickups")
	-- Bodhi leaves, each carrying a teaching
	for i, p in ipairs(Config.Leaves) do
		local y = (p.y or 0) + 3.4
		local root = ctx.collectible("leaf", "leaf_" .. i, p.x, y, p.z, "Read", "Bodhi Leaf")
		local leaf = Kit.blob(root, CFrame.new(p.x, y, p.z) * CFrame.Angles(math.rad(25), math.rad(i * 37), math.rad(20)), V(1.7, 0.25, 2.3), Color3.fromRGB(190, 220, 110), M.Neon, { collide = false, shadow = false })
		Kit.block(root, leaf.CFrame * CFrame.new(0, 0, 1.5), V(0.12, 0.12, 1.2), C.gold, M.Neon, { collide = false, shadow = false })
		Kit.sparkle(root, C.goldBright, 7)
		Kit.light(root, Color3.fromRGB(230, 240, 150), 14, 1.2)
		ctx.reserve(p.x, p.z, 4)
	end
	-- kusa grass on the east bank of the Neranjara
	for i, p in ipairs(Config.Kusa) do
		local root = ctx.collectible("kusa", "kusa_" .. i, p.x, 1.6, p.z, "Gather", "Kusa Grass")
		for k = 1, 7 do
			local cf = CFrame.new(p.x + ctx.rng:NextNumber(-1.2, 1.2), 0, p.z + ctx.rng:NextNumber(-1.2, 1.2)) * CFrame.Angles(math.rad(ctx.rng:NextNumber(-14, 14)), math.rad(ctx.rng:NextNumber(0, 180)), math.rad(ctx.rng:NextNumber(-14, 14)))
			Kit.block(root, cf * CFrame.new(0, 1.9, 0), V(0.22, 3.8, 0.5), (k % 2 == 0) and Color3.fromRGB(160, 190, 90) or Color3.fromRGB(128, 168, 76), M.Grass, { collide = false, shadow = false })
		end
		Kit.sparkle(root, Color3.fromRGB(200, 240, 140), 3)
		ctx.reserve(p.x, p.z, 4)
	end
	-- the Eight Auspicious Symbols, one hidden in each land
	for _, p in ipairs(Config.Symbols) do
		local y = 4
		local root = ctx.collectible("symbol", "symbol_" .. p.id, p.x, y, p.z, "Look closely", p.name)
		Props.symbol(root, CFrame.new(p.x, y, p.z), p.id)
		Kit.sparkle(root, C.goldBright, 10)
		Kit.light(root, Color3.fromRGB(255, 220, 130), 16, 1.4)
	end
	-- animals of the Jataka tales
	for _, p in ipairs(Config.Animals) do
		local root = ctx.collectible("animal", "animal_" .. p.id, p.x, 2.2, p.z, "Share rice", p.name)
		local o = Kit.at(p.x, p.z, p.yaw or 0)
		if p.kind == "deer" then
			Props.deer(root, o, Color3.fromRGB(226, 180, 84))
		elseif p.kind == "elephant" then
			Props.elephant(root, o, 0.42, Color3.fromRGB(238, 234, 226), { name = "Chaddanta" })
		elseif Props[p.kind] then
			Props[p.kind](root, o)
		end
		Kit.sparkle(root, Color3.fromRGB(255, 240, 190), 2)
	end
	-- lotus flowers in the ponds
	for i, p in ipairs(Config.Lotus) do
		local root = ctx.collectible("lotus", "lotus_" .. i, p.x, -0.4, p.z, "Pick", "Lotus Flower")
		Props.lotus(root, CFrame.new(p.x, -0.95, p.z), (i % 2 == 0) and C.lotusWhite or C.lotusPink, true)
	end
end

----------------------------------------------------------------------
-- Build everything
----------------------------------------------------------------------
function World.build()
	local started = os.clock()
	ctx.root = Kit.folder(workspace, "World")
	ctx.Config = Config
	ctx.Story = Story

	setupLighting()
	buildGround()

	-- where players first appear
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Arrival"
	spawn.Anchored = true
	spawn.Size = V(12, 1, 12)
	spawn.CFrame = CFrame.new(Config.Places.spawn.x, 0.2, Config.Places.spawn.z) * CFrame.Angles(0, math.rad(-90), 0)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = ctx.root
	World.objects.spawn = spawn

	-- keep scenery away from the people and places of the story
	for _, npc in ipairs(Story.NPCs) do
		ctx.reserve(npc.x, npc.z, 5)
	end
	for _, s in ipairs(Config.MeditationSpots) do
		ctx.reserve(s.x, s.z, 8)
	end
	for _, p in ipairs(Config.Leaves) do
		ctx.reserve(p.x, p.z, 5)
	end
	for _, p in ipairs(Config.Kusa) do
		ctx.reserve(p.x, p.z, 5)
	end
	for _, p in ipairs(Config.Symbols) do
		ctx.reserve(p.x, p.z, 6)
	end
	for _, p in ipairs(Config.Animals) do
		ctx.reserve(p.x, p.z, p.kind == "elephant" and 10 or 6)
	end
	for _, s in ipairs(Config.Spawns) do
		ctx.reserve(s.x, s.z, 4)
	end

	-- rivers first, so that everything else can keep clear of them
	for _, river in ipairs(Config.Rivers) do
		ctx.river(river.x, river.width, river.depth)
	end

	buildGates()
	buildShrines()

	local west = require(script.Parent.ZonesWest)
	local east = require(script.Parent.ZonesEast)
	west.build(ctx)
	east.build(ctx)

	buildCollectibles()

	print(string.format("[Bodhi Path] World built in %.2f seconds", os.clock() - started))
end

World.ctx = ctx

return World
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">ZonesEast</string><ProtectedString name="Source"><![CDATA[-- ZonesEast: the second half of the journey.
-- Uruvela (the grove of austerities), Senani village and the Neranjara river,
-- Mara's Field, and Bodh Gaya with the Bodhi tree.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)
local B = require(script.Parent.Buildings)

local C = Kit.C
local M = Enum.Material

local Zones = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local FLOWER = {
	Color3.fromRGB(240, 150, 30), Color3.fromRGB(236, 80, 90), Color3.fromRGB(250, 220, 80),
	Color3.fromRGB(240, 240, 240), Color3.fromRGB(190, 110, 220),
}

----------------------------------------------------------------------
-- Uruvela
----------------------------------------------------------------------
local function uruvela(ctx)
	local root = Kit.folder(ctx.root, "Uruvela")
	local rng = ctx.rng
	local P = ctx.Config.Places
	ctx.pave(1220, 1580, -7, 7, M.Sand)

	-- the camp of the five ascetics
	Props.campfire(root, Kit.at(P.ascetic_camp.x + 2, P.ascetic_camp.z - 2, 0))
	B.hut(root, Kit.at(1296, -78, Kit.yawToward(1296, -78, 1322, -52)), 5)
	ctx.reserve(1296, -78, 8)
	ctx.reserve(P.ascetic_camp.x, P.ascetic_camp.z, 20)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		Kit.cyl(root, CFrame.new(P.ascetic_camp.x + 2 + math.cos(a) * 9, 0.2, P.ascetic_camp.z - 2 + math.sin(a) * 9), 3, 0.4, C.thatch, M.Fabric, { collide = false, shadow = false })
	end
	ctx.pave(1318, 1326, -36, -7, M.Sand)

	-- the cave
	B.cave(root, Kit.at(P.cave.x, P.cave.z, Kit.FACE_NEG_Z))
	ctx.reserve(P.cave.x, P.cave.z, 30)
	ctx.pave(P.cave.x - 4, P.cave.x + 4, 7, P.cave.z - 18, M.Sand)
	Props.signpost(root, Kit.at(P.cave.x + 7, 11, 90), "The Cave of Austerities")
	Props.signpost(root, Kit.at(1330, -11, 90), "Camp of the Five Ascetics")

	-- one green tree in a dry land: the memory of the rose-apple tree
	Props.roundTree(root, Kit.at(1486, -84, 0), 1.5, C.leaf)
	Kit.block(root, CFrame.new(1486, 0.3, -76), V(6, 0.6, 5), C.stone, M.Slate)
	ctx.reserve(1486, -84, 12)

	local sand = Color3.fromRGB(190, 160, 120)
	local sandDark = Color3.fromRGB(150, 122, 92)
	ctx.scatter(1224, 1576, 54, 4.5, function(o)
		Props.rock(root, o, rng:NextNumber(0.9, 2.6), (rng:NextNumber() < 0.5) and sand or sandDark, rng)
	end)
	ctx.scatter(1224, 1576, 22, 7, function(o)
		Props.roundTree(root, o, rng:NextNumber(0.7, 1.1), C.leafDry)
	end)
	ctx.scatter(1224, 1576, 10, 5, function(o)
		Props.deadTree(root, o, rng:NextNumber(0.7, 1))
	end)
	ctx.scatter(1224, 1576, 30, 3, function(o)
		Props.bush(root, o, rng:NextNumber(0.6, 1.1), C.leafDry)
	end)
end

----------------------------------------------------------------------
-- Senani and the Neranjara
----------------------------------------------------------------------
local function senani(ctx)
	local root = Kit.folder(ctx.root, "Senani")
	local rng = ctx.rng
	local P = ctx.Config.Places
	local rx, half = P.neranjara.x, P.neranjara.width / 2
	ctx.pave(1580, 1800, -8, 8, M.Cobblestone)
	ctx.pave(1800, rx - half - 16, -7, 7, M.Ground)
	ctx.pave(rx + half + 2, 2040, -7, 7, M.Ground)
	ctx.pave(1638, 1650, -44, -8, M.Cobblestone)
	ctx.pave(1696, 1704, 8, 36, M.Ground)

	B.shop(root, Kit.at(P.store2.x, P.store2.z, Kit.FACE_POS_Z), "Senani Trading Post", { awning = C.flagBlue, wall = C.sandstoneLight, band = C.flagBlue })
	ctx.reserve(P.store2.x, P.store2.z, 24)

	local houses = {
		{ 1650, 60, Kit.FACE_NEG_Z, "thatch", C.mud },
		{ 1612, -66, Kit.FACE_POS_Z, "flat", C.ivory },
		{ 1742, -58, Kit.FACE_POS_Z, "tile", C.mud },
		{ 1778, 60, Kit.FACE_NEG_Z, "flat", C.sandstoneLight },
		{ 1696, -108, Kit.FACE_POS_Z, "thatch", C.mud },
		{ 1616, 104, Kit.FACE_NEG_Z, "tile", C.ivory },
	}
	for i, h in ipairs(houses) do
		B.house(root, Kit.at(h[1], h[2], h[3]), { roof = h[4], wall = h[5], band = (i % 2 == 0) and C.saffron or C.flagGreen, rug = FLOWER[i % #FLOWER + 1] })
		ctx.reserve(h[1], h[2], 17)
	end

	-- Sujata's banyan, with the offerings left at its roots
	Props.banyan(root, Kit.at(P.sujata_tree.x, P.sujata_tree.z + 6, 0), 1.2)
	ctx.reserve(P.sujata_tree.x, P.sujata_tree.z + 6, 12)
	Kit.block(root, CFrame.new(1692, 1, 50), V(5, 2, 3), C.sandstone, M.Sandstone)
	Props.butterLamp(root, CFrame.new(1690.6, 2, 50))
	Props.butterLamp(root, CFrame.new(1693.4, 2, 50))
	Props.flowers(root, Kit.at(1688, 46, 0), Color3.fromRGB(240, 150, 30), rng)
	Props.flowers(root, Kit.at(1697, 47, 0), Color3.fromRGB(236, 80, 90), rng)
	Props.flags(root, V(1680, 13, 40), V(1722, 13, 40), true)

	-- cattle pen
	local px, pz = 1752, 98
	for _, sx in ipairs({ -1, 1 }) do
		Kit.block(root, CFrame.new(px + sx * 16, 2.2, pz), V(0.4, 0.4, 24), C.wood, M.Wood)
		Kit.block(root, CFrame.new(px + sx * 16, 1.2, pz), V(0.4, 0.4, 24), C.wood, M.Wood)
		Kit.block(root, CFrame.new(px, 2.2, pz + sx * 12), V(32, 0.4, 0.4), C.wood, M.Wood)
		Kit.block(root, CFrame.new(px, 1.2, pz + sx * 12), V(32, 0.4, 0.4), C.wood, M.Wood)
		for _, sz in ipairs({ -1, 1 }) do
			Kit.cyl(root, CFrame.new(px + sx * 16, 1.5, pz + sz * 12), 0.7, 3, C.woodDark, M.Wood)
		end
	end
	Props.cow(root, Kit.at(px - 8, pz - 3, 30))
	Props.cow(root, Kit.at(px + 2, pz + 4, 160), Color3.fromRGB(196, 160, 118))
	Props.cow(root, Kit.at(px + 9, pz - 4, 250))
	Props.cow(root, Kit.at(px - 3, pz + 6, 80), Color3.fromRGB(120, 92, 70))
	Props.haystack(root, Kit.at(px + 22, pz + 2, 0))
	ctx.reserve(px, pz, 22)
	ctx.reserve(px + 22, pz + 2, 6)

	Props.well(root, Kit.at(1668, 26, 0))
	ctx.reserve(1668, 26, 7)
	Props.stall(root, Kit.at(1690, -21, Kit.FACE_POS_Z), C.flagGreen)
	Props.stall(root, Kit.at(1728, 21, Kit.FACE_NEG_Z), C.saffron)
	ctx.reserve(1690, -21, 8)
	ctx.reserve(1728, 21, 8)
	Props.cart(root, Kit.at(1764, -26, 110))
	ctx.reserve(1764, -26, 7)
	B.pagoda(root, Kit.at(1792, -96, 0), 3, 16, C.tileTeal)
	ctx.reserve(1792, -96, 20)
	Props.signpost(root, Kit.at(1590, 11, 90), "Senani Village")
	Props.signpost(root, Kit.at(1812, -11, 90), "The Neranjara")

	-- stone steps (a ghat) down into the river
	local bank = rx - half
	ctx.fill(bank - 14, bank, -4, 4, -17, 17, M.Air)
	for i = 0, 6 do
		Kit.block(root, CFrame.new(bank - 15 + i * 3, 0.2 - i * 0.55 - 2, 0), V(3.2, 4, 34), C.sandstone, M.Sandstone)
	end
	for _, sz in ipairs({ -1, 1 }) do
		Kit.block(root, CFrame.new(bank - 16, 3, sz * 18.5), V(3, 6, 3), C.sandstoneDark, M.Sandstone)
		Kit.ball(root, CFrame.new(bank - 16, 7, sz * 18.5), 2.4, C.gold, M.Metal, { collide = false })
	end
	Props.flags(root, V(bank - 16, 14, -18.5), V(bank - 16, 14, 18.5), true)
	local bowlSpot = Kit.block(root, CFrame.new(P.bowl_river.x, 0.4, P.bowl_river.z), V(4, 4, 4), C.gold, M.SmoothPlastic, { collide = false, shadow = false, transparency = 1, name = "BowlSpot" })
	ctx.objects.bowl_river = bowlSpot
	ctx.reserve(bank - 8, 0, 20)

	-- a sandbar in the middle, and stones to either side of it
	ctx.fill(rx - 10, rx + 10, -10, -1.2, -48, 48, M.Sand)
	B.steppingStones(root, bank + 3, rx - 13, 0, rng, 0.3)
	B.steppingStones(root, rx + 13, rx + half - 3, 0, rng, 0.3)
	for _, bx in ipairs({ bank - 3, rx + half + 3 }) do
		local z = -140
		while z < 140 do
			if math.abs(z) > 24 then
				for _ = 1, 4 do
					local cf = CFrame.new(bx + rng:NextNumber(-2, 2), 0, z + rng:NextNumber(-2, 2)) * CFrame.Angles(math.rad(rng:NextNumber(-8, 8)), 0, math.rad(rng:NextNumber(-8, 8)))
					Kit.block(root, cf * CFrame.new(0, 2.6, 0), V(0.25, 5.2, 0.25), C.bamboo, M.Grass, { collide = false, shadow = false })
				end
			end
			z = z + rng:NextNumber(9, 16)
		end
	end

	-- Mucalinda's pool
	ctx.pond(P.mucalinda.x, P.mucalinda.z, 16)
	Kit.cyl(root, CFrame.new(P.mucalinda.x, -3, P.mucalinda.z), 11, 7, C.stone, M.Slate)
	B.naga(root, Kit.at(P.mucalinda.x, P.mucalinda.z, Kit.FACE_POS_Z, 0.5), 0.8)
	for i = 1, 5 do
		local a = i * 1.3
		Props.lotus(root, CFrame.new(P.mucalinda.x + math.cos(a) * 12, -0.95, P.mucalinda.z + math.sin(a) * 12), C.lotusPink, i % 2 == 0)
	end
	Props.signpost(root, Kit.at(1988, -72, 30), "Mucalinda's Pool")

	-- wild grass on the east bank
	ctx.scatter(rx + half + 8, 2034, 46, 2.5, function(o)
		for _ = 1, 4 do
			local cf = o * CFrame.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5)) * CFrame.Angles(math.rad(rng:NextNumber(-12, 12)), 0, math.rad(rng:NextNumber(-12, 12)))
			Kit.block(root, cf * CFrame.new(0, 1.3, 0), V(0.2, 2.6, 0.45), Color3.fromRGB(112, 150, 70), M.Grass, { collide = false, shadow = false })
		end
	end)

	ctx.scatter(1584, 2036, 26, 8, function(o)
		local pick = rng:NextNumber()
		if pick < 0.45 then
			Props.palm(root, o, rng:NextNumber(0.9, 1.25), rng:NextNumber(3, 10))
		elseif pick < 0.75 then
			Props.roundTree(root, o, rng:NextNumber(0.9, 1.3))
		else
			Props.sal(root, o, rng:NextNumber(0.9, 1.2))
		end
	end)
	ctx.scatter(1584, 2036, 26, 3, function(o)
		Props.flowers(root, o, FLOWER[rng:NextInteger(1, #FLOWER)], rng)
	end)
	ctx.scatter(1584, 2036, 10, 4, function(o)
		Props.rock(root, o, rng:NextNumber(0.8, 1.6), C.stone, rng)
	end)
end

----------------------------------------------------------------------
-- Mara's Field
----------------------------------------------------------------------
local function mara(ctx)
	local root = Kit.folder(ctx.root, "MarasField")
	local rng = ctx.rng
	local P = ctx.Config.Places
	local terrain = workspace.Terrain
	ctx.pave(2040, 2560, -7, 7, M.Slate)

	-- the arena where Mara waits
	terrain:FillCylinder(CFrame.new(P.arena.x, -2, P.arena.z), 4, P.arena.radius + 4, M.Slate)
	ctx.reserve(P.arena.x, P.arena.z, P.arena.radius + 10)
	local violet = Color3.fromRGB(170, 90, 255)
	for i = 0, 21 do
		local a = i / 22 * math.pi * 2
		local z = math.sin(a) * (P.arena.radius + 2)
		if math.abs(z) > 12 then
			Props.brazier(root, Kit.at(P.arena.x + math.cos(a) * (P.arena.radius + 2), z, 0), violet)
		end
	end
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2 + 0.26
		local r = P.arena.radius + 12
		local z = math.sin(a) * r
		if math.abs(z) > 16 then
			local cf = Kit.at(P.arena.x + math.cos(a) * r, z, rng:NextNumber(0, 360)) * CFrame.Angles(math.rad(rng:NextNumber(-12, 12)), 0, math.rad(rng:NextNumber(-12, 12)))
			local h = rng:NextNumber(20, 34)
			Kit.block(root, cf * CFrame.new(0, h / 2 - 2, 0), V(5, h, 5), Color3.fromRGB(36, 30, 40), M.Basalt)
		end
	end

	-- Girimekhala, Mara's elephant, "a hundred and fifty leagues high"
	local mount = Kit.at(P.mara.x, P.mara.z, Kit.FACE_NEG_X)
	local scale = 2.3
	ctx.objects.elephant = Props.elephant(root, mount, scale, Color3.fromRGB(46, 40, 50), { name = "Girimekhala", eye = Color3.fromRGB(255, 60, 40), cloth = Color3.fromRGB(110, 20, 32) })
	ctx.objects.maraSeat = mount * CFrame.new(0, 12.9 * scale, 1 * scale)

	-- the pavilions of the three daughters
	local tints = { d1 = Color3.fromRGB(70, 200, 190), d2 = Color3.fromRGB(130, 140, 240), d3 = Color3.fromRGB(240, 90, 140) }
	for _, s in ipairs(ctx.Config.Spawns) do
		if tints[s.id] then
			B.pavilion(root, Kit.at(s.x, s.z, 0), tints[s.id])
			ctx.reserve(s.x, s.z, 20)
			ctx.pave(s.x - 3, s.x + 3, math.min(0, s.z), math.max(0, s.z), M.Slate)
		end
	end

	-- banners and fires along the road
	local x = 2070
	local n = 0
	while x < 2400 do
		n = n + 1
		local side = (n % 2 == 0) and 1 or -1
		Props.banner(root, Kit.at(x, side * 12, 90))
		Props.brazier(root, Kit.at(x + 22, -side * 12, 0))
		ctx.reserve(x, side * 12, 3)
		ctx.reserve(x + 22, -side * 12, 3)
		x = x + 46
	end
	Props.signpost(root, Kit.at(2052, 11, 90), "Mara's Field")

	-- glowing cracks in the ground
	ctx.scatter(2046, 2400, 34, 5, function(_, px, pz)
		local w = rng:NextNumber(3, 6)
		local d = rng:NextNumber(6, 16)
		if rng:NextNumber() < 0.5 then
			w, d = d, w
		end
		ctx.fill(px - w / 2, px + w / 2, -3, 0, pz - d / 2, pz + d / 2, M.CrackedLava)
	end)
	ctx.scatter(2046, 2556, 70, 5, function(o)
		Props.deadTree(root, o, rng:NextNumber(0.8, 1.5))
	end)
	ctx.scatter(2046, 2556, 46, 4, function(o)
		Props.rock(root, o, rng:NextNumber(1, 2.8), Color3.fromRGB(44, 38, 46), rng)
	end)
	ctx.scatter(2046, 2400, 16, 4, function(o)
		local h = rng:NextNumber(14, 26)
		Kit.block(root, o * CFrame.Angles(math.rad(rng:NextNumber(-14, 14)), 0, math.rad(rng:NextNumber(-14, 14))) * CFrame.new(0, h / 2 - 2, 0), V(4, h, 4), Color3.fromRGB(36, 30, 40), M.Basalt)
	end)
end

----------------------------------------------------------------------
-- Bodh Gaya
----------------------------------------------------------------------
local function bodhgaya(ctx)
	local root = Kit.folder(ctx.root, "BodhGaya")
	local rng = ctx.rng
	local P = ctx.Config.Places
	ctx.pave(2560, 2694, -7, 7, M.Limestone)

	local _, seat = B.bodhiTree(root, Kit.at(P.tree.x, P.tree.z, 0))
	ctx.objects.seat = seat
	ctx.reserve(P.tree.x, P.tree.z, 56)

	-- the Mahabodhi temple stands beside the tree
	B.temple(root, Kit.at(2822, 0, Kit.FACE_NEG_X))
	ctx.reserve(2822, 0, 48)

	for _, z in ipairs({ 70, -74 }) do
		ctx.pond(2662, z, 14)
		for i = 1, 6 do
			local a = i * 1.1
			local r = 3 + (i % 3) * 3.2
			Props.lotus(root, CFrame.new(2662 + math.cos(a) * r, -0.95, z + math.sin(a) * r), (i % 2 == 0) and C.lotusWhite or C.lotusPink, i % 3 ~= 0)
		end
	end
	for _, s in ipairs({ { 2618, 34 }, { 2618, -34 }, { 2652, 30 }, { 2652, -30 } }) do
		B.stupa(root, Kit.at(s[1], s[2], 0), 3.6)
		ctx.reserve(s[1], s[2], 8)
	end
	for _, x in ipairs({ 2606, 2636, 2666 }) do
		Props.flags(root, V(x, 15, -13), V(x, 15, 13), true)
		ctx.reserve(x, 13, 2)
		ctx.reserve(x, -13, 2)
	end
	for _, x in ipairs({ 2580, 2622, 2680 }) do
		for _, z in ipairs({ -11, 11 }) do
			Props.lantern(root, Kit.at(x + 8, z, 0))
			ctx.reserve(x + 8, z, 3)
		end
	end
	Props.signpost(root, Kit.at(2572, 11, 90), "Bodh Gaya")
	Props.deer(root, Kit.at(2630, 96, 20))
	Props.deer(root, Kit.at(2638, 104, 150))
	Props.deer(root, Kit.at(2610, -100, 240))
	Props.deer(root, Kit.at(2700, -108, 60))
	ctx.reserve(2634, 100, 8)
	ctx.reserve(2610, -100, 5)
	ctx.reserve(2700, -108, 5)

	ctx.scatter(2564, 2850, 40, 8, function(o)
		if rng:NextNumber() < 0.55 then
			Props.sal(root, o, rng:NextNumber(0.9, 1.4))
		else
			Props.roundTree(root, o, rng:NextNumber(1, 1.5))
		end
	end)
	ctx.scatter(2564, 2850, 60, 3, function(o)
		Props.flowers(root, o, FLOWER[rng:NextInteger(1, #FLOWER)], rng)
	end)
	ctx.scatter(2564, 2850, 16, 3, function(o)
		Props.bush(root, o, rng:NextNumber(0.8, 1.4), C.leafLight)
	end)
end

function Zones.build(ctx)
	uruvela(ctx)
	senani(ctx)
	mara(ctx)
	bodhgaya(ctx)
end

return Zones
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">ZonesWest</string><ProtectedString name="Source"><![CDATA[-- ZonesWest: the first half of the journey.
-- Kapilavastu (home temple and village), the Road of the Four Sights,
-- the River Anoma, and the Forest of the Teachers.

local Kit = require(script.Parent.Kit)
local Props = require(script.Parent.Props)
local B = require(script.Parent.Buildings)
local Garden = require(script.Parent.Garden)

local C = Kit.C
local M = Enum.Material

local Zones = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local FLOWER = {
	Color3.fromRGB(240, 150, 30), Color3.fromRGB(236, 80, 90), Color3.fromRGB(250, 220, 80),
	Color3.fromRGB(240, 240, 240), Color3.fromRGB(190, 110, 220),
}

----------------------------------------------------------------------
-- Kapilavastu: the monastery and the village
----------------------------------------------------------------------
local function village(ctx)
	local root = Kit.folder(ctx.root, "Kapilavastu")
	local rng = ctx.rng
	local P = ctx.Config.Places

	-- paving
	ctx.pave(-50, 104, -36, 36, M.Limestone)
	ctx.pave(-27, -13, 36, 66, M.Limestone)
	ctx.pave(5, 19, -46, -36, M.Limestone)
	ctx.pave(104, 116, -7, 7, M.Limestone)
	ctx.pave(128, 258, -8, 8, M.Cobblestone)
	ctx.pave(154, 166, 8, 46, M.Cobblestone)
	ctx.pave(198, 210, -46, -8, M.Cobblestone)

	-- compound wall with the main gateway on the east side
	local wx0, wx1, wz = -136, 106, 126
	B.wall(root, wx0, -wz, wx1, -wz, 9, C.ivory, M.Sandstone)
	B.wall(root, wx0, wz, wx1, wz, 9, C.ivory, M.Sandstone)
	B.wall(root, wx0, -wz, wx0, wz, 9, C.ivory, M.Sandstone)
	B.wall(root, wx1, -wz, wx1, -11.5, 9, C.ivory, M.Sandstone)
	B.wall(root, wx1, 11.5, wx1, wz, 9, C.ivory, M.Sandstone)
	B.torana(root, Kit.at(wx1, 0, 90), 20, 20)
	ctx.reserve(wx1, 0, 14)

	-- the great temple
	B.temple(root, Kit.at(P.temple.x, P.temple.z, Kit.FACE_POS_X))
	ctx.reserve(P.temple.x, P.temple.z, 48)
	Props.incenseBurner(root, Kit.at(-36, -9, 0))
	ctx.reserve(-36, -9, 3)

	-- meditation hall
	B.hall(root, Kit.at(P.hall.x, P.hall.z, 0))
	ctx.reserve(P.hall.x, P.hall.z, 34)

	-- bell
	local _, bell, striker = B.bellPavilion(root, Kit.at(P.temple_bell.x, P.temple_bell.z, 0))
	ctx.objects.bell = bell
	ctx.objects.striker = striker
	ctx.reserve(P.temple_bell.x, P.temple_bell.z, 14)

	-- prayer wheels
	local _, wheels = B.prayerWheels(root, Kit.at(P.wheels.x, P.wheels.z, 0), 8)
	for _, w in ipairs(wheels) do
		table.insert(ctx.objects.wheels, w)
	end
	ctx.reserve(P.wheels.x, P.wheels.z, 20)

	-- lotus pond
	ctx.pond(P.lotus_pond.x, P.lotus_pond.z, 20)
	for i = 1, 9 do
		local a = i * 0.7
		local r = 5 + (i % 4) * 3.4
		Props.lotus(root, CFrame.new(P.lotus_pond.x + math.cos(a) * r, -0.95, P.lotus_pond.z + math.sin(a) * r), (i % 3 == 0) and C.lotusWhite or C.lotusPink, i % 2 == 0)
	end

	-- pagoda, monks' quarters, refectory
	B.pagoda(root, Kit.at(-104, -84, 0), 5, 22, C.tileGrey)
	ctx.reserve(-104, -84, 24)
	B.house(root, Kit.at(-116, 36, Kit.FACE_POS_X), { w = 20, d = 14, roof = "flat", wall = C.ivory, band = C.maroon, name = "MonksQuarters" })
	B.house(root, Kit.at(-116, 62, Kit.FACE_POS_X), { w = 20, d = 14, roof = "flat", wall = C.ivory, band = C.maroon, name = "MonksQuarters" })
	ctx.reserve(-116, 36, 15)
	ctx.reserve(-116, 62, 15)
	B.house(root, Kit.at(72, 96, 0), { w = 30, d = 20, h = 11, roof = "tile", wall = C.ivory, band = C.saffron, name = "Refectory" })
	ctx.reserve(72, 96, 22)

	-- stone lanterns and prayer flags along the courtyard
	for _, x in ipairs({ -36, -12, 12, 36, 60, 84 }) do
		for _, z in ipairs({ -22, 22 }) do
			Props.lantern(root, Kit.at(x, z, 0))
			ctx.reserve(x, z, 3)
		end
	end
	Props.flags(root, V(-65.5, 34, 0), V(-12, 12, -30), "end")
	Props.flags(root, V(-65.5, 34, 0), V(-12, 12, 30), "end")
	Props.flags(root, V(60, 13, -36), V(100, 13, -36), true)
	Props.flags(root, V(60, 13, 36), V(100, 13, 36), true)

	-- the temple elephant
	Props.elephant(root, Kit.at(84, -66, Kit.FACE_NEG_X), 0.8, nil, { cloth = C.maroon })
	ctx.reserve(84, -66, 14)

	-- the Pilgrims' Garden: a place to meet, south of the courtyard
	Garden.build(ctx, root)

	-- trees and flowers inside the compound
	ctx.scatter(-128, 100, 16, 9, function(o)
		if rng:NextNumber() < 0.5 then
			Props.sal(root, o, rng:NextNumber(0.8, 1.1))
		else
			Props.roundTree(root, o, rng:NextNumber(0.9, 1.3))
		end
	end, 118)
	ctx.scatter(-128, 100, 24, 3, function(o)
		Props.flowers(root, o, FLOWER[rng:NextInteger(1, #FLOWER)], rng)
	end, 118)

	-- the stream and the bridge to the village
	B.bridge(root, Kit.at(122, 0, 90), 26, 12, C.wood)

	-- village
	B.shop(root, Kit.at(P.store.x, P.store.z, Kit.FACE_NEG_Z), "The Merit Store", { awning = C.saffron })
	ctx.reserve(P.store.x, P.store.z, 24)
	B.shop(root, Kit.at(P.tailor.x, P.tailor.z, Kit.FACE_POS_Z), "Visakha's Robes", { awning = C.maroon, wall = C.mud, band = C.maroon, goods = { C.saffron, C.maroon, Color3.fromRGB(128, 130, 134), C.black, C.white, Color3.fromRGB(150, 92, 38) } })
	ctx.reserve(P.tailor.x, P.tailor.z, 24)

	local houses = {
		{ 146, -54, Kit.FACE_POS_Z, "thatch", C.mud },
		{ 244, -56, Kit.FACE_POS_Z, "flat", C.ivory },
		{ 212, 56, Kit.FACE_NEG_Z, "tile", C.mud },
		{ 246, 60, Kit.FACE_NEG_Z, "thatch", C.sandstoneLight },
		{ 180, 108, Kit.FACE_NEG_Z, "flat", C.mud },
		{ 152, -104, Kit.FACE_POS_Z, "thatch", C.sandstoneLight },
		{ 230, -108, Kit.FACE_POS_Z, "tile", C.ivory },
	}
	for i, h in ipairs(houses) do
		B.house(root, Kit.at(h[1], h[2], h[3]), { roof = h[4], wall = h[5], band = (i % 2 == 0) and C.redstone or C.flagBlue, rug = FLOWER[i % #FLOWER + 1] })
		ctx.reserve(h[1], h[2], 17)
	end

	Props.stall(root, Kit.at(150, -20, Kit.FACE_POS_Z), C.saffron)
	Props.stall(root, Kit.at(180, 20, Kit.FACE_NEG_Z), C.flagRed)
	Props.stall(root, Kit.at(214, -20, Kit.FACE_POS_Z), C.flagBlue, { Color3.fromRGB(190, 98, 62), Color3.fromRGB(150, 116, 84), Color3.fromRGB(214, 178, 128) })
	Props.stall(root, Kit.at(234, 21, Kit.FACE_NEG_Z), C.flagGreen)
	for _, s in ipairs({ { 150, -20 }, { 180, 20 }, { 214, -20 }, { 234, 21 } }) do
		ctx.reserve(s[1], s[2], 8)
	end
	Props.well(root, Kit.at(194, 30, 0))
	ctx.reserve(194, 30, 7)
	Props.banyan(root, Kit.at(176, -30, 0), 0.9)
	ctx.reserve(176, -30, 8)
	Props.cart(root, Kit.at(228, -30, 30))
	ctx.reserve(228, -30, 7)
	Props.haystack(root, Kit.at(250, -96, 0))
	Props.haystack(root, Kit.at(242, -90, 0))
	ctx.reserve(246, -93, 9)
	Props.cow(root, Kit.at(232, 98, 40))
	Props.cow(root, Kit.at(244, 92, 200), Color3.fromRGB(196, 160, 118))
	ctx.reserve(238, 95, 10)
	for i = 1, 6 do
		Props.pot(root, Kit.at(166 + i * 1.6, 46 - (i % 2) * 1.6, 0), 0.6 + (i % 3) * 0.2)
	end
	Props.flags(root, V(140, 15, -10), V(140, 15, 10), true)
	Props.flags(root, V(256, 15, -10), V(256, 15, 10), true)
	Props.signpost(root, Kit.at(132, 11, 90), "Kapilavastu Village")
	Props.signpost(root, Kit.at(252, -11, 90), "East: the Four Sights")

	ctx.scatter(128, 256, 10, 7, function(o)
		if rng:NextNumber() < 0.6 then
			Props.palm(root, o, rng:NextNumber(0.85, 1.15), rng:NextNumber(3, 10))
		else
			Props.roundTree(root, o, rng:NextNumber(0.8, 1.2))
		end
	end)
	ctx.scatter(128, 256, 14, 3, function(o)
		Props.flowers(root, o, FLOWER[rng:NextInteger(1, #FLOWER)], rng)
	end)
	ctx.scatter(-200, -140, 10, 9, function(o)
		Props.sal(root, o, rng:NextNumber(0.9, 1.3))
	end)
end

----------------------------------------------------------------------
-- The Road of the Four Sights
----------------------------------------------------------------------
local function road(ctx)
	local root = Kit.folder(ctx.root, "FourSights")
	local rng = ctx.rng
	ctx.pave(258, 620, -7, 7, M.Ground)

	-- rice paddies to the north, mustard to the south
	for _, x in ipairs({ 300, 340, 380 }) do
		for _, z in ipairs({ 52, 90 }) do
			Props.paddy(root, Kit.at(x, z, 0), 34, 32, rng)
			ctx.reserve(x, z, 23)
		end
	end
	for _, f in ipairs({ { 306, -62 }, { 346, -70 }, { 388, -96 }, { 326, -106 } }) do
		Props.mustard(root, Kit.at(f[1], f[2], rng:NextNumber(-8, 8)), 32, 24)
		ctx.reserve(f[1], f[2], 19)
	end

	-- first sight: the old man resting in the shade
	Props.roundTree(root, Kit.at(340, 27, 0), 1.2)
	Kit.block(root, CFrame.new(334, 1, 25), V(5, 0.5, 1.6), C.wood, M.WoodPlanks)
	Kit.block(root, CFrame.new(332.2, 0.5, 25), V(0.5, 1, 1.4), C.woodDark, M.Wood)
	Kit.block(root, CFrame.new(335.8, 0.5, 25), V(0.5, 1, 1.4), C.woodDark, M.Wood)
	ctx.reserve(338, 26, 9)

	-- second sight: the sick man outside his hut
	B.house(root, Kit.at(412, -42, Kit.FACE_POS_Z), { w = 18, d = 14, h = 9, roof = "thatch", wall = C.mud })
	ctx.reserve(412, -42, 15)
	Kit.block(root, CFrame.new(418, 1.1, -26), V(3.6, 0.4, 6.6), C.wood, M.WoodPlanks)
	Kit.block(root, CFrame.new(418, 1.45, -26), V(3.2, 0.3, 6.2), C.ivory, M.Fabric, { collide = false })
	Props.pot(root, Kit.at(408, -28, 0), 0.7)

	-- the stream, its bridge, and the third sight: the funeral by the water
	B.bridge(root, Kit.at(456, 0, 90), 26, 12, C.wood)
	Props.bier(root, Kit.at(505, 40, 35))
	ctx.reserve(505, 40, 8)
	for i = 0, 3 do
		Kit.block(root, CFrame.new(522, 0.6 + i * 1, 58) * CFrame.Angles(0, math.rad(i * 90), 0), V(8, 1, 3), C.woodDark, M.Wood)
	end
	local pyre = Kit.ball(root, CFrame.new(522, 5, 58), 1, C.ember, M.Neon, { collide = false, shadow = false })
	Kit.smoke(pyre, Color3.fromRGB(150, 150, 150))
	ctx.reserve(522, 58, 8)
	for i = 1, 5 do
		Props.flowers(root, Kit.at(498 + i * 3, 46 + (i % 2) * 3, 0), Color3.fromRGB(240, 150, 30), rng)
	end

	-- fourth sight: the ascetic beneath the banyan
	Props.banyan(root, Kit.at(586, -36, 0), 1)
	ctx.reserve(586, -36, 10)
	Kit.block(root, CFrame.new(577, 0.3, -20), V(5, 0.6, 5), C.stone, M.Slate)

	-- a great stupa at the end of the road
	B.stupa(root, Kit.at(604, 72, 0), 10)
	ctx.reserve(604, 72, 18)
	B.torana(root, Kit.at(604, 52, 0), 12, 13)
	Props.flags(root, V(604, 26, 72), V(576, 11, 60), "end")
	Props.flags(root, V(604, 26, 72), V(628, 11, 54), "end")

	Props.signpost(root, Kit.at(268, 11, 90), "The Road of the Four Sights")
	Props.signpost(root, Kit.at(608, -11, 90), "East: River Anoma")
	for _, x in ipairs({ 300, 380, 520 }) do
		Props.lantern(root, Kit.at(x, 11, 0))
		ctx.reserve(x, 11, 3)
	end
	Props.deer(root, Kit.at(548, 84, 40))
	Props.deer(root, Kit.at(556, 92, 100))
	ctx.reserve(552, 88, 8)

	ctx.scatter(262, 618, 34, 8, function(o)
		local pick = rng:NextNumber()
		if pick < 0.4 then
			Props.roundTree(root, o, rng:NextNumber(0.9, 1.4))
		elseif pick < 0.7 then
			Props.palm(root, o, rng:NextNumber(0.9, 1.2), rng:NextNumber(3, 10))
		else
			Props.sal(root, o, rng:NextNumber(0.9, 1.2))
		end
	end)
	ctx.scatter(262, 618, 26, 3, function(o)
		Props.flowers(root, o, FLOWER[rng:NextInteger(1, #FLOWER)], rng)
	end)
	ctx.scatter(262, 618, 12, 4, function(o)
		Props.rock(root, o, rng:NextNumber(0.8, 1.6), C.stone, rng)
	end)
	ctx.scatter(262, 618, 14, 3, function(o)
		Props.bush(root, o, rng:NextNumber(0.8, 1.4))
	end)
end

----------------------------------------------------------------------
-- The River Anoma
----------------------------------------------------------------------
local function anoma(ctx)
	local root = Kit.folder(ctx.root, "Anoma")
	local rng = ctx.rng
	local P = ctx.Config.Places
	local rx, half = P.anoma_river.x, P.anoma_river.width / 2
	ctx.pave(620, rx - half - 2, -7, 7, M.Ground)
	ctx.pave(rx + half + 2, 830, -7, 7, M.Ground)

	B.steppingStones(root, rx - half - 1, rx + half + 1, 0, rng, 0.3)

	-- a fisherman's boat drawn up on the west bank
	Kit.blob(root, CFrame.new(702, 0.8, 52) * CFrame.Angles(0, math.rad(20), math.rad(8)), V(5, 2.4, 14), C.wood, M.WoodPlanks)
	Kit.block(root, CFrame.new(702, 1.6, 52) * CFrame.Angles(0, math.rad(20), math.rad(8)), V(4, 0.3, 1.2), C.woodDark, M.WoodPlanks, { collide = false })
	ctx.reserve(702, 52, 8)

	-- reeds along both banks
	for _, bx in ipairs({ rx - half - 3, rx + half + 3 }) do
		local z = -140
		while z < 140 do
			if math.abs(z) > 14 then
				for _ = 1, 4 do
					local cf = CFrame.new(bx + rng:NextNumber(-2, 2), 0, z + rng:NextNumber(-2, 2)) * CFrame.Angles(math.rad(rng:NextNumber(-8, 8)), 0, math.rad(rng:NextNumber(-8, 8)))
					Kit.block(root, cf * CFrame.new(0, 2.6, 0), V(0.25, 5.2, 0.25), C.bamboo, M.Grass, { collide = false, shadow = false })
				end
			end
			z = z + rng:NextNumber(9, 16)
		end
	end

	-- Kanthaka, and the rock where the prince left his old life
	Props.horse(root, Kit.at(794, 27, 70))
	ctx.reserve(794, 27, 7)
	local rock = Kit.blob(root, CFrame.new(P.hair_rock.x, 1.2, P.hair_rock.z), V(11, 3.4, 9), C.stone, M.Slate)
	rock.Name = "HairRock"
	Kit.block(root, CFrame.new(P.hair_rock.x - 1.5, 3, P.hair_rock.z), V(3.4, 0.5, 2.4), Color3.fromRGB(40, 60, 160), M.Fabric, { collide = false })
	Kit.block(root, CFrame.new(P.hair_rock.x - 1.5, 3.3, P.hair_rock.z), V(3.5, 0.15, 0.8), C.gold, M.Fabric, { collide = false })
	Kit.cyl(root, CFrame.new(P.hair_rock.x + 2, 3.3, P.hair_rock.z + 1), 1.6, 0.9, C.gold, M.Metal, { collide = false })
	Kit.block(root, CFrame.new(P.hair_rock.x + 1.4, 3.6, P.hair_rock.z - 2) * CFrame.Angles(0, math.rad(30), math.rad(72)), V(0.3, 5, 0.6), Color3.fromRGB(200, 204, 214), M.Metal, { collide = false })
	ctx.objects.hair_rock = rock
	ctx.reserve(P.hair_rock.x, P.hair_rock.z, 9)

	Props.signpost(root, Kit.at(628, 11, 90), "River Anoma")
	ctx.scatter(622, 828, 18, 8, function(o)
		if rng:NextNumber() < 0.5 then
			Props.palm(root, o, rng:NextNumber(0.9, 1.2), rng:NextNumber(3, 10))
		else
			Props.sal(root, o, rng:NextNumber(0.9, 1.3))
		end
	end)
	ctx.scatter(622, 828, 12, 3, function(o)
		Props.flowers(root, o, FLOWER[rng:NextInteger(1, #FLOWER)], rng)
	end)
	ctx.scatter(622, 828, 10, 4, function(o)
		Props.rock(root, o, rng:NextNumber(0.8, 1.8), C.stone, rng)
	end)
end

----------------------------------------------------------------------
-- The Forest of the Teachers
----------------------------------------------------------------------
local function hermitage(ctx, root, place, toward, name)
	local rng = ctx.rng
	local dir = (toward > place.z) and 1 or -1 -- which way the road lies
	local yaw = (dir == -1) and Kit.FACE_NEG_Z or Kit.FACE_POS_Z
	B.hut(root, Kit.at(place.x, place.z - dir * 10, yaw), 7)
	ctx.reserve(place.x, place.z - dir * 10, 11)
	B.hut(root, Kit.at(place.x + 22, place.z - dir * 6, yaw), 5)
	ctx.reserve(place.x + 22, place.z - dir * 6, 8)
	local spotZ = place.z + dir * 18
	for i = -2, 2 do
		Kit.cyl(root, CFrame.new(place.x + i * 4.4, 0.25, spotZ + (math.abs(i) % 2) * 3 * dir), 3, 0.5, C.thatch, M.Fabric, { collide = false, shadow = false })
	end
	Props.campfire(root, Kit.at(place.x + 11, spotZ - dir * 4, 0))
	ctx.reserve(place.x, spotZ, 16)
	ctx.pave(place.x - 4, place.x + 4, math.min(-dir * 7, spotZ + dir * 4), math.max(-dir * 7, spotZ + dir * 4), M.Ground)
	Props.flags(root, V(place.x - 14, 12, place.z), V(place.x + 14, 12, place.z), true)
	Props.signpost(root, Kit.at(place.x + 6, -dir * 11, 90), name)
	rng:NextNumber()
end

local function forest(ctx)
	local root = Kit.folder(ctx.root, "Forest")
	local rng = ctx.rng
	local P = ctx.Config.Places
	ctx.pave(830, 1220, -7, 7, M.Mud)

	hermitage(ctx, root, P.alara, 0, "Hermitage of Alara Kalama")
	hermitage(ctx, root, P.uddaka, 0, "Hermitage of Uddaka Ramaputta")
	B.bridge(root, Kit.at(1040, 0, 90), 26, 12, C.woodDark)

	for _, x in ipairs({ 880, 960, 1000, 1080, 1140, 1200 }) do
		Props.lantern(root, Kit.at(x, (x % 160 == 0) and 11 or -11, 0))
		ctx.reserve(x, (x % 160 == 0) and 11 or -11, 3)
	end

	ctx.scatter(834, 1216, 120, 6.5, function(o)
		Props.sal(root, o, rng:NextNumber(0.9, 1.5))
	end)
	ctx.scatter(834, 1216, 24, 5, function(o)
		Props.bamboo(root, o, rng, rng:NextInteger(5, 8))
	end)
	ctx.scatter(834, 1216, 40, 3, function(o)
		Props.bush(root, o, rng:NextNumber(0.8, 1.6), (rng:NextNumber() < 0.5) and C.leafDark or C.leaf)
	end)
	ctx.scatter(834, 1216, 18, 4, function(o)
		Props.rock(root, o, rng:NextNumber(0.9, 2), C.stoneDark, rng)
	end)
	ctx.scatter(834, 1216, 16, 3, function(o)
		Props.flowers(root, o, FLOWER[rng:NextInteger(1, #FLOWER)], rng)
	end)
end

function Zones.build(ctx)
	village(ctx)
	road(ctx)
	anoma(ctx)
	forest(ctx)
end

return Zones
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX35"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX34"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX33"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">Audio</string><ProtectedString name="Source"><![CDATA[-- Audio: plays the music for the current step of the journey and the sound effects.
-- The sound IDs themselves live in ReplicatedStorage.Shared.Sounds.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared:WaitForChild("Sounds"))
local Story = require(Shared:WaitForChild("Story"))
local Config = require(Shared:WaitForChild("Config"))

local Audio = {}

local player = Players.LocalPlayer
local folder = Instance.new("Folder")
folder.Name = "BodhiPathAudio"
folder.Parent = SoundService

local function asset(id)
	return "rbxassetid://" .. tostring(id)
end

----------------------------------------------------------------------
-- Music
----------------------------------------------------------------------
local current = nil
local currentId = 0

-- The track for a step; if that step has none, the nearest earlier step that has one.
local function musicFor(stage)
	local quest = Story.Quests[stage]
	if not quest then
		return 0
	end
	local index = 0
	for i, entry in ipairs(Sounds.Music) do
		if entry.step == quest.id then
			index = i
		end
	end
	for i = index, 1, -1 do
		local id = Sounds.Music[i].id
		if type(id) == "number" and id > 0 then
			return id
		end
	end
	return 0
end

function Audio.setStage(stage)
	local id = musicFor(stage)
	if id == currentId then
		return
	end
	currentId = id
	local old = current
	current = nil
	if old then
		local t = TweenService:Create(old, TweenInfo.new(2), { Volume = 0 })
		t:Play()
		task.delay(2.2, function()
			old:Destroy()
		end)
	end
	if id > 0 then
		local s = Instance.new("Sound")
		s.Name = "Music"
		s.SoundId = asset(id)
		s.Looped = true
		s.Volume = 0
		s.Parent = folder
		s:Play()
		TweenService:Create(s, TweenInfo.new(2.5), { Volume = Sounds.MusicVolume }):Play()
		current = s
	end
end

----------------------------------------------------------------------
-- Sound effects
----------------------------------------------------------------------
local lastPlayed = {}

-- Play an effect by name. If "pos" is given, it is only heard when you are near it.
-- "pitch" plays it higher (above 1) or lower (below 1): used for the song bells.
function Audio.play(name, pos, volume, pitch)
	local id = Sounds.Effects[name]
	if type(id) ~= "number" or id <= 0 then
		return
	end
	local now = os.clock()
	if now - (lastPlayed[name] or -10) < 0.08 then
		return
	end
	if pos then
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or (root.Position - pos).Magnitude > 160 then
			return
		end
	end
	lastPlayed[name] = now
	local s = Instance.new("Sound")
	s.Name = name
	s.SoundId = asset(id)
	s.Volume = (volume or 1) * Sounds.EffectVolume
	if pitch then
		s.PlaybackSpeed = pitch
	end
	s.Parent = folder
	local tail = Sounds.EffectTail and Sounds.EffectTail[name]
	if type(tail) == "number" and tail > 0 then
		-- only the ending is wanted: wait until the sound has arrived, then start near its end
		local full = s.Volume
		s.Volume = 0
		task.spawn(function()
			local waited = 0
			while not s.IsLoaded and waited < 3 do
				task.wait(0.05)
				waited = waited + 0.05
			end
			if not s.Parent then
				return
			end
			s.TimePosition = math.max(0, s.TimeLength - tail)
			s:Play()
			TweenService:Create(s, TweenInfo.new(0.12), { Volume = full }):Play()
		end)
	else
		s:Play()
	end
	local length = Sounds.EffectLength and Sounds.EffectLength[name]
	if type(length) == "number" and length > 0 and length < 12 then
		-- a long recording: let it ring, then fade it away over the last two seconds
		local fade = math.min(2, length / 2)
		task.delay(length - fade, function()
			if s.Parent then
				TweenService:Create(s, TweenInfo.new(fade), { Volume = 0 }):Play()
			end
		end)
		task.delay(length + 0.2, function()
			s:Destroy()
		end)
	else
		task.delay(12, function()
			s:Destroy()
		end)
	end
end

----------------------------------------------------------------------
-- Running water: louder the closer you are to a stream or river
----------------------------------------------------------------------
local HEAR = 75 -- studs from the bank at which water can first be heard

-- 0 (out of earshot) to 1 (standing at the water or on a bridge over it).
local function waterNearness(x)
	local best = 0
	for _, river in ipairs(Config.Rivers) do
		local fromBank = math.max(0, math.abs(x - river.x) - river.width / 2)
		local near = 1 - fromBank / HEAR
		if river.width < 20 then
			near = near * 0.75 -- a small stream is gentler than a great river
		end
		if near > best then
			best = near
		end
	end
	return best * best -- fades in gently, swells close by
end
Audio.waterNearness = waterNearness

-- Are you standing in a river's shallows (below the banks, not up on a bridge)?
local function inRiver(pos)
	if pos.Y > 1.2 then
		return false
	end
	for _, river in ipairs(Config.Rivers) do
		if math.abs(pos.X - river.x) < river.width / 2 + 3 then
			return true
		end
	end
	return false
end

-- A looping sound that is faded up and down. Returns nil if no sound has been chosen.
local function loop(name)
	local id = Sounds.Ambient and Sounds.Ambient[name]
	if type(id) ~= "number" or id <= 0 then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = asset(id)
	sound.Looped = true
	sound.Volume = 0
	sound.Parent = folder
	return function(want, quickness)
		sound.Volume = sound.Volume + (want - sound.Volume) * quickness
		if sound.Volume > 0.01 then
			if not sound.IsPlaying then
				sound:Play()
			end
		elseif sound.IsPlaying then
			sound:Stop()
		end
	end
end

do
	local stream, wade, swim = loop("stream"), loop("wade"), loop("swim")
	if stream or wade or swim or (Sounds.Effects.splash or 0) > 0 then
		task.spawn(function()
			local wasInWater = false
			while true do
				task.wait(0.15)
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local hum = character and character:FindFirstChildOfClass("Humanoid")
				local near, wading, swimming = 0, false, false
				if root and hum then
					near = waterNearness(root.Position.X)
					local moving = hum.MoveDirection.Magnitude > 0.1
					local inWater = hum:GetState() == Enum.HumanoidStateType.Swimming
					if inWater and not wasInWater then
						Audio.play("splash")
					end
					wasInWater = inWater
					swimming = inWater and moving
					wading = moving and not inWater and inRiver(root.Position)
				end
				if stream then
					stream(near * Sounds.WaterVolume, 0.25)
				end
				if wade then
					wade(wading and Sounds.EffectVolume or 0, 0.5)
				end
				if swim then
					swim(swimming and Sounds.EffectVolume or 0, 0.5)
				end
			end
		end)
	end
end

return Audio
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">Fx</string><ProtectedString name="Source"><![CDATA[-- Fx: what the world looks like for this player.
-- Visual effects, the changing light of each zone, which gates are open, and which
-- things have already been collected.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local Fx = {}

local player = Players.LocalPlayer

----------------------------------------------------------------------
-- Effects in the world
----------------------------------------------------------------------
local function tempPart(pos, size)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = size or Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace
	return p
end

-- A burst of petals: what is left when a shadow is dispelled.
function Fx.petals(data)
	local p = tempPart(data.pos, Vector3.new(2, 2, 2))
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.Lifetime = NumberRange.new(1.2, 2.2)
	e.Speed = NumberRange.new(6, 14)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -9, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.2) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.1), NumberSequenceKeypoint.new(1, 1) })
	e.Color = ColorSequence.new(Color3.fromRGB(255, 196, 214), data.color or Color3.fromRGB(255, 220, 150))
	e.LightEmission = 0.3
	e.Parent = p
	e:Emit(data.big and 70 or 26)
	Debris:AddItem(p, 3)
end

-- An expanding ring of light (Metta, the singing bowl, the temple bell).
function Fx.ring(data)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanTouch = false
	ring.CanQuery = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = data.color or Color3.fromRGB(255, 220, 130)
	ring.Transparency = 0.45
	ring.Size = Vector3.new(0.4, 2, 2)
	ring.CFrame = CFrame.new(data.pos.X, data.pos.Y - 2, data.pos.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	local d = (data.radius or 20) * 2
	TweenService:Create(ring, TweenInfo.new(data.time or 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.4, d, d), Transparency = 1 }):Play()
	Debris:AddItem(ring, (data.time or 0.8) + 0.2)
end

-- A number that floats up where a strike landed.
function Fx.hit(data)
	local p = tempPart(data.pos)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, 90, 0, 36)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 24
	label.TextColor3 = Color3.fromRGB(255, 226, 150)
	label.TextStrokeTransparency = 0.3
	label.Text = tostring(data.amount)
	label.Parent = gui
	gui.Parent = p
	TweenService:Create(p, TweenInfo.new(0.7), { CFrame = CFrame.new(data.pos + Vector3.new(0, 4, 0)) }):Play()
	TweenService:Create(label, TweenInfo.new(0.7), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(p, 0.8)
end

function Fx.shake(seconds, strength)
	local camera = workspace.CurrentCamera
	local character = player.Character
	local hum = character and character:FindFirstChildOfClass("Humanoid")
	if not camera or not hum then
		return
	end
	task.spawn(function()
		local t = 0
		while t < seconds do
			local k = strength * (1 - t / seconds)
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
			t = t + task.wait(0.03)
		end
		hum.CameraOffset = Vector3.new(0, 0, 0)
	end)
end

----------------------------------------------------------------------
-- The light of each zone
----------------------------------------------------------------------
local MOODS = {
	morning = { clock = 8.6, bright = 2.6, tint = Color3.fromRGB(255, 244, 228), air = Color3.fromRGB(222, 206, 178), density = 0.3, haze = 1.4, ambient = Color3.fromRGB(140, 132, 120) },
	day = { clock = 11.2, bright = 2.8, tint = Color3.fromRGB(255, 250, 238), air = Color3.fromRGB(214, 214, 200), density = 0.28, haze = 1.2, ambient = Color3.fromRGB(146, 142, 134) },
	forest = { clock = 14.6, bright = 2.1, tint = Color3.fromRGB(226, 246, 220), air = Color3.fromRGB(160, 186, 150), density = 0.42, haze = 1.8, ambient = Color3.fromRGB(104, 126, 104) },
	harsh = { clock = 12.6, bright = 3.3, tint = Color3.fromRGB(255, 244, 210), air = Color3.fromRGB(232, 210, 168), density = 0.36, haze = 2.4, ambient = Color3.fromRGB(160, 146, 120) },
	golden = { clock = 16.9, bright = 2.5, tint = Color3.fromRGB(255, 232, 196), air = Color3.fromRGB(240, 196, 150), density = 0.32, haze = 1.6, ambient = Color3.fromRGB(150, 126, 104) },
	storm = { clock = 18.4, bright = 1.1, tint = Color3.fromRGB(206, 176, 226), air = Color3.fromRGB(70, 44, 84), density = 0.5, haze = 2.6, ambient = Color3.fromRGB(84, 64, 96) },
	night = { clock = 19.6, bright = 1.5, tint = Color3.fromRGB(196, 210, 255), air = Color3.fromRGB(60, 70, 110), density = 0.34, haze = 1.4, ambient = Color3.fromRGB(88, 96, 130) },
	dawn = { clock = 6.5, bright = 2.8, tint = Color3.fromRGB(255, 236, 200), air = Color3.fromRGB(255, 206, 150), density = 0.3, haze = 1.6, ambient = Color3.fromRGB(160, 140, 120) },
}

local currentMood = nil

function Fx.setMood(name, seconds)
	local mood = MOODS[name]
	if not mood or currentMood == name then
		return
	end
	currentMood = name
	local info = TweenInfo.new(seconds or 4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(Lighting, info, { ClockTime = mood.clock, Brightness = mood.bright, OutdoorAmbient = mood.ambient }):Play()
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, info, { Color = mood.air, Density = mood.density, Haze = mood.haze }):Play()
	end
	local cc = Lighting:FindFirstChild("Mood")
	if cc then
		TweenService:Create(cc, info, { TintColor = mood.tint }):Play()
	end
end

function Fx.zoneAt(x)
	for _, zone in ipairs(Config.Zones) do
		if x >= zone.x0 and x < zone.x1 then
			return zone
		end
	end
	if x < Config.Zones[1].x0 then
		return Config.Zones[1]
	end
	return Config.Zones[#Config.Zones]
end

----------------------------------------------------------------------
-- Gates and collected things (seen differently by each player)
----------------------------------------------------------------------
local stage = 1
local gone = {}

local function applyGate(part)
	local min = part:GetAttribute("MinStage") or 1
	local open = stage >= min
	if part.Name == "GateBarrier" then
		part.CanCollide = not open
	else
		part.Transparency = open and 1 or 0.72
	end
end

local function applyCollectible(root)
	local id = root:GetAttribute("CollectId")
	local hide = id ~= nil and gone[id] == true
	if root:GetAttribute("Hidden") == hide then
		return
	end
	root:SetAttribute("Hidden", hide)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			d.LocalTransparencyModifier = hide and 1 or 0
		elseif d:IsA("ParticleEmitter") or d:IsA("PointLight") or d:IsA("ProximityPrompt") then
			d.Enabled = not hide
		end
	end
end

function Fx.refreshWorld(state)
	stage = state.stage or 1
	gone = {}
	for id in pairs(state.leaves or {}) do
		gone[id] = true
	end
	for id in pairs(state.collected or {}) do
		gone[id] = true
	end
	for id in pairs(state.lotus or {}) do
		gone[id] = true
	end
	for id in pairs(state.symbols or {}) do
		gone["symbol_" .. id] = true
	end
	for _, part in ipairs(CollectionService:GetTagged("GateBarrier")) do
		applyGate(part)
	end
	for _, part in ipairs(CollectionService:GetTagged("GateVeil")) do
		applyGate(part)
	end
	for _, root in ipairs(CollectionService:GetTagged("Collectible")) do
		applyCollectible(root)
	end
end

CollectionService:GetInstanceAddedSignal("GateBarrier"):Connect(applyGate)
CollectionService:GetInstanceAddedSignal("GateVeil"):Connect(applyGate)
CollectionService:GetInstanceAddedSignal("Collectible"):Connect(applyCollectible)

return Fx
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX31"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- The Bodhi Path: everything the player sees on screen and every button they press.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local StarterGui = game:GetService("StarterGui")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Story = require(Shared:WaitForChild("Story"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local BossState = ReplicatedStorage:WaitForChild("BossState")
local UI = require(script.Parent:WaitForChild("UI"))
local Fx = require(script.Parent:WaitForChild("Fx"))
local Audio = require(script.Parent:WaitForChild("Audio"))

local T = UI.Theme
local Action = Remotes:WaitForChild("Action")

local state = {
	merit = 0, stage = 1, prog = {}, inv = {}, abilities = { strike = true, meditate = true },
	robes = {}, robe = "novice", path = 0, leaves = {}, collected = {}, shrines = {}, bought = {}, lotus = {},
	weapon = "auto", symbols = {}, friends = {}, worn = {},
}

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

----------------------------------------------------------------------
-- The screen
----------------------------------------------------------------------
local gui = UI.new("ScreenGui", { Name = "BodhiPath", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5 })
local root = UI.new("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = gui })
local scale = UI.new("UIScale", { Parent = root })
gui.Parent = player:WaitForChild("PlayerGui")

local function fitScreen()
	local camera = workspace.CurrentCamera
	local size = camera and camera.ViewportSize or Vector2.new(1600, 900)
	local s = math.clamp(math.min(size.X / 1500, size.Y / 860), 0.5, 1.25)
	scale.Scale = s
	root.Size = UDim2.new(1 / s, 0, 1 / s, 0)
end
fitScreen()
if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fitScreen)
end

-- Calm and merit (top left)
local status = UI.panel({ Name = "Status", Position = UDim2.new(0, 20, 0, 54), Size = UDim2.new(0, 330, 0, 84), Parent = root })
UI.label({ Text = "Calm", Font = UI.TitleFont, TextSize = 20, TextColor3 = T.goldBright, Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(0, 70, 0, 26), Parent = status })
local calmBack = UI.new("Frame", { BackgroundColor3 = T.black, BorderSizePixel = 0, Position = UDim2.new(0, 84, 0, 12), Size = UDim2.new(0, 230, 0, 18), Parent = status }, { UI.corner(9) })
local calmFill = UI.new("Frame", { BackgroundColor3 = T.calm, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Parent = calmBack }, { UI.corner(9) })
local calmText = UI.label({ Text = "100 / 100", Font = UI.BoldFont, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 1, 0), ZIndex = 2, Parent = calmBack })
UI.label({ Text = "Merit", Font = UI.TitleFont, TextSize = 20, TextColor3 = T.goldBright, Position = UDim2.new(0, 14, 0, 42), Size = UDim2.new(0, 70, 0, 30), Parent = status })
local meritText = UI.label({ Text = "0", Font = UI.BoldFont, TextSize = 22, Position = UDim2.new(0, 84, 0, 42), Size = UDim2.new(0, 120, 0, 30), Parent = status })
local buffText = UI.label({ Text = "", TextSize = 13, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Right, Position = UDim2.new(0, 170, 0, 42), Size = UDim2.new(0, 146, 0, 30), Parent = status })

-- Menu buttons (under the status panel)
local menu = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 20, 0, 146), Size = UDim2.new(0, 330, 0, 36), Parent = root })
UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), Parent = menu })

-- Quest tracker (top right)
local tracker = UI.panel({ Name = "Tracker", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 54), Size = UDim2.new(0, 380, 0, 190), Parent = root })
local questTitle = UI.label({ Text = "", Font = UI.TitleFont, TextSize = 24, TextColor3 = T.goldBright, Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(1, -28, 0, 30), Parent = tracker })
local questIntro = UI.label({ Text = "", TextSize = 14, TextColor3 = T.dim, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.new(0, 14, 0, 38), Size = UDim2.new(1, -28, 0, 58), Parent = tracker })
local questList = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 14, 0, 100), Size = UDim2.new(1, -28, 0, 84), Parent = tracker })
UI.new("UIListLayout", { Padding = UDim.new(0, 2), Parent = questList })

-- Messages (top centre)
local toasts = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 130), Size = UDim2.new(0, 560, 0, 220), Parent = root })
UI.new("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = toasts })

-- Zone title
local zoneTitle = UI.label({ Text = "", Font = UI.TitleFont, TextSize = 54, TextColor3 = T.goldBright, TextTransparency = 1, TextStrokeTransparency = 1, TextStrokeColor3 = T.black, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.2, 0), Size = UDim2.new(0, 900, 0, 64), Parent = root })
local zoneSub = UI.label({ Text = "", Font = UI.BodyFont, TextSize = 22, TextTransparency = 1, TextStrokeTransparency = 1, TextStrokeColor3 = T.black, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.2, 66), Size = UDim2.new(0, 900, 0, 30), Parent = root })

-- Mara (top centre)
local bossPanel = UI.panel({ Name = "Mara", Visible = false, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 46), Size = UDim2.new(0, 620, 0, 76), Parent = root })
local bossText = UI.label({ Text = "", TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 12, 0, 4), Size = UDim2.new(1, -24, 0, 42), Parent = bossPanel })
local bossBack = UI.new("Frame", { BackgroundColor3 = T.black, BorderSizePixel = 0, Position = UDim2.new(0, 16, 0, 50), Size = UDim2.new(1, -32, 0, 16), Parent = bossPanel }, { UI.corner(8) })
local bossFill = UI.new("Frame", { BackgroundColor3 = T.red, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Parent = bossBack }, { UI.corner(8) })
local earthButton = UI.button({ Text = "Touch the Earth  (T)", Visible = false, TextSize = 30, Font = UI.TitleFont, BackgroundColor3 = T.goldBright, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.6, 0), Size = UDim2.new(0, 420, 0, 90), Parent = root }, function()
	Action:FireServer("TouchEarth")
end)

-- Screen flashes
local vignette = UI.new("Frame", { BackgroundColor3 = T.red, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), ZIndex = 40, Active = false, Parent = root })
local fade = UI.new("Frame", { BackgroundColor3 = T.black, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), ZIndex = 50, Active = false, Parent = root })
local fadeText = UI.label({ Text = "", Font = UI.TitleFont, TextSize = 34, TextTransparency = 1, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 900, 0, 160), ZIndex = 51, Parent = root })

local function tween(obj, seconds, props)
	local t = TweenService:Create(obj, TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

----------------------------------------------------------------------
-- Messages
----------------------------------------------------------------------
local TOAST_COLOR = { info = T.cream, good = T.green, warn = T.saffron, quest = T.goldBright, merit = T.goldBright }

local function toast(text, kind)
	if kind == "merit" or kind == "quest" then
		Audio.play(kind)
	end
	local count = 0
	for _, child in ipairs(toasts:GetChildren()) do
		if child:IsA("GuiObject") then
			count = count + 1
		end
	end
	if count >= 5 then
		for _, child in ipairs(toasts:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
				break
			end
		end
	end
	local big = kind == "quest"
	local frame = UI.new("Frame", { BackgroundColor3 = T.panel, BackgroundTransparency = 0.15, BorderSizePixel = 0, Size = UDim2.new(0, big and 520 or 440, 0, big and 46 or 34), Parent = toasts }, { UI.corner(8), UI.stroke(TOAST_COLOR[kind] or T.cream, 1.5) })
	UI.label({ Text = big and ("New step:  " .. text) or text, Font = big and UI.TitleFont or UI.BodyFont, TextSize = big and 22 or 15, TextColor3 = TOAST_COLOR[kind] or T.cream, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 8, 0, 0), Size = UDim2.new(1, -16, 1, 0), Parent = frame })
	task.delay(big and 5 or 3.6, function()
		if frame.Parent then
			frame:Destroy()
		end
	end)
end

----------------------------------------------------------------------
-- Dialogue and story-telling
----------------------------------------------------------------------
local dialog = UI.panel({ Name = "Dialog", Visible = false, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -130), Size = UDim2.new(0, 900, 0, 180), ZIndex = 20, Parent = root })
local dialogWho = UI.label({ Text = "", Font = UI.TitleFont, TextSize = 26, TextColor3 = T.goldBright, Position = UDim2.new(0, 22, 0, 10), Size = UDim2.new(1, -44, 0, 32), ZIndex = 21, Parent = dialog })
local dialogText = UI.label({ Text = "", TextSize = 19, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.new(0, 22, 0, 48), Size = UDim2.new(1, -44, 0, 88), ZIndex = 21, Parent = dialog })
local dialogNext = UI.button({ Text = "Continue", AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -12), Size = UDim2.new(0, 150, 0, 34), ZIndex = 22, Parent = dialog })
local dialogQueue = {}
local dialogOpen = false

local function showNextLine()
	local line = table.remove(dialogQueue, 1)
	if not line then
		if dialogOpen then
			Action:FireServer("DialogDone")
		end
		dialogOpen = false
		dialog.Visible = false
		return
	end
	dialogOpen = true
	dialog.Visible = true
	local who = line[1] or ""
	dialogWho.Text = (who == "") and "The Story" or who
	dialogWho.TextColor3 = (who == "") and T.dim or T.goldBright
	dialogText.Font = (who == "") and Enum.Font.Garamond or UI.BodyFont
	dialogText.TextSize = (who == "") and 22 or 19
	dialogText.Text = line[2] or ""
	dialogNext.Text = (#dialogQueue > 0) and "Continue" or "Close"
end

local function queueDialog(lines)
	if type(lines) ~= "table" then
		return
	end
	for _, line in ipairs(lines) do
		table.insert(dialogQueue, line)
	end
	if not dialogOpen then
		Audio.play("talk")
		showNextLine()
	end
end
dialogNext.Activated:Connect(showNextLine)

----------------------------------------------------------------------
-- Windows (bag, shop, robes, path, shrine, leaves)
----------------------------------------------------------------------
local window = UI.panel({ Name = "Window", Visible = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -10), Size = UDim2.new(0, 780, 0, 540), ZIndex = 30, Parent = root })
local windowTitle = UI.label({ Text = "", Font = UI.TitleFont, TextSize = 32, TextColor3 = T.goldBright, Position = UDim2.new(0, 24, 0, 10), Size = UDim2.new(1, -110, 0, 40), ZIndex = 31, Parent = window })
local windowSub = UI.label({ Text = "", TextSize = 15, TextColor3 = T.dim, Position = UDim2.new(0, 24, 0, 50), Size = UDim2.new(1, -48, 0, 22), ZIndex = 31, Parent = window })
local windowList = UI.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 18, 0, 82), Size = UDim2.new(1, -36, 1, -100), CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 8, ScrollBarImageColor3 = T.gold, ZIndex = 31, Parent = window })
UI.new("UIListLayout", { Padding = UDim.new(0, 8), Parent = windowList })
local openWindow = nil -- { kind = ..., arg = ... }

local function closeWindow()
	openWindow = nil
	window.Visible = false
end
UI.button({ Text = "X", TextSize = 20, BackgroundColor3 = T.red, TextColor3 = T.cream, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.new(0, 40, 0, 36), ZIndex = 32, Parent = window }, closeWindow)

-- One row in a window: a name, a description, and (optionally) a button.
local function row(name, desc, buttonText, buttonColor, onClick, height)
	local frame = UI.new("Frame", { BackgroundColor3 = T.row, BorderSizePixel = 0, Size = UDim2.new(1, -12, 0, height or 68), ZIndex = 31, Parent = windowList }, { UI.corner(8) })
	UI.label({ Text = name, Font = UI.BoldFont, TextSize = 17, TextColor3 = T.goldBright, Position = UDim2.new(0, 14, 0, 6), Size = UDim2.new(1, -200, 0, 22), ZIndex = 32, Parent = frame })
	UI.label({ Text = desc, TextSize = 14, TextColor3 = T.cream, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.new(0, 14, 0, 28), Size = UDim2.new(1, -200, 1, -32), ZIndex = 32, Parent = frame })
	if buttonText then
		local b = UI.button({ Text = buttonText, BackgroundColor3 = buttonColor or T.saffron, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.new(0, 160, 0, 38), ZIndex = 32, Parent = frame }, onClick)
		if not onClick then
			b.AutoButtonColor = false
			b.BackgroundTransparency = 0.5
		end
	end
	return frame
end

local function heading(text)
	UI.label({ Text = text, Font = UI.TitleFont, TextSize = 22, TextColor3 = T.gold, Size = UDim2.new(1, -12, 0, 30), ZIndex = 31, Parent = windowList })
end

local function price(base)
	if state.path >= 3 then
		return math.floor(base * 0.85 + 0.5)
	end
	return base
end

local function leafCount()
	local n = 0
	for _ in pairs(state.leaves) do
		n = n + 1
	end
	return n
end

local function countOf(list)
	local n = 0
	for _ in pairs(list or {}) do
		n = n + 1
	end
	return n
end

-- The weapon in hand: its id and its entry in Config.Weapons.
local function heldWeapon()
	local id = state.weapon or "auto"
	if id == "auto" then
		id = state.abilities.staff and "staff" or "palm"
	end
	if id ~= "palm" and (not Config.Weapons[id] or (state.inv[id] or 0) < 1) then
		id = "palm"
	end
	return id, Config.Weapons[id]
end

local Windows = {}

function Windows.bag()
	windowTitle.Text = "Bag"
	windowSub.Text = "What you carry. A monk owns little."
	local ids = {}
	for id, count in pairs(state.inv) do
		if count > 0 and Config.Items[id] then
			table.insert(ids, id)
		end
	end
	table.sort(ids, function(a, b)
		return Config.Items[a].order < Config.Items[b].order
	end)
	if #ids == 0 then
		row("Empty", "Your bag is empty. Villagers give alms, and shops trade for merit.", nil)
	end
	for _, id in ipairs(ids) do
		local def = Config.Items[id]
		local label = nil
		if def.use == "heal" or def.use == "speed" or def.use == "regen" or def.use == "quest" then
			label = (def.use == "heal" or def.use == "quest") and "Eat" or "Use"
		elseif def.use == "offer" then
			label = "Offer"
		elseif def.use == "equip" then
			label = (heldWeapon() == id) and "Put away" or "Hold"
		elseif def.use == "wear" then
			label = (state.worn and state.worn[def.slot] == id) and "Take off" or "Wear"
		end
		local color = (label == "Put away" or label == "Take off") and T.green or nil
		local single = def.use == "equip" or def.use == "wear" or def.lanternColor
		row(def.name .. (single and "" or ("  x" .. state.inv[id])), def.desc, label, color, label and function()
			Action:FireServer("UseItem", id)
		end or nil)
	end
end

function Windows.shop(shopId)
	local shop = Config.Shops[shopId]
	if not shop then
		return
	end
	windowTitle.Text = shop.name
	windowSub.Text = "Merit: " .. state.merit .. "    Everything here is paid for with merit, not coins."
	for _, entry in ipairs(shop.stock) do
		local def = Config.Items[entry.item]
		local owned = entry.once and (state.bought[entry.item] or (state.inv[entry.item] or 0) > 0)
		if owned then
			row(def.name, def.desc, "Owned", T.green, nil)
		else
			local cost = price(entry.price)
			row(def.name, def.desc, cost .. " merit", (state.merit >= cost) and T.saffron or T.dim, function()
				Action:FireServer("Buy", shopId, entry.item)
			end)
		end
	end
	if shop.robux then
		heading("Support the temple (Robux)")
		row("About these", "These change only how things look, or are a gift to everyone. Nothing here makes the journey easier.", nil, nil, nil, 50)
		for _, def in ipairs(Config.Robux.passes) do
			if state.bought["pass_" .. def.id] then
				row(def.name, def.desc, "Owned", T.green, nil, 76)
			elseif def.passId > 0 then
				row(def.name, def.desc, "Robux", T.goldBright, function()
					Action:FireServer("BuyPass", def.id)
				end, 76)
			else
				row(def.name, def.desc, "Coming soon", T.dim, nil, 76)
			end
		end
		for _, def in ipairs(Config.Robux.products) do
			if def.productId > 0 then
				row(def.name, def.desc, "Robux", T.goldBright, function()
					Action:FireServer("BuyProduct", def.id)
				end, 76)
			else
				row(def.name, def.desc, "Coming soon", T.dim, nil, 76)
			end
		end
	end
end

function Windows.robes()
	windowTitle.Text = "Robes"
	windowSub.Text = "Merit: " .. state.merit .. "    Robes of the Buddhist traditions. Some can only be earned."
	for _, def in ipairs(Config.Robes) do
		if state.robe == def.id then
			row(def.name, def.desc, "Wearing", T.green, nil)
		elseif state.robes[def.id] then
			row(def.name, def.desc, "Wear", T.goldBright, function()
				Action:FireServer("WearRobe", def.id)
			end)
		elseif def.pass then
			row(def.name, def.desc, "A patron's gift", T.dim, nil)
		elseif def.quest or def.reward then
			row(def.name, def.desc, "Earned on the journey", T.dim, nil)
		else
			local cost = price(def.price or 0)
			row(def.name, def.desc, cost .. " merit", (state.merit >= cost) and T.saffron or T.dim, function()
				Action:FireServer("BuyRobe", def.id)
			end)
		end
	end
end

local function pathRows()
	for i, step in ipairs(Config.Path) do
		local title = i .. ". " .. step.name .. "  (" .. step.pali .. ")"
		if i <= state.path then
			row(title, step.text, "Practised", T.green, nil, 60)
		elseif i == state.path + 1 then
			row(title, step.text, step.cost .. " merit", (state.merit >= step.cost) and T.saffron or T.dim, function()
				Action:FireServer("BuyPath")
			end, 60)
		else
			row(title, step.text, "Later", T.dim, nil, 60)
		end
	end
end

function Windows.path()
	windowTitle.Text = "The Noble Eightfold Path"
	windowSub.Text = "Merit: " .. state.merit .. "    Practised in order, at any shrine."
	pathRows()
end

function Windows.leaves()
	windowTitle.Text = "Things Found"
	windowSub.Text = "Leaves " .. leafCount() .. " of " .. #Config.Leaves .. "    Symbols " .. countOf(state.symbols) .. " of " .. #Config.Symbols .. "    Animal friends " .. countOf(state.friends) .. " of " .. #Config.Animals
	heading("The Eight Auspicious Symbols")
	for _, def in ipairs(Config.Symbols) do
		if state.symbols and state.symbols[def.id] then
			row(def.name, def.text, nil, nil, nil, 76)
		else
			row("A hidden symbol", "Not yet found. One is hidden in each land, far from the road. Find all eight to earn the Sword of Wisdom.", nil, nil, nil, 60)
		end
	end
	heading("Animals of the Jataka Tales")
	for _, def in ipairs(Config.Animals) do
		if state.friends and state.friends[def.id] then
			row(def.name, def.text .. "  (" .. def.source .. ", retold)", nil, nil, nil, 112)
		else
			row("An animal you have not met", "Somewhere along the road an animal is waiting. Share Alms Rice with it to hear its story. Befriend all six to earn the Wheel of Light.", nil, nil, nil, 50)
		end
	end
	heading("Bodhi Leaves")
	for i, teaching in ipairs(Story.Teachings) do
		if state.leaves["leaf_" .. i] then
			row("Leaf " .. i, teaching.text .. "  (" .. teaching.source .. ", paraphrased)", nil, nil, nil, 76)
		else
			row("Leaf " .. i, "Not yet found. Look off the road, in quiet corners.", nil, nil, nil, 50)
		end
	end
end

function Windows.shrine(shrineId)
	local name = "Shrine"
	for _, s in ipairs(Config.Shrines) do
		if s.id == shrineId then
			name = s.name
		end
	end
	windowTitle.Text = name
	windowSub.Text = "Merit: " .. state.merit .. "    Your Calm is restored. You will return here if you are overwhelmed."
	heading("Offerings")
	local any = false
	for _, id in ipairs({ "lotus", "lamp" }) do
		local count = state.inv[id] or 0
		if count > 0 then
			any = true
			local def = Config.Items[id]
			row(def.name .. "  x" .. count, def.desc, "Offer", nil, function()
				Action:FireServer("UseItem", id)
			end, 60)
		end
	end
	if not any then
		row("Nothing to offer", "Lotus flowers grow in the ponds. Butter lamps are sold in the shops.", nil, nil, nil, 50)
	end
	heading("Travel to another shrine")
	for _, s in ipairs(Config.Shrines) do
		if s.id ~= shrineId and state.shrines[s.id] then
			row(s.name, "A shrine you have prayed at.", "Travel", T.goldBright, function()
				Action:FireServer("Travel", s.id)
				closeWindow()
			end, 50)
		end
	end
	heading("The Noble Eightfold Path")
	pathRows()
end

local function refreshWindow()
	if not openWindow then
		return
	end
	local y = windowList.CanvasPosition
	UI.clear(windowList)
	Windows[openWindow.kind](openWindow.arg)
	windowList.CanvasPosition = y
end

local function showWindow(kind, arg)
	if openWindow and openWindow.kind == kind and kind ~= "shop" and kind ~= "shrine" then
		closeWindow()
		return
	end
	openWindow = { kind = kind, arg = arg }
	window.Visible = true
	windowList.CanvasPosition = Vector2.new(0, 0)
	refreshWindow()
end

local function menuButton(text, kind)
	UI.button({ Text = text, TextSize = 14, BackgroundColor3 = T.panelLight, TextColor3 = T.goldBright, Size = UDim2.new(0, 78, 1, 0), Parent = menu }, function()
		showWindow(kind)
	end)
end
menuButton("Bag (B)", "bag")
menuButton("Path (P)", "path")
menuButton("Robes", "robes")
menuButton("Finds", "leaves")

----------------------------------------------------------------------
-- Abilities (bottom centre)
----------------------------------------------------------------------
local bar = UI.new("Frame", { Name = "Abilities", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.new(0, 460, 0, 92), Parent = root })
UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Parent = bar })

local abilityButtons = {}
local cooldownEnds = {}
local cooldownLength = {}
local meditating = false
local slashTrack = nil
local slashOwner = nil

local function humanoid()
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid") or nil
end

local function playSlash()
	local hum = humanoid()
	if not hum then
		return
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	pcall(function()
		if not slashTrack or slashOwner ~= animator then
			slashOwner = animator
			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://522635514"
			slashTrack = animator:LoadAnimation(anim)
			slashTrack.Priority = Enum.AnimationPriority.Action
		end
		slashTrack:Play(0.05)
	end)
end

local function setMeditating(on)
	if meditating == on then
		return
	end
	meditating = on
	if on then
		Audio.play("meditate")
	end
	local hum = humanoid()
	if hum then
		hum.Sit = on
	end
	Action:FireServer("meditate", on)
end

local function useAbility(name)
	local def = Config.Abilities[name]
	if not def or not state.abilities[name] then
		return
	end
	if dialogOpen then
		return
	end
	if name == "meditate" then
		setMeditating(not meditating)
		return
	end
	local now = os.clock()
	if now < (cooldownEnds[name] or 0) then
		return
	end
	local cd = def.cooldown
	if name == "beads" and (state.inv.long_mala or 0) > 0 then
		cd = cd / 2
	end
	if name == "strike" then
		local _, weapon = heldWeapon()
		cd = weapon.cooldown
	end
	cooldownEnds[name] = now + cd
	cooldownLength[name] = cd
	if meditating then
		setMeditating(false)
	end
	if name == "strike" then
		playSlash()
	end
	Audio.play(name)
	Action:FireServer(name)
end

do
	local names = {}
	for name in pairs(Config.Abilities) do
		table.insert(names, name)
	end
	table.sort(names, function(a, b)
		return Config.Abilities[a].order < Config.Abilities[b].order
	end)
	for _, name in ipairs(names) do
		local def = Config.Abilities[name]
		local b = UI.button({ Name = name, Text = "", BackgroundColor3 = T.panel, LayoutOrder = def.order, Size = UDim2.new(0, 82, 0, 82), ClipsDescendants = true, Parent = bar }, function()
			useAbility(name)
		end)
		UI.stroke(T.gold, 2).Parent = b
		UI.label({ Text = def.name, Font = UI.TitleFont, TextSize = 19, TextColor3 = T.goldBright, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 0, 14), Size = UDim2.new(1, 0, 0, 30), ZIndex = 3, Parent = b })
		UI.label({ Text = def.key, Font = UI.BoldFont, TextSize = 14, TextColor3 = T.dim, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 1, -28), Size = UDim2.new(1, 0, 0, 20), ZIndex = 3, Parent = b })
		local shade = UI.new("Frame", { Name = "Shade", BackgroundColor3 = T.black, BackgroundTransparency = 0.35, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 0), ZIndex = 2, Parent = b })
		abilityButtons[name] = { button = b, shade = shade }
	end
end

----------------------------------------------------------------------
-- Keeping the screen up to date
----------------------------------------------------------------------
local marker = Instance.new("Part")
marker.Name = "GoalMarker"
marker.Anchored = true
marker.CanCollide = false
marker.CanTouch = false
marker.CanQuery = false
marker.Transparency = 1
marker.Size = Vector3.new(1, 1, 1)
local markerGui = UI.new("BillboardGui", { Size = UDim2.new(0, 150, 0, 54), AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 100000, Enabled = false, Parent = marker })
local markerDiamond = UI.new("Frame", { BackgroundColor3 = T.goldBright, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 2), Size = UDim2.new(0, 18, 0, 18), Rotation = 45, Parent = markerGui }, { UI.stroke(T.black, 2) })
local markerText = UI.label({ Text = "", Font = UI.BoldFont, TextSize = 15, TextColor3 = T.goldBright, TextStrokeTransparency = 0.2, TextStrokeColor3 = T.black, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 22), Parent = markerGui })
marker.Parent = workspace
local goal = nil

local function npcPlace(id)
	for _, npc in ipairs(Story.NPCs) do
		if npc.id == id then
			return npc
		end
	end
	return nil
end

local INTERACT_PLACE = { temple_bell = "temple_bell", hair_rock = "hair_rock", bowl_river = "bowl_river", vajrasana = "seat" }

-- Where should the golden marker point for this objective?
local function goalFor(obj)
	if obj.kind == "talk" then
		return npcPlace(obj.target)
	elseif obj.kind == "interact" then
		return Config.Places[INTERACT_PLACE[obj.target] or ""]
	elseif obj.kind == "alms" then
		-- the next villager who has not yet filled the bowl
		for _, npc in ipairs(Story.NPCs) do
			if npc.alms and not (state.almsGiven and state.almsGiven[npc.id]) then
				return npc
			end
		end
		return { x = 190, z = 0 }
	elseif obj.kind == "meditate" then
		for _, s in ipairs(Config.MeditationSpots) do
			if s.id == obj.target then
				return s
			end
		end
	elseif obj.kind == "reach" then
		return Config.Areas[obj.target]
	elseif obj.kind == "dispel" then
		for _, s in ipairs(Config.Spawns) do
			if s.type == obj.target or s.group == obj.target then
				return s
			end
		end
	elseif obj.kind == "collect" then
		for i, p in ipairs(Config.Kusa) do
			if not state.collected["kusa_" .. i] then
				return p
			end
		end
	elseif obj.kind == "boss" then
		return Config.Places.arena
	end
	return nil
end

local function refreshTracker()
	local quest = Story.Quests[state.stage] or Story.Quests[1]
	questTitle.Text = quest.title
	questIntro.Text = quest.intro or ""
	UI.clear(questList)
	goal = nil
	for i, obj in ipairs(quest.objectives) do
		local need = obj.count or 1
		local have = math.min(need, math.floor(state.prog[tostring(i)] or 0))
		local done = have >= need
		local text = obj.text
		if need > 1 then
			text = text .. "  " .. have .. " / " .. need
		end
		UI.label({ Text = (done and "[done]  " or "-  ") .. text, Font = UI.BoldFont, TextSize = 15, TextColor3 = done and T.green or T.cream, Size = UDim2.new(1, 0, 0, 20), Parent = questList })
		if not done and not goal then
			goal = goalFor(obj)
		end
	end
	if quest.final then
		UI.label({ Text = "Leaves found: " .. leafCount() .. " / " .. #Config.Leaves, Font = UI.BoldFont, TextSize = 15, Size = UDim2.new(1, 0, 0, 20), Parent = questList })
		UI.label({ Text = "Eightfold Path: " .. state.path .. " / " .. #Config.Path, Font = UI.BoldFont, TextSize = 15, Size = UDim2.new(1, 0, 0, 20), Parent = questList })
	end
	if goal then
		marker.CFrame = CFrame.new(goal.x, (goal.y or 0) + 11, goal.z)
		markerGui.Enabled = true
	else
		markerGui.Enabled = false
	end
end

local function refreshAbilities()
	for name, entry in pairs(abilityButtons) do
		entry.button.Visible = state.abilities[name] == true
	end
end

local function refreshCalm()
	local max = player:GetAttribute("MaxCalm") or 100
	local calm = math.clamp(player:GetAttribute("Calm") or max, 0, max)
	calmFill.Size = UDim2.new(calm / max, 0, 1, 0)
	calmFill.BackgroundColor3 = (calm / max < 0.3) and T.red or T.calm
	calmText.Text = math.floor(calm + 0.5) .. " / " .. max
end

local function refreshMerit()
	meritText.Text = tostring(player:GetAttribute("Merit") or state.merit or 0)
end

player:GetAttributeChangedSignal("Calm"):Connect(refreshCalm)
player:GetAttributeChangedSignal("MaxCalm"):Connect(refreshCalm)
player:GetAttributeChangedSignal("Merit"):Connect(refreshMerit)
player:GetAttributeChangedSignal("Meditating"):Connect(function()
	if not player:GetAttribute("Meditating") and meditating then
		meditating = false
		local hum = humanoid()
		if hum then
			hum.Sit = false
		end
	end
end)

Remotes:WaitForChild("State").OnClientEvent:Connect(function(new)
	if type(new) ~= "table" then
		return
	end
	for key, value in pairs(new) do
		state[key] = value
	end
	refreshTracker()
	refreshAbilities()
	refreshMerit()
	refreshWindow()
	Fx.refreshWorld(state)
	Audio.setStage(state.stage)
end)

Remotes:WaitForChild("Notify").OnClientEvent:Connect(toast)
Remotes:WaitForChild("Dialog").OnClientEvent:Connect(queueDialog)
Remotes:WaitForChild("UI").OnClientEvent:Connect(function(kind, arg)
	if Windows[kind] then
		if kind == "shrine" then
			Audio.play("pray")
		end
		openWindow = nil
		showWindow(kind, arg)
	end
end)

----------------------------------------------------------------------
-- Effects sent by the server
----------------------------------------------------------------------
local function flash(color, peak, seconds)
	fade.BackgroundColor3 = color
	fade.BackgroundTransparency = peak
	tween(fade, seconds, { BackgroundTransparency = 1 })
end

local Effects = {}
Effects.petals = Fx.petals
Effects.ring = Fx.ring
Effects.hit = Fx.hit
function Effects.bell()
	Fx.shake(0.4, 0.25)
end
-- the song bells and the drum in the Pilgrims' Garden
function Effects.note(data)
	Audio.play("pray", data.pos, 1, data.pitch or 1)
end
function Effects.drum(data)
	Audio.play("hit", data.pos, 1.5, 0.5)
end
function Effects.hurt()
	vignette.BackgroundTransparency = 0.72
	tween(vignette, 0.5, { BackgroundTransparency = 1 })
end
function Effects.fade()
	fade.BackgroundColor3 = T.black
	tween(fade, 0.3, { BackgroundTransparency = 0 })
	task.delay(0.8, function()
		tween(fade, 0.6, { BackgroundTransparency = 1 })
	end)
end
function Effects.overwhelm(data)
	meditating = false
	fade.BackgroundColor3 = T.black
	tween(fade, 0.5, { BackgroundTransparency = 0 })
	fadeText.Text = data.text or ""
	tween(fadeText, 0.5, { TextTransparency = 0 })
	task.delay(3, function()
		tween(fade, 1, { BackgroundTransparency = 1 })
		tween(fadeText, 1, { TextTransparency = 1 })
	end)
end
function Effects.storm(data)
	flash(data.color or T.black, 0.55, 1.2)
	Fx.shake(0.6, 0.4)
end
function Effects.quake()
	Fx.shake(3, 1.6)
	flash(Color3.fromRGB(255, 240, 200), 0.1, 3)
end
function Effects.awaken()
	fade.BackgroundColor3 = Color3.fromRGB(255, 248, 226)
	tween(fade, 2.5, { BackgroundTransparency = 0 })
	fadeText.TextColor3 = Color3.fromRGB(120, 80, 20)
	fadeText.Text = "The morning star rises.\nYou are awake."
	task.delay(2.5, function()
		Fx.setMood("dawn", 0.1)
		tween(fadeText, 1, { TextTransparency = 0 })
	end)
	task.delay(8, function()
		tween(fade, 4, { BackgroundTransparency = 1 })
		tween(fadeText, 3, { TextTransparency = 1 })
	end)
	task.delay(12.5, function()
		fadeText.TextColor3 = T.cream
	end)
end

Remotes:WaitForChild("Fx").OnClientEvent:Connect(function(name, data)
	Audio.play(name, type(data) == "table" and data.pos or nil)
	local fn = Effects[name]
	if fn then
		local ok, err = pcall(fn, data or {})
		if not ok then
			warn("[Bodhi Path] effect failed:", name, err)
		end
	end
end)

----------------------------------------------------------------------
-- Mara
----------------------------------------------------------------------
local function refreshBoss()
	local phase = BossState:GetAttribute("Phase") or "idle"
	local near = false
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp then
		local a = Config.Places.arena
		near = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(a.x, 0, a.z)).Magnitude < a.radius + 60
	end
	bossPanel.Visible = phase ~= "idle" and near
	earthButton.Visible = phase == "witness" and near
	local text = BossState:GetAttribute("Text") or ""
	if phase == "mara" then
		local hp, max = BossState:GetAttribute("Hp") or 0, BossState:GetAttribute("MaxHp") or 1
		bossBack.Visible = true
		bossFill.Size = UDim2.new(math.clamp(hp / math.max(1, max), 0, 1), 0, 1, 0)
	elseif phase == "host" or phase == "storms" then
		local count, need = BossState:GetAttribute("Count") or 0, BossState:GetAttribute("Need") or 1
		bossBack.Visible = true
		bossFill.Size = UDim2.new(math.clamp(count / math.max(1, need), 0, 1), 0, 1, 0)
		text = text .. "  (" .. count .. " / " .. need .. ")"
	else
		bossBack.Visible = false
	end
	bossText.Text = text
end
BossState.AttributeChanged:Connect(refreshBoss)

----------------------------------------------------------------------
-- Keys
----------------------------------------------------------------------
local KEYS = {}
for name, def in pairs(Config.Abilities) do
	KEYS[Enum.KeyCode[def.key]] = name
end

UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.Return then
		if dialogOpen then
			showNextLine()
			return
		end
	end
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if dialogOpen then
			showNextLine()
		elseif not openWindow then
			useAbility("strike")
		end
	elseif input.UserInputType == Enum.UserInputType.Keyboard then
		local ability = KEYS[input.KeyCode]
		if ability then
			useAbility(ability)
		elseif input.KeyCode == Enum.KeyCode.B then
			showWindow("bag")
		elseif input.KeyCode == Enum.KeyCode.P then
			showWindow("path")
		elseif input.KeyCode == Enum.KeyCode.T then
			Action:FireServer("TouchEarth")
		elseif input.KeyCode == Enum.KeyCode.Escape then
			closeWindow()
		end
	elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
		if input.KeyCode == Enum.KeyCode.ButtonR2 then
			useAbility("strike")
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			useAbility("beads")
		elseif input.KeyCode == Enum.KeyCode.ButtonY then
			useAbility("meditate")
		elseif input.KeyCode == Enum.KeyCode.ButtonR1 then
			useAbility("metta")
		elseif input.KeyCode == Enum.KeyCode.ButtonL1 then
			useAbility("bowl")
		end
	end
end)

----------------------------------------------------------------------
-- Every frame / every half second
----------------------------------------------------------------------
local currentZone = nil

local function showZone(zone)
	zoneTitle.Text = zone.name
	zoneSub.Text = zone.sub
	tween(zoneTitle, 1, { TextTransparency = 0, TextStrokeTransparency = 0.4 })
	tween(zoneSub, 1, { TextTransparency = 0, TextStrokeTransparency = 0.5 })
	task.delay(4.5, function()
		if currentZone == zone then
			tween(zoneTitle, 1.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
			tween(zoneSub, 1.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	for name, entry in pairs(abilityButtons) do
		local left = (cooldownEnds[name] or 0) - now
		local length = cooldownLength[name] or 1
		if left > 0 and length > 0.6 then
			entry.shade.Size = UDim2.new(1, 0, math.clamp(left / length, 0, 1), 0)
		else
			entry.shade.Size = UDim2.new(1, 0, 0, 0)
		end
	end
	local med = abilityButtons.meditate
	if med then
		med.button.BackgroundColor3 = meditating and T.saffron or T.panel
	end
end)

task.spawn(function()
	while true do
		task.wait(0.5)
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		local hum = humanoid()
		if hrp then
			local zone = Fx.zoneAt(hrp.Position.X)
			if zone ~= currentZone then
				currentZone = zone
				showZone(zone)
			end
			local mood = zone.light
			if zone.id == "bodhgaya" and player:GetAttribute("Awakened") then
				mood = "dawn"
			end
			Fx.setMood(mood, 4)
			if goal then
				local d = (Vector3.new(goal.x, hrp.Position.Y, goal.z) - hrp.Position).Magnitude
				markerText.Text = math.floor(d / 3.5 + 0.5) .. " m"
				markerGui.Enabled = d > 14
			end
		end
		-- standing up (jumping or walking) ends meditation
		if meditating and hum and not hum.Sit then
			meditating = false
			Action:FireServer("meditate", false)
		end
		buffText.Text = meditating and "Meditating" or ""
		refreshBoss()
	end
end)

refreshCalm()
refreshMerit()
refreshTracker()
refreshAbilities()
Action:FireServer("Ready")
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[-- UI: small helpers and the shared look of every panel on screen.

local UI = {}

UI.Theme = {
	panel = Color3.fromRGB(46, 22, 24),
	panelLight = Color3.fromRGB(74, 36, 34),
	row = Color3.fromRGB(62, 30, 30),
	gold = Color3.fromRGB(226, 178, 54),
	goldBright = Color3.fromRGB(255, 214, 96),
	cream = Color3.fromRGB(246, 236, 212),
	dim = Color3.fromRGB(196, 176, 150),
	saffron = Color3.fromRGB(232, 136, 24),
	green = Color3.fromRGB(110, 170, 96),
	red = Color3.fromRGB(196, 72, 60),
	calm = Color3.fromRGB(96, 190, 200),
	black = Color3.fromRGB(12, 8, 8),
}

UI.TitleFont = Enum.Font.Fondamento
UI.BodyFont = Enum.Font.Merriweather
UI.BoldFont = Enum.Font.GothamBold

-- Create an instance, set its properties, and add children.
function UI.new(class, props, children)
	local inst = Instance.new(class)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				inst[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(color, thickness)
	return UI.new("UIStroke", { Color = color or UI.Theme.gold, Thickness = thickness or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.pad(n)
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, n), PaddingRight = UDim.new(0, n),
		PaddingTop = UDim.new(0, n), PaddingBottom = UDim.new(0, n),
	})
end

-- A framed panel.
function UI.panel(props)
	props.BackgroundColor3 = props.BackgroundColor3 or UI.Theme.panel
	props.BackgroundTransparency = props.BackgroundTransparency or 0.08
	props.BorderSizePixel = 0
	return UI.new("Frame", props, { UI.corner(12), UI.stroke(UI.Theme.gold, 2) })
end

function UI.label(props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or UI.BodyFont
	props.TextColor3 = props.TextColor3 or UI.Theme.cream
	props.TextSize = props.TextSize or 18
	props.TextWrapped = (props.TextWrapped == nil) and true or props.TextWrapped
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	props.TextYAlignment = props.TextYAlignment or Enum.TextYAlignment.Center
	return UI.new("TextLabel", props)
end

function UI.button(props, onClick)
	props.BackgroundColor3 = props.BackgroundColor3 or UI.Theme.saffron
	props.BorderSizePixel = 0
	props.AutoButtonColor = true
	props.Font = props.Font or UI.BoldFont
	props.TextColor3 = props.TextColor3 or UI.Theme.black
	props.TextSize = props.TextSize or 16
	props.TextWrapped = true
	local b = UI.new("TextButton", props, { UI.corner(8) })
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

function UI.clear(frame)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

return UI
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
